local function neutralizeSeat(seat)
    if seat:IsA("Seat") or seat:IsA("VehicleSeat") then
        seat.Disabled=true seat.CanTouch=false
    end
end

local function setupAntiSit(state)
    AntiSit = state
    if antiSitConn1 then antiSitConn1:Disconnect() end
    if antiSitConn2 then antiSitConn2:Disconnect() end
    if antiSitConn3 then antiSitConn3:Disconnect() end
    if state then
        for _,obj in ipairs(workspace:GetDescendants()) do neutralizeSeat(obj) end
        antiSitConn1=workspace.DescendantAdded:Connect(function(obj)
            if obj:IsA("Seat") or obj:IsA("VehicleSeat") then task.wait(0.1) neutralizeSeat(obj) end
        end)
        if LocalPlayer.Character then
            local hum=LocalPlayer.Character:FindFirstChild("Humanoid")
            if hum then antiSitConn2=hum:GetPropertyChangedSignal("Sit"):Connect(function() if hum.Sit then hum.Sit=false end end) end
        end
        antiSitConn3=LocalPlayer.CharacterAdded:Connect(function(char)
            local hum=char:WaitForChild("Humanoid")
            hum:GetPropertyChangedSignal("Sit"):Connect(function() if hum.Sit and AntiSit then hum.Sit=false end end)
        end)
    end
end

local function setupSilentReload(enabled)
    if silentReloadConn then silentReloadConn:Disconnect() silentReloadConn=nil end
    if enabled and LocalPlayer.Character then
        local hum=LocalPlayer.Character:WaitForChild("Humanoid")
        silentReloadConn=RunService.Heartbeat:Connect(function()
            for _,track in pairs(hum:GetPlayingAnimationTracks()) do
                if track.Animation.AnimationId=="rbxassetid://2877910736" then track:Stop() end
            end
        end)
    end
end

