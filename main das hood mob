    e3.Lifetime=NumberRange.new(2,2); e3.FlipbookLayout=Enum.ParticleFlipbookLayout.Grid4x4
    e3.SpreadAngle=Vector2.new(180,180); e3.LockedToPart=true; e3.LightEmission=1
