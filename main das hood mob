local function emitHitParticles(target, hitPart)
    if not (hitParticleSettings.enabled or (Toggles.HitParticlesToggle and Toggles.HitParticlesToggle.Value)) then return end
    if not target or not target.Character then return end
    local root = target.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    hitParticlePart.CFrame = root.CFrame
    local ptype = hitParticleSettings.particleType
    local emitters = hitParticleTypes[ptype]
    local count = hitParticleCounts[ptype] or 1
    if emitters then
        for _, name in ipairs(emitters) do
            local e = hitParticleEmitters[name]
            if e then
                e:Emit(count)
            end
        end
    end
end

