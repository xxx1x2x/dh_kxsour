local function getClosestPlayerToScreenDot()
    local closestPlayer = nil
    local bestScore = math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            local root = v.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local be = v.Character:FindFirstChild("BodyEffects")
                local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
                local isSD = be and be:FindFirstChild("SDeath") and be["SDeath"].Value
                if not (isKO or isSD) then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        local centerDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        local maxDistance = SilentAimSettings.FOV or 500
                        if centerDist <= maxDistance or bestScore == math.huge then
                            local worldDist = (root.Position - myRoot.Position).Magnitude
                            local score = worldDist + (centerDist * 0.5)
                            if score < bestScore then
                                bestScore = score
                                closestPlayer = v
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPlayer
end

