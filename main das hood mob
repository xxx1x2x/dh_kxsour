    local s=Instance.new("Sound"); s.SoundId=hitsounds[HitSndSettings.sound_id]; s.Volume=HitSndSettings.volume; s.Parent=workspace; s:Play()
    s.Ended:Connect(function() s:Destroy() end)
end
local prevHitHealth={}
RunService.Heartbeat:Connect(function()
    for _,player in ipairs(Players:GetPlayers()) do
        if player~=LocalPlayer and player.Character then
            local hum=player.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                local cur=hum.Health; local prev=prevHitHealth[player.UserId] or cur
                if cur<prev then doHitSound() end
                prevHitHealth[player.UserId]=cur
            end
