local oldToolGrips = {}

local function resetToolGrips()
    for tool, origGrip in pairs(oldToolGrips) do
        if tool and tool.Parent then
            pcall(function() tool.Grip = origGrip end)
        end
    end
    oldToolGrips = {}
end

Toggles.EnableAnimatedTools:OnChanged(function()
    if not Toggles.EnableAnimatedTools.Value then
        resetToolGrips()
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if not Toggles.EnableAnimatedTools or not Toggles.EnableAnimatedTools.Value then return end
    local char = LocalPlayer.Character
    if not char then return end

    local hMode = Options.AnimToolHorizontal and Options.AnimToolHorizontal.Value or 'sine spin'
    local hSpeed = (Options.AnimToolHorizontalSpeed and Options.AnimToolHorizontalSpeed.Value or 10) / 10
    local vMode = Options.AnimToolVertical and Options.AnimToolVertical.Value or 'sine spin'
    local vSpeed = (Options.AnimToolVerticalSpeed and Options.AnimToolVerticalSpeed.Value or 10) / 10

    local horiz = 0
    if hMode == 'sine spin' then
        horiz = math.sin(os.clock()) * 45
    elseif hMode == 'random' then
        horiz = (math.random() * 2 - 1) * 180
    elseif hMode == 'jitter' then
        horiz = math.random(-10, 10)
    elseif hMode == 'spin' then
        horiz = 45
    end

    local vert = 0
    if vMode == 'sine spin' then
        vert = math.sin(os.clock()) * 45
    elseif vMode == 'random' then
        vert = (math.random() * 2 - 1) * 180
    elseif vMode == 'jitter' then
        vert = math.random(-10, 10)
    elseif vMode == 'spin' then
        vert = 45
    end

    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and child:FindFirstChild("Handle") then
            if not oldToolGrips[child] then
                oldToolGrips[child] = child.Grip
            end
            pcall(function()
                child.Grip = child.Grip * CFrame.Angles(math.rad(vert * dt * vSpeed), math.rad(horiz * dt * hSpeed), 0)
            end)
        end
    end
end)

