end)


local isDmgEnabled=false
local dmgColor=Color3.fromRGB(255,255,255)
local prevDmgHealth={}

do
    local dmgRayParams=RaycastParams.new()
    dmgRayParams.FilterType=Enum.RaycastFilterType.Blacklist
    dmgRayParams.IgnoreWater=true

    local function isVisible(player)
        if not player.Character or not player.Character:FindFirstChild("Head") then return false end
        local head=player.Character.Head
        local orig=Camera.CFrame.Position
        local dir=(head.Position-orig)
        dmgRayParams.FilterDescendantsInstances={LocalPlayer.Character}
        local res=workspace:Raycast(orig,dir,dmgRayParams)
        return not res or res.Instance:IsDescendantOf(player.Character)
    end

    local function getNearestCursor()
        local mouse=UserInputService:GetMouseLocation()
        local nearest,shortest=nil,math.huge
        for _,player in ipairs(Players:GetPlayers()) do
            if player~=LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and isVisible(player) then
                local sp,on=Camera:WorldToViewportPoint(player.Character.Head.Position)
                if on then
                    local d=(Vector2.new(sp.X,sp.Y)-mouse).Magnitude
                    if d<shortest then shortest=d nearest=player end
                end
            end
        end
        return nearest
    end

    local function showDamage(player,amount)
        if not isDmgEnabled then return end
        local head=player.Character and player.Character:FindFirstChild("Head"); if not head then return end
        local gui=head:FindFirstChild("DamageContainer")
        if not gui then
            gui=Instance.new("BillboardGui"); gui.Name="DamageContainer"; gui.Parent=head; gui.Adornee=head
            gui.Size=UDim2.new(0,100,0,50); gui.StudsOffset=Vector3.new(0,2,0); gui.AlwaysOnTop=true; gui.MaxDistance=500; gui.Enabled=true
        end
        local lbl=Instance.new("TextLabel",gui)
        lbl.Text=tostring(amount); lbl.TextColor3=dmgColor; lbl.TextSize=32+(amount/10); lbl.Font=Enum.Font.SourceSansBold
        lbl.BackgroundTransparency=1; lbl.Size=UDim2.new(1,0,0,32); lbl.TextStrokeTransparency=0.4
        lbl.Position=UDim2.new(0.5,-50+math.random(-20,20),0,math.random(-20,20))
        local t1=TweenService:Create(lbl,TweenInfo.new(3,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),{Position=UDim2.new(0.5,-50,0,-100)})
        t1:Play()
        t1.Completed:Connect(function()
            local t2=TweenService:Create(lbl,TweenInfo.new(1,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),{TextTransparency=1,TextStrokeTransparency=1})
            t2:Play(); t2.Completed:Connect(function() lbl:Destroy() end)
        end)
    end

    RunService.RenderStepped:Connect(function()
        local near=getNearestCursor()
        if near and near.Character then
            local hum=near.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                local cur=hum.Health; local prev=prevDmgHealth[near.UserId] or cur
                if cur<prev and isDmgEnabled then showDamage(near,math.floor(prev-cur)) end
                prevDmgHealth[near.UserId]=cur
            end
        end
    end)
end


local ChinaHatSettings={
    enabled=false, hatTransparency=0.35, circleTransparency=1,
    height=0.75, radius=1, sides=25, rainbow=false,
    color=Color3.fromRGB(128,18,255), offset=Vector3.new(0,0.75,0)
}

do
    local chinaTau=math.pi*2
    local chinaLines={}; local chinaTris={}
    for i=1,25 do
        chinaLines[i]=Drawing.new("Line"); chinaLines[i].ZIndex=2; chinaLines[i].Thickness=2; chinaLines[i].Visible=false
        chinaTris[i]=Drawing.new("Triangle"); chinaTris[i].ZIndex=1; chinaTris[i].Filled=true; chinaTris[i].Visible=false
    end

    RunService.RenderStepped:Connect(function()
        local char=LocalPlayer.Character; local head=char and char:FindFirstChild("Head")
        local hum=char and char:FindFirstChildOfClass("Humanoid")
        local pass=ChinaHatSettings.enabled and head and hum and hum.Health>0
        for i=1,#chinaLines do
            if pass then
                local color=ChinaHatSettings.rainbow and Color3.fromHSV((tick()%5/5-(i/#chinaLines))%1,0.5,1) or ChinaHatSettings.color
                local pos=head.Position+ChinaHatSettings.offset
                local topWorld=pos+Vector3.new(0,ChinaHatSettings.height,0)
                local a1=(i/#chinaLines)*chinaTau; local a2=((i+1)/#chinaLines)*chinaTau
                local w1=pos+Vector3.new(math.cos(a1),0,math.sin(a1))*ChinaHatSettings.radius
                local w2=pos+Vector3.new(math.cos(a2),0,math.sin(a2))*ChinaHatSettings.radius
                local s1=Camera:WorldToViewportPoint(w1); local s2=Camera:WorldToViewportPoint(w2); local st=Camera:WorldToViewportPoint(topWorld)
                chinaLines[i].From=Vector2.new(s1.X,s1.Y); chinaLines[i].To=Vector2.new(s2.X,s2.Y)
                chinaLines[i].Color=color; chinaLines[i].Transparency=ChinaHatSettings.circleTransparency; chinaLines[i].Visible=true
                chinaTris[i].PointA=Vector2.new(st.X,st.Y); chinaTris[i].PointB=chinaLines[i].From; chinaTris[i].PointC=chinaLines[i].To
                chinaTris[i].Color=color; chinaTris[i].Transparency=ChinaHatSettings.hatTransparency; chinaTris[i].Visible=true
            else chinaLines[i].Visible=false; chinaTris[i].Visible=false end
        end
    end)
end


local scEnabled=false
local scColor=Color3.fromRGB(155,125,175)
local scTrans=0
local scReflect=0
local scMat="ForceField"
local scEffect="none"
local scParticles="none"
local scParticleColor=Color3.fromRGB(255,255,255)
local scParticleTrans=0

local scApply, scDisable, scEnable, scRemoveParticles, scApplyStars, scApplySpecks, scStartHeat, scStopHeat

do
    local scCharConn
    local scHeatConn
    local scHeatTime=0
    local scHeatLast=0
    local scOriginal={}
    local scR15={"LeftFoot","LeftLowerLeg","LeftUpperLeg","RightFoot","RightLowerLeg","RightUpperLeg","LeftHand","LeftLowerArm","LeftUpperArm","RightHand","RightLowerArm","RightUpperArm","LowerTorso","UpperTorso","Head"}
    local scHeatMap={LeftFoot=0.7,LeftLowerLeg=0.3,LeftUpperLeg=0.5,RightFoot=0.7,RightLowerLeg=0.3,RightUpperLeg=0.5,LeftHand=0.7,LeftLowerArm=0.3,LeftUpperArm=0.5,RightHand=0.7,RightLowerArm=0.3,RightUpperArm=0.5,LowerTorso=0.3,UpperTorso=0.5,Head=0.5}

    scRemoveParticles=function(char)
        if not char then return end
        for _,pn in ipairs(scR15) do local p=char:FindFirstChild(pn) if p then local s1=p:FindFirstChild("SC_Stars") local s2=p:FindFirstChild("SC_Specks") if s1 then pcall(function() s1:Destroy() end) end if s2 then pcall(function() s2:Destroy() end) end end end
    end

    scApplyStars=function(char)
        if not char then return end
        for _,pn in ipairs(scR15) do local p=char:FindFirstChild(pn) if not p then continue end pcall(function() local e=Instance.new("ParticleEmitter") e.Name="SC_Stars" e.Lifetime=NumberRange.new(0.45,0.9) e.LockedToPart=true e.LightEmission=1 e.Color=ColorSequence.new(scParticleColor) e.Speed=NumberRange.new(0.001,0.001) e.Brightness=3 e.ZOffset=1 e.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(0.508,0.05,0.05),NumberSequenceKeypoint.new(1,0)}) e.Rate=150 e.Texture="rbxassetid://1084996976" e.Transparency=NumberSequence.new(scParticleTrans) e.Orientation=Enum.ParticleOrientation.VelocityPerpendicular e.Parent=p end) end
    end

    scApplySpecks=function(char)
        if not char then return end
        for _,pn in ipairs(scR15) do local p=char:FindFirstChild(pn) if not p then continue end pcall(function() local e=Instance.new("ParticleEmitter") e.Name="SC_Specks" e.Lifetime=NumberRange.new(0.22,0.22) e.SpreadAngle=Vector2.new(90,90) e.LightEmission=1 e.Color=ColorSequence.new(scParticleColor) e.Speed=NumberRange.new(1,1) e.Brightness=4.2 e.Size=NumberSequence.new(0.15) local t=scParticleTrans e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,math.min(1,t+0.8)),NumberSequenceKeypoint.new(0.25,math.max(0,t-0.1)),NumberSequenceKeypoint.new(1,math.min(1,t+0.8))}) e.Rate=100 e.Texture="rbxassetid://7216849703" e.Acceleration=Vector3.new(0,-15,0) e.Parent=p end) end
    end

    local function scCacheChar(char)
        if not char then return end scOriginal={}
        for _,pn in ipairs(scR15) do local p=char:FindFirstChild(pn) if p and (p:IsA("MeshPart") or p:IsA("BasePart")) then scOriginal[pn]={Material=p.Material,Color=p.Color,Transparency=p.Transparency,Reflectance=p.Reflectance,TextureID=p:IsA("MeshPart") and p.TextureID or nil} end end
        for _,d in ipairs(char:GetDescendants()) do if d:IsA("Shirt") then scOriginal._shirt=d.ShirtTemplate end if d:IsA("Pants") then scOriginal._pants=d.PantsTemplate end end
    end

    scApply=function(char)
        if not char then return end
        for _,d in ipairs(char:GetDescendants()) do if d:IsA("Pants") or d:IsA("Shirt") then pcall(function() d:Destroy() end) end end
        for _,pn in ipairs(scR15) do local p=char:FindFirstChild(pn) if not p then continue end pcall(function() p.Material=Enum.Material[scMat] p.Color=scColor p.Reflectance=scReflect if p:IsA("MeshPart") then p.TextureID="" end if scEffect~="heat" then p.Transparency=scTrans end end) end
        scRemoveParticles(char)
        if scParticles=="stars" then scApplyStars(char) elseif scParticles=="specks" then scApplySpecks(char) end
    end

    local function scRestore(char)
        if not char then return end scRemoveParticles(char)
        for _,pn in ipairs(scR15) do local p=char:FindFirstChild(pn) local d=scOriginal[pn] if p and d then pcall(function() p.Material=d.Material p.Color=d.Color p.Transparency=d.Transparency p.Reflectance=d.Reflectance if p:IsA("MeshPart") and d.TextureID then p.TextureID=d.TextureID end end) end end
        if scOriginal._shirt then pcall(function() local s=Instance.new("Shirt") s.ShirtTemplate=scOriginal._shirt s.Parent=char end) end
        if scOriginal._pants then pcall(function() local p=Instance.new("Pants") p.PantsTemplate=scOriginal._pants p.Parent=char end) end
    end

    scStopHeat=function()
        if scHeatConn then scHeatConn:Disconnect() scHeatConn=nil end scHeatTime=0 scHeatLast=0
    end

    scStartHeat=function(char)
        scStopHeat() scHeatLast=tick()
        scHeatConn=RunService.Heartbeat:Connect(function()
            if not scEnabled or scEffect~="heat" then scStopHeat() return end
            if not char or not char.Parent then return end
            local now=tick() local dt=now-scHeatLast scHeatLast=now scHeatTime=scHeatTime+dt
            local pulse=math.sin(scHeatTime*2)*0.5+0.5
            for _,pn in ipairs(scR15) do local p=char:FindFirstChild(pn) if p and scHeatMap[pn] then local base=scHeatMap[pn] pcall(function() p.Transparency=base+(math.min(base+0.2,1)-base)*pulse end) end end
        end)
    end

    scEnable=function()
        local char=LocalPlayer.Character scCacheChar(char) scApply(char)
        if scEffect=="heat" then scStartHeat(char) end
        if scCharConn then scCharConn:Disconnect() end
        scCharConn=LocalPlayer.CharacterAdded:Connect(function(c)
            c:WaitForChild("Humanoid") task.wait(1.1)
            if not scEnabled then return end
            scCacheChar(c) scApply(c)
            if scEffect=="heat" then scStartHeat(c) end
        end)
    end

    scDisable=function()
        scStopHeat()
        if scCharConn then scCharConn:Disconnect() scCharConn=nil end
        scRestore(LocalPlayer.Character)
    end
end


local tcEnabled=false
local tcApply, tcDisable, tcEnable, tcRemoveParticles, tcApplyStars, tcApplySpecks
local tcTracked={}

do
    local tcColor=Color3.fromRGB(155,125,175)
    local tcTrans=0
    local tcReflect=0
    local tcMat="ForceField"
    local tcParticles="none"
    local tcParticleColor=Color3.fromRGB(255,255,255)
    local tcParticleTrans=0
    local tcCached={}
    local tcCharConn
    local tcAddedConn
    local tcRemovedConn

    tcRemoveParticles=function(tool)
        if not tool then return end
        for _,p in ipairs(tool:GetDescendants()) do if p:IsA("BasePart") or p:IsA("MeshPart") then local s1=p:FindFirstChild("TC_Stars") local s2=p:FindFirstChild("TC_Specks") if s1 then pcall(function() s1:Destroy() end) end if s2 then pcall(function() s2:Destroy() end) end end end
    end

    tcApplyStars=function(tool)
        if not tool then return end
        for _,p in ipairs(tool:GetDescendants()) do if (p:IsA("BasePart") or p:IsA("MeshPart")) and p.Name~="Handle" then pcall(function() local e=Instance.new("ParticleEmitter") e.Name="TC_Stars" e.Lifetime=NumberRange.new(0.45,0.9) e.LockedToPart=true e.LightEmission=1 e.Color=ColorSequence.new(tcParticleColor) e.Speed=NumberRange.new(0.001,0.001) e.Brightness=3 e.ZOffset=1 e.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(0.508,0.05,0.05),NumberSequenceKeypoint.new(1,0)}) e.Rate=150 e.Texture="rbxassetid://1084996976" e.Transparency=NumberSequence.new(tcParticleTrans) e.Orientation=Enum.ParticleOrientation.VelocityPerpendicular e.Parent=p end) end end
    end

    tcApplySpecks=function(tool)
        if not tool then return end
        for _,p in ipairs(tool:GetDescendants()) do if (p:IsA("BasePart") or p:IsA("MeshPart")) and p.Name~="Handle" then pcall(function() local e=Instance.new("ParticleEmitter") e.Name="TC_Specks" e.Lifetime=NumberRange.new(0.22,0.22) e.SpreadAngle=Vector2.new(90,90) e.LightEmission=1 e.Color=ColorSequence.new(tcParticleColor) e.Speed=NumberRange.new(1,1) e.Brightness=4.2 e.Size=NumberSequence.new(0.15) local t=tcParticleTrans e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,math.min(1,t+0.8)),NumberSequenceKeypoint.new(0.25,math.max(0,t-0.1)),NumberSequenceKeypoint.new(1,math.min(1,t+0.8))}) e.Rate=100 e.Texture="rbxassetid://7216849703" e.Acceleration=Vector3.new(0,-15,0) e.Parent=p end) end end
    end

    tcApply=function(tool)
        if not tool or not tcEnabled then return end
        for _,p in ipairs(tool:GetDescendants()) do if (p:IsA("BasePart") or p:IsA("MeshPart")) and p.Name~="Handle" then pcall(function() p.Material=Enum.Material[tcMat] p.Color=tcColor p.Transparency=tcTrans p.Reflectance=tcReflect if p:IsA("MeshPart") then p.TextureID="" end end) end end
        tcRemoveParticles(tool)
        if tcParticles=="stars" then tcApplyStars(tool) elseif tcParticles=="specks" then tcApplySpecks(tool) end
    end

    local function tcCacheTool(tool)
        if not tool or tcCached[tool] then return end tcCached[tool]={}
        for _,p in ipairs(tool:GetDescendants()) do if p:IsA("BasePart") or p:IsA("MeshPart") then tcCached[tool][p]={Material=p.Material,Color=p.Color,Transparency=p.Transparency,Reflectance=p.Reflectance,TextureID=p:IsA("MeshPart") and p.TextureID or nil} end end
    end

    local function tcRestoreTool(tool)
        if not tool then return end tcRemoveParticles(tool)
        local cache=tcCached[tool] if not cache then return end
        for p,d in pairs(cache) do if p and p.Parent then pcall(function() p.Material=d.Material p.Color=d.Color p.Transparency=d.Transparency p.Reflectance=d.Reflectance if p:IsA("MeshPart") and d.TextureID then p.TextureID=d.TextureID end end) end end
    end

    local function tcApplyAll()
        local char=LocalPlayer.Character if not char then return end
        for _,child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") and not tcTracked[child] then tcCacheTool(child) tcTracked[child]=true end
            if child:IsA("Tool") then tcApply(child) end
        end
    end

    local function tcSetupChar(char)
        if tcAddedConn then tcAddedConn:Disconnect() end
        if tcRemovedConn then tcRemovedConn:Disconnect() end
        tcAddedConn=char.ChildAdded:Connect(function(c)
            if c:IsA("Tool") and tcEnabled then task.wait(0.1) tcCacheTool(c) tcTracked[c]=true tcApply(c) end
        end)
        tcRemovedConn=char.ChildRemoved:Connect(function(c)
            if c:IsA("Tool") then tcTracked[c]=nil end
        end)
    end

    tcEnable=function()
        tcTracked={}; tcCached={}
        local char=LocalPlayer.Character
        if char then tcApplyAll() tcSetupChar(char) end
        if tcCharConn then tcCharConn:Disconnect() end
        tcCharConn=LocalPlayer.CharacterAdded:Connect(function(c)
            tcTracked={}; tcCached={}
            task.wait(0.5)
            if tcEnabled then tcApplyAll() tcSetupChar(c) end
        end)
    end

    tcDisable=function()
        if tcCharConn then tcCharConn:Disconnect() tcCharConn=nil end
        if tcAddedConn then tcAddedConn:Disconnect() tcAddedConn=nil end
        if tcRemovedConn then tcRemovedConn:Disconnect() tcRemovedConn=nil end
        for tool in pairs(tcTracked) do if tool and tool.Parent then tcRestoreTool(tool) end end
        tcTracked={}; tcCached={}
    end

    function Library._tcSet(key, val)
        if key=="color" then tcColor=val
        elseif key=="trans" then tcTrans=val
        elseif key=="reflect" then tcReflect=val
        elseif key=="mat" then tcMat=val
        elseif key=="particles" then tcParticles=val
        elseif key=="particleColor" then tcParticleColor=val
        elseif key=="particleTrans" then tcParticleTrans=val end
    end
end


local saEnabled      = false
local saColor        = Color3.fromRGB(133, 220, 255)
local saTypes        = {}
local saAttachments  = {}
local saCharConn

local function saClear()
    for _, a in ipairs(saAttachments) do pcall(function() a:Destroy() end) end
    saAttachments = {}
end

local function saMakeAtt(parent, cf)
    local a = Instance.new("Attachment")
    a.CFrame  = cf
    a.Parent  = parent
    table.insert(saAttachments, a)
    return a
end

local function saCreateAngelic(char)
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not torso then return end
    local a1 = saMakeAtt(torso, CFrame.new(-1.012,0.5,0.852,0.966,0,0.259,0,1,0,-0.259,0,0.966))
    local function makeE(parent, dir)
        local e = Instance.new("ParticleEmitter")
        e.Lifetime=NumberRange.new(1,1); e.LockedToPart=true; e.LightEmission=1
        e.Color=ColorSequence.new(saColor); e.Speed=NumberRange.new(0.05,0.05)
        e.Size=NumberSequence.new(2.75,3.5); e.Rate=4
        e.Texture="http://www.roblox.com/asset/?id=13267054240"
