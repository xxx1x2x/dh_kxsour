do
    local scEnabled = false
    local scColor = Color3.fromRGB(155, 125, 175)
    local scTrans = 0
    local scReflect = 0
    local scMat = "ForceField"
    local scParticles = "none"
    local scParticleColor = Color3.fromRGB(255, 255, 255)
    local scParticleTrans = 0
    local scCharConn
    local scOriginal = {}

    
    local function scRemoveParticles(char)
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                local s2 = part:FindFirstChild("SC_Specks")
                if s2 then s2:Destroy() end
            end
        end
    end

    
    local function scApplySpecks(char)
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                local orig = scOriginal[part]
                local skip = orig and orig.Transparency and orig.Transparency >= 1
                if not skip then
                    pcall(function()
                        local e = Instance.new("ParticleEmitter")
                        e.Name = "SC_Specks"
                        e.Lifetime = NumberRange.new(0.22, 0.22)
                        e.SpreadAngle = Vector2.new(90, 90)
                        e.LightEmission = 1
                        e.Color = ColorSequence.new(scParticleColor)
                        e.Speed = NumberRange.new(1, 1)
                        e.Brightness = 4.2
                        e.Size = NumberSequence.new(0.15)
                        local t = scParticleTrans
                        e.Transparency = NumberSequence.new({
                            NumberSequenceKeypoint.new(0, math.min(1, t + 0.8)),
                            NumberSequenceKeypoint.new(0.25, math.max(0, t - 0.1)),
                            NumberSequenceKeypoint.new(1, math.min(1, t + 0.8))
                        })
                        e.Rate = 100
                        e.Texture = "rbxassetid://7216849703"
                        e.Acceleration = Vector3.new(0, -15, 0)
                        e.Parent = part
                    end)
                end
            end
        end
    end

    
    local function scCacheChar(char)
        if not char then return end
        scOriginal = {}
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and not part:IsA("HumanoidRootPart") then
                scOriginal[part] = {
                    Material = part.Material,
                    Color = part.Color,
                    Transparency = part.Transparency,
                    Reflectance = part.Reflectance,
                    TextureID = part:IsA("MeshPart") and part.TextureID or nil
                }
            end
        end
    end

    local function scApply(char)
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and not part:IsA("HumanoidRootPart") then
                local orig = scOriginal[part]
                local skip = orig and orig.Transparency and orig.Transparency >= 1
                if not skip then
                    pcall(function()
                        part.Material = Enum.Material[scMat]
                        part.Color = scColor
                        part.Reflectance = scReflect
                        if part:IsA("MeshPart") then 
                            part.TextureID = "" 
                        end
                        part.Transparency = scTrans
                    end)
                end
            end
        end
        
        scRemoveParticles(char)
        if scParticles == "specks" then
            scApplySpecks(char)
        end
    end

    
    local function scRestore(char)
        if not char then return end
        scRemoveParticles(char)
        for part, data in pairs(scOriginal) do
            if part and part.Parent then
                pcall(function()
                    part.Material = data.Material
                    part.Color = data.Color
                    part.Transparency = data.Transparency
                    part.Reflectance = data.Reflectance
                    if part:IsA("MeshPart") and data.TextureID then
                        part.TextureID = data.TextureID
                    end
                end)
            end
        end
        scOriginal = {}
    end

    
    local function scEnable()
        local char = LocalPlayer.Character
        scCacheChar(char)
        scApply(char)
        if scCharConn then scCharConn:Disconnect() end
        scCharConn = LocalPlayer.CharacterAdded:Connect(function(c)
            c:WaitForChild("Humanoid")
            task.wait(1.1)
            if not scEnabled then return end
            scCacheChar(c)
            scApply(c)
        end)
    end

    local function scDisable()
        if scCharConn then scCharConn:Disconnect() scCharConn = nil end
        scRestore(LocalPlayer.Character)
    end

    
    local SelfChamsGroup = Tabs.visuals:AddRightGroupbox("Self Chams")
    SelfChamsGroup:AddToggle("SelfChamsToggle", {
        Text = "Self Chams",
        Default = false,
        Callback = function(v)
            scEnabled = v
            if v then scEnable() else scDisable() end
        end
    })
    SelfChamsGroup:AddLabel("Color"):AddColorPicker("SelfChamsColor", {
        Default = Color3.fromRGB(155, 125, 175),
        Callback = function(v) scColor = v if scEnabled then scApply(LocalPlayer.Character) end end
    })
    SelfChamsGroup:AddSlider("SelfChamsTrans", {
        Text = "Transparency",
        Default = 0, Min = 0, Max = 1, Rounding = 2,
        Callback = function(v)
            scTrans = v
            if scEnabled then scApply(LocalPlayer.Character) end
        end
    })
    SelfChamsGroup:AddSlider("SelfChamsRefl", {
        Text = "Reflectance",
        Default = 0, Min = 0, Max = 1, Rounding = 2,
        Callback = function(v) scReflect = v if scEnabled then scApply(LocalPlayer.Character) end end
    })
    SelfChamsGroup:AddDropdown("SelfChamsParticles", {
        Values = {"none", "specks"},
        Default = 1, Multi = false, Text = "Particles",
        Callback = function(v)
            scParticles = v
            if scEnabled then
                scRemoveParticles(LocalPlayer.Character)
                if scParticles == "specks" then scApplySpecks(LocalPlayer.Character) end
            end
        end
    })
    SelfChamsGroup:AddLabel("Particle Color"):AddColorPicker("SelfChamsParticleColor", {
        Default = Color3.fromRGB(255, 255, 255),
        Callback = function(v)
            scParticleColor = v
            if scEnabled then
                scRemoveParticles(LocalPlayer.Character)
                if scParticles == "specks" then scApplySpecks(LocalPlayer.Character) end
            end
        end
    })
