    SilentCircle.Visible=SilentAimSettings.ShowFOV and SilentAimSettings.Enabled and not _hidden

    if SilentAimSettings.Enabled and SilentAimSettings.TracerEnabled then
        local target=GetClosest(SilentAimSettings.FOV,SilentAimSettings.TargetPart,SilentAimSettings.Whitelist,SilentAimSettings.IgnoreKO)
        if target and target.Character then
            local tp=getPart(target.Character,SilentAimSettings.TargetPart)
            if tp then
                local sp,on=Camera:WorldToViewportPoint(tp.Position)
                if on then
                    SilentTracerLine.From=UserInputService:GetMouseLocation(); SilentTracerLine.To=Vector2.new(sp.X,sp.Y)
                    SilentTracerLine.Color=SilentAimSettings.TracerColor; SilentTracerLine.Visible=true
                else SilentTracerLine.Visible=false end
            else SilentTracerLine.Visible=false end
        else SilentTracerLine.Visible=false end
    else SilentTracerLine.Visible=false end

    if not _aimIsActive() then
        if not AimbotSettings.Sticky then AimbotSettings.StickyTarget=nil end return
    end
    local target=nil
    if AimbotSettings.Sticky and AimbotSettings.StickyTarget then
        local sc=AimbotSettings.StickyTarget
        local hum=sc.Character and sc.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health>0 and not matchesWhitelist(AimbotSettings.Whitelist,sc) and not (AimbotSettings.IgnoreKO and isKO(sc)) then
            target=sc
        else AimbotSettings.StickyTarget=nil end
    end
    if not target then
        target=GetClosest(AimbotSettings.FOV,AimbotSettings.TargetPart,AimbotSettings.Whitelist,AimbotSettings.IgnoreKO)
        if AimbotSettings.Sticky and target then AimbotSettings.StickyTarget=target end
    end
    if not (target and target.Character) then return end
    local tp=getPart(target.Character,AimbotSettings.TargetPart)
    local aimPos=tp and tp.Position; if not aimPos then return end
    Camera.CFrame=Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position,aimPos),math.clamp(AimbotSettings.Smoothness,0.01,1))
end)


local GunHandler = nil
local _originalGetAim = nil
do
    local function tryRequire(path)
        local ok, result = pcall(function()
            local obj = ReplicatedStorage
            for _, key in ipairs(path) do obj = obj[key] end
            return require(obj)
        end)
        return ok and result or nil
    end
    GunHandler = tryRequire({"Modules","GunHandler"})
              or tryRequire({"GunHandler"})
              or tryRequire({"Modules","Gun","GunHandler"})
              or tryRequire({"Gun","GunHandler"})
    if GunHandler then
        _originalGetAim = GunHandler.getAim
    else
        GunHandler = {}
        _originalGetAim = function(origin, range) return Camera.CFrame.LookVector, range end
        warn("[KraviX] GunHandler não encontrado — Silent Aim desativado.")
    end
end

local function _silentGetNearest()
    local best,target=math.huge,nil
    local center=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude
    for _,plr in pairs(Players:GetPlayers()) do
        if plr==LocalPlayer or not plr.Character then continue end
        if matchesWhitelist(SilentAimSettings.Whitelist,plr) then continue end
        local part=getPart(plr.Character,SilentAimSettings.TargetPart); if not part then continue end
        if SilentAimSettings.IgnoreKO and isKO(plr) then continue end
        local hum=plr.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health<=0 then continue end
        local sp,on=Camera:WorldToViewportPoint(part.Position); if not on then continue end
        local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude
        if d<=SilentAimSettings.FOV and d<best then
            if SilentAimSettings.WallCheck then
                local char=LocalPlayer.Character; local hrp=char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    rp.FilterDescendantsInstances={char,plr.Character}
                    local res=workspace:Raycast(hrp.Position,part.Position-hrp.Position,rp)
                    if res then continue end
                end
            end
            best=d; target=part
        end
    end
    return target
end

local function _applyHook()
    GunHandler.getAim=function(origin,range)
        if SilentAimSettings.Enabled and math.random(1,100)<=SilentAimSettings.HitChance then
            local t=_silentGetNearest()
            if t and t.Parent then local dir=t.Position-origin; if dir.Magnitude>0.001 then return dir.Unit,range end end
        end
