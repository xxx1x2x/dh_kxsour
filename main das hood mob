local removeFireCooldownEnabled = false
local rfc_old_tools = {}
local rfc_old_upvalues = {}
local rfc_equipped_conn = nil
local rfc_char_conn = nil

local function apply_firerate_bypass(tool)
    task.wait()
    if not removeFireCooldownEnabled then return end
    local name = tool and tool:IsA("Tool") and tool.Name
    if tool and name and not rfc_old_tools[name] then
        local getgc = getgc or (debug and debug.getgc)
        local getinfo = debug.getinfo or getinfo
        local getupvalues = debug.getupvalues or getupvalues
        local setupvalue = debug.setupvalue or setupvalue
        if getgc and getinfo and getupvalues and setupvalue then
            local gc = getgc()
            for i = 1, #gc do
                local obj = gc[i]
                if type(obj) == "function" then
                    local info = getinfo(obj)
                    local src = info and info.source
                    if src and string.find(src, "GunClient") and string.find(src, name) then
                        for idx, upvalue in pairs(getupvalues(obj)) do
                            if type(upvalue) == "number" and upvalue < 10 then
                                rfc_old_upvalues[obj] = upvalue
                                setupvalue(obj, idx, 0)
                            end
                        end
                    end
                end
            end
            rfc_old_tools[name] = 1
        end
    end
end

local function toggleRemoveFireCooldown(state)
    removeFireCooldownEnabled = state
    if rfc_equipped_conn then rfc_equipped_conn:Disconnect() rfc_equipped_conn = nil end
    if rfc_char_conn then rfc_char_conn:Disconnect() rfc_char_conn = nil end
    
    if state then
        rfc_old_upvalues = {}
        rfc_old_tools = {}
        local char = LocalPlayer.Character
        if char then
            for _, t in ipairs(char:GetChildren()) do
                if t:IsA("Tool") then task.spawn(apply_firerate_bypass, t) end
            end
            rfc_equipped_conn = char.ChildAdded:Connect(function(child)
                if child:IsA("Tool") then task.spawn(apply_firerate_bypass, child) end
            end)
        end
        rfc_char_conn = LocalPlayer.CharacterAdded:Connect(function(c)
            rfc_old_tools = {}
            rfc_old_upvalues = {}
            rfc_equipped_conn = c.ChildAdded:Connect(function(child)
                if child:IsA("Tool") then task.spawn(apply_firerate_bypass, child) end
            end)
        end)
    else
        local getgc = getgc or (debug and debug.getgc)
        local getinfo = debug.getinfo or getinfo
        local getupvalues = debug.getupvalues or getupvalues
        local setupvalue = debug.setupvalue or setupvalue
        if rfc_old_upvalues and getgc and getinfo and setupvalue then
            local gc = getgc()
            for i = 1, #gc do
                local obj = gc[i]
                if type(obj) == "function" then
                    local info = getinfo(obj)
                    if info and info.source and string.find(info.source, "GunClient") then
                        local orig = rfc_old_upvalues[obj]
                        if orig then
                            for idx, _ in pairs(getupvalues(obj)) do
                                setupvalue(obj, idx, orig)
                            end
                        end
                    end
                end
            end
        end
        rfc_old_tools = {}
        rfc_old_upvalues = {}
    end
end

