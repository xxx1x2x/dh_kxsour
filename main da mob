            if name:find("Ammo") then
                local base=name:sub(1,-6)
                if not all_items[base] then all_items[base]={main=nil,ammo=head} elseif not all_items[base].ammo then all_items[base].ammo=head end
            else
                if not all_items[name] then all_items[name]={main=head,ammo=nil} elseif not all_items[name].main then all_items[name].main=head end
            end
