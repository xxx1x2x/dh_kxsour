            local Box=Create("Frame",{Parent=Frame,Size=UDim2.new(0,13,0,13),Position=UDim2.new(0,0,0.5,-6.5),BackgroundColor3=CFG.SecondaryColor,BorderSizePixel=0},{Create("UIStroke",{Color=CFG.StrokeColor})})
