        Min      = 0.1,
        Max      = 5,
        Rounding = 1,
        Callback = function(v)
            DanceSpeed = v
            if CurrentDanceTrack then
                CurrentDanceTrack:AdjustSpeed(DanceSpeed)
            end
        end
    })
