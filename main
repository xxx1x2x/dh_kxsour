Toggles.EnableHitboxExpander:OnChanged(function()
    HitboxSettings.Enabled = Toggles.EnableHitboxExpander.Value
    if not HitboxSettings.Enabled then
        for HRP, _ in pairs(HitboxOriginal) do
            revertHRP(HRP)
        end
    end
end)

Options.HitboxExpanderSize:OnChanged(function()
    HitboxSettings.Size = Options.HitboxExpanderSize.Value
    for HRP, sphere in pairs(HitboxVisuals) do
        if sphere and sphere.Parent then
            sphere.Size = Vector3.new(HitboxSettings.Size, HitboxSettings.Size, HitboxSettings.Size)
        end
        if HRP and HRP.Parent then
            HRP.Size = Vector3.new(HitboxSettings.Size, HitboxSettings.Size, HitboxSettings.Size)
        end
    end
end)

Options.HitboxExpanderColor:OnChanged(function()
    HitboxSettings.Color = Options.HitboxExpanderColor.Value
    for _, sphere in pairs(HitboxVisuals) do
        if sphere and sphere.Parent then
            sphere.Color = HitboxSettings.Color
        end
    end
end)

Options.HitboxExpanderTransparency:OnChanged(function()
    HitboxSettings.Transparency = Options.HitboxExpanderTransparency.Value
    for _, sphere in pairs(HitboxVisuals) do
        if sphere and sphere.Parent then
            sphere.Transparency = HitboxSettings.Transparency
        end
    end
end)






