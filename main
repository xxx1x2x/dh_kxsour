MiscGroup:AddToggle("HideGunCrosshair", {Text = "Hide Gun Crosshair", Default = false})
local hideCrosshairConn = nil

local function hideCrosshair(bool)
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return end
    local mainScreenGui = playerGui:FindFirstChild("MainScreenGui")
    if not mainScreenGui then return end
    local aim = mainScreenGui:FindFirstChild("Aim")
    if not aim then return end

    local hide = (bool == true)
    local transparency = hide and 1 or 0

    aim.Size = hide and UDim2.new(0, 0, 0, 0) or UDim2.new(0, 4, 0, 4)

    for _, child in pairs(aim:GetChildren()) do
        if child:IsA("Frame") then
            child.BackgroundTransparency = transparency
        elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
            child.ImageTransparency = transparency
        end
        local innerFrame = child:FindFirstChildOfClass("Frame")
        if innerFrame then
            innerFrame.BackgroundTransparency = transparency
        end
    end
end

Toggles.HideGunCrosshair:OnChanged(function()
    local enabled = Toggles.HideGunCrosshair.Value
    if hideCrosshairConn then
        hideCrosshairConn:Disconnect()
        hideCrosshairConn = nil
    end

    if enabled then
        hideCrosshairConn = RunService.RenderStepped:Connect(function()
            hideCrosshair(true)
        end)
    else
        hideCrosshair(false)
    end
end)


MiscGroup:AddToggle("AntiRPG", {Text = "Anti RPG", Default = false})
local antiRPGConn = nil

local function avoidRPG(rpgPart)
    if not rpgPart then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local oldParent = rpgPart.Parent and rpgPart.Parent.Parent

    while Toggles.AntiRPG and Toggles.AntiRPG.Value and rpgPart and rpgPart.Parent and rpgPart.Parent.Parent == oldParent do
        local currentChar = LocalPlayer.Character
        local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
        if not currentHrp then break end

        local dist = (rpgPart.Position - currentHrp.Position).Magnitude
        if dist < 35 then
            pcall(function()

                currentHrp.CFrame = currentHrp.CFrame + (rpgPart.CFrame.LookVector * 40 * Vector3.new(1, 0, 1))
            end)
            task.wait(0.2)
            break
        end
        task.wait(0.02)
    end
end

Toggles.AntiRPG:OnChanged(function()
    local enabled = Toggles.AntiRPG.Value
    if antiRPGConn then
        antiRPGConn:Disconnect()
        antiRPGConn = nil
    end

    if enabled then
        local ignoredFolder = workspace:FindFirstChild("Ignored") or workspace:WaitForChild("Ignored", 5)
        if ignoredFolder then
            local function handleObject(object)
                if not (Toggles.AntiRPG and Toggles.AntiRPG.Value) then return end
                if object.Name == "Model" then
                    local part = object:FindFirstChild("Launcher") or object:FindFirstChildWhichIsA("BasePart") or object:WaitForChild("Launcher", 0.5)
                    if part then
                        task.spawn(avoidRPG, part)
                    end
                elseif object.Name == "Launcher" and object:IsA("BasePart") then
                    task.spawn(avoidRPG, object)
                end
            end

            for _, child in ipairs(ignoredFolder:GetChildren()) do
                task.spawn(handleObject, child)
            end

            antiRPGConn = ignoredFolder.ChildAdded:Connect(function(object)
                task.spawn(handleObject, object)
            end)
        end
    end
end)


