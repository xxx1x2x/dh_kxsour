        dummy.Name = "ChatWindowConfiguration"
        dummy.Parent = TextChatService
    end
end

MiscGroup:AddToggle("AutoBlock", {Text="God Block", Default=false})
getgenv().XZQW_ENABLED = false
getgenv().YRWL_Connection___ = {}
ReplicatedStorage:WaitForChild("ClientAnimations").Block.AnimationId = "rbxassetid://0"
local function startAutoBlock()
    table.insert(getgenv().YRWL_Connection___, RunService.Stepped:Connect(function()
        if not getgenv().XZQW_ENABLED then return end
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("BodyEffects") then
            local be = char.BodyEffects
            if be:FindFirstChild("Block") then be.Block:Destroy() end
            local tool = char:FindFirstChildWhichIsA("Tool")
            if tool and tool:FindFirstChild("Ammo") then
                MainEvent:FireServer("Block", false)
            else
                MainEvent:FireServer("Block", true)
                wait()
                MainEvent:FireServer("Block", false)
            end
        end
    end))
end

local function stopAutoBlock()
    for _, c in ipairs(getgenv().YRWL_Connection___) do c:Disconnect() end
    table.clear(getgenv().YRWL_Connection___)
end
Toggles.AutoBlock:OnChanged(function()
    getgenv().XZQW_ENABLED = Toggles.AutoBlock.Value
    if Toggles.AutoBlock.Value then startAutoBlock() else stopAutoBlock() end
end)


MiscGroup:AddToggle("RespawnAtDeath", {Text="Respawn At Death", Default=false})
local function saveDeathPos(char)
    if not respawnEnabled then return end
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then lastDeathPos = hrp.CFrame end
end
local function watchKO(char)
    local be = char:WaitForChild("BodyEffects", 5)
    if not be then return end
    local ko = be:WaitForChild("K.O", 5)
    if not ko then return end
    ko:GetPropertyChangedSignal("Value"):Connect(function()
        if ko.Value then saveDeathPos(char) end
    end)
    local hum = char:FindFirstChild("Humanoid")
    if hum then
        hum:GetPropertyChangedSignal("Health"):Connect(function()
            if hum.Health <= 0 then saveDeathPos(char) end
        end)
    end
end
if LocalPlayer.Character then task.spawn(function() watchKO(LocalPlayer.Character) end) end
LocalPlayer.CharacterAdded:Connect(function(char)
    task.spawn(function() watchKO(char) end)
    if respawnEnabled and lastDeathPos then
        task.wait(0.5)
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CFrame = lastDeathPos end
    end
end)
Toggles.RespawnAtDeath:OnChanged(function()
    respawnEnabled = Toggles.RespawnAtDeath.Value
    if not respawnEnabled then lastDeathPos = nil end
end)


MiscGroup:AddToggle("NoJumpCooldown", {Text="No Jump Cooldown", Default=false})
Toggles.NoJumpCooldown:OnChanged(function()
    if Toggles.NoJumpCooldown.Value then
        if game.PlaceId == 2788229376 then
            local gmt = getrawmetatable(game)
            setreadonly(gmt, false)
            local old_ni = gmt.__newindex
            gmt.__newindex = newcclosure(function(t, i, v)
                if i == "JumpPower" then return old_ni(t, i, 50) end
                return old_ni(t, i, v)
            end)
        end
    end
end)


if not _G.autoStompReady then
    _G.autoStompReady = true
    local stompLooping = false
    MiscGroup:AddToggle("EnableAutoStomp", {Text="Auto Stomp", Default=false})
    local stompConn = nil
    Toggles.EnableAutoStomp:OnChanged(function()
        stompLooping = Toggles.EnableAutoStomp.Value
        if stompLooping then
            if stompConn then stompConn:Disconnect() end
            local lastT = tick()
            stompConn = RunService.Heartbeat:Connect(function()
                if not stompLooping then return end
                if tick() - lastT >= 0 then
                    local char = LocalPlayer.Character
                    local hum = char and char:FindFirstChild("Humanoid")
                    if hum and hum.Parent then MainEvent:FireServer("Stomp") lastT = tick() end
                end
            end)
        else
            if stompConn then stompConn:Disconnect() stompConn = nil end
        end
    end)
end


MiscGroup:AddToggle("AntiTaser", {Text = "Anti Taser", Default = false})
do
    local connection = nil
    local connections = {}

    local function do_anti_taser(plr, tool)
        if not tool or tool.Name ~= "[Taser]" then return end

        local handle = tool:FindFirstChild("Handle") or tool:WaitForChild("Handle", 5)
        if not handle then return end

        local beam = handle:FindFirstChild("TazerBeam") or handle:WaitForChild("TazerBeam", 5)
        if not beam then return end

        if connections[plr] then
            connections[plr]:Disconnect()
            connections[plr] = nil
        end

        connections[plr] = beam:GetPropertyChangedSignal("Attachment1"):Connect(function()
            local part = beam.Attachment1
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local bodyEffects = char and char:FindFirstChild("BodyEffects")
            local isKnocked = bodyEffects and bodyEffects:FindFirstChild("K.O") and bodyEffects["K.O"].Value

            if char and part and part:IsDescendantOf(char) and not isKnocked and hrp then

                pcall(function() beam.Attachment1 = nil end)


                local oldCFrame = hrp.CFrame
                pcall(function()
                    hrp.CFrame = CFrame.new(
                        math.random(-100000, 100000),
                        math.random(-400, 100000),
                        math.random(-100000, 100000)
                    )
                end)
                task.wait(0.1)
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = oldCFrame
                end
            end
        end)
    end

    Toggles.AntiTaser:OnChanged(function()
        local value = Toggles.AntiTaser.Value
        if connection then
            connection:Disconnect()
            connection = nil
        end
        for data, conn in pairs(connections) do
            conn:Disconnect()
            connections[data] = nil
        end

        if value then
            connection = Players.PlayerAdded:Connect(function(plr)
                plr.CharacterAdded:Connect(function(c)
                    c.ChildAdded:Connect(function(t)
                        if t:IsA("Tool") then do_anti_taser(plr, t) end
                    end)
                end)
            end)
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    for _, child in ipairs(plr.Character:GetChildren()) do
                        if child:IsA("Tool") then do_anti_taser(plr, child) end
                    end
                    plr.Character.ChildAdded:Connect(function(child)
                        if child:IsA("Tool") then do_anti_taser(plr, child) end
                    end)
                end
            end
        end
    end)
end




RunService.Heartbeat:Connect(function()
    if Toggles.AntiTaser and Toggles.AntiTaser.Value and LocalPlayer.Character then
        local char = LocalPlayer.Character
        local hum = char:FindFirstChildOfClass("Humanoid")
        local be  = char:FindFirstChild("BodyEffects")
        if be then
            local tazed = be:FindFirstChild("Tazed") or be:FindFirstChild("IsTazed") or be:FindFirstChild("Tazer")
            if tazed then
                if tazed:IsA("ValueBase") then tazed.Value = false end
                pcall(function() tazed:Destroy() end)
            end
        end
        if hum then
            if hum.PlatformStand then hum.PlatformStand = false end
            if hum.Sit then hum.Sit = false end
            for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                local animId = track.Animation and track.Animation.AnimationId or ""
                if animId:find("313762699") or animId:find("taser") or animId:find("taze") or track.Name:lower():find("taser") or track.Name:lower():find("taze") then
                    track:Stop()
                end
            end
        end
    end
    if MiscSettings.AntiStompEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
        local be  = LocalPlayer.Character:FindFirstChild("BodyEffects")
        local ko  = be and be:FindFirstChild("K.O")
        if hum and ko and ko.Value then
            if respawnEnabled then
                local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then lastDeathPos = hrp.CFrame end
            end
            hum.Health = 0
        end
        if hum and hum.Health <= 1 then
            if respawnEnabled then
                local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then lastDeathPos = hrp.CFrame end
            end
            hum.Health = 0
        end
    end
    if MiscSettings.AntiSlowEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then
            for _, eff in pairs(hum:GetChildren()) do
                if eff:IsA("NumberValue") and eff.Name == "Slowed" then eff:Destroy() end
            end
            if hum.WalkSpeed < 16 and not CharacterSettings.SpeedEnabled then hum.WalkSpeed = 16 end
        end
    end
    if MiscSettings.NoClipEnabled and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end)





do
    local TrashTalkSettings = {
        Mode = "Auto",
        CustomMessage = "get KraviX",
        Presets = {
            "get KraviX",
            "Get aim",
            "BAG!",
            "KRAVIX DOMINATES",
            "too slow",
            "This isn’t a fight anymore — it’s a KraviX tutorial.",
            "RUN MY DOG HAHAHAH",
            "go KraviX now"
        }
    }

    local function sendTrashTalk()
        local Channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if not Channel then return end
        local msg = TrashTalkSettings.Mode == "Auto"
            and TrashTalkSettings.Presets[math.random(#TrashTalkSettings.Presets)]
            or  TrashTalkSettings.CustomMessage
        pcall(function() Channel:SendAsync(msg) end)
    end

    local TrashTalkGroup = Tabs.main:AddLeftGroupbox("Trash Talk")
    TrashTalkGroup:AddDropdown("TrashTalkMode", {Values = {"Auto", "Custom"}, Default = 1, Multi = false, Text = "Mode"})
    TrashTalkGroup:AddInput("TrashTalkCustomMessage", {Default = "get KraviX", Text = "Custom Message"})
    TrashTalkGroup:AddButton({Text = "Send Trash Talk", Func = sendTrashTalk})
    TrashTalkGroup:AddLabel("Keybind"):AddKeyPicker("TrashTalkKeybind", {Default = "T", SyncToggleState = false, Mode = "Hold", Text = "Trash Talk Key", NoUI = false})

    Options.TrashTalkMode:OnChanged(function() TrashTalkSettings.Mode = Options.TrashTalkMode.Value end)
    Options.TrashTalkCustomMessage:OnChanged(function() TrashTalkSettings.CustomMessage = Options.TrashTalkCustomMessage.Value end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if Options.TrashTalkKeybind and Options.TrashTalkKeybind:GetState() then
            sendTrashTalk()
        end
    end)
end


do
    local VelocityDesyncGroup = Tabs.main:AddLeftGroupbox('Velocity Desync')

    VelocityDesyncGroup:AddToggle('EnableVelocityDesync', {Text = 'Enable Velocity Desync', Default = false})
    VelocityDesyncGroup:AddDropdown('VelocityDesyncType', {Values = {'low', 'high', 'y high', 'limit', 'zero'}, Default = 1, Multi = false, Text = 'Desync Type'})
    VelocityDesyncGroup:AddToggle('VelocityDesyncRotate', {Text = 'Rotate Angular Velocity', Default = false})

    RunService.Heartbeat:Connect(function()
        if not Toggles.EnableVelocityDesync or not Toggles.EnableVelocityDesync.Value then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local oldLinear = hrp.AssemblyLinearVelocity
        local oldAngular = hrp.AssemblyAngularVelocity
        local dType = Options.VelocityDesyncType and Options.VelocityDesyncType.Value or 'low'

        local vel = Vector3.zero
        if dType == 'y high' then
            vel = Vector3.new(0, 16384, 0)
        elseif dType == 'high' then
            local r1 = math.random(1, 2) == 1 and -16384 or 16384
            local r2 = math.random(1, 2) == 1 and -14384 or 16384
            local r3 = math.random(1, 2) == 1 and -16384 or 16384
            vel = Vector3.new(r1, r2, r3)
        elseif dType == 'low' then
            local r1 = math.random(1, 2) == 1 and -300 or 300
            local r2 = math.random(1, 2) == 1 and -300 or 300
            local r3 = math.random(1, 2) == 1 and -300 or 300
            vel = Vector3.new(r1, r2, r3)
        elseif dType == 'limit' then
            vel = Vector3.new(math.random(-1000000, 1000000), math.random(-1000000, 1000000), math.random(-1000000, 1000000))
        elseif dType == 'zero' then
            vel = Vector3.zero
        end

        hrp.AssemblyLinearVelocity = vel
        if Toggles.VelocityDesyncRotate and Toggles.VelocityDesyncRotate.Value then
            hrp.AssemblyAngularVelocity = vel
        end

        RunService:BindToRenderStep("VelDesyncRestore", 199, function()
            if hrp and hrp.Parent then
                hrp.AssemblyLinearVelocity = oldLinear
                hrp.AssemblyAngularVelocity = oldAngular
            end
            RunService:UnbindFromRenderStep("VelDesyncRestore")
        end)
    end)
end


do
    local VoidHideGroup = Tabs.main:AddRightGroupbox('Void Hide')

    VoidHideGroup:AddToggle('EnableVoidHide', {Text = 'Enable Void Hide', Default = false})
    VoidHideGroup:AddSlider('VoidHideTeleportTime', {Text = 'Teleport Duration', Default = 1, Min = 0.1, Max = 5, Rounding = 1, Suffix = 's'})
    VoidHideGroup:AddSlider('VoidHideVoidTime', {Text = 'Void Duration', Default = 2, Min = 0.5, Max = 10, Rounding = 1, Suffix = 's'})
    VoidHideGroup:AddSlider('VoidHideOffset', {Text = 'Void Depth', Default = 500, Min = 100, Max = 500, Rounding = 0, Suffix = ' studs'})

    local lastVoidTick = os.clock()

    RunService.Heartbeat:Connect(function()
        if not Toggles.EnableVoidHide or not Toggles.EnableVoidHide.Value then
            return
        end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local now = os.clock()
        local tpTime = Options.VoidHideTeleportTime and Options.VoidHideTeleportTime.Value or 1
        local voidTime = Options.VoidHideVoidTime and Options.VoidHideVoidTime.Value or 2
        local depth = Options.VoidHideOffset and Options.VoidHideOffset.Value or 500

        if now - lastVoidTick > voidTime then
            lastVoidTick = now
        elseif now - lastVoidTick < tpTime then
            local savedCF = hrp.CFrame
            local voidCF = savedCF - Vector3.new(0, depth, 0)
            hrp.CFrame = voidCF
            RunService:BindToRenderStep("VoidHideRestore", 199, function()
                if hrp and hrp.Parent then
                    hrp.CFrame = savedCF
                end
                RunService:UnbindFromRenderStep("VoidHideRestore")
            end)
        end
    end)
end


