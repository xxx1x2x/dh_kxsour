    Options.TrashTalkCustomMessage:OnChanged(function() TrashTalkSettings.CustomMessage = Options.TrashTalkCustomMessage.Value end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if Options.TrashTalkKeybind and Options.TrashTalkKeybind:GetState() then
            sendTrashTalk()
        end
    end)
end)

task.spawn(function()
    local VelocityDesyncGroup = Tabs.main:AddLeftGroupbox('Velocity Desync')

    VelocityDesyncGroup:AddToggle('EnableVelocityDesync', {Text = 'Enable Velocity Desync', Default = false})
    VelocityDesyncGroup:AddDropdown('VelocityDesyncType', {Values = {'low', 'high', 'y high', 'limit', 'zero'}, Default = 1, Multi = false, Text = 'Desync Type'})
    VelocityDesyncGroup:AddToggle('VelocityDesyncRotate', {Text = 'Rotate Angular Velocity', Default = false})

    RunService.Heartbeat:Connect(function()
        if not Toggles.EnableVelocityDesync or not Toggles.EnableVelocityDesync.Value then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local oldLinear = hrp.AssemblyLinearVelocity
        local oldAngular = hrp.AssemblyAngularVelocity
        local dType = Options.VelocityDesyncType and Options.VelocityDesyncType.Value or 'low'

        local vel = Vector3.zero
        if dType == 'y high' then
            vel = Vector3.new(0, 16384, 0)
        elseif dType == 'high' then
            local r1 = math.random(1, 2) == 1 and -16384 or 16384
            local r2 = math.random(1, 2) == 1 and -14384 or 16384
            local r3 = math.random(1, 2) == 1 and -16384 or 16384
            vel = Vector3.new(r1, r2, r3)
        elseif dType == 'low' then
            local r1 = math.random(1, 2) == 1 and -300 or 300
            local r2 = math.random(1, 2) == 1 and -300 or 300
            local r3 = math.random(1, 2) == 1 and -300 or 300
            vel = Vector3.new(r1, r2, r3)
        elseif dType == 'limit' then
            vel = Vector3.new(math.random(-1000000, 1000000), math.random(-1000000, 1000000), math.random(-1000000, 1000000))
        elseif dType == 'zero' then
            vel = Vector3.zero
        end

        hrp.AssemblyLinearVelocity = vel
        if Toggles.VelocityDesyncRotate and Toggles.VelocityDesyncRotate.Value then
            hrp.AssemblyAngularVelocity = vel
        end

        RunService:BindToRenderStep("VelDesyncRestore", 199, function()
            if hrp and hrp.Parent then
                hrp.AssemblyLinearVelocity = oldLinear
                hrp.AssemblyAngularVelocity = oldAngular
            end
            RunService:UnbindFromRenderStep("VelDesyncRestore")
        end)
    end)
end)

task.spawn(function()
    local VoidHideGroup = Tabs.main:AddRightGroupbox('Void Hide')

    VoidHideGroup:AddToggle('EnableVoidHide', {Text = 'Enable Void Hide', Default = false})
    VoidHideGroup:AddSlider('VoidHideTeleportTime', {Text = 'Teleport Duration', Default = 1, Min = 0.1, Max = 5, Rounding = 1, Suffix = 's'})
    VoidHideGroup:AddSlider('VoidHideVoidTime', {Text = 'Void Duration', Default = 2, Min = 0.5, Max = 10, Rounding = 1, Suffix = 's'})
    VoidHideGroup:AddSlider('VoidHideOffset', {Text = 'Void Depth', Default = 500, Min = 100, Max = 500, Rounding = 0, Suffix = ' studs'})

    local lastVoidTick = os.clock()

    RunService.Heartbeat:Connect(function()
        if not Toggles.EnableVoidHide or not Toggles.EnableVoidHide.Value then
            return
        end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local now = os.clock()
        local tpTime = Options.VoidHideTeleportTime and Options.VoidHideTeleportTime.Value or 1
        local voidTime = Options.VoidHideVoidTime and Options.VoidHideVoidTime.Value or 2
        local depth = Options.VoidHideOffset and Options.VoidHideOffset.Value or 500

        if now - lastVoidTick > voidTime then
            lastVoidTick = now
        elseif now - lastVoidTick < tpTime then
            local savedCF = hrp.CFrame
            local voidCF = savedCF - Vector3.new(0, depth, 0)
            hrp.CFrame = voidCF
            RunService:BindToRenderStep("VoidHideRestore", 199, function()
                if hrp and hrp.Parent then
                    hrp.CFrame = savedCF
                end
                RunService:UnbindFromRenderStep("VoidHideRestore")
            end)
        end
    end)
end)

task.spawn(function()
    local MusicPlayerGroup = Tabs['UI Settings']:AddRightGroupbox('Music Player')

    local musicFolder = "KraviX_Music"
    if not isfolder(musicFolder) then
        makefolder(musicFolder)
    end

    local HttpService = game:GetService("HttpService")
    local customSongsFile = musicFolder .. "/custom_songs.json"

    local defaultSongs = {
        {name = "red", file = "red.mp3", url = "https://files.catbox.moe/pxvfhh.mp3"},
        {name = "yara yara phonk", file = "yara_yara_phonk.mp3", url = "https://files.catbox.moe/tvyr23.mp3"},
        {name = "scars", file = "scars.mp3", url = "https://files.catbox.moe/08kz5q.mp3"},
        {name = "OTПУSТИ МЕНR", file = "OTPUSTI_MENR.mp3", url = "https://files.catbox.moe/w9wdkd.mp3"},
        {name = "Ice cube", file = "Ice_cube.mp3", url = "https://files.catbox.moe/ca42f1.mp3"},
        {name = "505", file = "505.mp3", url = "https://files.catbox.moe/75klqo.mp3"},
    }

    local songsList = {}
    for _, song in ipairs(defaultSongs) do
        table.insert(songsList, song)
    end

    local function loadSavedCustomSongs()
        if isfile and readfile and isfile(customSongsFile) then
            pcall(function()
                local content = readfile(customSongsFile)
                local savedData = HttpService:JSONDecode(content)
                if type(savedData) == "table" then
                    for _, s in ipairs(savedData) do
                        if type(s) == "table" and s.name and s.url then
                            local exists = false
                            for _, existing in ipairs(songsList) do
                                if existing.url == s.url or existing.name == s.name then
                                    exists = true
                                    break
                                end
                            end
                            if not exists then
                                table.insert(songsList, {
                                    name = s.name,
                                    file = s.file or (s.name:gsub("[^%w%_%-]", "_") .. ".mp3"),
                                    url = s.url
                                })
                            end
                        end
                    end
                end
            end)
        end
    end

    local function saveCustomSongs()
        if writefile then
            local customToSave = {}
            for _, song in ipairs(songsList) do
                local isDefault = false
                for _, def in ipairs(defaultSongs) do
                    if def.url == song.url then
                        isDefault = true
                        break
                    end
                end
                if not isDefault then
                    table.insert(customToSave, {
                        name = song.name,
                        file = song.file,
                        url = song.url
                    })
                end
            end
            pcall(function()
                writefile(customSongsFile, HttpService:JSONEncode(customToSave))
            end)
        end
    end

    loadSavedCustomSongs()

    local songNames = {}
    for _, song in ipairs(songsList) do
        table.insert(songNames, song.name)
    end

    local currentSound = nil
    local currentSongIdx = 1
    local isSongPlaying = false
    local musicVolumeVal = 5

    local function getSongFilePath(song)
        return musicFolder .. "/" .. song.file
    end

    local function downloadSongFile(song)
        local path = getSongFilePath(song)
        if isfile and isfile(path) then
            return path
        end
        local ok, data = pcall(function()
            return game:HttpGet(song.url, true)
        end)
        if ok and data and #data > 10000 then
            if writefile then writefile(path, data) end
            return path
        end
        return nil
    end

    local function playSelectedSong()
        if #songsList == 0 then return end
        local song = songsList[currentSongIdx]
        if not song then return end

        if currentSound then
            pcall(function() currentSound:Stop() currentSound:Destroy() end)
            currentSound = nil
        end

        local path = downloadSongFile(song)
        if not path then
            Library:Notify("Music: Failed to download " .. song.name, 3)
            return
        end

        local assetId = nil
        local synOk, synAsset = pcall(function() return getsynasset and getsynasset(path) end)
        if synOk and synAsset then
            assetId = synAsset
        else
            local custOk, custAsset = pcall(function() return getcustomasset and getcustomasset(path) end)
            if custOk and custAsset then
                assetId = custAsset
            end
        end

        if not assetId then
            Library:Notify("Music: Executor asset error!", 3)
            return
        end

        currentSound = Instance.new("Sound")
        currentSound.Name = "KraviX_MusicPlayer"
        currentSound.SoundId = assetId
        currentSound.Volume = musicVolumeVal / 10
        currentSound.Looped = false
        currentSound.Parent = game:GetService("SoundService")
        currentSound.Ended:Connect(function()
            isSongPlaying = false
            currentSongIdx = (currentSongIdx % #songsList) + 1
            task.wait(1)
            playSelectedSong()
        end)
        currentSound:Play()
        isSongPlaying = true
        Library:Notify("Playing: " .. song.name, 3)
    end

    local function stopSelectedSong()
        if currentSound then
            pcall(function() currentSound:Stop() currentSound:Destroy() end)
            currentSound = nil
        end
        isSongPlaying = false
        Library:Notify("Music Stopped", 2)
    end

    local function nextSelectedSong()
        currentSongIdx = (currentSongIdx % #songsList) + 1
        if isSongPlaying then
            playSelectedSong()
        end
    end

    local function refreshSongDropdown()
        songNames = {}
        for _, song in ipairs(songsList) do
            table.insert(songNames, song.name)
        end
        if Options.MusicSelectDropdown then
            pcall(function()
                if Options.MusicSelectDropdown.SetValues then
                    Options.MusicSelectDropdown:SetValues(songNames)
                else
                    Options.MusicSelectDropdown.Values = songNames
                    if Options.MusicSelectDropdown.BuildDropdownList then Options.MusicSelectDropdown:BuildDropdownList() end
                    if Options.MusicSelectDropdown.Display then Options.MusicSelectDropdown:Display() end
                end
            end)
        end
    end

    _G.AddKraviXCustomSong = function(url, name)
        if not url or url == "" or not (url:find("http://") or url:find("https://")) then
            Library:Notify("Invalid URL! Paste a direct Catbox/MP3 link.", 3)
            return
        end

        if not name or name == "" then
            local fileFromUrl = url:match("([^/]+)$") or "Custom"
            name = "Custom - " .. fileFromUrl
        end

        local cleanFileName = name:gsub("[^%w%_%-]", "_") .. ".mp3"
        local songObj = {
            name = name,
            file = cleanFileName,
            url = url
        }

        table.insert(songsList, songObj)
        saveCustomSongs()
        refreshSongDropdown()
        Library:Notify("Added: " .. name .. " to playlist!", 3)
    end

    MusicPlayerGroup:AddDropdown('MusicSelectDropdown', {
        Values = songNames,
        Default = 1,
        Multi = false,
        Text = 'Select Song'
    })

    MusicPlayerGroup:AddSlider('MusicVolumeSlider', {
        Text = 'Volume',
        Default = 5,
        Min = 1,
        Max = 10,
        Rounding = 0
    })

    MusicPlayerGroup:AddButton({Text = 'Play Song', Func = function()
        local selectedName = Options.MusicSelectDropdown and Options.MusicSelectDropdown.Value
        if selectedName then
            for idx, s in ipairs(songsList) do
                if s.name == selectedName then
                    currentSongIdx = idx
                    break
                end
            end
        end
        playSelectedSong()
    end})

    MusicPlayerGroup:AddButton({Text = 'Stop Music', Func = stopSelectedSong})

    MusicPlayerGroup:AddLabel('upload music in catbox')
    MusicPlayerGroup:AddInput('CustomSongNameInput', {Text = 'Custom Song Name', Default = '', Placeholder = 'Song Title'})
    MusicPlayerGroup:AddInput('CustomSongUrlInput', {Text = 'Custom MP3 Link (Catbox)', Default = '', Placeholder = 'https://files.catbox.moe/...mp3'})
    MusicPlayerGroup:AddButton({Text = 'Add & Update Music List', Func = function()
        local url = Options.CustomSongUrlInput and Options.CustomSongUrlInput.Value
        local name = Options.CustomSongNameInput and Options.CustomSongNameInput.Value
        if _G.AddKraviXCustomSong then
            _G.AddKraviXCustomSong(url, name)
        end
    end})

    Options.MusicSelectDropdown:OnChanged(function()
        local selectedName = Options.MusicSelectDropdown.Value
        for idx, s in ipairs(songsList) do
            if s.name == selectedName then
                currentSongIdx = idx
                break
            end
        end
        if isSongPlaying then
            playSelectedSong()
        end
        if currentSound then
            currentSound.Volume = musicVolumeVal / 10
        end
    end)
end)

task.spawn(function()
    local AutoEatGroup = Tabs.main:AddRightGroupbox('Auto Eat')

    AutoEatGroup:AddToggle('EnableAutoEat', {Text = 'Enable Auto Eat', Default = false})
    AutoEatGroup:AddDropdown('AutoEatFoodType', {Values = {'Taco', 'Pizza', 'Chicken', 'Cranberry'}, Default = 1, Multi = false, Text = 'Food Type to Buy'})
    AutoEatGroup:AddSlider('AutoEatHealth', {Text = 'Health Threshold', Default = 80, Min = 10, Max = 95, Rounding = 0, Suffix = ' HP'})

    local isEating = false
    local isBuyingDesync = false

    local function buyFoodFunc(foodType)
        pcall(function()
            scanShop()
            local itemData = all_items[foodType]
            if not itemData then
                for name, data in pairs(all_items) do
                    if name:lower():find(foodType:lower(), 1, true) or (foodType:lower() == "cranberry" and (name:lower():find("cran", 1, true) or name:lower():find("drink", 1, true))) then
                        itemData = data
                        break
                    end
                end
            end

            if itemData and itemData.main then
                local cd = itemData.main.Parent:FindFirstChildOfClass("ClickDetector") or itemData.main.Parent:FindFirstChildWhichIsA("ClickDetector")
                if cd then
                    buyItemWithDesync4(itemData.main, cd, 1)
                    return
                end
            end

            local shop = workspace:FindFirstChild("Ignored") and workspace.Ignored:FindFirstChild("Shop")
            if shop then
                local targetName = foodType:lower()
                for _, item in ipairs(shop:GetChildren()) do
                    local itemName = item.Name:lower()
                    if itemName:find(targetName, 1, true) or (targetName == "cranberry" and (itemName:find("cran", 1, true) or itemName:find("drink", 1, true))) then
                        local head = item:FindFirstChild("Head") or item:FindFirstChildWhichIsA("BasePart")
                        local cd = item:FindFirstChildOfClass("ClickDetector") or item:FindFirstChildWhichIsA("ClickDetector")
                        if head and cd then
                            buyItemWithDesync4(head, cd, 1)
                            break
                        end
                    end
                end
            end
        end)
    end

    RunService.Heartbeat:Connect(function()
        if not Toggles.EnableAutoEat or not Toggles.EnableAutoEat.Value then return end
        if isEating or desync4.enabled then return end

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then return end

        local threshold = Options.AutoEatHealth and Options.AutoEatHealth.Value or 80
        local selectedFoodType = Options.AutoEatFoodType and Options.AutoEatFoodType.Value or "Taco"

        if hum.Health < threshold then
            local targetName = selectedFoodType:lower()
            local food = nil

            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") and tool.Name:lower():find(targetName, 1, true) then
                    food = tool
                    break
                end
            end
            if not food then
                for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
                    if tool:IsA("Tool") and tool.Name:lower():find(targetName, 1, true) then
                        food = tool
                        break
                    end
                end
            end

            if not food then
                local fallbackFoods = {"taco", "pizza", "chicken", "cranberry", "lettuce", "donut", "hamburger", "drink"}
                for _, tool in ipairs(char:GetChildren()) do
                    if tool:IsA("Tool") then
                        local tName = tool.Name:lower()
                        for _, fKey in ipairs(fallbackFoods) do
                            if tName:find(fKey, 1, true) or tool:FindFirstChild("Eat") or tool:FindFirstChild("Drink") then
                                food = tool
                                break
                            end
                        end
                    end
                    if food then break end
                end
            end
            if not food then
                local fallbackFoods = {"taco", "pizza", "chicken", "cranberry", "lettuce", "donut", "hamburger", "drink"}
                for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
                    if tool:IsA("Tool") then
                        local tName = tool.Name:lower()
                        for _, fKey in ipairs(fallbackFoods) do
                            if tName:find(fKey, 1, true) or tool:FindFirstChild("Eat") or tool:FindFirstChild("Drink") then
                                food = tool
                                break
                            end
                        end
                    end
                    if food then break end
                end
            end

            if food then
                isEating = true
                food.Parent = char
                task.wait(0.05)
                pcall(function() food:Activate() end)
                task.wait(0.2)
                isEating = false
            else
                buyFoodFunc(selectedFoodType)
            end
        elseif hum.Health >= 100 then
            local fallbackFoods = {"taco", "pizza", "chicken", "cranberry", "lettuce", "donut", "hamburger", "drink"}
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    local tName = tool.Name:lower()
                    for _, fKey in ipairs(fallbackFoods) do
                        if tName:find(fKey, 1, true) or tool:FindFirstChild("Eat") or tool:FindFirstChild("Drink") then
                            tool.Parent = LocalPlayer.Backpack
                            break
                        end
                    end
                end
            end
        end
    end)
end)

task.spawn(function()
    local TargetLeftGroup = Tabs.target:AddLeftGroupbox('Target Selection')
    local TargetRightGroup = Tabs.target:AddRightGroupbox('Target Actions')

    local function getPlayerNames()
        local names = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                table.insert(names, p.Name .. " (@" .. p.Name .. ")")
            end
        end
        if #names == 0 then table.insert(names, "No Players") end
        table.sort(names)
        return names
    end

    local playerList = getPlayerNames()

    TargetLeftGroup:AddDropdown('TargetPlayerDropdown', {
        Values = playerList,
        Default = 1,
        Multi = false,
        Text = 'Select Target'
    })

    TargetLeftGroup:AddInput('TargetUserSearch', {
        Default = '',
        Numeric = false,
        Finished = true,
        Text = 'Search Target Name',
        Tooltip = 'Type partial username/displayname to select target',
        Placeholder = 'Username...'
    })

    TargetLeftGroup:AddDropdown('TargetAttackMethod', {
        Values = {'Heavy Attack', 'Light Attack'},
        Default = 1,
        Multi = false,
        Text = 'Attack Method'
    })

    TargetLeftGroup:AddDropdown('TargetWeaponSelect', {
        Values = {'Combat', 'Knife', 'Bat'},
        Default = 1,
        Multi = false,
        Text = 'Select Weapon'
    })

    local function refreshTargetDropdown()
        if Options.TargetPlayerDropdown then
            local newNames = getPlayerNames()
            pcall(function()
                if Options.TargetPlayerDropdown.SetValues then
                    Options.TargetPlayerDropdown:SetValues(newNames)
                else
                    Options.TargetPlayerDropdown.Values = newNames
                    if Options.TargetPlayerDropdown.BuildDropdownList then Options.TargetPlayerDropdown:BuildDropdownList() end
                    if Options.TargetPlayerDropdown.Display then Options.TargetPlayerDropdown:Display() end
                end
            end)
        end
    end

    Players.PlayerAdded:Connect(refreshTargetDropdown)
    Players.PlayerRemoving:Connect(refreshTargetDropdown)

    TargetLeftGroup:AddButton({Text = 'Refresh Players List', Func = refreshTargetDropdown})

    local avatarLabel = TargetLeftGroup:AddLabel('')
    local avatarImage = nil
    local targetInfoText = nil

    if avatarLabel and avatarLabel.TextLabel then
        avatarLabel.TextLabel.Size = UDim2.new(1, 0, 0, 200)
        avatarLabel.TextLabel.Text = ""

        avatarImage = Instance.new("ImageLabel")
        avatarImage.Name = "TargetAvatarImage"
        avatarImage.Size = UDim2.new(0, 90, 0, 90)
        avatarImage.Position = UDim2.new(0, 5, 0, 5)
        avatarImage.BackgroundTransparency = 1
        avatarImage.ScaleType = Enum.ScaleType.Fit
        avatarImage.Image = "rbxassetid://0"
        avatarImage.Parent = avatarLabel.TextLabel

        targetInfoText = Instance.new("TextLabel")
        targetInfoText.Name = "TargetInfoText"
        targetInfoText.Size = UDim2.new(1, -105, 1, -10)
        targetInfoText.Position = UDim2.new(0, 100, 0, 5)
        targetInfoText.BackgroundTransparency = 1
        targetInfoText.TextColor3 = Color3.fromRGB(240, 240, 240)
        targetInfoText.TextXAlignment = Enum.TextXAlignment.Left
        targetInfoText.TextYAlignment = Enum.TextYAlignment.Top
        targetInfoText.Font = Enum.Font.Code
        targetInfoText.TextSize = 13
        targetInfoText.TextWrapped = true
        targetInfoText.Text = "Select a target to view info..."
        targetInfoText.Parent = avatarLabel.TextLabel
    end

    local function getSelectedTarget()
        local rawVal = Options.TargetPlayerDropdown and Options.TargetPlayerDropdown.Value
        if not rawVal or rawVal == "No Players" then return nil end
        local name = rawVal:split(" (@")[1] or rawVal
        return Players:FindFirstChild(name)
    end

    local function formatMoney(val)
        if not val then return "N/A" end
        local raw = tostring(val)
        local cleaned = (raw:gsub("[^%d%-]", ""))
        local num = tonumber(cleaned)
        if num then
            local formatted = tostring(math.abs(num)):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
            if num < 0 then
                return "-$" .. formatted
            end
            return "$" .. formatted
        end
        if raw:sub(1,1) == "$" then return raw end
        return "$" .. raw
    end

    local function getTargetMoney(plr)
        if not plr then return "N/A" end
        local val = nil
        pcall(function()
            if plr:FindFirstChild("DataFolder") then
                local df = plr.DataFolder
                if df:FindFirstChild("Currency") then
                    val = df.Currency.Value
                elseif df:FindFirstChild("Information") and df.Information:FindFirstChild("Currency") then
                    val = df.Information.Currency.Value
                end
            end
        end)
        if val == nil then
            pcall(function()
                if plr:FindFirstChild("leaderstats") then
                    local ls = plr.leaderstats
                    local w = ls:FindFirstChild("Wallet") or ls:FindFirstChild("Money") or ls:FindFirstChild("Cash") or ls:FindFirstChild("Currency") or ls:FindFirstChild("$")
                    if w then val = w.Value end
                end
            end)
        end
        if val == nil then
            pcall(function()
                local walletTool = nil
                local bpk = plr:FindFirstChild("Backpack")
                if bpk then
                    walletTool = bpk:FindFirstChild("[Wallet]") or bpk:FindFirstChild("Wallet")
                end
                local char = plr.Character
                if not walletTool and char then
                    walletTool = char:FindFirstChild("[Wallet]") or char:FindFirstChild("Wallet")
                end
                if walletTool then
                    local am = walletTool:FindFirstChild("Amount") or walletTool:FindFirstChild("Value")
                    if am then val = am.Value end
                end
            end)
        end
        if val ~= nil then
            return formatMoney(val)
        end
        return "N/A"
    end

    local function getTargetWanted(plr)
        if not plr then return "N/A" end
        local val = nil
        pcall(function()
            if plr:FindFirstChild("leaderstats") and plr.leaderstats:FindFirstChild("Wanted") then
                val = plr.leaderstats.Wanted.Value
            end
        end)
        if val == nil then
            pcall(function()
                if plr:FindFirstChild("DataFolder") and plr.DataFolder:FindFirstChild("Information") and plr.DataFolder.Information:FindFirstChild("Wanted") then
                    val = plr.DataFolder.Information.Wanted.Value
                end
            end)
        end
        if val ~= nil then
            return tostring(val)
        end
        return "N/A"
    end

    local function updateAvatarImage()
        local target = getSelectedTarget()
        if target and target.UserId then
            if avatarImage then
                local content, isLoaded = Players:GetUserThumbnailAsync(target.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
                avatarImage.Image = content or string.format("https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=150&height=150&format=png", target.UserId)
            end

            if targetInfoText then
                local dispName = target.DisplayName or target.Name
                local uname = target.Name
                local uid = target.UserId
                local age = target.AccountAge or 0

                local moneyStr = getTargetMoney(target)
                local wantedStr = getTargetWanted(target)

                local infoFormat = string.format("%s - (@%s) - %d\nAccount Age: %d days\nMoney: %s\nWanted: %s", dispName, uname, uid, age, moneyStr, wantedStr)
                targetInfoText.Text = infoFormat
            end
        else
            if avatarImage then avatarImage.Image = "rbxassetid://0" end
            if targetInfoText then targetInfoText.Text = "Select a target to view info..." end
        end
    end

    if Options.TargetPlayerDropdown then
        Options.TargetPlayerDropdown:OnChanged(function()
            updateAvatarImage()
            local TLD = _G.TargetLockDot
            if TLD and TLD.isActive then
                local target = getSelectedTarget()
                if target then
                    TLD.lock(target)
                else
                    TLD.unlock()
                end
            end
        end)
    end
    task.delay(0.5, updateAvatarImage)
    task.spawn(function()
        while true do
            task.wait(1)
            pcall(updateAvatarImage)
        end
    end)

    Options.TargetUserSearch:OnChanged(function()
        local searchText = Options.TargetUserSearch.Value
        if searchText and searchText ~= '' then
            local lowerSearch = searchText:lower()
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    if plr.Name:lower():find(lowerSearch, 1, true) or plr.DisplayName:lower():find(lowerSearch, 1, true) then
                        Options.TargetPlayerDropdown:SetValue(plr.Name .. " (@" .. plr.Name .. ")")
                        break
                    end
                end
            end
        end
    end)

    local glueConnection = nil
    local glueTarget = nil
    local glueOffset = CFrame.new(0, 0, 1.2)

    local function stopGlue()
        if glueConnection then
            glueConnection:Disconnect()
            glueConnection = nil
        end
        glueTarget = nil
    end

    local function startGlue(targetPlayer, offset)
        stopGlue()
        if not targetPlayer or not targetPlayer.Character then return end
        glueTarget = targetPlayer
        glueOffset = offset or CFrame.new(0, 0, 1.2)

        glueConnection = RunService.Heartbeat:Connect(function()
            if not glueTarget or not glueTarget.Character then
                stopGlue()
                return
            end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local tChar = glueTarget.Character
            local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")

            if not hrp or not tHrp then return end

            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end

            hrp.CFrame = tHrp.CFrame * glueOffset
            hrp.AssemblyLinearVelocity = Vector3.zero
        end)
    end

    local function equipAttackWeapon()
        local weaponMode = Options.TargetWeaponSelect and Options.TargetWeaponSelect.Value or 'Combat'
        local char = LocalPlayer.Character
        local bp = LocalPlayer.Backpack
        if not char then return nil end

        if weaponMode == 'Combat' then
            local combat = (bp and bp:FindFirstChild("Combat")) or char:FindFirstChild("Combat")
            if combat then combat.Parent = char return combat end
        elseif weaponMode == 'Knife' then
            local knife = (bp and (bp:FindFirstChild("[Knife]") or bp:FindFirstChild("Knife"))) or char:FindFirstChild("[Knife]") or char:FindFirstChild("Knife")
            if knife then knife.Parent = char return knife end
        elseif weaponMode == 'Bat' then
            local bat = (bp and (bp:FindFirstChild("[Bat]") or bp:FindFirstChild("Bat"))) or char:FindFirstChild("[Bat]") or char:FindFirstChild("Bat")
            if bat then bat.Parent = char return bat end
        end

        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then return tool end
        end
        if bp then
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") then tool.Parent = char return tool end
            end
        end
        return nil
    end

    TargetRightGroup:AddButton({Text = 'Goto Target', Func = function()
        local target = getSelectedTarget()
        if target and target.Character then
            local tHrp = target.Character:FindFirstChild("HumanoidRootPart")
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp and tHrp then
                hrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, 2)
                Library:Notify("Teleported to: " .. target.Name, 3)
            end
        else
            Library:Notify("No target selected!", 3)
        end
    end})

    TargetRightGroup:AddToggle('TargetView', {Text = 'View Target', Default = false})
    local viewConn = nil
    Toggles.TargetView:OnChanged(function()
        if viewConn then
            viewConn:Disconnect()
            viewConn = nil
        end
        if Toggles.TargetView.Value then
            kfSpectating = true
            viewConn = RunService.RenderStepped:Connect(function()
                local target = getSelectedTarget()
                if target and target.Character then
                    local targetHum = target.Character:FindFirstChildOfClass("Humanoid") or target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("UpperTorso")
                    if targetHum then
                        workspace.CurrentCamera.CameraSubject = targetHum
                    end
                else
                    local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if myHum then
                        workspace.CurrentCamera.CameraSubject = myHum
                    end
                end
            end)
        else
            kfSpectating = false
            local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if myHum then
                workspace.CurrentCamera.CameraSubject = myHum
            end
        end
    end)

    local function performSingleKill(targetPlr)
        if not targetPlr or not targetPlr.Character then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        local savedCF = hrp.CFrame
        local isKilling = true

        local noclipConn
        noclipConn = RunService.Stepped:Connect(function()
            if not isKilling then return end
            local c = LocalPlayer.Character
            if c then
                for _, p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end
            local t = targetPlr and targetPlr.Character
            if t then
                for _, p in ipairs(t:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end
        end)

        local tool = equipAttackWeapon()
        local activeHandle = nil

        local function updateHitbox()
            if tool then
                local handle = tool:FindFirstChild('HITBOX_PART') or tool:FindFirstChild('Handle') or tool:FindFirstChildWhichIsA('BasePart')
                if handle and handle:IsA('BasePart') then
                    if handle:GetAttribute('TargetOrigSize') == nil then
                        handle:SetAttribute('TargetOrigSize', handle.Size)
                    end
                    if handle:GetAttribute('TargetOrigMassless') == nil then
                        handle:SetAttribute('TargetOrigMassless', handle.Massless)
                    end
                    local sz = (Options and Options.KnifeHitboxSize and Options.KnifeHitboxSize.Value) or 21
                    handle.Size = Vector3.new(sz, sz, sz)
                    handle.Massless = true
                    handle.CanCollide = false
                    activeHandle = handle
                end
            end
        end

        updateHitbox()

        local killConn
        killConn = RunService.Heartbeat:Connect(function()
            if not isKilling or not targetPlr or not targetPlr.Character then return end
            local c = LocalPlayer.Character
            local root = c and c:FindFirstChild("HumanoidRootPart")
            local myHum = c and c:FindFirstChildOfClass("Humanoid")
            if not root or not myHum then return end

            local tChar = targetPlr.Character
            local tHrp = tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("UpperTorso")
            if not tHrp then return end

            local be = tChar:FindFirstChild("BodyEffects")
            local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
            local isDead = (tChar:FindFirstChildOfClass("Humanoid") and tChar:FindFirstChildOfClass("Humanoid").Health <= 0) or (be and be:FindFirstChild("SDeath") and be["SDeath"].Value)

            if isDead then
                isKilling = false
                return
            end

            if not isKO then

                if sethiddenproperty then
                    pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", tHrp) end)
                end

                local targetPos = tHrp.Position
                local dir = (root.Position - targetPos)
                dir = (dir.Magnitude > 0.1) and dir.Unit or Vector3.new(0, 0, 1)
                pcall(function()
                    root.CFrame = CFrame.lookAt(targetPos + dir * 1.8, targetPos)
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.Velocity = Vector3.zero
                    root.RotVelocity = Vector3.zero
                end)

                if tool and tool.Parent ~= c then
                    pcall(function() myHum:EquipTool(tool) end)
                    updateHitbox()
                elseif not tool or not tool.Parent then
                    tool = equipAttackWeapon()
                    updateHitbox()
                else
                    updateHitbox()
                end

                local attackMethod = Options.TargetAttackMethod and Options.TargetAttackMethod.Value or 'Heavy Attack'
                if tool then
                    pcall(function() tool:Activate() end)
                    local handle = activeHandle or tool:FindFirstChild("HITBOX_PART") or tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("Part") or tool:FindFirstChildWhichIsA("BasePart")
                    if attackMethod == 'Light Attack' then
                        pcall(function()
                            game:GetService("VirtualUser"):ClickButton1(Vector2.new(20, 20), workspace.CurrentCamera.CFrame)
                        end)
                        if handle and firetouchinterest then
                            for _, pName in ipairs({"UpperTorso", "Head", "HumanoidRootPart", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg"}) do
                                local pPart = tChar:FindFirstChild(pName)
                                if pPart then
                                    pcall(function()
                                        firetouchinterest(handle, pPart, 0)
                                        firetouchinterest(handle, pPart, 1)
                                    end)
                                end
                            end
                        end
                    else
                        if handle and firetouchinterest then
                            for _, pName in ipairs({"UpperTorso", "Head", "HumanoidRootPart", "LowerTorso"}) do
                                local pPart = tChar:FindFirstChild(pName)
                                if pPart then
                                    pcall(function()
                                        firetouchinterest(handle, pPart, 0)
                                        firetouchinterest(handle, pPart, 1)
                                    end)
                                end
                            end
                        end
                    end
                end
            else

                if sethiddenproperty then
                    pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
                end
                local upperTorso = tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso") or tChar:FindFirstChild("HumanoidRootPart")
                if upperTorso then
                    pcall(function()
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        root.Velocity = Vector3.zero
                        root.RotVelocity = Vector3.zero
                        root.CFrame = CFrame.new(upperTorso.Position + Vector3.new(0, 3.5, 0))
                    end)
                end
                pcall(function() ReplicatedStorage.MainEvent:FireServer("Stomp") end)
            end
        end)

        local startTime = os.clock()
        while isKilling and (os.clock() - startTime < 12) do
            task.wait(0.05)
            if not targetPlr or not targetPlr.Character then break end
            local tHum = targetPlr.Character:FindFirstChildOfClass("Humanoid")
            if not tHum or tHum.Health <= 0 then break end
        end

        isKilling = false
        if killConn then killConn:Disconnect() end
        if noclipConn then noclipConn:Disconnect() end

        if activeHandle and activeHandle:IsA('BasePart') then
            local origSize = activeHandle:GetAttribute('TargetOrigSize')
            if typeof(origSize) == 'Vector3' then activeHandle.Size = origSize end
            local origMassless = activeHandle:GetAttribute('TargetOrigMassless')
            if origMassless ~= nil then activeHandle.Massless = origMassless end
            activeHandle:SetAttribute('TargetOrigSize', nil)
            activeHandle:SetAttribute('TargetOrigMassless', nil)
        end

        local endChar = LocalPlayer.Character
        if endChar then
            for _, p in ipairs(endChar:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = true
                    p.AssemblyLinearVelocity = Vector3.zero
                    p.AssemblyAngularVelocity = Vector3.zero
                    p.Velocity = Vector3.zero
                    p.RotVelocity = Vector3.zero
                end
            end
            local endHum = endChar:FindFirstChildOfClass("Humanoid")
            if endHum then
                pcall(function() endHum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            end
        end

        if sethiddenproperty and hrp then
            pcall(function() sethiddenproperty(hrp, "PhysicsRepRootPart", nil) end)
        end

        if hrp and hrp.Parent and savedCF then
            pcall(function()

                hrp.CFrame = savedCF + Vector3.new(0, 0.5, 0)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
            end)
        end
    end

    local function performSingleKnock(targetPlr)
        if not targetPlr or not targetPlr.Character then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end

        local savedCF = hrp.CFrame
        local isKnocking = true

        local noclipConn
        noclipConn = RunService.Stepped:Connect(function()
            if not isKnocking then return end
            local c = LocalPlayer.Character
            if c then
                for _, p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end
            local t = targetPlr and targetPlr.Character
            if t then
                for _, p in ipairs(t:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end
        end)

        local tool = equipAttackWeapon()
        local activeHandle = nil

        local function updateHitbox()
            if tool then
                local handle = tool:FindFirstChild('HITBOX_PART') or tool:FindFirstChild('Handle') or tool:FindFirstChildWhichIsA('BasePart')
                if handle and handle:IsA('BasePart') then
                    if handle:GetAttribute('TargetOrigSize') == nil then
                        handle:SetAttribute('TargetOrigSize', handle.Size)
                    end
                    if handle:GetAttribute('TargetOrigMassless') == nil then
                        handle:SetAttribute('TargetOrigMassless', handle.Massless)
                    end
                    local sz = (Options and Options.KnifeHitboxSize and Options.KnifeHitboxSize.Value) or 21
                    handle.Size = Vector3.new(sz, sz, sz)
                    handle.Massless = true
                    handle.CanCollide = false
                    activeHandle = handle
                end
            end
        end

        updateHitbox()

        local knockConn
        knockConn = RunService.Heartbeat:Connect(function()
            if not isKnocking or not targetPlr or not targetPlr.Character then return end
            local c = LocalPlayer.Character
            local root = c and c:FindFirstChild("HumanoidRootPart")
            local myHum = c and c:FindFirstChildOfClass("Humanoid")
            if not root or not myHum then return end

            local tChar = targetPlr.Character
            local tHrp = tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("UpperTorso")
            if not tHrp then return end

            local be = tChar:FindFirstChild("BodyEffects")
            local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
            local isDead = (tChar:FindFirstChildOfClass("Humanoid") and tChar:FindFirstChildOfClass("Humanoid").Health <= 0) or (be and be:FindFirstChild("SDeath") and be["SDeath"].Value)

            if isKO or isDead then

                isKnocking = false
                return
            end

            if sethiddenproperty then
                pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", tHrp) end)
            end

            local targetPos = tHrp.Position
            local dir = (root.Position - targetPos)
            dir = (dir.Magnitude > 0.1) and dir.Unit or Vector3.new(0, 0, 1)
            pcall(function()
                root.CFrame = CFrame.lookAt(targetPos + dir * 1.8, targetPos)
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
            end)

            if tool and tool.Parent ~= c then
                pcall(function() myHum:EquipTool(tool) end)
                updateHitbox()
            elseif not tool or not tool.Parent then
                tool = equipAttackWeapon()
                updateHitbox()
            else
                updateHitbox()
            end

            local attackMethod = Options.TargetAttackMethod and Options.TargetAttackMethod.Value or 'Heavy Attack'
            if tool then
                pcall(function() tool:Activate() end)
                local handle = activeHandle or tool:FindFirstChild("HITBOX_PART") or tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("Part") or tool:FindFirstChildWhichIsA("BasePart")
                if attackMethod == 'Light Attack' then
                    pcall(function()
                        game:GetService("VirtualUser"):ClickButton1(Vector2.new(20, 20), workspace.CurrentCamera.CFrame)
                    end)
                    if handle and firetouchinterest then
                        for _, pName in ipairs({"UpperTorso", "Head", "HumanoidRootPart", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg"}) do
                            local pPart = tChar:FindFirstChild(pName)
                            if pPart then
                                pcall(function()
                                    firetouchinterest(handle, pPart, 0)
                                    firetouchinterest(handle, pPart, 1)
                                end)
                            end
                        end
                    end
                else
                    if handle and firetouchinterest then
                        for _, pName in ipairs({"UpperTorso", "Head", "HumanoidRootPart", "LowerTorso"}) do
                            local pPart = tChar:FindFirstChild(pName)
                            if pPart then
                                pcall(function()
                                    firetouchinterest(handle, pPart, 0)
                                    firetouchinterest(handle, pPart, 1)
                                end)
                            end
                        end
                    end
                end
            end
        end)

        local startTime = os.clock()
        while isKnocking and (os.clock() - startTime < 12) do
            task.wait(0.05)
            if not targetPlr or not targetPlr.Character then break end
            local tHum = targetPlr.Character:FindFirstChildOfClass("Humanoid")
            if not tHum or tHum.Health <= 0 then break end
        end

        isKnocking = false
        if knockConn then knockConn:Disconnect() end
        if noclipConn then noclipConn:Disconnect() end

        if activeHandle and activeHandle:IsA('BasePart') then
            local origSize = activeHandle:GetAttribute('TargetOrigSize')
            if typeof(origSize) == 'Vector3' then activeHandle.Size = origSize end
            local origMassless = activeHandle:GetAttribute('TargetOrigMassless')
            if origMassless ~= nil then activeHandle.Massless = origMassless end
            activeHandle:SetAttribute('TargetOrigSize', nil)
            activeHandle:SetAttribute('TargetOrigMassless', nil)
        end

        local endChar = LocalPlayer.Character
        if endChar then
            for _, p in ipairs(endChar:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = true
                    p.AssemblyLinearVelocity = Vector3.zero
                    p.AssemblyAngularVelocity = Vector3.zero
                    p.Velocity = Vector3.zero
                    p.RotVelocity = Vector3.zero
                end
            end
            local endHum = endChar:FindFirstChildOfClass("Humanoid")
            if endHum then
                pcall(function() endHum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            end
        end

        if sethiddenproperty and hrp then
            pcall(function() sethiddenproperty(hrp, "PhysicsRepRootPart", nil) end)
        end

        if hrp and hrp.Parent and savedCF then
            pcall(function()
                hrp.CFrame = savedCF + Vector3.new(0, 0.5, 0)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                hrp.Velocity = Vector3.zero
                hrp.RotVelocity = Vector3.zero
            end)
        end
    end

    TargetRightGroup:AddButton({Text = 'Bring Target', Func = function()
        local target = getSelectedTarget()
        if not target or not target.Character then
            Library:Notify("No target selected!", 3)
            return
        end
        Library:Notify("Bringing " .. target.Name .. "...", 3)
        task.spawn(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then return end

            local savedCF = hrp.CFrame
            local isBringActive = true

            local noclipConn = RunService.Stepped:Connect(function()
                if not isBringActive then return end
                local c = LocalPlayer.Character
                if c then
                    for _, p in ipairs(c:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
                local t = target and target.Character
                if t then
                    for _, p in ipairs(t:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
            end)

            local tool = equipAttackWeapon()
            local activeHandle = nil

            local function updateHitbox()
                if tool then
                    local handle = tool:FindFirstChild('HITBOX_PART') or tool:FindFirstChild('Handle') or tool:FindFirstChildWhichIsA('BasePart')
                    if handle and handle:IsA('BasePart') then
                        if handle:GetAttribute('TargetOrigSize') == nil then
                            handle:SetAttribute('TargetOrigSize', handle.Size)
                        end
                        if handle:GetAttribute('TargetOrigMassless') == nil then
                            handle:SetAttribute('TargetOrigMassless', handle.Massless)
                        end
                        local sz = (Options and Options.KnifeHitboxSize and Options.KnifeHitboxSize.Value) or 21
                        handle.Size = Vector3.new(sz, sz, sz)
                        handle.Massless = true
                        handle.CanCollide = false
                        activeHandle = handle
                    end
                end
            end

            updateHitbox()

            local isTargetKO = false
            local attackConn
            attackConn = RunService.Heartbeat:Connect(function()
                if not isBringActive or not target or not target.Character then return end
                local c = LocalPlayer.Character
                local root = c and c:FindFirstChild("HumanoidRootPart")
                local myHum = c and c:FindFirstChildOfClass("Humanoid")
                if not root or not myHum then return end

                local tChar = target.Character
                local tHrp = tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("UpperTorso")
                if not tHrp then return end

                local be = tChar:FindFirstChild("BodyEffects")
                local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
                local isDead = (tChar:FindFirstChildOfClass("Humanoid") and tChar:FindFirstChildOfClass("Humanoid").Health <= 0) or (be and be:FindFirstChild("SDeath") and be["SDeath"].Value)

                if isDead then
                    isBringActive = false
                    return
                end

                if isKO then
                    isTargetKO = true
                    return
                end

                if sethiddenproperty then
                    pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", tHrp) end)
                end
                local targetPos = tHrp.Position
                local dir = (root.Position - targetPos)
                dir = (dir.Magnitude > 0.1) and dir.Unit or Vector3.new(0, 0, 1)
                pcall(function()
                    root.CFrame = CFrame.lookAt(targetPos + dir * 1.8, targetPos)
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.Velocity = Vector3.zero
                    root.RotVelocity = Vector3.zero
                end)

                if tool and tool.Parent ~= c then
                    pcall(function() myHum:EquipTool(tool) end)
                    updateHitbox()
                elseif not tool or not tool.Parent then
                    tool = equipAttackWeapon()
                    updateHitbox()
                else
                    updateHitbox()
                end

                local attackMethod = Options.TargetAttackMethod and Options.TargetAttackMethod.Value or 'Heavy Attack'
                if tool then
                    pcall(function() tool:Activate() end)
                    local handle = activeHandle or tool:FindFirstChild("HITBOX_PART") or tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("Part") or tool:FindFirstChildWhichIsA("BasePart")
                    if attackMethod == 'Light Attack' then
                        pcall(function()
                            game:GetService("VirtualUser"):ClickButton1(Vector2.new(20, 20), workspace.CurrentCamera.CFrame)
                        end)
                        if handle and firetouchinterest then
                            for _, pName in ipairs({"UpperTorso", "Head", "HumanoidRootPart", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg"}) do
                                local pPart = tChar:FindFirstChild(pName)
                                if pPart then
                                    pcall(function()
                                        firetouchinterest(handle, pPart, 0)
                                        firetouchinterest(handle, pPart, 1)
                                    end)
                                end
                            end
                        end
                    else
                        if handle and firetouchinterest then
                            for _, pName in ipairs({"UpperTorso", "Head", "HumanoidRootPart", "LowerTorso"}) do
                                local pPart = tChar:FindFirstChild(pName)
                                if pPart then
                                    pcall(function()
                                        firetouchinterest(handle, pPart, 0)
                                        firetouchinterest(handle, pPart, 1)
                                    end)
                                end
                            end
                        end
                    end
                end
            end)

            local knockStart = os.clock()
            while isBringActive and not isTargetKO and (os.clock() - knockStart < 10) do
                task.wait(0.05)
                if target and target.Character then
                    local be = target.Character:FindFirstChild("BodyEffects")
                    if be and be:FindFirstChild("K.O") and be["K.O"].Value then
                        isTargetKO = true
                        break
                    end
                end
            end

            if attackConn then attackConn:Disconnect() end

            local isGrabbed = false
            if isTargetKO and isBringActive and target and target.Character then
                local isBringingKO = true
                local lastGrabTick = 0

                local bringKOConn = RunService.Heartbeat:Connect(function()
                    if not isBringingKO or not target or not target.Character then return end
                    local c = LocalPlayer.Character
                    local root = c and c:FindFirstChild("HumanoidRootPart")
                    if not root then return end

                    local tc = target.Character
                    local ut = tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("Torso") or tc:FindFirstChild("HumanoidRootPart")
                    if not ut then return end

                    if tc:FindFirstChild("GRABBING_CONSTRAINT") or (c and c:FindFirstChild("GRABBING_CONSTRAINT")) then
                        isGrabbed = true
                        isBringingKO = false
                        return
                    end

                    if sethiddenproperty then
                        pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
                    end

                    pcall(function()
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        root.Velocity = Vector3.zero
                        root.RotVelocity = Vector3.zero
                        root.CFrame = CFrame.new(ut.Position + Vector3.new(0, 3.5, 0))
                    end)

                    if tick() - lastGrabTick >= 0.35 then
                        lastGrabTick = tick()
                        pcall(function() ReplicatedStorage.MainEvent:FireServer("Grabbing", false) end)
                    end
                end)

                local startGrab = os.clock()
                while isBringingKO and (os.clock() - startGrab < 8) do
                    task.wait(0.05)
                    if target and target.Character then
                        local tc = target.Character
                        local mc = LocalPlayer.Character
                        if (tc and tc:FindFirstChild("GRABBING_CONSTRAINT")) or (mc and mc:FindFirstChild("GRABBING_CONSTRAINT")) then
                            isGrabbed = true
                            break
                        end
                    end
                end

                isBringingKO = false
                if bringKOConn then bringKOConn:Disconnect() end
            end

            isBringActive = false
            if noclipConn then noclipConn:Disconnect() end

            if activeHandle and activeHandle:IsA('BasePart') then
                local origSize = activeHandle:GetAttribute('TargetOrigSize')
                if typeof(origSize) == 'Vector3' then activeHandle.Size = origSize end
                local origMassless = activeHandle:GetAttribute('TargetOrigMassless')
                if origMassless ~= nil then activeHandle.Massless = origMassless end
                activeHandle:SetAttribute('TargetOrigSize', nil)
                activeHandle:SetAttribute('TargetOrigMassless', nil)
            end

            local endChar = LocalPlayer.Character
            local endHrp = endChar and endChar:FindFirstChild("HumanoidRootPart")

            if sethiddenproperty and endHrp then
                pcall(function() sethiddenproperty(endHrp, "PhysicsRepRootPart", nil) end)
            end

            if isGrabbed and endHrp and savedCF then
                endHrp.CFrame = savedCF + Vector3.new(0, 0.5, 0)
                endHrp.AssemblyLinearVelocity = Vector3.zero
                endHrp.AssemblyAngularVelocity = Vector3.zero
                endHrp.Velocity = Vector3.zero
                endHrp.RotVelocity = Vector3.zero

                task.wait(0.35)
                pcall(function() ReplicatedStorage.MainEvent:FireServer("Grabbing", false) end)
                task.wait(0.35)
            elseif endHrp and savedCF then
                endHrp.CFrame = savedCF + Vector3.new(0, 0.5, 0)
                endHrp.AssemblyLinearVelocity = Vector3.zero
                endHrp.AssemblyAngularVelocity = Vector3.zero
                endHrp.Velocity = Vector3.zero
                endHrp.RotVelocity = Vector3.zero
                Library:Notify("Finished Bring attempt!", 3)
            end

            if endChar then
                for _, p in ipairs(endChar:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.CanCollide = true
                        p.AssemblyLinearVelocity = Vector3.zero
                        p.AssemblyAngularVelocity = Vector3.zero
                        p.Velocity = Vector3.zero
                        p.RotVelocity = Vector3.zero
                    end
                end
                local endHum = endChar:FindFirstChildOfClass("Humanoid")
                if endHum then
                    pcall(function() endHum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                end
            end
        end)
    end})

    TargetRightGroup:AddButton({Text = 'Kill Target', Func = function()
        local target = getSelectedTarget()
        if target then
            Library:Notify("Killing: " .. target.Name, 3)
            task.spawn(function() performSingleKill(target) end)
        else
            Library:Notify("No target selected!", 3)
        end
    end})

    TargetRightGroup:AddToggle('TargetLoopKill', {Text = 'Loop Kill Target', Default = false})

    task.spawn(function()
        while true do
            if Toggles.TargetLoopKill and Toggles.TargetLoopKill.Value then
                local target = getSelectedTarget()
                if target and target.Character then
                    performSingleKill(target)
                end
            end
            task.wait(0.5)
        end
    end)

    local activeFlingRunning = false
    local broughtKOCharacters = {}

    TargetRightGroup:AddToggle('TargetSentry', {Text = 'Sentry Target (Bring KO)', Default = false})

    task.spawn(function()
        local sentryBusy = false
        while true do
            if Toggles.TargetSentry and Toggles.TargetSentry.Value and not sentryBusy then
                local target = getSelectedTarget()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")

                if target and target.Character and hrp then
                    local tChar = target.Character
                    local be = tChar:FindFirstChild("BodyEffects")
                    local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
                    local upperTorso = tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso") or tChar:FindFirstChild("HumanoidRootPart")

                    if not isKO then
                        broughtKOCharacters[tChar] = nil
                    end

                    if isKO and upperTorso and not broughtKOCharacters[tChar] then
                        sentryBusy = true
                        local savedCF = hrp.CFrame
                        local isBringing = true
                        local isGrabbed = false

                        local noclipConn = RunService.Stepped:Connect(function()
                            if not isBringing then return end
                            local c = LocalPlayer.Character
                            if c then
                                for _, p in ipairs(c:GetDescendants()) do
                                    if p:IsA("BasePart") then p.CanCollide = false end
                                end
                            end
                            local t = target and target.Character
                            if t then
                                for _, p in ipairs(t:GetDescendants()) do
                                    if p:IsA("BasePart") then p.CanCollide = false end
                                end
                            end
                        end)

                        local lastGrabTick = 0
                        local bringConn = RunService.Heartbeat:Connect(function()
                            if not isBringing or not target or not target.Character then return end
                            local c = LocalPlayer.Character
                            local root = c and c:FindFirstChild("HumanoidRootPart")
                            if not root then return end

                            local tc = target.Character
                            local ut = tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("Torso") or tc:FindFirstChild("HumanoidRootPart")
                            if not ut then return end

                            if tc:FindFirstChild("GRABBING_CONSTRAINT") or (c and c:FindFirstChild("GRABBING_CONSTRAINT")) then
                                isGrabbed = true
                                isBringing = false
                                return
                            end

                            if sethiddenproperty then
                                pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
                            end

                            pcall(function()
                                root.AssemblyLinearVelocity = Vector3.zero
                                root.AssemblyAngularVelocity = Vector3.zero
                                root.Velocity = Vector3.zero
                                root.RotVelocity = Vector3.zero
                                root.CFrame = CFrame.new(ut.Position + Vector3.new(0, 3.5, 0))
                            end)

                            if tick() - lastGrabTick >= 0.35 then
                                lastGrabTick = tick()
                                pcall(function() ReplicatedStorage.MainEvent:FireServer("Grabbing", false) end)
                            end
                        end)

                        local start = os.clock()
                        while isBringing and (os.clock() - start < 8) do
                            task.wait(0.05)
                            if target and target.Character then
                                local tc = target.Character
                                local mc = LocalPlayer.Character
                                if (tc and tc:FindFirstChild("GRABBING_CONSTRAINT")) or (mc and mc:FindFirstChild("GRABBING_CONSTRAINT")) then
                                    isGrabbed = true
                                    break
                                end
                            end
                        end

                        isBringing = false
                        if bringConn then bringConn:Disconnect() end
                        if noclipConn then noclipConn:Disconnect() end

                        local endChar = LocalPlayer.Character
                        local endHrp = endChar and endChar:FindFirstChild("HumanoidRootPart")

                        if sethiddenproperty and endHrp then
                            pcall(function() sethiddenproperty(endHrp, "PhysicsRepRootPart", nil) end)
                        end

                        if isGrabbed and endHrp and savedCF then
                            endHrp.CFrame = savedCF + Vector3.new(0, 0.5, 0)
                            endHrp.AssemblyLinearVelocity = Vector3.zero
                            endHrp.AssemblyAngularVelocity = Vector3.zero
                            endHrp.Velocity = Vector3.zero
                            endHrp.RotVelocity = Vector3.zero

                            task.wait(0.35)
                            pcall(function() ReplicatedStorage.MainEvent:FireServer("Grabbing", false) end)
                            task.wait(0.35)
                        end

                        if endChar then
                            for _, p in ipairs(endChar:GetDescendants()) do
                                if p:IsA("BasePart") then
                                    p.CanCollide = true
                                    p.AssemblyLinearVelocity = Vector3.zero
                                    p.AssemblyAngularVelocity = Vector3.zero
                                    p.Velocity = Vector3.zero
                                    p.RotVelocity = Vector3.zero
                                end
                            end
                        end

                        broughtKOCharacters[tChar] = true
                        sentryBusy = false
                    end
                end
            end
            task.wait(0.3)
        end
    end)

    TargetRightGroup:AddButton({Text = 'Fling Target', Func = function()
        local target = getSelectedTarget()
        if not target or not target.Character then
            Library:Notify("No target selected!", 3)
            return
        end

        local speakerChar = LocalPlayer.Character
        local hrp = speakerChar and speakerChar:FindFirstChild("HumanoidRootPart")
        local hum = speakerChar and speakerChar:FindFirstChildOfClass("Humanoid")
        local tHrp = target.Character and (target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("UpperTorso"))

        if not hrp or not hum or not tHrp then
            Library:Notify("Target or character not ready!", 3)
            return
        end

        if activeFlingRunning then
            activeFlingRunning = false
            task.wait(0.15)
        end

        activeFlingRunning = true
        Library:Notify("Flinging: " .. target.Name, 3)

        task.spawn(function()
            local savedCF = hrp.CFrame

            if sethiddenproperty and hrp then
                pcall(function() sethiddenproperty(hrp, "PhysicsRepRootPart", nil) end)
            end

            pcall(function() hrp.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5) end)

            local noclipConn = RunService.Stepped:Connect(function()
                if not activeFlingRunning then return end
                local c = LocalPlayer.Character
                if c then
                    for _, p in ipairs(c:GetDescendants()) do
                        if p:IsA("BasePart") then
                            if p.Name == "HumanoidRootPart" then
                                p.CanCollide = true
                            else
                                p.CanCollide = false
                            end
                        end
                    end
                end
            end)

            local bambam = Instance.new("BodyAngularVelocity")
            bambam.Name = "FlingBambam_" .. math.random(1000, 9999)
            bambam.Parent = hrp
            bambam.AngularVelocity = Vector3.new(0, 99999, 0)
            bambam.MaxTorque = Vector3.new(0, math.huge, 0)
            bambam.P = math.huge

            for _, v in ipairs(speakerChar:GetChildren()) do
                if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                    v.Massless = true
                    v.Velocity = Vector3.zero
                end
            end

            local flingDied = hum.Died:Connect(function()
                activeFlingRunning = false
            end)

            local flingGlueConn = RunService.Heartbeat:Connect(function()
                if not activeFlingRunning or not target or not target.Character then return end
                local curTargetHrp = target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("UpperTorso")
                local myChar = LocalPlayer.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if curTargetHrp and myHrp then
                    if sethiddenproperty then
                        pcall(function() sethiddenproperty(myHrp, "PhysicsRepRootPart", curTargetHrp) end)
                    end
                    local targetPos = curTargetHrp.Position
                    pcall(function()
                        myHrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 0, 0.2))
                        myHrp.AssemblyLinearVelocity = Vector3.new(9999, 9999, 9999)
                    end)
                end
            end)

            local startTime = os.clock()
            repeat
                bambam.AngularVelocity = Vector3.new(0, 99999, 0)
                task.wait(0.15)
                bambam.AngularVelocity = Vector3.new(0, 0, 0)
                task.wait(0.05)
            until activeFlingRunning == false or (os.clock() - startTime) > 4 or not target or not target.Character

            activeFlingRunning = false
            if flingDied then flingDied:Disconnect() end
            if flingGlueConn then flingGlueConn:Disconnect() end
            if noclipConn then noclipConn:Disconnect() end
            if bambam then bambam:Destroy() end

            local endChar = LocalPlayer.Character
            local endHrp = endChar and endChar:FindFirstChild("HumanoidRootPart")

            if sethiddenproperty and endHrp then
                pcall(function() sethiddenproperty(endHrp, "PhysicsRepRootPart", nil) end)
            end

            if endChar then
                for _, v in ipairs(endChar:GetDescendants()) do
                    if v:IsA("BasePart") then
                        pcall(function() v.CustomPhysicalProperties = nil end)
                        v.Massless = false
                        v.CanCollide = true
                        v.AssemblyLinearVelocity = Vector3.zero
                        v.AssemblyAngularVelocity = Vector3.zero
                        v.Velocity = Vector3.zero
                        v.RotVelocity = Vector3.zero
                    end
                end
                local endHum = endChar:FindFirstChildOfClass("Humanoid")
                if endHum then
                    pcall(function() endHum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                end
            end

            task.wait(0.05)

            if endHrp and endHrp.Parent and savedCF then
                pcall(function()
                    endHrp.CFrame = savedCF + Vector3.new(0, 0.5, 0)
                    endHrp.AssemblyLinearVelocity = Vector3.zero
                    endHrp.AssemblyAngularVelocity = Vector3.zero
                    endHrp.Velocity = Vector3.zero
                    endHrp.RotVelocity = Vector3.zero
                end)
            end
        end)
    end})

    TargetRightGroup:AddButton({Text = 'Sky / Void Target', Func = function()
        local target = getSelectedTarget()
        if not target or not target.Character then
            Library:Notify("No target selected!", 3)
            return
        end
        Library:Notify("Sending " .. target.Name .. " to Sky/Void!", 3)
        task.spawn(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then return end

            local savedCF = hrp.CFrame
            local isSkyActive = true

            local noclipConn = RunService.Stepped:Connect(function()
                if not isSkyActive then return end
                local c = LocalPlayer.Character
                if c then
                    for _, p in ipairs(c:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
                local t = targetPlr and targetPlr.Character
                if t then
                    for _, p in ipairs(t:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
            end)

            local tool = equipAttackWeapon()
            local activeHandle = nil

            local function updateHitbox()
                if tool then
                    local handle = tool:FindFirstChild('HITBOX_PART') or tool:FindFirstChild('Handle') or tool:FindFirstChildWhichIsA('BasePart')
                    if handle and handle:IsA('BasePart') then
                        if handle:GetAttribute('TargetOrigSize') == nil then
                            handle:SetAttribute('TargetOrigSize', handle.Size)
                        end
                        if handle:GetAttribute('TargetOrigMassless') == nil then
                            handle:SetAttribute('TargetOrigMassless', handle.Massless)
                        end
                        local sz = (Options and Options.KnifeHitboxSize and Options.KnifeHitboxSize.Value) or 21
                        handle.Size = Vector3.new(sz, sz, sz)
                        handle.Massless = true
                        handle.CanCollide = false
                        activeHandle = handle
                    end
                end
            end

            updateHitbox()

            local lastGrabTick = 0
            local attackConn
            attackConn = RunService.Heartbeat:Connect(function()
                if not isSkyActive or not target or not target.Character then return end
                local c = LocalPlayer.Character
                local root = c and c:FindFirstChild("HumanoidRootPart")
                local myHum = c and c:FindFirstChildOfClass("Humanoid")
                if not root or not myHum then return end

                local tChar = target.Character
                local tHrp = tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("UpperTorso")
                if not tHrp then return end

                local be = tChar:FindFirstChild("BodyEffects")
                local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
                local isDead = (tChar:FindFirstChildOfClass("Humanoid") and tChar:FindFirstChildOfClass("Humanoid").Health <= 0) or (be and be:FindFirstChild("SDeath") and be["SDeath"].Value)

                if isDead then
                    isSkyActive = false
                    return
                end

                if not isKO then
                    if sethiddenproperty then
                        pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", tHrp) end)
                    end
                    local targetPos = tHrp.Position
                    local dir = (root.Position - targetPos)
                    dir = (dir.Magnitude > 0.1) and dir.Unit or Vector3.new(0, 0, 1)
                    pcall(function()
                        root.CFrame = CFrame.lookAt(targetPos + dir * 1.8, targetPos)
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        root.Velocity = Vector3.zero
                        root.RotVelocity = Vector3.zero
                    end)

                    if tool and tool.Parent ~= c then
                        pcall(function() myHum:EquipTool(tool) end)
                        updateHitbox()
                    elseif not tool or not tool.Parent then
                        tool = equipAttackWeapon()
                        updateHitbox()
                    else
                        updateHitbox()
                    end

                    local attackMethod = Options.TargetAttackMethod and Options.TargetAttackMethod.Value or 'Heavy Attack'
                    if tool then
                        pcall(function() tool:Activate() end)
                        local handle = activeHandle or tool:FindFirstChild("HITBOX_PART") or tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("Part") or tool:FindFirstChildWhichIsA("BasePart")
                        if attackMethod == 'Light Attack' then
                            pcall(function()
                                game:GetService("VirtualUser"):ClickButton1(Vector2.new(20, 20), workspace.CurrentCamera.CFrame)
                            end)
                            if handle and firetouchinterest then
                                for _, pName in ipairs({"UpperTorso", "Head", "HumanoidRootPart", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg"}) do
                                    local pPart = tChar:FindFirstChild(pName)
                                    if pPart then
                                        pcall(function()
                                            firetouchinterest(handle, pPart, 0)
                                            firetouchinterest(handle, pPart, 1)
                                        end)
                                    end
                                end
                            end
                        else
                            if handle and firetouchinterest then
                                for _, pName in ipairs({"UpperTorso", "Head", "HumanoidRootPart", "LowerTorso"}) do
                                    local pPart = tChar:FindFirstChild(pName)
                                    if pPart then
                                        pcall(function()
                                            firetouchinterest(handle, pPart, 0)
                                            firetouchinterest(handle, pPart, 1)
                                        end)
                                    end
                                end
                            end
                        end
                    end
                else

                    if sethiddenproperty then
                        pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
                    end
                    local upperTorso = tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso") or tChar:FindFirstChild("HumanoidRootPart")
                    if upperTorso then
                        pcall(function()
                            root.AssemblyLinearVelocity = Vector3.zero
                            root.AssemblyAngularVelocity = Vector3.zero
                            root.Velocity = Vector3.zero
                            root.RotVelocity = Vector3.zero
                            root.CFrame = CFrame.new(upperTorso.Position + Vector3.new(0, 3.5, 0))
                        end)
                    end
                    if tick() - lastGrabTick >= 0.35 then
                        lastGrabTick = tick()
                        pcall(function() ReplicatedStorage.MainEvent:FireServer("Grabbing", false) end)
                    end
                end
            end)

            local start = os.clock()
            local isGrabbed = false
            while isSkyActive and (os.clock() - start < 14) do
                task.wait(0.05)
                if target and target.Character then
                    local tChar = target.Character
                    local myChar = LocalPlayer.Character
                    if (tChar and tChar:FindFirstChild("GRABBING_CONSTRAINT")) or (myChar and myChar:FindFirstChild("GRABBING_CONSTRAINT")) then
                        isGrabbed = true
                        break
                    end
                end
            end

            isSkyActive = false
            if attackConn then attackConn:Disconnect() end
            if noclipConn then noclipConn:Disconnect() end

            if activeHandle and activeHandle:IsA('BasePart') then
                local origSize = activeHandle:GetAttribute('TargetOrigSize')
                if typeof(origSize) == 'Vector3' then activeHandle.Size = origSize end
                local origMassless = activeHandle:GetAttribute('TargetOrigMassless')
                if origMassless ~= nil then activeHandle.Massless = origMassless end
                activeHandle:SetAttribute('TargetOrigSize', nil)
                activeHandle:SetAttribute('TargetOrigMassless', nil)
            end

            if sethiddenproperty and hrp then
                pcall(function() sethiddenproperty(hrp, "PhysicsRepRootPart", nil) end)
            end

            local isConstraintActive = isGrabbed or (target and target.Character and target.Character:FindFirstChild("GRABBING_CONSTRAINT")) or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("GRABBING_CONSTRAINT"))
            if isConstraintActive and hrp and hrp.Parent then
                pcall(function()
                    hrp.CFrame = CFrame.new(0, -999999999, 0)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                    hrp.Velocity = Vector3.zero
                    hrp.RotVelocity = Vector3.zero
                end)
                task.wait(0.35)
                pcall(function() ReplicatedStorage.MainEvent:FireServer("Grabbing", false) end)
                task.wait(0.35)
                Library:Notify("Target dropped in Sky/Void!", 3)
            else
                Library:Notify("Failed to grab target for Sky/Void!", 3)
            end

            local endChar = LocalPlayer.Character
            if endChar then
                for _, p in ipairs(endChar:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.CanCollide = true
                        p.AssemblyLinearVelocity = Vector3.zero
                        p.AssemblyAngularVelocity = Vector3.zero
                        p.Velocity = Vector3.zero
                        p.RotVelocity = Vector3.zero
                    end
                end
                if hum then
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                end
            end

            if hrp and hrp.Parent and savedCF then
                pcall(function()
                    hrp.CFrame = savedCF + Vector3.new(0, 0.5, 0)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                    hrp.Velocity = Vector3.zero
                    hrp.RotVelocity = Vector3.zero
                end)
            end
        end)
    end})

    TargetRightGroup:AddToggle('TargetBang', {Text = 'Bang Target', Default = false})
    local bangAnimTrack = nil
    local bangAnimObj = nil
    local bangLoopConn = nil
    local bangDiedConn = nil
    local bangSavePos = nil

    Toggles.TargetBang:OnChanged(function()
        if Toggles.TargetBang.Value then
            local target = getSelectedTarget()
            if not target or not target.Character then
                Library:Notify("No target selected!", 3)
                Toggles.TargetBang:SetValue(false)
                return
            end

            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hum or not hrp then return end

            bangSavePos = hrp.Position

            pcall(function()
                bangAnimObj = Instance.new("Animation")
                bangAnimObj.AnimationId = "rbxassetid://3119980985"
                bangAnimTrack = hum:LoadAnimation(bangAnimObj)
                bangAnimTrack:Play()
                bangAnimTrack:AdjustSpeed(2)
            end)

            bangDiedConn = hum.Died:Connect(function()
                pcall(function()
                    if Toggles and Toggles.TargetBang then
                        Toggles.TargetBang:SetValue(false)
                    end
                end)
            end)

            bangLoopConn = RunService.Stepped:Connect(function()
                local myChar = LocalPlayer.Character
                if not target or not target.Character or not myChar then return end
                local tChar = target.Character
                local tHrp = tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso")
                local myHrp = myChar:FindFirstChild("HumanoidRootPart")
                if tHrp and myHrp then
                    for _, p in ipairs(myChar:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                    pcall(function()
                        myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, 1)
                    end)
                end
            end)
        else
            if bangLoopConn then bangLoopConn:Disconnect() bangLoopConn = nil end
            if bangDiedConn then bangDiedConn:Disconnect() bangDiedConn = nil end
            if bangAnimTrack then
                pcall(function() bangAnimTrack:Stop() end)
                bangAnimTrack = nil
            end
            if bangAnimObj then
                pcall(function() bangAnimObj:Destroy() end)
                bangAnimObj = nil
            end
            local endChar = LocalPlayer.Character
            if endChar then
                for _, p in ipairs(endChar:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = true end
                end
            end
            if bangSavePos then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    pcall(function() hrp.CFrame = CFrame.new(bangSavePos) end)
                end
                bangSavePos = nil
            end
        end
    end)

    TargetRightGroup:AddButton({
        Text = 'Knock Target',
        Func = function()
            local target = getSelectedTarget()
            if target then
                Library:Notify("Knocking: " .. target.Name .. " (No Stomp)", 3)
                task.spawn(function() performSingleKnock(target) end)
            else
                Library:Notify("No target selected!", 3)
            end
        end
    })

    TargetRightGroup:AddButton({
        Text = 'Lock Target Dot',
        Func = function()
            local target = getSelectedTarget()
            if not target or not target.Character then
                Library:Notify("No target selected!", 3)
                return
            end

            local TLD = _G.TargetLockDot
            if TLD and TLD.isActive and TLD.lockedPlr == target then
                TLD.unlock()
            else
                if TLD then TLD.lock(target) end
            end
        end
    })

    TargetRightGroup:AddToggle('TargetSpamCall', {Text = 'Spam Call Target', Default = false})
    task.spawn(function()
        while true do
            if Toggles.TargetSpamCall and Toggles.TargetSpamCall.Value then
                local target = getSelectedTarget()
                if target then
                    local char = LocalPlayer.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum then hum:UnequipTools() end
                    task.wait(0.05)

                    local phone = LocalPlayer.Backpack:FindFirstChild("[Phone]") or (char and char:FindFirstChild("[Phone]"))
                    if phone then phone.Parent = char end

                    task.wait(0.05)
                    pcall(function() ReplicatedStorage.MainEvent:FireServer("PhoneCall", target.Name) end)
                    pcall(function() ReplicatedStorage.MainEvent:FireServer("PhoneCall", target) end)
                end
            end
            task.wait(0.5)
        end
    end)
end)

local MenuGroup = Tabs['UI Settings']:AddLeftGroupbox('Menu')
MenuGroup:AddButton({Text = 'Unload', Func = function() Library:Unload() end})
MenuGroup:AddLabel('Menu bind'):AddKeyPicker('MenuKeybind', { Default = 'End', NoUI = true, Text = 'Menu keybind' })

Library.ToggleKeybind = Options.MenuKeybind

ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)

SaveManager:IgnoreThemeSettings()
SaveManager:SetIgnoreIndexes({ 'MenuKeybind' })

ThemeManager:SetFolder('KraviX/Da Hood')
SaveManager:SetFolder('KraviX/Da Hood')

SaveManager:BuildConfigSection(Tabs['UI Settings'])
ThemeManager:ApplyToTab(Tabs['UI Settings'])
