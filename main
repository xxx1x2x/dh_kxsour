AutoBuyGroup:AddButton({Text='Buy Mask', Func=function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local Shop = workspace:WaitForChild("Ignored"):WaitForChild("Shop")
    local skullMask
    for _, v in pairs(Shop:GetChildren()) do
        if v.Name:lower():find("skull") or v.Name:lower():find("mask") then skullMask = v break end
    end
    if not skullMask then return end
    local head = skullMask:FindFirstChild("Head") or skullMask:FindFirstChildWhichIsA("BasePart")
    local cd = skullMask:FindFirstChildOfClass("ClickDetector")
    if not head or not cd then return end

    buyItemWithDesync4(head, cd, 1)

    local attempts = 0
    repeat task.wait(0.2) attempts = attempts + 1
    until LocalPlayer.Backpack:FindFirstChild("[Mask]") or (char and char:FindFirstChild("[Mask]")) or attempts > 25

    local mask = LocalPlayer.Backpack:FindFirstChild("[Mask]") or char:FindFirstChild("[Mask]")
    if mask then
        if mask.Parent ~= char then mask.Parent = char end
        task.wait(0.3) mask:Activate()
    end
end})

