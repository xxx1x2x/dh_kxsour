local function updateTeleportPlayerList()
    local values = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(values, player.DisplayName .. ' (@' .. player.Name .. ')')
        end
    end
    table.sort(values)
    if TeleportTargetDropdown and TeleportTargetDropdown.SetValues then
        TeleportTargetDropdown:SetValues(values)
    end
end

Players.PlayerAdded:Connect(function()
    task.delay(0.5, updateTeleportPlayerList)
end)
Players.PlayerRemoving:Connect(function()
    task.delay(0.5, updateTeleportPlayerList)
end)
updateTeleportPlayerList()

teleGroup:AddButton({Text='Teleport to Player', Func=function()
    local selected = Options.PlayerSelect and Options.PlayerSelect.Value
    if not selected or selected == "" then
        Library:Notify('Select a player first!', 2)
        return
    end
    local playerName = selected:match("@([^%s%)]+)") or selected
    local tp = Players:FindFirstChild(playerName)
    if tp and tp.Character and tp.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character then
        LocalPlayer.Character.HumanoidRootPart.CFrame = tp.Character.HumanoidRootPart.CFrame
        Library:Notify('Teleported to ' .. tp.DisplayName, 2)
    else
        Library:Notify('Player not found or no character!', 2)
    end
end})

teleGroup:AddToggle('ViewTargetPlayer', {Text='View Player', Default=false,
    Callback=function(en)
        if not en then
            local lh = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild('Humanoid')
            if lh then workspace.CurrentCamera.CameraSubject = lh end
        end
    end
})

RunService.Heartbeat:Connect(function()
    if not (Toggles.ViewTargetPlayer and Toggles.ViewTargetPlayer.Value) then return end
    local selected = Options.PlayerSelect and Options.PlayerSelect.Value
    if not selected or selected == "" then return end
    local playerName = selected:match("@([^%s%)]+)") or selected
    local tp = Players:FindFirstChild(playerName)
    if tp and tp.Character then
        local hum = tp.Character:FindFirstChild('Humanoid')
        if hum then workspace.CurrentCamera.CameraSubject = hum end
    end
end)

