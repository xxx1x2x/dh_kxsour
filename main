            pcall(function() rbStatusLabel.Text = RB.active and (txt or "") or "" end)
        end

        RB.sendChat = function(msg)
            if not msg or msg == "" then return end
            pcall(function()
                local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
                if chatEvents and chatEvents:FindFirstChild("SayMessageRequest") then
                    chatEvents.SayMessageRequest:FireServer(msg, "All")
                end
            end)
            pcall(function()
                local tcs = game:GetService("TextChatService")
                if tcs and tcs.ChatVersion == Enum.ChatVersion.TextChatService then
                    local gen = tcs:FindFirstChild("TextChannels", true) and tcs.TextChannels:FindFirstChild("RBXGeneral")
                    if gen then gen:SendAsync(msg) end
                end
            end)
        end

