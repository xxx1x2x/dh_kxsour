                            local phone = LocalPlayer.Backpack:FindFirstChild("[Phone]")
                            if phone then
                                phone.Parent = LocalPlayer.Character
                                task.wait(0.2)
                                ReplicatedStorage.MainEvent:FireServer("PhoneCall", plr.Name)
                            else
                                warn("Phone not found in backpack")
                                break
                            end
                        end
                    end
                    task.wait(0.5)
                end
            end)
        end
    end
})

getgenv().AutoUnjailActive = false
local UnjailRunning = false

local function getObjectPosition(obj)
    if obj.PrimaryPart then return obj.PrimaryPart.Position end
    local part = obj:FindFirstChild("Cabeza") or obj:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position
end

local function findKeyObjectNear(fromPosition, maxDist)
    maxDist = maxDist or 20
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:FindFirstChild("Price") and obj:FindFirstChildOfClass("ClickDetector") then
            if obj.Name:lower():find("key") then
                local pos = getObjectPosition(obj)
                if pos and (pos - fromPosition).Magnitude <= maxDist then
                    return obj
                end
            end
        end
    end
    return nil
end

local function fireBuyDetector(detector)
    local ok = pcall(function()
        fireclickdetector(detector, 0, "MouseClick")
    end)
    if not ok then
        pcall(function() fireclickdetector(detector) end)
    end
end

local function DoUnjail()
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end

    local isJailed = false
    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
        if track.Animation.AnimationId:match("rbxassetid://3144026747") then
            isJailed = true
            break
        end
    end
    if not isJailed then return false end

    local keyShopPos = CFrame.new(-270.7900390625, 18.849632263183594, -238.81988525390625)
    hrp.CFrame = keyShopPos
    hrp.Velocity = Vector3.new(0, 0, 0)
    task.wait(0.5)

    local keyObj
    for attempt = 1, 15 do
        keyObj = findKeyObjectNear(hrp.Position, 20)
        if keyObj then break end
        task.wait(0.2)
    end
    if not keyObj then
        warn("Key object not found near fixed position")
        return false
    end

    local detector = keyObj:FindFirstChildOfClass("ClickDetector")
    if not detector then
        warn("ClickDetector not found inside [Key] object")
        return false
    end

    for i = 1, 5 do
        fireBuyDetector(detector)
        task.wait(0.3)
        if LocalPlayer.Backpack:FindFirstChild("[Key]") then break end
    end

    local key = nil
    for _ = 1, 30 do
        key = LocalPlayer.Backpack:FindFirstChild("[Key]")
        if key then break end
        task.wait(0.1)
    end
    if not key then
        warn("Key not found in backpack")
        return false
    end

    key.Parent = char
    task.wait(0.5)
    pcall(function() key:Activate() end)
    task.wait(0.5)

    hrp.CFrame = CFrame.new(-319.2906494140625, 80.41372680664063, -210.28460693359375)
    return true
end

MiscGroup:AddToggle("AutoUnjailToggle", {
    Text = "Auto Unjail",
    Default = false,
    Callback = function(state)
        getgenv().AutoUnjailActive = state
        if not state then UnjailRunning = false end
    end
})

RunService.Stepped:Connect(function()
    if not getgenv().AutoUnjailActive then
        UnjailRunning = false
        return
    end
    if UnjailRunning then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local isJailed = false
    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
        if track.Animation.AnimationId:match("rbxassetid://3144026747") then
            isJailed = true
            break
        end
    end

    if isJailed then
        UnjailRunning = true
        task.spawn(function()
            pcall(function()
                DoUnjail()
            end)
            UnjailRunning = false
        end)
    end
end)

