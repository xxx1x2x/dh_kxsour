local GunHandler, OriginalGetAim, OriginalGetCanShoot
pcall(function()
    local modules = ReplicatedStorage:FindFirstChild("Modules") or ReplicatedStorage
    GunHandler = require(modules:FindFirstChild("GunHandler") or modules:FindFirstChild("Framework"))
    OriginalGetAim = GunHandler and GunHandler.getAim
    OriginalGetCanShoot = GunHandler and GunHandler.getCanShoot
end)

pcall(function()
    if GunHandler then
        local origCanShoot = OriginalGetCanShoot or GunHandler.getCanShoot
        if type(origCanShoot) == "function" then
            GunHandler.getCanShoot = function(c, ...)
                if Toggles and Toggles.EnableRapidFire and Toggles.EnableRapidFire.Value then
                    return true
                end
                return origCanShoot(c, ...)
            end
        end
    end
end)

local function GetFOVOrigin()
    if SilentAimSettings.FOVMode == "Mouse" or SilentAimSettings.FOVMode == "mouse" then
        return UserInputService:GetMouseLocation()
    else
        return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    end
end

local function GetNearestPlayerSilent()
    local strafeActive = Toggles and Toggles.TargetStrafeToggle and Toggles.TargetStrafeToggle.Value
    local lockActive = Toggles and Toggles.TargetLockToggle and Toggles.TargetLockToggle.Value

    if strafeActive or lockActive then
        local activeStrafePlr = (strafeActive and strafeTargetPlayer) or (lockActive and lockTargetPlayer) or getSelectedTarget()
        if activeStrafePlr and activeStrafePlr.Character then
            local targetPartName = (SilentAimSettings and SilentAimSettings.TargetPart) or "Head"
            local targetPart = activeStrafePlr.Character:FindFirstChild(targetPartName) or activeStrafePlr.Character:FindFirstChild("HumanoidRootPart") or activeStrafePlr.Character:FindFirstChild("Head")
            local hum = activeStrafePlr.Character:FindFirstChildOfClass("Humanoid")
            if targetPart and hum and hum.Health > 0 then
                local be = activeStrafePlr.Character:FindFirstChild("BodyEffects")
                local isKO = be and (
                    (be:FindFirstChild("K.O") and be["K.O"].Value == true) or
                    (be:FindFirstChild("KO") and be.KO.Value == true) or
                    (be:FindFirstChild("SDeath") and be.SDeath.Value == true) or
                    (be:FindFirstChild("Dead") and be.Dead.Value == true)
                )
                if not (SilentAimSettings and SilentAimSettings.KOCheck and isKO) then
                    return targetPart
                end
            end
        end
        return nil
    end

    local best, target = math.huge, nil
    local origin = GetFOVOrigin()
    local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localHrp then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local targetPartName = SilentAimSettings.TargetPart
            local targetPart = plr.Character:FindFirstChild(targetPartName)
            if targetPartName == "Legs" then
                targetPart = plr.Character:FindFirstChild("LeftLowerLeg") or plr.Character:FindFirstChild("RightLowerLeg") or hrp
            end
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")

            if hrp and targetPart and hum and hum.Health > 0 then
                local dist = (hrp.Position - localHrp.Position).Magnitude
                if dist <= SilentAimSettings.MaxDistance then
                    local be = plr.Character:FindFirstChild("BodyEffects")
                    local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
                    local isSD = be and be:FindFirstChild("SDeath") and be["SDeath"].Value
                    if not (SilentAimSettings.KOCheck and (isKO or isSD)) then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local fovDist = (Vector2.new(screenPos.X, screenPos.Y) - origin).Magnitude
                            if fovDist <= SilentAimSettings.FOV and fovDist < best then
                                if SilentAimSettings.WallCheck then
                                    local rayOrigin = Camera.CFrame.Position
                                    local rayDir = targetPart.Position - rayOrigin
                                    local rayParams = RaycastParams.new()
                                    rayParams.FilterType = Enum.RaycastFilterType.Exclude
                                    local ignoreList = {LocalPlayer.Character, plr.Character, Camera}
                                    if workspace:FindFirstChild("Ignored") then table.insert(ignoreList, workspace.Ignored) end
                                    rayParams.FilterDescendantsInstances = ignoreList
                                    local hitResult = workspace:Raycast(rayOrigin, rayDir, rayParams)
                                    if not hitResult then
                                        best = fovDist
                                        target = targetPart
                                    end
                                else
                                    best = fovDist
                                    target = targetPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return target
end

local function GetNearestPlayerTracer()
    local strafeActive = Toggles and Toggles.TargetStrafeToggle and Toggles.TargetStrafeToggle.Value
    local lockActive = Toggles and Toggles.TargetLockToggle and Toggles.TargetLockToggle.Value

    if strafeActive or lockActive then
        local activeStrafePlr = (strafeActive and strafeTargetPlayer) or (lockActive and lockTargetPlayer) or getSelectedTarget()
        if activeStrafePlr and activeStrafePlr.Character then
            local targetPartName = (SilentAimSettings and SilentAimSettings.TargetPart) or "Head"
            local targetPart = activeStrafePlr.Character:FindFirstChild(targetPartName) or activeStrafePlr.Character:FindFirstChild("HumanoidRootPart") or activeStrafePlr.Character:FindFirstChild("Head")
            local hum = activeStrafePlr.Character:FindFirstChildOfClass("Humanoid")
            if targetPart and hum and hum.Health > 0 then
                local be = activeStrafePlr.Character:FindFirstChild("BodyEffects")
                local isKO = be and (
                    (be:FindFirstChild("K.O") and be["K.O"].Value == true) or
                    (be:FindFirstChild("KO") and be.KO.Value == true) or
                    (be:FindFirstChild("SDeath") and be.SDeath.Value == true) or
                    (be:FindFirstChild("Dead") and be.Dead.Value == true)
                )
                if not (SilentAimSettings and SilentAimSettings.KOCheck and isKO) then
                    return targetPart
                end
            end
        end
        return nil
    end

    local best, target = math.huge, nil
    local origin = GetFOVOrigin()
    local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localHrp then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local targetPartName = SilentAimSettings.TargetPart
            local targetPart = plr.Character:FindFirstChild(targetPartName)
            if targetPartName == "Legs" then
                targetPart = plr.Character:FindFirstChild("LeftLowerLeg") or plr.Character:FindFirstChild("RightLowerLeg") or hrp
            end
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")

            if hrp and targetPart and hum and hum.Health > 0 then
                local dist = (hrp.Position - localHrp.Position).Magnitude
                if dist <= SilentAimSettings.MaxDistance then
                    local be = plr.Character:FindFirstChild("BodyEffects")
                    local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
                    local isSD = be and be:FindFirstChild("SDeath") and be["SDeath"].Value
                    if not (SilentAimSettings.KOCheck and (isKO or isSD)) then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local fovDist = (Vector2.new(screenPos.X, screenPos.Y) - origin).Magnitude
                            if fovDist <= SilentAimSettings.FOV and fovDist < best then
                                best = fovDist
                                target = targetPart
                            end
                        end
                    end
                end
            end
        end
    end
    return target
end

local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5
FOVCircle.NumSides = 64
FOVCircle.Filled = false
FOVCircle.Transparency = 1
FOVCircle.Color = SilentAimSettings.FOVColor

local SilentTracer = Drawing.new("Line")
SilentTracer.Thickness = 1.5
SilentTracer.Transparency = 1
SilentTracer.Color = Color3.fromRGB(255, 255, 255)
SilentTracer.Visible = false

local wasSilentFovVisible = false
RunService.RenderStepped:Connect(function()
    if SilentAimSettings.ShowFOV then
        wasSilentFovVisible = true
        local origin = GetFOVOrigin()
        FOVCircle.Position = origin
        FOVCircle.Radius = SilentAimSettings.FOV
        FOVCircle.Color = SilentAimSettings.FOVColor
        FOVCircle.Visible = true
    else
        if wasSilentFovVisible then
            wasSilentFovVisible = false
            FOVCircle.Visible = false
        end
    end

    if SilentAimSettings.Enabled and Toggles.SilentTracer and Toggles.SilentTracer.Value then
        local tracerTarget = GetNearestPlayerTracer()
        if tracerTarget then
            local screenPos, onScreen = Camera:WorldToViewportPoint(tracerTarget.Position)
            if onScreen then
                local origin = GetFOVOrigin()
                SilentTracer.From = origin
                SilentTracer.To = Vector2.new(screenPos.X, screenPos.Y)
                SilentTracer.Visible = true
            else
                SilentTracer.Visible = false
            end
        else
            SilentTracer.Visible = false
        end
    else
        SilentTracer.Visible = false
    end
end)

local dotPart = nil
local currentDotTarget = nil
local dotEnabledState = false
local lastDotToggleTime = 0
local isLockActive = false
local lockedTargetPlayer = nil
local wasTargetAvailable = false

local function getClosestPlayerToCursorDot()
    local closestPlayer = nil
    local bestScore = math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local origin = GetFOVOrigin()

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            local root = v.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local be = v.Character:FindFirstChild("BodyEffects")
                local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
                local isSD = be and be:FindFirstChild("SDeath") and be["SDeath"].Value
                if not (isKO or isSD) then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - origin).Magnitude
                        if mouseDist <= (SilentAimSettings.FOV or 500) then
                            local worldDist = (root.Position - myRoot.Position).Magnitude
                            local score = worldDist + (mouseDist * 0.5)
                            if score < bestScore then
                                bestScore = score
                                closestPlayer = v
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function cleanupDotTarget()
    if dotPart then
        dotPart.CFrame = CFrame.new(0, 9999, 0)
    end
    currentDotTarget = nil
    dotEnabledState = false
end

local function ensureDotPartExists()
    local dotColor = Options.DotTargetColor and Options.DotTargetColor.Value or Color3.fromRGB(255, 30, 30)
    if not dotPart or not dotPart.Parent then
        local part = Instance.new("Part")
        part.Name = "DotTargetMarkerPart"
        part.Anchored = true
        part.CanCollide = false
        part.Size = Vector3.new(0.1, 0.1, 0.1)
        part.Transparency = 1
        part.CFrame = CFrame.new(0, 9999, 0)
        part.Parent = workspace

        local bgui = Instance.new("BillboardGui")
        bgui.Name = "PP"
        bgui.Adornee = part
        bgui.Size = UDim2.new(0, 16, 0, 16)
        bgui.AlwaysOnTop = true
        bgui.LightInfluence = 0
        bgui.Parent = part

        local frame = Instance.new("Frame", bgui)
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundTransparency = 0
        frame.BackgroundColor3 = dotColor
        frame.BorderSizePixel = 0

        local corner = Instance.new("UICorner", frame)
        corner.CornerRadius = UDim.new(1, 0)

        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = Color3.fromRGB(0, 0, 0)
        stroke.Thickness = 1.5

        dotPart = part
    else
        if dotPart:FindFirstChild("PP") and dotPart.PP:FindFirstChildOfClass("Frame") then
            dotPart.PP:FindFirstChildOfClass("Frame").BackgroundColor3 = dotColor
        end
    end
end

local function lockOnTarget(plr)
    if not plr or not plr.Parent then return end
    lockedTargetPlayer = plr
    isLockActive = true
    currentDotTarget = plr
    dotEnabledState = true
    ensureDotPartExists()
    if Toggles.EnableSilent and not Toggles.EnableSilent.Value then
        Toggles.EnableSilent:SetValue(true)
    end
    if Toggles.DotTargetEnable and not Toggles.DotTargetEnable.Value then
        Toggles.DotTargetEnable:SetValue(true)
    end
    wasTargetAvailable = true
    Library:Notify("Locked Silent Dot on: " .. (plr.DisplayName or plr.Name), 3)
end

local function unlockTarget()
    local oldName = lockedTargetPlayer and (lockedTargetPlayer.DisplayName or lockedTargetPlayer.Name)
    lockedTargetPlayer = nil
    isLockActive = false
    wasTargetAvailable = false
    cleanupDotTarget()
    if oldName then
        Library:Notify("Unlocked Target Dot from: " .. oldName, 3)
    else
        Library:Notify("Unlocked Target Dot", 2)
    end
end

local function toggleDotLock()
    if tick() - lastDotToggleTime < 0.25 then return end
    lastDotToggleTime = tick()

    if not Toggles.DotTargetEnable or not Toggles.DotTargetEnable.Value then return end
    if not SilentAimSettings.Enabled then
        Library:Notify("Dot Target: Enable Silent Aim first!", 2)
        return
    end

    if dotEnabledState then
        cleanupDotTarget()
        Library:Notify("Dot Target: Unlocked", 2)
    else
        local targetPlr = getClosestPlayerToCursorDot()
        if targetPlr and targetPlr.Character then
            ensureDotPartExists()
            currentDotTarget = targetPlr
            dotEnabledState = true
            Library:Notify("Dot Target Locked: " .. (targetPlr.DisplayName or targetPlr.Name), 2)
        else
            Library:Notify("Dot Target: No target near cursor!", 2)
        end
    end
end

local function applyGunHandlerHook()
    if not GunHandler or not OriginalGetAim then return end
    GunHandler.getAim = function(origin, range)
        if SilentAimSettings.Enabled then
            local aimPos = nil
            local TLD = _G.TargetLockDot
            if TLD and TLD.isActive and TLD.part and TLD.part.Parent and TLD.lockedPlr then
                aimPos = TLD.part.Position
            elseif dotEnabledState and dotPart and dotPart.Parent and currentDotTarget then
                aimPos = dotPart.Position
            else
                local target = GetNearestPlayerSilent()
                if target and target.Parent then
                    aimPos = target.Position
                end
            end
            if aimPos then
                local dir = aimPos - origin
                if dir.Magnitude > 0.001 then
                    return dir.Unit, range
                end
            end
        end
        local ok, a, b = pcall(OriginalGetAim, origin, range)
        if ok and a then return a, b end
        return Camera.CFrame.LookVector, range
    end
end

local function removeGunHandlerHook()
    if GunHandler and OriginalGetAim then
        GunHandler.getAim = OriginalGetAim
    end
end

local SilentGroup = Tabs.main:AddRightGroupbox("Silent Aim")
SilentGroup:AddToggle("EnableSilent",  {Text="Enable Silent Aim", Default=false}):AddKeyPicker("EnableSilentKey", {Default="None", SyncToggleState=true, Mode="Toggle", Text="Silent Aim Key", NoUI=false})
SilentGroup:AddToggle("SilentTracer",  {Text="Tracer",            Default=false})
SilentGroup:AddToggle("SilentKOCheck", {Text="K.O Check", Default=false})
SilentGroup:AddToggle("SilentWallCheck", {Text="Wall Check", Default=false})
SilentGroup:AddDropdown("SilentFOVMode", {Values={"Mouse", "Center"}, Default=1, Multi=false, Text="FOV Position"})
SilentGroup:AddSlider("SilentMaxDistance", {Text="Max Distance", Default=500, Min=50, Max=2000, Rounding=0})
SilentGroup:AddDropdown("SilentTargetPart", {Values={"Head","HumanoidRootPart","UpperTorso","LowerTorso"}, Default=1, Multi=false, Text="Target Part"})
SilentGroup:AddLabel("Tracer Color"):AddColorPicker("SilentTracerColor",{Default=Color3.fromRGB(255,255,255),Title="Tracer Color",Transparency=0})
SilentGroup:AddDivider()
SilentGroup:AddToggle("SilentShowFOV", {Text="Show FOV Circle", Default=false})
SilentGroup:AddSlider("SilentFOVSize", {Text="FOV Size", Default=150, Min=20, Max=1000, Rounding=0})
SilentGroup:AddLabel("FOV Color"):AddColorPicker("SilentFOVColor",{Default=Color3.fromRGB(255,255,255),Title="FOV Color",Transparency=0})

Toggles.EnableSilent:OnChanged(function()
    SilentAimSettings.Enabled = Toggles.EnableSilent.Value
    if SilentAimSettings.Enabled then applyGunHandlerHook() else removeGunHandlerHook() end
end)
Toggles.SilentKOCheck:OnChanged(function() SilentAimSettings.KOCheck = Toggles.SilentKOCheck.Value end)
Toggles.SilentWallCheck:OnChanged(function() SilentAimSettings.WallCheck = Toggles.SilentWallCheck.Value end)
Options.SilentFOVMode:OnChanged(function() SilentAimSettings.FOVMode = Options.SilentFOVMode.Value end)
Options.SilentMaxDistance:OnChanged(function() SilentAimSettings.MaxDistance = Options.SilentMaxDistance.Value end)
Options.SilentTargetPart:OnChanged(function() SilentAimSettings.TargetPart = Options.SilentTargetPart.Value end)
Options.SilentTracerColor:OnChanged(function() SilentTracer.Color = Options.SilentTracerColor.Value end)
Toggles.SilentShowFOV:OnChanged(function() SilentAimSettings.ShowFOV = Toggles.SilentShowFOV.Value end)
Options.SilentFOVSize:OnChanged(function() SilentAimSettings.FOV = Options.SilentFOVSize.Value end)
Options.SilentFOVColor:OnChanged(function() SilentAimSettings.FOVColor = Options.SilentFOVColor.Value end)

SilentGroup:AddToggle('DotTargetEnable', {Text='Dot Target', Default=false})
    :AddKeyPicker('DotTargetKey', {Default='Q', Mode='Toggle', Text='Dot Key', SyncToggleState=false, NoUI=false})
SilentGroup:AddLabel('Dot Color'):AddColorPicker('DotTargetColor', {Default=Color3.fromRGB(255,255,255), Title='Dot Color', Transparency=0})

Toggles.DotTargetEnable:OnChanged(function()
    if not Toggles.DotTargetEnable.Value then
        cleanupDotTarget()
    end
end)

Options.DotTargetColor:OnChanged(function()
    if dotPart and dotPart:FindFirstChild("PP") and dotPart.PP:FindFirstChildOfClass("Frame") then
        dotPart.PP:FindFirstChildOfClass("Frame").BackgroundColor3 = Options.DotTargetColor.Value
    end
end)

if Options.DotTargetKey and Options.DotTargetKey.OnClick then
    Options.DotTargetKey:OnClick(toggleDotLock)
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if Toggles.DotTargetEnable and Toggles.DotTargetEnable.Value then
        local dotKey = Options.DotTargetKey and Options.DotTargetKey.Value
        if dotKey and input.KeyCode == dotKey then
            toggleDotLock()
        end
    end
end)

local TargetStrafeGroup = Tabs.main:AddRightGroupbox('Target Strafe')

local targetStrafeSettings = { Enabled = false, Speed = 1.5, Distance = 8, Height = 4 }
local orbitAngle = 0
local strafeConn = nil

TargetStrafeGroup:AddToggle('TargetStrafeToggle', {Text = 'Target Strafe', Default = false})
    :AddKeyPicker('TargetStrafeKeybind', {Default = 'None', SyncToggleState = true, Mode = 'Toggle', Text = 'Target Strafe', NoUI = false})

TargetStrafeGroup:AddSlider('TargetStrafeSpeed', {Text = 'Strafe Speed', Default = 1.5, Min = 0.1, Max = 20, Rounding = 1, Suffix = 'x'})
TargetStrafeGroup:AddSlider('TargetStrafeDistance', {Text = 'Strafe Distance', Default = 8, Min = 1, Max = 50, Rounding = 0, Suffix = ' studs'})
TargetStrafeGroup:AddSlider('TargetStrafeHeight', {Text = 'Strafe Height', Default = 4, Min = 0, Max = 20, Rounding = 0, Suffix = ' studs'})

Options.TargetStrafeSpeed:OnChanged(function() targetStrafeSettings.Speed = Options.TargetStrafeSpeed.Value end)
Options.TargetStrafeDistance:OnChanged(function() targetStrafeSettings.Distance = Options.TargetStrafeDistance.Value end)
Options.TargetStrafeHeight:OnChanged(function() targetStrafeSettings.Height = Options.TargetStrafeHeight.Value end)

local function updateStrafeState()
    targetStrafeSettings.Enabled = Toggles.TargetStrafeToggle.Value
    if strafeConn then strafeConn:Disconnect() strafeConn = nil end
    local TLD = _G.TargetLockDot
    if targetStrafeSettings.Enabled then
        strafeTargetPlayer = findNewStrafeTarget()
        if strafeTargetPlayer then
            Library:Notify("Target Strafe locked onto: " .. (strafeTargetPlayer.DisplayName or strafeTargetPlayer.Name), 3)
        else
            Library:Notify("No target found in camera view", 3)
        end
        strafeConn = RunService.RenderStepped:Connect(function(dt)
            if not targetStrafeSettings.Enabled or getgenv().Flying then return end
            if not strafeTargetPlayer or not strafeTargetPlayer.Character then return end
            local myChar = LocalPlayer.Character
            local root = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local tR = strafeTargetPlayer.Character:FindFirstChild("HumanoidRootPart") or strafeTargetPlayer.Character:FindFirstChild("UpperTorso") or strafeTargetPlayer.Character:FindFirstChild("Head")
            if root and tR then
                orbitAngle = orbitAngle + dt * targetStrafeSettings.Speed * 2 * math.pi
                local rad = targetStrafeSettings.Distance
                local hgt = targetStrafeSettings.Height
                local want = tR.Position + Vector3.new(math.sin(orbitAngle) * rad, hgt, math.cos(orbitAngle) * rad)
                root.CFrame = CFrame.new(want, tR.Position)
            end
        end)
    else
        strafeTargetPlayer = nil
    end
end

Toggles.TargetStrafeToggle:OnChanged(updateStrafeState)

TargetStrafeGroup:AddDivider()

local autoShootSettings = { Enabled = false }
TargetStrafeGroup:AddToggle('TargetAutoShoot', {Text = 'Auto Shoot Target', Default = false})
    :AddKeyPicker('TargetAutoShootKeybind', {Default = 'None', SyncToggleState = true, Mode = 'Toggle', Text = 'Auto Shoot', NoUI = false})

local autoShootConn = nil
local lastAutoShootTick = 0
local function updateAutoShootState()
    autoShootSettings.Enabled = Toggles.TargetAutoShoot.Value
    if autoShootConn then autoShootConn:Disconnect() autoShootConn = nil end
    if autoShootSettings.Enabled then
        autoShootConn = RunService.Heartbeat:Connect(function()
            if not autoShootSettings.Enabled then return end
            local strafeActive = Toggles.TargetStrafeToggle and Toggles.TargetStrafeToggle.Value
            if not strafeActive then return end

            local target = getSelectedTarget()
            if not target or not target.Character then return end

            local hasFF = target.Character:FindFirstChildOfClass("ForceField") or target.Character:FindFirstChild("ForceField")
            if hasFF then return end

            local tH = target.Character:FindFirstChildOfClass("Humanoid")
            if not tH or tH.Health <= 0 or tH.PlatformStand then return end

            local be = target.Character:FindFirstChild("BodyEffects")
            if be then
                local isKO = (be:FindFirstChild("K.O") and be["K.O"].Value == true)
                    or (be:FindFirstChild("KO") and be.KO.Value == true)
                    or (be:FindFirstChild("SDeath") and be.SDeath.Value == true)
                    or (be:FindFirstChild("Dead") and be.Dead.Value == true)
                if isKO then return end
            end

            local myChar = LocalPlayer.Character
            if not myChar then return end

            local aimPart = target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("UpperTorso")
            if not aimPart then return end

            local cam = workspace.CurrentCamera
            if cam then
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = { myChar }
                rayParams.IgnoreWater = true

                local origin = cam.CFrame.Position
                local direction = aimPart.Position - origin
                local result = workspace:Raycast(origin, direction, rayParams)
                if result and not result.Instance:IsDescendantOf(target.Character) then
                    return
                end
            end

            local tool = myChar:FindFirstChildOfClass("Tool")
            if tool then
                local ammo = tool:FindFirstChild("Ammo")
                if not ammo or ammo.Value > 0 then
                    local now = tick()
                    if not lastAutoShootTick or (now - lastAutoShootTick) >= 0.35 then
                        lastAutoShootTick = now
                        tool:Activate()
                    end
                end
            end
        end)
    end
end

Toggles.TargetAutoShoot:OnChanged(updateAutoShootState)

RunService.Heartbeat:Connect(function()
    local TLD = _G.TargetLockDot
    if TLD and TLD.isActive and TLD.lockedPlr and TLD.lockedPlr.Parent then
        local tChar = TLD.lockedPlr.Character
        local targetPartName = "HumanoidRootPart"
        pcall(function()
            if Options and Options.SilentTargetPart then
                targetPartName = Options.SilentTargetPart.Value or "HumanoidRootPart"
            end
        end)
        local part = tChar and (tChar:FindFirstChild(targetPartName) or tChar:FindFirstChild("Head") or tChar:FindFirstChild("HumanoidRootPart"))
        local hum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        local be = tChar and tChar:FindFirstChild("BodyEffects")
        local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
        local isSD = be and be:FindFirstChild("SDeath") and be["SDeath"].Value

        local isValid = part and hum and hum.Health > 0 and not (isKO or isSD)

        if isValid then
            if not TLD.wasAvailable then
                TLD.wasAvailable = true
                Library:Notify("Target Lock Re-engaged: " .. (TLD.lockedPlr.DisplayName or TLD.lockedPlr.Name), 3)
            end
            TLD.ensurePart()
            TLD.part.CFrame = part.CFrame
        else
            if TLD.wasAvailable then
                TLD.wasAvailable = false
                Library:Notify("Target Lock Suspended (Dead/K.O): " .. (TLD.lockedPlr.DisplayName or TLD.lockedPlr.Name), 3)
            end
            if TLD.part then
                TLD.part.CFrame = CFrame.new(0, 9999, 0)
            end
        end
    elseif dotEnabledState and currentDotTarget and currentDotTarget.Character then
        local targetPartName = (SilentAimSettings and SilentAimSettings.TargetPart) or "HumanoidRootPart"
        local part = currentDotTarget.Character:FindFirstChild(targetPartName) or currentDotTarget.Character:FindFirstChild("Head") or currentDotTarget.Character:FindFirstChild("HumanoidRootPart")
        local hum = currentDotTarget.Character:FindFirstChildOfClass("Humanoid")
        local be = currentDotTarget.Character:FindFirstChild("BodyEffects")
        local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
        local isSD = be and be:FindFirstChild("SDeath") and be["SDeath"].Value

        if part and hum and hum.Health > 0 and not (isKO or isSD) then
            ensureDotPartExists()
            dotPart.CFrame = part.CFrame
        else
            cleanupDotTarget()
        end
    else
        if TLD and TLD.part then
            TLD.part.CFrame = CFrame.new(0, 9999, 0)
        end
        if dotPart then
            dotPart.CFrame = CFrame.new(0, 9999, 0)
        end
    end
end)
end

local HitboxSettings = {
    Enabled = false,
    Size = 15,
    Color = Color3.fromRGB(255, 255, 255),
    Transparency = 0.5,
}

local HitboxOriginal = {}
local HitboxVisuals = {}

local function hbIsPlayerKO(Player)
    if not Player or not Player.Character then return true end
    local hum = Player.Character:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return true end
    local be = Player.Character:FindFirstChild("BodyEffects")
    local ko = be and (be:FindFirstChild("K.O") or be:FindFirstChild("KO"))
    return ko and ko.Value == true or false
end

local function applyToHRP(HRP)
    if not HitboxOriginal[HRP] then
        HitboxOriginal[HRP] = {
            Size = HRP.Size,
            CanCollide = HRP.CanCollide
        }
    end

    local targetSize = Vector3.new(HitboxSettings.Size, HitboxSettings.Size, HitboxSettings.Size)
    if HRP.Size ~= targetSize then
        HRP.Size = targetSize
    end
    if HRP.CanCollide then
        HRP.CanCollide = false
    end

    if not HitboxVisuals[HRP] or not HitboxVisuals[HRP].Parent then
        local sphere = Instance.new("Part")
        sphere.Name = "HitboxVisualizer"
        sphere.Material = Enum.Material.ForceField
        sphere.Color = HitboxSettings.Color
        sphere.Transparency = HitboxSettings.Transparency
        sphere.Size = targetSize
        sphere.CFrame = HRP.CFrame
        sphere.Anchored = false
        sphere.CanCollide = false
        sphere.Massless = true
        sphere.Parent = workspace

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = sphere
        weld.Part1 = HRP
        weld.Parent = sphere

        HitboxVisuals[HRP] = sphere
    else
        local vis = HitboxVisuals[HRP]
        if vis.Color ~= HitboxSettings.Color then vis.Color = HitboxSettings.Color end
        if vis.Transparency ~= HitboxSettings.Transparency then vis.Transparency = HitboxSettings.Transparency end
        if vis.Size ~= targetSize then vis.Size = targetSize end
    end
end

local function revertHRP(HRP)
    local data = HitboxOriginal[HRP]
    if data then
        if HRP and HRP.Parent then
            HRP.Size = data.Size
            HRP.CanCollide = data.CanCollide
        end
        HitboxOriginal[HRP] = nil
    end

    if HitboxVisuals[HRP] then
        pcall(function() HitboxVisuals[HRP]:Destroy() end)
        HitboxVisuals[HRP] = nil
    end
end

RunService.RenderStepped:Connect(function()
    if not HitboxSettings.Enabled then
        if next(HitboxOriginal) ~= nil or next(HitboxVisuals) ~= nil then
            for HRP, _ in pairs(HitboxOriginal) do
                revertHRP(HRP)
            end
            for HRP, _ in pairs(HitboxVisuals) do
                revertHRP(HRP)
            end
        end
        return
    end

    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            local char = Player.Character
            local HRP = char and char:FindFirstChild("HumanoidRootPart")
            if HRP then
                if not hbIsPlayerKO(Player) then
                    applyToHRP(HRP)
                else
                    revertHRP(HRP)
                end
            end
        end
    end
end)



