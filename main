            Text = 'Targets',
            Tooltip = 'Select players to target with ragebot',
            Callback = function() end
        })
        
        Options.ragebottargets:OnChanged(function()
            RB.targets = {}
            local val = Options.ragebottargets.Value
            if type(val) == "table" then
                for k, v in pairs(val) do
                    local entry = nil
                    if type(k) == "number" and type(v) == "string" then
                        entry = v
                    elseif type(k) == "string" and v == true then
                        entry = k
                    end
                    if entry then
                        local cleanName = entry:match("@([^%s%)]+)") or entry
                        local p = Players:FindFirstChild(cleanName)
                        if p then table.insert(RB.targets, p) end
                    end
                end
            end
            RB.lockedTarget = nil
            _G.rb_lockedTargetUserId = nil
            _G.rb_currentTargetIndex = 0
            _G.rb_shouldSwitch = true
        end)
        
        RB.updatePlayerList = function()
            local values = {}
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    table.insert(values, player.DisplayName .. ' (@' .. player.Name .. ')')
                end
            end
            table.sort(values)
            if RB.TargetDropdown and RB.TargetDropdown.SetValues then
                RB.TargetDropdown:SetValues(values)
            end
        end
        
        Players.PlayerAdded:Connect(function()
            task.delay(0.5, RB.updatePlayerList)
        end)
        Players.PlayerRemoving:Connect(function()
            task.delay(0.5, RB.updatePlayerList)
        end)
        RB.updatePlayerList()
        
        RB.targetsDepBox:SetupDependencies({{Toggles.selecttargets,true}})
        
        RB.GroupBox:AddLabel('Select Target Keybind'):AddKeyPicker('ragebottargetkey',{Default='',Text='Select Target',
            Callback=function()
                if not (Toggles.selecttargets and Toggles.selecttargets.Value and Toggles.ragebotenabled and Toggles.ragebotenabled.Value) then return end
                if UserInputService:GetFocusedTextBox() then return end
                local mouse = UserInputService:GetMouseLocation()
                local closest, closestPlr = math.huge, nil
                for _, player in ipairs(Players:GetPlayers()) do
                    if player~=LocalPlayer and player.Character then
                        local hrp = player.Character:FindFirstChild('HumanoidRootPart')
                        local hum = player.Character:FindFirstChild('Humanoid')
                        if hrp and hum and hum.Health>0 then
                            local sp, on = workspace.CurrentCamera:WorldToViewportPoint(hrp.Position)
                            if on then
                                local d = (Vector2.new(sp.X,sp.Y)-mouse).Magnitude
                                if d<closest then closest=d closestPlr=player end
                            end
                        end
                    end
                end
                if not closestPlr then return end
                local cur = Options.ragebottargets.Value or {}
                local new = {}
                if type(cur) == "table" then
                    for k, v in pairs(cur) do
                        if type(k) == "string" then
                            new[k] = v
                        elseif type(k) == "number" and type(v) == "string" then
                            new[v] = true
                        end
                    end
                end
                local key = closestPlr.DisplayName .. ' (@' .. closestPlr.Name .. ')'
                if new[key] then
                    new[key] = nil
                    RB.lockedTarget = nil
                    _G.rb_lockedTargetUserId = nil
                    _G.rb_shouldSwitch = true
                else
                    new[key] = true
                    RB.lockedTarget = closestPlr
                    _G.rb_lockedTargetUserId = closestPlr.UserId
                    _G.rb_shouldSwitch = false
                end
                Options.ragebottargets:SetValue(new)
            end
        })
    end

