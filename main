local function buyArmorFunc()
    pcall(function()
        scanShop()
        local a = all_items["High-Medium Armor"] or all_items["Medium Armor"] or all_items["MediumArmor"]
        if a and a.main then
            local cd = a.main.Parent:FindFirstChildOfClass("ClickDetector") or a.main.Parent:FindFirstChildWhichIsA("ClickDetector")
            if cd then
                buyItemWithDesync4(a.main, cd, 1)
            end
        else
            local shop = workspace:FindFirstChild("Ignored") and workspace.Ignored:FindFirstChild("Shop")
            if shop then
                for _, item in ipairs(shop:GetChildren()) do
                    if item.Name:lower():find("armor") and not item.Name:lower():find("fire") then
                        local head = item:FindFirstChild("Head") or item:FindFirstChildWhichIsA("BasePart")
                        local cd = item:FindFirstChildOfClass("ClickDetector") or item:FindFirstChildWhichIsA("ClickDetector")
                        if head and cd then
                            buyItemWithDesync4(head, cd, 1)
                            break
                        end
                    end
                end
            end
        end
    end)
end

local function buyFireArmorFunc()
    pcall(function()
        scanShop()
        local fa = all_items["Fire Armor"] or all_items["FireArmor"] or all_items["firearmor"]
        if fa and fa.main then
            local cd = fa.main.Parent:FindFirstChildOfClass("ClickDetector") or fa.main.Parent:FindFirstChildWhichIsA("ClickDetector")
            if cd then
                buyItemWithDesync4(fa.main, cd, 1)
            end
        else
            local shop = workspace:FindFirstChild("Ignored") and workspace.Ignored:FindFirstChild("Shop")
            if shop then
                for _, item in ipairs(shop:GetChildren()) do
                    if item.Name:lower():find("fire") and item.Name:lower():find("armor") then
                        local head = item:FindFirstChild("Head") or item:FindFirstChildWhichIsA("BasePart")
                        local cd = item:FindFirstChildOfClass("ClickDetector") or item:FindFirstChildWhichIsA("ClickDetector")
                        if head and cd then
                            buyItemWithDesync4(head, cd, 1)
                            break
                        end
                    end
                end
            end
        end
    end)
end

AutoBuyGroup:AddToggle('AutoArmor', {Text='Auto Armor', Default=false})
AutoBuyGroup:AddSlider('ArmorThreshold', {Text='Armor Threshold', Default=50, Min=1, Max=100, Rounding=0, Suffix='%'})

AutoBuyGroup:AddToggle('AutoFireArmor', {Text='Auto Fire Armor', Default=false})
AutoBuyGroup:AddSlider('FireArmorThreshold', {Text='Fire Armor Threshold', Default=50, Min=1, Max=100, Rounding=0, Suffix='%'})

local function checkArmorStatus()
    local char = LocalPlayer.Character
    if not char then return end
    local bodyEffects = char:FindFirstChild("BodyEffects")
    if not bodyEffects then return end

    if Toggles.AutoArmor and Toggles.AutoArmor.Value then
        local armor = bodyEffects:FindFirstChild("Armor")
        local thresh = Options.ArmorThreshold and Options.ArmorThreshold.Value or 50
        if armor and (armor.Value / 130) < (thresh / 100) then
            buyArmorFunc()
        end
    end

    if Toggles.AutoFireArmor and Toggles.AutoFireArmor.Value then
        local fireArmor = bodyEffects:FindFirstChild("FireArmor")
        local thresh = Options.FireArmorThreshold and Options.FireArmorThreshold.Value or 50
        if fireArmor and (fireArmor.Value / 130) < (thresh / 100) then
            buyFireArmorFunc()
        end
    end
end

Toggles.AutoArmor:OnChanged(function()
    if Toggles.AutoArmor.Value then checkArmorStatus() end
end)
Toggles.AutoFireArmor:OnChanged(function()
    if Toggles.AutoFireArmor.Value then checkArmorStatus() end
end)

local function setupAutoArmor(char)
    if not char then return end
    local bodyEffects = char:WaitForChild("BodyEffects", 120)
    if not bodyEffects then return end

    local armor = bodyEffects:WaitForChild("Armor", 120)
    local fireArmor = bodyEffects:WaitForChild("FireArmor", 120)

    if armor then
        armor:GetPropertyChangedSignal("Value"):Connect(function()
            if Toggles.AutoArmor and Toggles.AutoArmor.Value then
                local thresh = Options.ArmorThreshold and Options.ArmorThreshold.Value or 50
                if (armor.Value / 130) < (thresh / 100) then
                    buyArmorFunc()
                end
            end
        end)
    end

    if fireArmor then
        fireArmor:GetPropertyChangedSignal("Value"):Connect(function()
            if Toggles.AutoFireArmor and Toggles.AutoFireArmor.Value then
                local thresh = Options.FireArmorThreshold and Options.FireArmorThreshold.Value or 50
                if (fireArmor.Value / 130) < (thresh / 100) then
                    buyFireArmorFunc()
                end
            end
        end)
    end
end

if LocalPlayer.Character then
    task.spawn(setupAutoArmor, LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(function(char)
    task.spawn(setupAutoArmor, char)
end)

local GunModsGroup = Tabs.main:AddLeftGroupbox('Gun Mods')

GunModsGroup:AddToggle('EnableRapidFire', {Text='Enable Rapid Fire', Default=false})
GunModsGroup:AddSlider('RapidFireDelay', {Text='Rapid Fire Delay', Default=0.08, Min=0.001, Max=0.5, Rounding=3})

local State_RF = {
    rapidFireHooks = {},
    rapidFireChildConns = {},
    isHolding = false
}
local Refs_RF = {
    rapidFireLoopRunning = false,
    rapidFireLoopThread = nil
}

local function hookToolForRapidFire(tool)
    if not tool or not tool:IsA("Tool") then return end
    local getconnections = getconnections or (debug and debug.getconnections)
    local getinfo = debug.getinfo or (debug and debug.getinfo)
    local getupvalue = debug.getupvalue or (debug and debug.getupvalue)
    local setupvalue = debug.setupvalue or (debug and debug.setupvalue)

    local cd = tool:FindFirstChild("Cooldown") or tool:FindFirstChild("FireRate")
    if cd and cd:IsA("NumberValue") then
        pcall(function() cd.Value = 0 end)
    end

    if not getconnections or not getinfo or not getupvalue or not setupvalue then return end

    pcall(function()
        local conns = getconnections(tool.Activated)
        if not conns or #conns == 0 then
            conns = getconnections(tool.Equipped)
        end
        if not conns then return end

        for _, conn in ipairs(conns) do
            if conn and conn.Function then
                local info = getinfo(conn.Function, "u")
                if info then
                    for i = 1, info.nups do
                        local v = getupvalue(conn.Function, i)
                        if type(v) == "number" then
                            table.insert(State_RF.rapidFireHooks, {conn = conn, fn = conn.Function, index = i, original = v})
                            setupvalue(conn.Function, i, 0)
                        end
                    end
                end
            end
        end
    end)
end

local function startRapidFireLoop()
    if Refs_RF.rapidFireLoopRunning then return end
    Refs_RF.rapidFireLoopRunning = true
    Refs_RF.rapidFireLoopThread = task.spawn(function()
        while Refs_RF.rapidFireLoopRunning do
            local isPressed = State_RF.isHolding or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            if isPressed and Toggles.EnableRapidFire.Value then
                local c = LocalPlayer.Character
                if c then
                    local t = c:FindFirstChildOfClass("Tool")
                    if t then
                        local a = t:FindFirstChild("Ammo")
                        if not a or a.Value > 0 then
                            t:Activate()
                        end
                    end
                end
            end
            local delayVal = (Options.RapidFireDelay and Options.RapidFireDelay.Value) or 0.08
            task.wait(delayVal)
        end
    end)
end

local function stopRapidFireLoop()
    Refs_RF.rapidFireLoopRunning = false
    if Refs_RF.rapidFireLoopThread then
        task.cancel(Refs_RF.rapidFireLoopThread)
        Refs_RF.rapidFireLoopThread = nil
    end
end

local function applyRapidFire()
    if GunHandler then
        local origCanShoot = OriginalGetCanShoot or GunHandler.getCanShoot
        if type(origCanShoot) == "function" then
            GunHandler.getCanShoot = function(c, ...)
                if Toggles and Toggles.EnableRapidFire and Toggles.EnableRapidFire.Value then
                    return true
                end
                return origCanShoot(c, ...)
            end
        end
    end

    local setupvalue = debug.setupvalue or (debug and debug.setupvalue)
    for _, hook in ipairs(State_RF.rapidFireHooks) do
        pcall(function()
            if setupvalue and hook.fn then
                setupvalue(hook.fn, hook.index, hook.original)
            end
        end)
    end
    State_RF.rapidFireHooks = {}
    for _, conn in ipairs(State_RF.rapidFireChildConns) do
        if conn and conn.Disconnect then pcall(function() conn:Disconnect() end) end
    end
    State_RF.rapidFireChildConns = {}
    stopRapidFireLoop()

    if not Toggles.EnableRapidFire.Value then
        if GunHandler and OriginalGetCanShoot then
            GunHandler.getCanShoot = OriginalGetCanShoot
        end
        return
    end

    local c = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if c then
        for _, t in ipairs(c:GetChildren()) do hookToolForRapidFire(t) end
        local conn = c.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then task.wait(0.1); hookToolForRapidFire(child) end
        end)
        table.insert(State_RF.rapidFireChildConns, conn)
    end
    if bp then
        for _, t in ipairs(bp:GetChildren()) do hookToolForRapidFire(t) end
        local conn = bp.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then task.wait(0.1); hookToolForRapidFire(child) end
        end)
        table.insert(State_RF.rapidFireChildConns, conn)
    end
    startRapidFireLoop()
end

UserInputService.InputBegan:Connect(function(input, gp)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        State_RF.isHolding = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        State_RF.isHolding = false
    end
end)

Toggles.EnableRapidFire:OnChanged(function()
    applyRapidFire()
end)

do
    local spreaddd = {on = false, int = 100}
    local mathranbynig = math.random
    local orig_math_random = nil
    local spread_hooked_funcs = {}
    local spread_conns = {}

    pcall(function()
        if type(hookfunction) == "function" then
            orig_math_random = hookfunction(math.random, newcclosure(function(...)
                local spreadman_args = {...}
                local spreadman_result = orig_math_random(...)
                local is_spread_call = (#spreadman_args == 0) or
                                       (spreadman_args[1] == -0.05 and spreadman_args[2] == 0.05) or
                                       (spreadman_args[1] == -0.1 and spreadman_args[2] == 0.1) or
                                       (spreadman_args[1] == -0.1) or
                                       (spreadman_args[1] == -0.05)
                if not checkcaller() and spreaddd.on and is_spread_call then
                    return spreadman_result * (spreaddd.int / 100)
                end
                return spreadman_result
            end))
        end
    end)

    local function applyGunSpreadToTool(tool)
        if not tool or not tool:IsA("Tool") then return end
        local getconnections = getconnections or (debug and debug.getconnections)
        if not getconnections then return end
        pcall(function()
            local conns = getconnections(tool.Activated)
            if not conns or #conns == 0 then conns = getconnections(tool.Equipped) end
            if not conns then return end

            for _, conn in ipairs(conns) do
                if conn and conn.Function then
                    local fn = conn.Function
                    pcall(function()
                        local env = getfenv(fn)
                        if env then
                            env.math = env.math or {}
                            env.math.random = newcclosure(function(...)
                                local spreadman_args = {...}
                                local spreadman_result = mathranbynig(...)
                                local is_spread_call = (#spreadman_args == 0) or
                                                       (spreadman_args[1] == -0.05 and spreadman_args[2] == 0.05) or
                                                       (spreadman_args[1] == -0.1 and spreadman_args[2] == 0.1) or
                                                       (spreadman_args[1] == -0.1) or
                                                       (spreadman_args[1] == -0.05)
                                if spreaddd.on and is_spread_call then
                                    return spreadman_result * (spreaddd.int / 100)
                                end
                                return spreadman_result
                            end)
                            table.insert(spread_hooked_funcs, fn)
                        end
                    end)
                end
            end
        end)
    end

    local function refreshGunSpread()
        for _, conn in ipairs(spread_conns) do
            if conn and conn.Disconnect then pcall(function() conn:Disconnect() end) end
        end
        spread_conns = {}

        if spreaddd.on then
            local char = LocalPlayer.Character
            local bp = LocalPlayer:FindFirstChild("Backpack")
            if char then
                for _, t in ipairs(char:GetChildren()) do
                    if t:IsA("Tool") then applyGunSpreadToTool(t) end
                end
                local c1 = char.ChildAdded:Connect(function(child)
                    if child:IsA("Tool") then task.wait(0.1); applyGunSpreadToTool(child) end
                end)
                table.insert(spread_conns, c1)
            end
            if bp then
                for _, t in ipairs(bp:GetChildren()) do
                    if t:IsA("Tool") then applyGunSpreadToTool(t) end
                end
                local c2 = bp.ChildAdded:Connect(function(child)
                    if child:IsA("Tool") then task.wait(0.1); applyGunSpreadToTool(child) end
                end)
                table.insert(spread_conns, c2)
            end
            local c3 = LocalPlayer.CharacterAdded:Connect(function(c)
                task.wait(0.5)
                for _, t in ipairs(c:GetChildren()) do
                    if t:IsA("Tool") then applyGunSpreadToTool(t) end
                end
                local c4 = c.ChildAdded:Connect(function(child)
                    if child:IsA("Tool") then task.wait(0.1); applyGunSpreadToTool(child) end
                end)
                table.insert(spread_conns, c4)
            end)
            table.insert(spread_conns, c3)
        else
            for _, fn in ipairs(spread_hooked_funcs) do
                pcall(function()
                    local env = getfenv(fn)
                    if env then env.math = nil end
                end)
            end
            spread_hooked_funcs = {}
        end
    end

    GunModsGroup:AddToggle('EnableGunSpread', {Text = 'Gun Spread', Default = false})
    GunModsGroup:AddSlider('SpreadIntensity', {Text = 'Spread Intensity', Default = 100, Min = 0, Max = 100, Rounding = 1, Compact = false})

    Toggles.EnableGunSpread:OnChanged(function()
        spreaddd.on = Toggles.EnableGunSpread.Value
        refreshGunSpread()
    end)

    Options.SpreadIntensity:OnChanged(function()
        spreaddd.int = Options.SpreadIntensity.Value
    end)
end

do
    local man_target_position = Vector3.new()
    local man_target_part = nil
    local man_smart_origin = Vector3.new()
    local man_main_event = ReplicatedStorage:WaitForChild("MainEvent")
    local man_ray_params = RaycastParams.new()
    man_ray_params.FilterType = Enum.RaycastFilterType.Exclude

    local man_fov_circle = Drawing.new("Circle")
    man_fov_circle.Thickness = 1
    man_fov_circle.NumSides = 100
    man_fov_circle.Filled = false
    man_fov_circle.Visible = false

    local man_fov_outline = Drawing.new("Circle")
    man_fov_outline.Thickness = 2
    man_fov_outline.NumSides = 100
    man_fov_outline.Filled = false
    man_fov_outline.Visible = false

    local man_fov_inline = Drawing.new("Circle")
    man_fov_inline.Thickness = 1
    man_fov_inline.NumSides = 100
    man_fov_inline.Filled = false
    man_fov_inline.Visible = false

    local man_Enabled = false
    local man_ShowFOV = false
    local man_FOVColor = Color3.fromRGB(255, 255, 255)
    local man_FOVSize = 100

    local man_get_nearest_in_fov = function()
        local nearest_player = nil
        local nearest_distance = math.huge
        local character = LocalPlayer.Character
        local my_hrp = character and character:FindFirstChild("HumanoidRootPart")
        if not my_hrp then return nil end
        local mouse_pos = UserInputService:GetMouseLocation()
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer or not player.Character then continue end
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end
            local screen_pos, on_screen = workspace.CurrentCamera:WorldToViewportPoint(hrp.Position)
            if on_screen then
                local distance_to_mouse = (Vector2.new(screen_pos.X, screen_pos.Y) - mouse_pos).Magnitude
                if distance_to_mouse <= man_FOVSize then
                    if distance_to_mouse < nearest_distance then
                        nearest_distance = distance_to_mouse
                        nearest_player = player
                    end
                end
            end
        end
        return nearest_player
    end

    RunService.Heartbeat:Connect(function()
        local mouse_pos = UserInputService:GetMouseLocation()
        man_fov_circle.Visible = man_ShowFOV
        man_fov_circle.Color = man_FOVColor
        man_fov_circle.Radius = man_FOVSize
        man_fov_circle.Position = mouse_pos

        man_fov_outline.Visible = man_ShowFOV
        man_fov_outline.Color = Color3.new(0, 0, 0)
        man_fov_outline.Radius = man_FOVSize + 1
        man_fov_outline.Position = mouse_pos

        man_fov_inline.Visible = man_ShowFOV
        man_fov_inline.Color = man_FOVColor
        man_fov_inline.Radius = man_FOVSize - 1
        man_fov_inline.Position = mouse_pos

        if not man_Enabled then return end
        local character = LocalPlayer.Character
        if not character then return end
        local tool = character:FindFirstChildOfClass("Tool")
        local handle = tool and tool:FindFirstChild("Handle")
        if not handle then return end
        local target = man_get_nearest_in_fov()
        if not target or not target.Character then return end
        local head = target.Character:FindFirstChild("Head")
        local target_hrp = target.Character:FindFirstChild("HumanoidRootPart")
        if not head or not target_hrp then return end
        man_target_position = target_hrp.Position
        man_target_part = head
        man_ray_params.FilterDescendantsInstances = {character, target.Character}
        local player_origin = handle.Position
        local target_pos = head.Position
        local direction = (player_origin - target_pos).Unit
        local distance = (player_origin - target_pos).Magnitude
        local result = workspace:Raycast(target_pos, direction * distance, man_ray_params)
        man_smart_origin = (result and result.Instance) and (result.Position + direction * 0.1) or player_origin
    end)

    local man_old_namecall
    man_old_namecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if not checkcaller() and self == man_main_event and method == "FireServer" and args[1] == "ShootGun" and man_Enabled then
            args[3] = man_smart_origin
            args[4] = man_target_position
            args[5] = man_target_part
            args[6] = Vector3.new(0, 0, 0)
            return man_old_namecall(self, unpack(args))
        end
        return man_old_namecall(self, ...)
    end))

    local ManipulationGroup = Tabs.main:AddRightGroupbox('Bullet Manipulation')
    ManipulationGroup:AddToggle('ManipulationEnabled', {Text = 'Enable Bullet Manipulation', Default = false})
    ManipulationGroup:AddToggle('ManipulationShowFOV', {Text = 'Show FOV', Default = false})
    ManipulationGroup:AddLabel('FOV Color'):AddColorPicker('ManipulationFOVColor', {Default = Color3.fromRGB(255, 255, 255), Title = 'FOV Color'})
    ManipulationGroup:AddSlider('ManipulationFOVSize', {Text = 'FOV Size', Default = 100, Min = 10, Max = 1000, Rounding = 0})

    Toggles.ManipulationEnabled:OnChanged(function()
        man_Enabled = Toggles.ManipulationEnabled.Value
    end)
    Toggles.ManipulationShowFOV:OnChanged(function()
        man_ShowFOV = Toggles.ManipulationShowFOV.Value
    end)
    Options.ManipulationFOVColor:OnChanged(function()
        man_FOVColor = Options.ManipulationFOVColor.Value
    end)
    Options.ManipulationFOVSize:OnChanged(function()
        man_FOVSize = Options.ManipulationFOVSize.Value
    end)
end

GunModsGroup:AddToggle('AutoReload', {Text='Auto Reload', Default=false})

local function handleAutoReloadForTool(tool)
    if not tool:IsA("Tool") then return end
    local ammo = tool:FindFirstChild("Ammo")
    if not ammo then return end

    local lastAmmo = ammo.Value
    local conn
    conn = ammo:GetPropertyChangedSignal("Value"):Connect(function()
        if not tool.Parent or not tool.Parent:IsA("Model") then
            conn:Disconnect()
            return
        end
        local currentAmmo = ammo.Value
        if Toggles.AutoReload and Toggles.AutoReload.Value then
            if currentAmmo == 0 then
                local mainEvent = ReplicatedStorage:FindFirstChild("MainEvent") or (workspace:FindFirstChild("ReplicatedStorage") and workspace.ReplicatedStorage:FindFirstChild("MainEvent"))
                if mainEvent then
                    mainEvent:FireServer("Reload", tool)
                end
            end
        end
        lastAmmo = currentAmmo
    end)
end

local function setupAutoReloadForChar(char)
    if not char then return end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") then
            handleAutoReloadForTool(child)
        end
    end
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            handleAutoReloadForTool(child)
        end
    end)
end

if LocalPlayer.Character then
    task.spawn(setupAutoReloadForChar, LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(setupAutoReloadForChar)

local AutoLoadoutGroup = Tabs.main:AddRightGroupbox('Auto Loadout')

local autoLoadoutGunValues = (function()
    local list = {}
    local added = {}
    if weaponList and #weaponList > 0 then
        for _, w in ipairs(weaponList) do
            if not added[w] then
                table.insert(list, w)
                added[w] = true
            end
        end
    end
    for _, it in ipairs(masterItemList) do
        local n = it.display
        if not added[n] and not n:lower():find("armor") and not n:lower():find("bag") and not n:lower():find("weight") and not n:lower():find("food") and not n:lower():find("phone") and not n:lower():find("wallet") and not n:lower():find("radio") and not n:lower():find("pizza") and not n:lower():find("hamburger") and not n:lower():find("chicken") and not n:lower():find("medkit") and not n:lower():find("camera") then
            table.insert(list, n)
            added[n] = true
        end
    end
    table.sort(list)
    return list
end)()

AutoLoadoutGroup:AddToggle('EnableAutoLoadout', {Text = 'Enable Auto Loadout', Default = false})
AutoLoadoutGroup:AddDropdown('AutoLoadoutGuns', {
    Values = autoLoadoutGunValues,
    Default = {'Rifle'},
    Multi = true,
    Text = 'Guns'
})
AutoLoadoutGroup:AddSlider('AutoLoadoutAmmo', {Text = 'Ammo Amount', Default = 5, Min = 0, Max = 50, Rounding = 0, Compact = true})
AutoLoadoutGroup:AddSlider('AutoLoadoutDelay', {Text = 'Buy Delay (s)', Default = 0.35, Min = 0.1, Max = 2, Rounding = 2, Compact = true})

local function al_has_item(name)
    if not name or name == "" then return false end
    local clean = name:lower():gsub("[%[%]]", ""):gsub("%s+", "")
    if clean == "" then return false end

    local function check(parent)
        if not parent then return false end
        for _, v in ipairs(parent:GetChildren()) do
            if v:IsA("Tool") and v.Name ~= "" then
                local toolName = v.Name:lower():gsub("[%[%]]", ""):gsub("%s+", "")
                if toolName ~= "" then
                    if toolName == clean or toolName:find(clean, 1, true) or (#toolName >= 3 and clean:find(toolName, 1, true)) then
                        return true
                    end
                end
            end
        end
        return false
    end
    return check(LocalPlayer:FindFirstChild("Backpack")) or check(LocalPlayer.Character)
end

local autoLoadoutRunning = false
local function do_auto_loadout()
    if not Toggles.EnableAutoLoadout or not Toggles.EnableAutoLoadout.Value then return end
    if autoLoadoutRunning then return end

    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 1 then return end

    autoLoadoutRunning = true
    task.spawn(function()
        pcall(function()
            scanShop()

            local selectedGuns = Options.AutoLoadoutGuns and Options.AutoLoadoutGuns.Value or {}
            local ammoCount    = Options.AutoLoadoutAmmo and Options.AutoLoadoutAmmo.Value or 5
            local buyDelay     = Options.AutoLoadoutDelay and Options.AutoLoadoutDelay.Value or 0.35

            local gunListToBuy = {}
            if type(selectedGuns) == "table" then
                for k, v in pairs(selectedGuns) do
                    if type(k) == "number" and type(v) == "string" then
                        table.insert(gunListToBuy, v)
                    elseif type(k) == "string" and v == true then
                        table.insert(gunListToBuy, k)
                    end
                end
            end

            for _, gunDisplay in ipairs(gunListToBuy) do
                if not Toggles.EnableAutoLoadout or not Toggles.EnableAutoLoadout.Value then break end

                char = LocalPlayer.Character
                hum  = char and char:FindFirstChildOfClass("Humanoid")
                hrp  = char and char:FindFirstChild("HumanoidRootPart")
                if not hum or not hrp or hum.Health <= 1 then break end

                scanShop()

                local shopItem = all_items[gunDisplay]
                if not shopItem then
                    for n, data in pairs(all_items) do
                        if n:lower():find(gunDisplay:lower(), 1, true) or gunDisplay:lower():find(n:lower(), 1, true) then
                            shopItem = data
                            break
                        end
                    end
                end

                if shopItem then
                    local hasGun = al_has_item(gunDisplay)
                    if not hasGun then
                        if shopItem.main then
                            local cdMain = shopItem.main.Parent:FindFirstChildOfClass("ClickDetector")
                            if not cdMain then
                                for _, d in ipairs(shopItem.main.Parent:GetDescendants()) do
                                    if d:IsA("ClickDetector") then cdMain = d break end
                                end
                            end
                            if cdMain then
                                buyItemWithDesync4(shopItem.main, cdMain, 1)
                                task.wait(buyDelay)
                            end
                        end

                        if shopItem.ammo and ammoCount > 0 then
                            local cdAmmo = shopItem.ammo.Parent:FindFirstChildOfClass("ClickDetector")
                            if not cdAmmo then
                                for _, d in ipairs(shopItem.ammo.Parent:GetDescendants()) do
                                    if d:IsA("ClickDetector") then cdAmmo = d break end
                                end
                            end
                            if cdAmmo then
                                buyItemWithDesync4(shopItem.ammo, cdAmmo, ammoCount)
                                task.wait(buyDelay)
                            end
                        end
                    end
                end
            end
        end)
        autoLoadoutRunning = false
    end)
end

Toggles.EnableAutoLoadout:OnChanged(function()
    if Toggles.EnableAutoLoadout.Value then
        do_auto_loadout()
    end
end)

Options.AutoLoadoutGuns:OnChanged(function()
    if Toggles.EnableAutoLoadout and Toggles.EnableAutoLoadout.Value then
        do_auto_loadout()
    end
end)

local function onCharacterSpawn(char)
    autoLoadoutRunning = false
    if not char then return end

    local hum = char:WaitForChild("Humanoid", 10)
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    if not hum or not hrp then return end

    task.wait(1.5)

    local attempts = 0
    while attempts < 30 do
        if hum and hum.Health > 1 and not hrp.Anchored then
            local be = char:FindFirstChild("BodyEffects")
            local ko = be and be:FindFirstChild("K.O")
            if not ko or not ko.Value then
                break
            end
        end
        attempts = attempts + 1
        task.wait(0.2)
    end

    task.wait(0.5)

    if Toggles.EnableAutoLoadout and Toggles.EnableAutoLoadout.Value then
        do_auto_loadout()
    end
end

if LocalPlayer.Character then
    task.spawn(function() onCharacterSpawn(LocalPlayer.Character) end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.spawn(function() onCharacterSpawn(char) end)
end)

local WorldGroup = Tabs.visuals:AddRightGroupbox('World')
local ESPGroup = Tabs.visuals:AddLeftGroupbox('ESP')
local SkyboxGroup = Tabs.visuals:AddRightGroupbox('Skybox')

ESPGroup:AddToggle('ESPEnabled', {Text='Enabled', Default=false})
ESPGroup:AddToggle('ESPBox', {Text='Box', Default=false})
ESPGroup:AddToggle('ESP3DBox', {Text='3D Box', Default=false})
ESPGroup:AddToggle('ESPBoxFill', {Text='Box Fill', Default=false})
ESPGroup:AddToggle('ESPGradientFill', {Text='Gradient Box Fill', Default=false})
ESPGroup:AddToggle('ESPHealthBar', {Text='Health Bar', Default=false})
ESPGroup:AddToggle('ESPArmorBar', {Text='Armor Bar', Default=false})
ESPGroup:AddToggle('ESPNames', {Text='Names', Default=false})
ESPGroup:AddToggle('ESPDistance', {Text='Distance', Default=false})
ESPGroup:AddToggle('ESPTool', {Text='Tool', Default=false})
ESPGroup:AddToggle('ESPTracers', {Text='Tracers', Default=false})
ESPGroup:AddToggle('ESPSkeleton', {Text='Skeleton', Default=false})
ESPGroup:AddToggle('ESPHighlight', {Text='Highlight', Default=false})

ESPGroup:AddLabel('Box Color'):AddColorPicker('ESPBoxColor', {Default=Color3.fromRGB(255,255,255), Title='Box Color'})
ESPGroup:AddLabel('3D Box Color'):AddColorPicker('ESP3DBoxColor', {Default=Color3.fromRGB(255,255,255), Title='3D Box Color'})
ESPGroup:AddLabel('Fill Color'):AddColorPicker('ESPBoxFillColor', {Default=Color3.fromRGB(255,255,255), Title='Fill Color'})
ESPGroup:AddLabel('Gradient Top'):AddColorPicker('ESPGradientTopColor', {Default=Color3.fromRGB(65,105,205), Title='Gradient Top Color'})
ESPGroup:AddLabel('Gradient Bottom'):AddColorPicker('ESPGradientBottomColor', {Default=Color3.fromRGB(15,20,35), Title='Gradient Bottom Color'})
ESPGroup:AddLabel('Health Full'):AddColorPicker('ESPHpFull', {Default=Color3.fromRGB(0,255,0), Title='Health Full'})
ESPGroup:AddLabel('Health Empty'):AddColorPicker('ESPHpEmpty', {Default=Color3.fromRGB(255,0,0), Title='Health Empty'})
ESPGroup:AddDropdown('ESPBarSide', {Values={'Left','Right'}, Default=1, Multi=false, Text='Bar Side'})
ESPGroup:AddLabel('Armor Full'):AddColorPicker('ESPArmorFull', {Default=Color3.fromRGB(80,160,255), Title='Armor Full'})
ESPGroup:AddLabel('Armor Empty'):AddColorPicker('ESPArmorEmpty', {Default=Color3.fromRGB(30,60,120), Title='Armor Empty'})
ESPGroup:AddLabel('Name Color'):AddColorPicker('ESPNameColor', {Default=Color3.fromRGB(255,255,255), Title='Name Color'})
ESPGroup:AddLabel('Dist Color'):AddColorPicker('ESPDistColor', {Default=Color3.fromRGB(255,255,255), Title='Dist Color'})
ESPGroup:AddLabel('Tool Color'):AddColorPicker('ESPToolColor', {Default=Color3.fromRGB(255,220,0), Title='Tool Color'})
ESPGroup:AddDropdown('ESPTracerOrigin', {Values={'Bottom','Center','Top'}, Default=1, Multi=false, Text='Tracer Origin'})
ESPGroup:AddLabel('Tracer Color'):AddColorPicker('ESPTracerColor', {Default=Color3.fromRGB(255,255,255), Title='Tracer Color'})
ESPGroup:AddLabel('Skeleton Color'):AddColorPicker('ESPSkeletonColor', {Default=Color3.fromRGB(255,255,255), Title='Skeleton Color'})
ESPGroup:AddLabel('HL Fill'):AddColorPicker('ESPHLFill', {Default=Color3.fromRGB(173,216,230), Title='HL Fill'})
ESPGroup:AddLabel('HL Outline'):AddColorPicker('ESPHLOutline', {Default=Color3.fromRGB(0,0,0), Title='HL Outline'})

ESPGroup:AddLabel('ESP Adjustments')
ESPGroup:AddSlider('ESPBoxFillTrans', {Text='Box Fill Transparency', Default=0.45, Min=0, Max=1, Rounding=2})
ESPGroup:AddSlider('ESPHLFillTrans', {Text='Highlight Fill Transparency', Default=0.5, Min=0, Max=1, Rounding=2})
ESPGroup:AddSlider('ESPHLOutTrans', {Text='Highlight Outline Transparency', Default=0, Min=0, Max=1, Rounding=2})

local esp = (function()
    local ESP = {}
    local lp = Players.LocalPlayer
    local cam = workspace.CurrentCamera
    local enabled = false
    local maxDist = math.huge
    local boxEnabled = false
    local boxColor = Color3.fromRGB(255,255,255)
    local box3DEnabled = false
    local box3DColor = Color3.fromRGB(255,255,255)
    local boxFill = false
    local boxFillColor = Color3.fromRGB(255,255,255)
    local boxFillTransparency = 0.45
    local gradientFill = false
    local gradientTopColor = Color3.fromRGB(65,105,205)
    local gradientBottomColor = Color3.fromRGB(15,20,35)
    local healthBarEnabled = false
    local healthBarSide = 'Left'
    local hpColorFull  = Color3.fromRGB(0,255,0)
    local hpColorEmpty = Color3.fromRGB(255,0,0)
    local armorBarEnabled = false
    local armorColorFull  = Color3.fromRGB(80,160,255)
    local armorColorEmpty = Color3.fromRGB(30,60,120)
    local namesEnabled = false
    local namesColor = Color3.fromRGB(173,216,230)
    local distanceEnabled = false
    local distanceColor = Color3.fromRGB(255,255,255)
    local toolEnabled = false
    local toolColor = Color3.fromRGB(255,220,0)
    local tracersEnabled = false
    local tracerColor = Color3.fromRGB(255,255,255)
    local tracerOrigin = 'Bottom'
    local skeletonEnabled = false
    local skeletonColor = Color3.fromRGB(255,255,255)
    local highlightEnabled = false
    local highlightFillColor = Color3.fromRGB(173,216,230)
    local highlightOutlineColor = Color3.fromRGB(0,0,0)
    local highlightFillTransparency = 0.5
    local highlightOutlineTransparency = 0

    local vertices = {
        {-0.5,-0.5,-0.5},{-0.5,0.5,-0.5},{0.5,-0.5,-0.5},{0.5,0.5,-0.5},
        {-0.5,-0.5,0.5},{-0.5,0.5,0.5},{0.5,-0.5,0.5},{0.5,0.5,0.5}
    }

    local box3DEdges = {
        {1,2},{1,3},{1,5},{2,4},{2,6},{3,4},{3,7},{4,8},{5,6},{5,7},{6,8},{7,8}
    }

    local espFolder = Instance.new('Folder')
    espFolder.Name = 'SymbolESP'
    espFolder.Parent = workspace
    local playerESP = {}

    local skeletonBones = {
        {'Head','UpperTorso'},{'UpperTorso','LowerTorso'},
        {'UpperTorso','RightUpperArm'},{'RightUpperArm','RightLowerArm'},{'RightLowerArm','RightHand'},
        {'UpperTorso','LeftUpperArm'},{'LeftUpperArm','LeftLowerArm'},{'LeftLowerArm','LeftHand'},
        {'LowerTorso','RightUpperLeg'},{'RightUpperLeg','RightLowerLeg'},{'RightLowerLeg','RightFoot'},
        {'LowerTorso','LeftUpperLeg'},{'LeftUpperLeg','LeftLowerLeg'},{'LeftLowerLeg','LeftFoot'},
    }

    local function newLine(thickness, color, zindex)
        local l = Drawing.new('Line')
        l.Thickness = thickness or 1
        l.Color = color or Color3.new(1,1,1)
        l.Transparency = 1
        l.ZIndex = zindex or 1
        l.Visible = false
        return l
    end
    local function newText(size, color, zindex)
        local t = Drawing.new('Text')
        t.Size = size or 13
        t.Color = color or Color3.new(1,1,1)
        t.Outline = true
        t.Center = true
        t.Font = 2
        t.ZIndex = zindex or 2
        t.Visible = false
        return t
    end
    local function newSquare(filled, thickness, color, zindex)
        local s = Drawing.new('Square')
        s.Filled = filled or false
        s.Thickness = thickness or 1
        s.Color = color or Color3.new(1,1,1)
        s.ZIndex = zindex or 1
        s.Visible = false
        return s
    end
    local function newQuad(color, transparency, zindex)
        local q = Drawing.new('Quad')
        q.Color = color or Color3.new(1,1,1)
        q.Filled = true
        q.Transparency = transparency or 1
        q.ZIndex = zindex or 1
        q.Visible = false
        return q
    end

    local function customBounds(char)
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local size = Vector3.new(4, 5.5, 2)
        local center = hrp.Position
        return hrp.CFrame, size, center
    end

    local function w2s(pos)
        local sp, on = cam:WorldToViewportPoint(pos)
        return Vector2.new(sp.X,sp.Y), on, sp.Z
    end

    local function createPlayerESP(player)
        if playerESP[player] then return end
        local d = {
            box        = newSquare(false, 1, boxColor, 3),
            boxOutline = newSquare(false, 1, Color3.new(0,0,0), 2),
            boxFillQ   = newQuad(boxFillColor, boxFillTransparency, 1),
            gradientSegments = {},
            box3DLines = {},
            healthBarOutline = newSquare(false, 1, Color3.fromRGB(0,0,0), 1),
            healthBar    = newSquare(true,  1, Color3.fromRGB(0,255,0), 3),
            armorBarBg   = newSquare(false, 1, Color3.fromRGB(0,0,0), 1),
            armorBar     = newSquare(true,  1, armorColorFull, 3),
            name     = newText(13, namesColor, 4),
            distance = newText(13, distanceColor, 4),
            tool     = newText(13, toolColor, 4),
            tracer   = newLine(1, tracerColor, 1),
            skeleton = {},
            highlight = nil,
            chams = {},
        }
        for i = 1, 35 do
            d.gradientSegments[i] = newSquare(true, 1, Color3.new(1,1,1), 1)
        end
        for i = 1, 12 do
            d.box3DLines[i] = newLine(1, box3DColor, 3)
        end
        for i=1,#skeletonBones do
            d.skeleton[i] = newLine(1, skeletonColor, 2)
        end
        playerESP[player] = d
    end

    local function removePlayerESP(player)
        local d = playerESP[player]
        if not d then return end
        pcall(function() d.box:Remove() end)
        pcall(function() d.boxOutline:Remove() end)
        pcall(function() d.boxFillQ:Remove() end)
        for _, seg in ipairs(d.gradientSegments or {}) do pcall(function() seg:Remove() end) end
        for _, line3d in ipairs(d.box3DLines or {}) do pcall(function() line3d:Remove() end) end
        pcall(function() d.healthBarOutline:Remove() end)
        pcall(function() d.healthBar:Remove() end)
        pcall(function() d.armorBarBg:Remove() end)
        pcall(function() d.armorBar:Remove() end)
        pcall(function() d.name:Remove() end)
        pcall(function() d.distance:Remove() end)
        pcall(function() d.tool:Remove() end)
        pcall(function() d.tracer:Remove() end)
        for _,l in ipairs(d.skeleton) do pcall(function() l:Remove() end) end
        if d.highlight and d.highlight.Parent then d.highlight:Destroy() end
        playerESP[player] = nil
    end

    local function updateHighlight(player, d)
        if not player.Character then
            if d.highlight and d.highlight.Parent then
                d.highlight:Destroy()
                d.highlight = nil
            end
            return
        end
        if highlightEnabled then
            if not d.highlight or not d.highlight.Parent then
                local hl = Instance.new('Highlight')
                hl.FillColor = highlightFillColor
                hl.OutlineColor = highlightOutlineColor
                hl.FillTransparency = highlightFillTransparency
                hl.OutlineTransparency = highlightOutlineTransparency
                hl.Adornee = player.Character
                hl.Parent = espFolder
                d.highlight = hl
            else
                d.highlight.FillColor = highlightFillColor
                d.highlight.OutlineColor = highlightOutlineColor
                d.highlight.FillTransparency = highlightFillTransparency
                d.highlight.OutlineTransparency = highlightOutlineTransparency
            end
        else
            if d.highlight and d.highlight.Parent then
                d.highlight:Destroy()
                d.highlight = nil
            end
        end
    end

    local function hideAll(d)
        d.box.Visible = false
        d.boxOutline.Visible = false
        d.boxFillQ.Visible = false
        for _, seg in ipairs(d.gradientSegments or {}) do seg.Visible = false end
        for _, l in ipairs(d.box3DLines or {}) do l.Visible = false end
        d.healthBarOutline.Visible = false
        d.healthBar.Visible = false
        d.armorBarBg.Visible = false
        d.armorBar.Visible = false
        d.name.Visible = false
        d.distance.Visible = false
        d.tool.Visible = false
        d.tracer.Visible = false
        for _,l in ipairs(d.skeleton) do l.Visible = false end
    end

    local function updatePlayer(player, d)
        local char = player.Character
        if not char then hideAll(d) return end
        local hrp = char:FindFirstChild('HumanoidRootPart')
        local hum = char:FindFirstChild('Humanoid')
        if not hrp or not hum or hum.Health <= 0 then hideAll(d) return end

        local cf, size, center = customBounds(char)
        if not cf then hideAll(d) return end

        local screenPos, visible = cam:WorldToViewportPoint(center)
        if not visible then hideAll(d) return end

        local tl = cam:WorldToViewportPoint((cf * CFrame.new(-size.X/2,  size.Y/2, 0)).Position)
        local tr = cam:WorldToViewportPoint((cf * CFrame.new( size.X/2,  size.Y/2, 0)).Position)
        local bl = cam:WorldToViewportPoint((cf * CFrame.new(-size.X/2, -size.Y/2, 0)).Position)
        local br = cam:WorldToViewportPoint((cf * CFrame.new( size.X/2, -size.Y/2, 0)).Position)

        local boxW = math.max(math.abs(tr.X - tl.X), 3)
        local boxH = math.max(math.abs(bl.Y - tl.Y), 3)
        local boxPos = Vector2.new(
            math.min(tl.X, tr.X, bl.X, br.X),
            math.min(tl.Y, tr.Y, bl.Y, br.Y)
        )

        local dist = math.floor((hrp.Position - cam.CFrame.Position).Magnitude)
        if dist > maxDist then hideAll(d) return end

        if boxEnabled and enabled then
            d.box.Size = Vector2.new(boxW, boxH)
            d.box.Position = boxPos
            d.box.Color = boxColor
            d.box.Visible = true
            d.boxOutline.Size = Vector2.new(boxW + 2, boxH + 2)
            d.boxOutline.Position = Vector2.new(boxPos.X - 1, boxPos.Y - 1)
            d.boxOutline.Color = Color3.fromRGB(0,0,0)
            d.boxOutline.Visible = true
            if gradientFill then
                d.boxFillQ.Visible = false
                local segCount = 25
                local segH = boxH / segCount
                local startX = math.floor(boxPos.X)
                local startW = math.floor(boxW)
                local startY = boxPos.Y
                for i = 1, segCount do
                    local seg = d.gradientSegments[i]
                    if seg then
                        local y1 = math.floor(startY + (i - 1) * segH)
                        local y2 = math.floor(startY + i * segH)
                        local h = math.max(y2 - y1, 1)
                        local t = (i - 0.5) / segCount
                        seg.Size = Vector2.new(startW, h)
                        seg.Position = Vector2.new(startX, y1)
                        seg.Color = gradientTopColor:Lerp(gradientBottomColor, t)
                        seg.Transparency = boxFillTransparency
                        seg.Visible = true
                    end
                end
            else
                for i = 1, #d.gradientSegments do
                    if d.gradientSegments[i] then d.gradientSegments[i].Visible = false end
                end
                if boxFill then
                    d.boxFillQ.PointA = Vector2.new(boxPos.X, boxPos.Y)
                    d.boxFillQ.PointB = Vector2.new(boxPos.X + boxW, boxPos.Y)
                    d.boxFillQ.PointC = Vector2.new(boxPos.X + boxW, boxPos.Y + boxH)
                    d.boxFillQ.PointD = Vector2.new(boxPos.X, boxPos.Y + boxH)
                    d.boxFillQ.Color = boxFillColor
                    d.boxFillQ.Transparency = boxFillTransparency
                    d.boxFillQ.Visible = true
                else
                    d.boxFillQ.Visible = false
                end
            end
        else
            d.box.Visible = false
            d.boxOutline.Visible = false
            d.boxFillQ.Visible = false
            for i = 1, #d.gradientSegments do
                if d.gradientSegments[i] then d.gradientSegments[i].Visible = false end
            end
        end

        if box3DEnabled and enabled then
            local points3D = {}
            for i, v in ipairs(vertices) do
                local w = cf:PointToWorldSpace(Vector3.new(v[1]*size.X, v[2]*size.Y, v[3]*size.Z))
                local sPos, on = w2s(w)
                points3D[i] = {pos = sPos, vis = on}
            end
            for idx, edge in ipairs(box3DEdges) do
                local p1 = points3D[edge[1]]
                local p2 = points3D[edge[2]]
                local line = d.box3DLines[idx]
                if line then
                    if p1 and p2 and (p1.vis or p2.vis) then
                        line.From = p1.pos
                        line.To = p2.pos
                        line.Color = box3DColor
                        line.Visible = true
                    else
                        line.Visible = false
                    end
                end
            end
        else
            for _, l in ipairs(d.box3DLines or {}) do l.Visible = false end
        end

        if healthBarEnabled and enabled then
            local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local barX = healthBarSide == 'Left' and (boxPos.X - 8) or (boxPos.X + boxW + 4)
            local hpColor = hpColorEmpty:Lerp(hpColorFull, ratio)
            d.healthBarOutline.Size = Vector2.new(6, boxH + 2)
            d.healthBarOutline.Position = Vector2.new(barX - 1, boxPos.Y - 1)
            d.healthBarOutline.Color = Color3.fromRGB(0,0,0)
            d.healthBarOutline.Visible = true
            d.healthBar.Size = Vector2.new(4, boxH * ratio)
            d.healthBar.Position = Vector2.new(barX, boxPos.Y + boxH * (1 - ratio))
            d.healthBar.Color = hpColor
            d.healthBar.Visible = true
        else
            d.healthBarOutline.Visible = false
            d.healthBar.Visible = false
        end

        if armorBarEnabled and enabled then
            local armorVal = 0
            local be2 = char:FindFirstChild('BodyEffects')
            if be2 then
                local a = be2:FindFirstChild('Armor')
                if a then armorVal = a.Value end
            end
            local ratio = math.clamp(armorVal / 100, 0, 1)
            local armorColor = armorColorEmpty:Lerp(armorColorFull, ratio)
            local barX2
            if healthBarSide == 'Right' then
                barX2 = boxPos.X - 8
            else
                barX2 = boxPos.X + boxW + 4
            end
            d.armorBarBg.Size = Vector2.new(6, boxH + 2)
            d.armorBarBg.Position = Vector2.new(barX2 - 1, boxPos.Y - 1)
            d.armorBarBg.Color = Color3.fromRGB(0,0,0)
            d.armorBarBg.Visible = true
            d.armorBar.Size = Vector2.new(4, boxH * ratio)
            d.armorBar.Position = Vector2.new(barX2, boxPos.Y + boxH * (1 - ratio))
            d.armorBar.Color = armorColor
            d.armorBar.Visible = true
        else
            d.armorBarBg.Visible = false
            d.armorBar.Visible = false
        end

        if namesEnabled and enabled then
            d.name.Text = player.Name
            d.name.Color = namesColor
            d.name.Position = Vector2.new(boxPos.X + boxW/2, boxPos.Y - 16)
            d.name.Visible = true
        else
            d.name.Visible = false
        end

        if distanceEnabled and enabled then
            d.distance.Text = dist .. ' studs'
            d.distance.Color = distanceColor
            d.distance.Position = Vector2.new(boxPos.X + boxW/2, boxPos.Y + boxH + 2)
            d.distance.Visible = true
        else
            d.distance.Visible = false
        end

        if toolEnabled and enabled then
            local tool = char:FindFirstChildOfClass('Tool')
            d.tool.Text = tool and tool.Name or ''
            d.tool.Color = toolColor
            local distOffset = distanceEnabled and 18 or 2
            d.tool.Position = Vector2.new(boxPos.X + boxW/2, boxPos.Y + boxH + distOffset)
            d.tool.Visible = tool ~= nil
        else
            d.tool.Visible = false
        end

        if tracersEnabled and enabled then
            local vpS = cam.ViewportSize
            local oy = tracerOrigin == 'Bottom' and vpS.Y or tracerOrigin == 'Center' and vpS.Y/2 or 0
            local sBot,_ = w2s(Vector3.new(center.X, center.Y - size.Y/2, center.Z))
            d.tracer.From = Vector2.new(vpS.X/2, oy)
            d.tracer.To = sBot
            d.tracer.Color = tracerColor
            d.tracer.Transparency = 1
            d.tracer.Visible = true
        else
            d.tracer.Visible = false
        end

        if skeletonEnabled and enabled then
            for i,bone in ipairs(skeletonBones) do
                local p0 = char:FindFirstChild(bone[1])
                local p1 = char:FindFirstChild(bone[2])
                if p0 and p1 then
                    local s0, on0 = w2s(p0.Position)
                    local s1, on1 = w2s(p1.Position)
                    if on0 and on1 then
                        d.skeleton[i].From = s0
                        d.skeleton[i].To = s1
                        d.skeleton[i].Color = skeletonColor
                        d.skeleton[i].Transparency = 1
                        d.skeleton[i].Visible = true
                    else
                        d.skeleton[i].Visible = false
                    end
                else
                    d.skeleton[i].Visible = false
                end
            end
        else
            for _,l in ipairs(d.skeleton) do l.Visible = false end
        end

        updateHighlight(player, d)
    end

    local function onPlayerAdded(player)
        if player == lp then return end
        createPlayerESP(player)
        player.CharacterAdded:Connect(function()
            if playerESP[player] then
                if playerESP[player].highlight and playerESP[player].highlight.Parent then
                    playerESP[player].highlight:Destroy()
                    playerESP[player].highlight = nil
                end
            end
        end)
    end

    for _,p in ipairs(Players:GetPlayers()) do onPlayerAdded(p) end
    Players.PlayerAdded:Connect(onPlayerAdded)
    Players.PlayerRemoving:Connect(function(p) removePlayerESP(p) end)

    local wasEspEnabled = false
    RunService.RenderStepped:Connect(function()
        if not enabled then
            if wasEspEnabled then
                wasEspEnabled = false
                for _,d in pairs(playerESP) do
                    hideAll(d)
                    if d.highlight and d.highlight.Parent then
                        d.highlight:Destroy()
                        d.highlight = nil
                    end
                    for _,inst in ipairs(d.chams or {}) do
                        if inst.Parent then inst:Destroy() end
                    end
                    d.chams = {}
                end
            end
            return
        end
        wasEspEnabled = true
        for player,d in pairs(playerESP) do
            updatePlayer(player, d)
        end
    end)

    function ESP:setEnabled(v)              enabled = v end
    function ESP:setMaxDist(v)              maxDist = v end
    function ESP:setBoxEnabled(v)           boxEnabled = v end
    function ESP:setBoxColor(c)             boxColor = c end
    function ESP:setBox3DEnabled(v)         box3DEnabled = v end
    function ESP:setBox3DColor(c)           box3DColor = c end
    function ESP:setBoxFill(v)              boxFill = v end
    function ESP:setBoxFillColor(c)         boxFillColor = c end
    function ESP:setBoxFillTransparency(t)  boxFillTransparency = t end
    function ESP:setGradientFill(v)        gradientFill = v end
    function ESP:setGradientTopColor(c)    gradientTopColor = c end
    function ESP:setGradientBottomColor(c) gradientBottomColor = c end
    function ESP:setHealthBarEnabled(v)     healthBarEnabled = v end
    function ESP:setHealthBarSide(s)        healthBarSide = s end
    function ESP:setHpColorFull(c)          hpColorFull = c end
    function ESP:setHpColorEmpty(c)         hpColorEmpty = c end
    function ESP:setArmorBarEnabled(v)      armorBarEnabled = v end
    function ESP:setArmorColorFull(c)       armorColorFull = c end
    function ESP:setArmorColorEmpty(c)      armorColorEmpty = c end
    function ESP:setNamesEnabled(v)         namesEnabled = v end
    function ESP:setNamesColor(c)           namesColor = c end
    function ESP:setDistanceEnabled(v)      distanceEnabled = v end
    function ESP:setDistanceColor(c)        distanceColor = c end
    function ESP:setToolEnabled(v)          toolEnabled = v end
    function ESP:setToolColor(c)            toolColor = c end
    function ESP:setTracersEnabled(v)       tracersEnabled = v end
    function ESP:setTracerColor(c)          tracerColor = c end
    function ESP:setTracerOrigin(o)         tracerOrigin = o end
    function ESP:setSkeletonEnabled(v)      skeletonEnabled = v end
    function ESP:setSkeletonColor(c)        skeletonColor = c end
    function ESP:setHighlightEnabled(v)     highlightEnabled = v end
    function ESP:setHighlightFillColor(c)   highlightFillColor = c end
    function ESP:setHighlightOutlineColor(c) highlightOutlineColor = c end
    function ESP:setHighlightFillTransparency(t) highlightFillTransparency = t end
    function ESP:setHighlightOutlineTransparency(t) highlightOutlineTransparency = t end
    return ESP
end)()

Toggles.ESPEnabled:OnChanged(function()      esp:setEnabled(Toggles.ESPEnabled.Value) end)
if Options.ESPMaxDist then Options.ESPMaxDist:OnChanged(function() esp:setMaxDist(Options.ESPMaxDist.Value) end) end
Toggles.ESPBox:OnChanged(function()          esp:setBoxEnabled(Toggles.ESPBox.Value) end)
