            :AddKeyPicker('ragebotkeybind', { Default = '', Text = 'ragebot', Mode = 'Toggle', SyncToggleState = true, NoUI = false })

        Toggles.ragebotenabled:OnChanged(function()
            local enabled = Toggles.ragebotenabled.Value
            RB.enabled = enabled
            RB.active = enabled
            
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild('HumanoidRootPart')
            
            if enabled then
                if root then
                    RB.savedCFrame = root.CFrame
                end
            else
                if root and RB.savedCFrame then
                    pcall(function()
                        root.Velocity = Vector3.zero
                        root.RotVelocity = Vector3.zero
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        root.CFrame = RB.savedCFrame
                    end)
                end
                RB.savedCFrame = nil
                RB.lockedTarget = nil
                _G.rb_teleporting = false
                _G.rb_voiding = false
                _G.rb_isInCombat = false
                RB.setStatus("")
                if char and char:FindFirstChild('Humanoid') then
                    workspace.CurrentCamera.CameraSubject = char.Humanoid
                end
            end
        end)
