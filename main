local LightingModifications = false
local lighting = game:GetService("Lighting")

local LightingSettings = {
    DefaultAmbient = lighting.Ambient,
    DefaultOutdoorAmbient = lighting.OutdoorAmbient,
    DefaultExposureCompensation = lighting.ExposureCompensation,
    DefaultFogStart = lighting.FogStart,
    DefaultFogEnd = lighting.FogEnd,
    DefaultFogColor = lighting.FogColor,
    DefaultBrightness = lighting.Brightness,
    DefaultClockTime = lighting.ClockTime,

    CustomAmbient = Color3.new(0, 0, 0),
    CustomOutdoorAmbient = Color3.fromRGB(80, 120, 200),
    CustomExposureCompensation = -0.3,
    CustomFogStart = 50,
    CustomFogEnd = 1000,
    CustomFogColor = Color3.fromRGB(80, 120, 200),
    CustomBrightness = 2,
    CustomClockTime = 14,
}


local mcProcessedParts = {}
local mcFaces = {
    Enum.NormalId.Front,
    Enum.NormalId.Back,
    Enum.NormalId.Bottom,
    Enum.NormalId.Top,
    Enum.NormalId.Right,
    Enum.NormalId.Left,
}
local mcMaterials = {
    Wood = '128754006217410',
    WoodPlanks = '8676581022',
    Brick = '8139086777',
    Cobblestone = '17874801808',
    Concrete = '15622710576',
    DiamondPlate = '14197861013',
    Fabric = '9744916443',
    Granite = '4714662147',
    Grass = '9267183930',
    Ice = '11413423466',
    Marble = '14974016515',
    Metal = '12623531687',
    Sand = '11119324718',
    Slate = '8139086777',
    Ground = '9267089500',
    Plastic = '8676581022',
    SmoothPlastic = '8676581022',
}

local function applyMinecraftTextures()
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA('BasePart') and not mcProcessedParts[part] then
            local matName = part.Material.Name
            local texId = mcMaterials[matName] or '8676581022'
            if texId then
                for _, face in ipairs(mcFaces) do
                    local tex = Instance.new('Texture')
                    tex.Name = 'MinecraftTex'
                    tex.ZIndex = 2147483647
                    tex.Texture = 'rbxassetid://' .. texId
                    tex.Face = face
                    tex.Color3 = part.Color
                    tex.Transparency = part.Transparency
                    tex.StudsPerTileU = 4
                    tex.StudsPerTileV = 4
                    tex.Parent = part
                end
                mcProcessedParts[part] = part.Material
                part.Material = Enum.Material.SmoothPlastic
            end
        end
    end
end

local function removeMinecraftTextures()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA('Texture') and obj.Name == 'MinecraftTex' then
            pcall(function() obj:Destroy() end)
        end
    end
    for part, origMat in pairs(mcProcessedParts) do
        if part and part.Parent then
            pcall(function() part.Material = origMat end)
        end
    end
    mcProcessedParts = {}
end

local function applyLightingSettings()
    if LightingModifications then
        lighting.Ambient = LightingSettings.CustomAmbient
        lighting.OutdoorAmbient = LightingSettings.CustomOutdoorAmbient
        lighting.ExposureCompensation = LightingSettings.CustomExposureCompensation
        lighting.FogStart = LightingSettings.CustomFogStart
        lighting.FogEnd = LightingSettings.CustomFogEnd
        lighting.FogColor = LightingSettings.CustomFogColor
        lighting.Brightness = LightingSettings.CustomBrightness
        lighting.ClockTime = LightingSettings.CustomClockTime
    end
end

RunService.RenderStepped:Connect(function()
    if LightingModifications then
        applyLightingSettings()
    end
end)

WorldGroup:AddToggle('lightingmodifications', {
    Text = 'Enable Lighting',
    Default = false,
    Callback = function(value)
        LightingModifications = value
        if value then
            applyLightingSettings()
        else
            lighting.Ambient = LightingSettings.DefaultAmbient
            lighting.OutdoorAmbient = LightingSettings.DefaultOutdoorAmbient
            lighting.ExposureCompensation = LightingSettings.DefaultExposureCompensation
            lighting.FogStart = LightingSettings.DefaultFogStart
            lighting.FogEnd = LightingSettings.DefaultFogEnd
            lighting.FogColor = LightingSettings.DefaultFogColor
            lighting.Brightness = LightingSettings.DefaultBrightness
            lighting.ClockTime = LightingSettings.DefaultClockTime
        end
    end
})
WorldGroup:AddToggle('MinecraftTextureToggle', {
    Text = 'Minecraft Texture',
    Default = false,
    Callback = function(val)
        if val then
            task.spawn(applyMinecraftTextures)
        else
            task.spawn(removeMinecraftTextures)
        end
    end
})

