    do
        RB.getShopItem = function(targetName)
            local shop = workspace:FindFirstChild('Ignored') and workspace.Ignored:FindFirstChild('Shop')
            if not shop then return nil, nil end
            local cleanTarget = string.lower(targetName or ''):gsub('[%[%]]', ''):gsub('%s', ''):gsub('-', '')
            if cleanTarget == "" then return nil, nil end

            local shopAliasTable = {
                ["bag"] = {"brownbag", "bag", "christmas_sock"},
                ["brownbag"] = {"brownbag", "bag", "christmas_sock"},
                ["knife"] = {"knife"},
                ["combat"] = {"combat", "combatknife"},
                ["bat"] = {"bat"},
                ["stopsing"] = {"stopsign", "stopsing"},
                ["stopsign"] = {"stopsign", "stopsing"},
                ["sledgehammer"] = {"sledgehammer"},
                ["doublebarrelsg"] = {"doublebarrelsg", "doublebarrel"},
                ["doublebarrel"] = {"doublebarrelsg", "doublebarrel"},
                ["db"] = {"doublebarrelsg", "doublebarrel"},
                ["shotgun"] = {"shotgun"},
                ["tacticalshotgun"] = {"tacticalshotgun"},
            }

            local aliases = shopAliasTable[cleanTarget] or {cleanTarget}

            for _, item in ipairs(shop:GetChildren()) do
                local rawName = item.Name
                local bracketName = string.match(rawName, "%b[]")
                local cleanBracket = bracketName and string.lower(bracketName):gsub('[%[%]]', ''):gsub('%s', ''):gsub('-', '') or ""
                for _, alias in ipairs(aliases) do
                    if cleanBracket == alias then
                        local head = item:FindFirstChild('Head') or item:FindFirstChildOfClass('BasePart') or item:FindFirstChildWhichIsA('BasePart')
                        local cd = item:FindFirstChildOfClass('ClickDetector') or item:FindFirstChildWhichIsA('ClickDetector')
                        if not cd then
                            for _, v in ipairs(item:GetDescendants()) do
                                if v:IsA('ClickDetector') then cd = v; break end
                            end
                        end
                        if head and cd then return head, cd end
                    end
                end
            end

            for _, item in ipairs(shop:GetChildren()) do
                local rawName = item.Name
                local bracketName = string.match(rawName, "%b[]")
                local cleanBracket = bracketName and string.lower(bracketName):gsub('[%[%]]', ''):gsub('%s', ''):gsub('-', '') or ""
                local cleanItem = string.lower(rawName):gsub('[%[%]]', ''):gsub('%s', ''):gsub('-', '')
                for _, alias in ipairs(aliases) do
                    if cleanBracket:find(alias, 1, true) or cleanItem:find(alias, 1, true) then
                        local head = item:FindFirstChild('Head') or item:FindFirstChildOfClass('BasePart') or item:FindFirstChildWhichIsA('BasePart')
                        local cd = item:FindFirstChildOfClass('ClickDetector') or item:FindFirstChildWhichIsA('ClickDetector')
                        if not cd then
                            for _, v in ipairs(item:GetDescendants()) do
                                if v:IsA('ClickDetector') then cd = v; break end
                            end
                        end
                        if head and cd then return head, cd end
                    end
                end
            end

            return nil, nil
        end

        RB.findGun = function(parent)
            if not parent then return nil end
            for _, t in ipairs(parent:GetChildren()) do
                if t:IsA('Tool') and t:FindFirstChild('Ammo') then
                    return t
                end
            end
            return nil
        end

        RB.getCurrentGunName = function()
            local char = LocalPlayer.Character
            local bp   = LocalPlayer.Backpack
            local gun  = (char and RB.findGun(char)) or (bp and RB.findGun(bp))
            if not gun then return nil end
            return gun.Name:lower():gsub('[%[%]]', ''):gsub('%s', '')
        end

        RB.hasSpecificGun = function(wepName)
            if not wepName then return false end
            local clean = string.lower(wepName):gsub('[%[%]]', ''):gsub('%s', ''):gsub('-', '')
            if clean == "" then return false end
            local function check(parent)
                if not parent then return false end
                for _, t in ipairs(parent:GetChildren()) do
                    if t:IsA('Tool') and t.Name ~= "" then
                        local cleanTool = string.lower(t.Name):gsub('[%[%]]', ''):gsub('%s', ''):gsub('-', '')
                        if cleanTool == clean or cleanTool:find(clean, 1, true) or (#clean >= 3 and clean:find(cleanTool, 1, true)) then
                            return true
                        end
                    end
                end
                return false
            end
            local char = LocalPlayer.Character
            local bp   = LocalPlayer:FindFirstChild("Backpack")
            return check(char) or check(bp)
        end

        RB.hasGun = function()
            local char = LocalPlayer.Character
            local bp   = LocalPlayer:FindFirstChild("Backpack")
            return (char and RB.findGun(char)) ~= nil or (bp and RB.findGun(bp)) ~= nil
        end

        RB.buyGun = function(wepName)
            if RB.buyingWeapon then return end
            if RB.hasSpecificGun(wepName) then return end
            RB.buyingWeapon = true
            task.spawn(function()
                pcall(function()
                    local char = LocalPlayer.Character
                    local hrp  = char and char:FindFirstChild('HumanoidRootPart')
                    if not hrp then RB.buyingWeapon = false return end
                    local origCF = hrp.CFrame

                    local head, cd = RB.getShopItem(wepName)
                    if not head or not cd then
                        head, cd = RB.getShopItem(wepName:gsub("%s+", ""):gsub("-", ""))
                    end
                    if head and cd then
                        local shopCF = CFrame.new(head.Position - Vector3.new(0, 5.5, 0))
                        local attempts = 0
                        while not RB.hasSpecificGun(wepName) and attempts < 25 do
                            local c = LocalPlayer.Character
                            local r = c and c:FindFirstChild('HumanoidRootPart')
                            local h = c and c:FindFirstChildOfClass('Humanoid')
                            if not r or not h or h.Health <= 0 then break end

                            RB.forceCFrame = shopCF
                            r.CFrame = shopCF
                            r.AssemblyLinearVelocity = Vector3.zero
                            r.AssemblyAngularVelocity = Vector3.zero
                            pcall(function() fireclickdetector(cd) end)
                            pcall(function() fireclickdetector(cd, 0) end)
                            pcall(function() fireclickdetector(cd, 5) end)
                            pcall(function() fireclickdetector(cd, 10) end)
                            pcall(function() fireclickdetector(cd, 0, 'MouseClick') end)
                            pcall(function() fireclickdetector(cd, 1) end)
                            task.wait(0.08)
                            if RB.hasSpecificGun(wepName) then break end
                            attempts = attempts + 1
                        end
                        RB.forceCFrame = nil
                        local c2 = LocalPlayer.Character
                        local r2 = c2 and c2:FindFirstChild('HumanoidRootPart')
                        if r2 then r2.CFrame = origCF end
                    end
                end)
                RB.forceCFrame = nil
                RB.buyingWeapon = false
            end)
        end
    end

    _G.rb_failedAmmoBuy = _G.rb_failedAmmoBuy or {}

    do
        RB.getShopAmmoItem = function(gunName)
            local shop = workspace:FindFirstChild('Ignored') and workspace.Ignored:FindFirstChild('Shop')
            if not shop then return nil, nil end
            local cleanGun = string.lower(gunName or ''):gsub('[%[%]]', ''):gsub('%s', ''):gsub('-', '')

            for _, item in ipairs(shop:GetChildren()) do
                local cleanItem = string.lower(item.Name):gsub('[%[%]]', ''):gsub('%s', ''):gsub('-', '')
                if cleanItem:find(cleanGun, 1, true) and cleanItem:find("ammo", 1, true) then
                    local head = item:FindFirstChild('Head') or item:FindFirstChildOfClass('BasePart') or item:FindFirstChildWhichIsA('BasePart')
                    local cd = item:FindFirstChildOfClass('ClickDetector')
                    if not cd then
                        for _, v in ipairs(item:GetDescendants()) do
                            if v:IsA('ClickDetector') then cd = v; break end
                        end
                    end
                    if head and cd then return head, cd end
                end
            end

            local genericAmmoMap = {
                ["doublebarrelsg"] = "12 gauge",
                ["doublebarrel"] = "12 gauge",
                ["shotgun"] = "12 gauge",
                ["tacticalshotgun"] = "12 gauge",
                ["revolver"] = "revolver",
                ["glock"] = "9mm",
                ["silencer"] = "9mm",
                ["smg"] = "9mm",
                ["p90"] = "9mm",
                ["drumgun"] = "9mm",
                ["ak47"] = "7.62",
                ["ar"] = "5.56",
                ["silencerar"] = "5.56",
                ["aug"] = "5.56",
                ["rifle"] = "5.56",
                ["lmg"] = "5.56",
                ["rpg"] = "rpg",
                ["flamethrower"] = "flamethrower"
            }
            local ammoTerm = genericAmmoMap[cleanGun]
            if ammoTerm then
                local cleanAmmoTerm = string.lower(ammoTerm):gsub('%s', ''):gsub('-', '')
                for _, item in ipairs(shop:GetChildren()) do
                    local cleanItem = string.lower(item.Name):gsub('[%[%]]', ''):gsub('%s', ''):gsub('-', '')
                    if cleanItem:find(cleanAmmoTerm, 1, true) and (cleanItem:find("ammo", 1, true) or cleanAmmoTerm == "12gauge" or cleanAmmoTerm == "9mm" or cleanAmmoTerm == "7.62" or cleanAmmoTerm == "5.56") then
                        local head = item:FindFirstChild('Head') or item:FindFirstChildOfClass('BasePart') or item:FindFirstChildWhichIsA('BasePart')
                        local cd = item:FindFirstChildOfClass('ClickDetector')
                        if not cd then
                            for _, v in ipairs(item:GetDescendants()) do
                                if v:IsA('ClickDetector') then cd = v; break end
                            end
                        end
                        if head and cd then return head, cd end
                    end
                end
            end
            return nil, nil
        end

        RB.buyAmmo = function(tool)
            if RB.buyingAmmo or not tool then return end
            if _G.rb_failedAmmoBuy[tool] and tick() < _G.rb_failedAmmoBuy[tool] then return end
            RB.buyingAmmo = true
            task.spawn(function()
                pcall(function()
                    local char = LocalPlayer.Character
                    local hum  = char and char:FindFirstChildOfClass("Humanoid")
                    if hum then pcall(function() hum:UnequipTools() end) end

                    RB.reloadTool()
                    task.wait(0.05)
                    if tool:FindFirstChild("Ammo") and tool.Ammo.Value > 0 then
                        RB.buyingAmmo = false
                        return
                    end

                    local char = LocalPlayer.Character
                    local hrp  = char and char:FindFirstChild('HumanoidRootPart')
                    if not hrp then RB.buyingAmmo = false return end
                    local origCF = hrp.CFrame

                    local gunName = tool.Name:gsub('[%[%]]', ''):gsub('%s', '')
                    local head, cd = RB.getShopAmmoItem(gunName)
                    if not head or not cd then
                        _G.rb_failedAmmoBuy[tool] = tick() + 5
                        RB.buyingAmmo = false
                        return
                    end

                    local shopCF = CFrame.new(head.Position - Vector3.new(0, 5.5, 0))
                    local attempts = 0
                    while attempts < 25 do
                        local c = LocalPlayer.Character
                        local r = c and c:FindFirstChild('HumanoidRootPart')
                        local h = c and c:FindFirstChildOfClass('Humanoid')
                        if not r or not h or h.Health <= 0 then break end
                        if tool:FindFirstChild('Ammo') and tool.Ammo.Value > 0 then break end

                        RB.forceCFrame = shopCF
                        r.CFrame = shopCF
                        r.AssemblyLinearVelocity = Vector3.zero
                        r.AssemblyAngularVelocity = Vector3.zero
                        pcall(function() fireclickdetector(cd) end)
                        pcall(function() fireclickdetector(cd, 0) end)
                        pcall(function() fireclickdetector(cd, 5) end)
                        pcall(function() fireclickdetector(cd, 10) end)
                        pcall(function() fireclickdetector(cd, 0, 'MouseClick') end)
                        pcall(function() fireclickdetector(cd, 1) end)
                        pcall(function() ReplicatedStorage.MainEvent:FireServer("Reload", tool) end)
                        task.wait(0.08)
                        attempts = attempts + 1
                    end
                    RB.forceCFrame = nil
                    local c2 = LocalPlayer.Character
                    local r2 = c2 and c2:FindFirstChild('HumanoidRootPart')
                    if r2 then r2.CFrame = origCF end

                    if tool:FindFirstChild('Ammo') and tool.Ammo.Value <= 0 then
                        _G.rb_failedAmmoBuy[tool] = tick() + 5
                    end
                end)
                RB.forceCFrame = nil
                RB.buyingAmmo = false
            end)
        end
    end

    do
        RB.getMyBag = function()
            local char = LocalPlayer.Character
            local bp   = LocalPlayer:FindFirstChild("Backpack")
            if not char and not bp then return nil end
            for _, name in ipairs({'[BrownBag]','[Christmas_Sock]','[Bag]','BrownBag','Bag'}) do
                local t = (char and char:FindFirstChild(name)) or (bp and bp:FindFirstChild(name))
                if t then return t end
            end
            if char then
                for _, t in ipairs(char:GetChildren()) do
                    if t:IsA('Tool') and t.Name:lower():find('bag') then return t end
                end
            end
            if bp then
                for _, t in ipairs(bp:GetChildren()) do
                    if t:IsA('Tool') and t.Name:lower():find('bag') then return t end
                end
            end
            return nil
        end

        RB.isTargetBagged = function(plr)
            if not plr or not plr.Character then return false end
            for _, name in ipairs({'Christmas_Sock','BrownBag','Bag','SantaBag','HalloweenBag','Socks'}) do
                local c = plr.Character:FindFirstChild(name, true)
                if c and not c:IsA('Tool') then return true end
            end
            return false
        end

        RB.buyBag = function()
            if RB.buyingBag then return end
            if RB.getMyBag() then return end
            RB.buyingBag = true
            task.spawn(function()
                pcall(function()
                    local char = LocalPlayer.Character
                    local hrp  = char and char:FindFirstChild('HumanoidRootPart')
                    if not hrp then RB.buyingBag = false return end
                    local origCF = hrp.CFrame
                    local head, cd = RB.getShopItem('bag')
                    if not head or not cd then
                        head, cd = RB.getShopItem('brownbag')
                    end
                    if not head or not cd then RB.buyingBag = false return end
                    local shopCF = CFrame.new(head.Position - Vector3.new(0, 5.5, 0))
                    local attempts = 0
                    while RB.getMyBag() == nil and attempts < 15 do
                        local c = LocalPlayer.Character
                        if not c then break end
                        local r = c:FindFirstChild('HumanoidRootPart')
                        local h = c:FindFirstChildOfClass('Humanoid')
                        if not r or not h or h.Health <= 0 then break end
                        RB.forceCFrame = shopCF
                        r.CFrame = shopCF
                        r.AssemblyLinearVelocity = Vector3.new(0, 1.85, 0)
                        task.wait(0.08)
                        pcall(function() fireclickdetector(cd) end)
                        pcall(function() fireclickdetector(cd, 0) end)
                        pcall(function() fireclickdetector(cd, 0, 'MouseClick') end)
                        task.wait(0.1)
                        attempts = attempts + 1
                    end
                    RB.forceCFrame = nil
                    local c2 = LocalPlayer.Character
                    local r2 = c2 and c2:FindFirstChild('HumanoidRootPart')
                    if r2 then r2.CFrame = origCF end
                end)
                RB.forceCFrame = nil
                RB.buyingBag = false
            end)
        end

        RB.getBagCFrame = function(targetRoot)
            if not targetRoot then return nil end
            local baseCF = targetRoot.CFrame * CFrame.Angles(math.rad(90), 0, math.rad(180)) - Vector3.new(0, 0.5, 0)
            return baseCF
        end
        _G.rb_getBagCFrame = RB.getBagCFrame

        RB.useBag = function(target)
            if _G.rb_bagging then return end
            if RB.isTargetBagged(target) then return end
            local bag = RB.getMyBag()
            if not bag or not target or not target.Character then return end
            _G.rb_bagging = true
            task.spawn(function()
                pcall(function()
                    local attempts = 0
                    while not RB.isTargetBagged(target) and attempts < 25 do
                        local char = LocalPlayer.Character
                        local root = char and char:FindFirstChild('HumanoidRootPart')
                        local hum  = char and char:FindFirstChildOfClass('Humanoid')
                        if not root or not hum or hum.Health <= 0 then break end
                        local targetChar = target.Character
                        local targetRoot = targetChar and targetChar:FindFirstChild('HumanoidRootPart')
                        if not targetRoot then break end
                        local tBE = targetChar:FindFirstChild('BodyEffects')
                        if (tBE and tBE:FindFirstChild('K.O') and tBE['K.O'].Value)
                        or (tBE and tBE:FindFirstChild('SDeath') and tBE['SDeath'].Value) then break end
                        bag = RB.getMyBag()
                        if not bag then break end
                        local tPart = targetChar:FindFirstChild('UpperTorso') or targetChar:FindFirstChild('Head') or targetRoot
                        local bagCF = RB.getBagCFrame(targetRoot)
                        if bagCF then
                            RB.forceCFrame = bagCF
                            pcall(function()
                                root.CFrame = bagCF
                                root.AssemblyLinearVelocity = Vector3.zero
                                root.Velocity = Vector3.zero
                            end)
                        end
                        pcall(function() hum:EquipTool(bag) end)
                        task.wait(0.02)
                        pcall(function() bag:Activate() end)
                        local handle = bag:FindFirstChild('Handle') or bag:FindFirstChildOfClass('Part') or bag:FindFirstChildWhichIsA('BasePart')
                        if handle and tPart and firetouchinterest then
                            pcall(function() firetouchinterest(handle, tPart, 0) firetouchinterest(handle, tPart, 1) end)
                        end
                        pcall(function()
                            local ev = ReplicatedStorage:FindFirstChild('MainEvent')
                            if ev then ev:FireServer('Bag', targetRoot) ev:FireServer('UseBag', target) ev:FireServer('BagPlayer', target) end
                        end)
                        task.wait(0.04)
                        attempts = attempts + 1
                    end
                end)
                RB.forceCFrame = nil
                _G.rb_bagging = false
            end)
        end
    end

    task.spawn(function()
        local localPlayerDiedThisLife = false
        while task.wait(0.2) do
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local be = char and char:FindFirstChild("BodyEffects")
            local isDead = (hum and hum.Health <= 0) or (be and be:FindFirstChild("SDeath") and be.SDeath.Value == true)
            if isDead then
                if not localPlayerDiedThisLife then
                    localPlayerDiedThisLife = true
                    if RB.notificationsEnabled then
                        RB.deathCount = RB.deathCount + 1
                        Library:Notify(string.format("✦ DEATH  [%d / %d]", RB.killCount, RB.deathCount), 4)
                    end
                end
            else
                localPlayerDiedThisLife = false
            end
        end
    end)

    task.spawn(function()
        while RunService.Heartbeat:Wait() do
            local char = LocalPlayer.Character
            if char then
                local hum  = char:FindFirstChildOfClass("Humanoid")
                local root = hum and hum.RootPart
                if root then
                    if _G.rb_bagging and RB.lockedTarget and RB.lockedTarget.Character then
                        local tHRP = RB.lockedTarget.Character:FindFirstChild("HumanoidRootPart")
                        if tHRP then
                            if sethiddenproperty then pcall(sethiddenproperty, root, "PhysicsRepRootPart", tHRP) end
                            RB.forceCFrame = _G.rb_getBagCFrame(tHRP)
                        else
                            if sethiddenproperty then pcall(sethiddenproperty, root, "PhysicsRepRootPart", nil) end
                        end
                    else
                        if sethiddenproperty then pcall(sethiddenproperty, root, "PhysicsRepRootPart", nil) end
                    end
                end
            end
        end
    end)

    _G.rbStompFrameCount = 0

    _G.rb_steppedMove = function(root, targetCF)
        if not root or not root.Parent then return end
        local dist = (root.CFrame.Position - targetCF.Position).Magnitude
        if dist < 4 then
            pcall(function()
                root.CFrame = targetCF
                root.AssemblyLinearVelocity = Vector3.zero
            end)
            return
        end
        local steps = math.clamp(math.floor(dist / 15), 1, 4)
        local startCF = root.CFrame
        local dir = (targetCF.Position - startCF.Position).Unit
        pcall(function()
            root.AssemblyLinearVelocity = dir * math.clamp(dist * 3, 30, 90)
        end)
        for i = 1, steps do
            local alpha = i / steps
            local midPos = startCF.Position:Lerp(targetCF.Position, alpha)
            local midCF  = CFrame.new(midPos, midPos + (targetCF.LookVector))
            pcall(function()
                root.CFrame = midCF
                if i < steps then
                    root.AssemblyLinearVelocity = dir * math.clamp(dist * 3 * (1 - alpha * 0.5), 20, 90)
                else
                    root.AssemblyLinearVelocity = Vector3.zero
                end
            end)
            if i < steps then RunService.Heartbeat:Wait() end
        end
        pcall(function() root.CFrame = targetCF end)
    end

    RunService.Heartbeat:Connect(function(dt)
        if not RB.active then
            _G.rb_isInCombat=false
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root and RB.savedCFrame then
                pcall(function()
                    root.Velocity = Vector3.zero
                    root.RotVelocity = Vector3.zero
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.CFrame = RB.savedCFrame
                end)
                RB.savedCFrame = nil
            end
            RB.setStatus("")
            if not RB.viewactive and not kfSpectating and LocalPlayer.Character then
                workspace.CurrentCamera.CameraSubject = LocalPlayer.Character:FindFirstChild("Humanoid")
            end
            return
        end
        local Character = LocalPlayer.Character
        local RootPart  = Character and Character:FindFirstChild("HumanoidRootPart")
        if not RootPart then return end
        local BodyEffects = Character:FindFirstChild("BodyEffects")
        local isReloadingValue = BodyEffects and BodyEffects:FindFirstChild("Reload") and BodyEffects.Reload.Value

        local isLowAmmo = false
        local emptyGunTool = nil
        for _, tool in ipairs(Character:GetChildren()) do
            if tool:IsA("Tool") and tool:FindFirstChild("Ammo") then
                if tool.Ammo.Value <= 0 then
                    isLowAmmo = true
                    emptyGunTool = tool
                    break
                end
            end
        end

        if not emptyGunTool and LocalPlayer.Backpack then
            for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
                if tool:IsA("Tool") and tool:FindFirstChild("Ammo") and tool.Ammo.Value <= 0 then
                    emptyGunTool = tool
                    break
                end
            end
        end

        if RB.autoBuyAmmo and emptyGunTool and not RB.buyingWeapon and not RB.buyingAmmo then
            if not _G.rb_failedAmmoBuy[emptyGunTool] or tick() > _G.rb_failedAmmoBuy[emptyGunTool] then
                local hum = Character:FindFirstChildOfClass("Humanoid")
                if hum then pcall(function() hum:UnequipTools() end) end
                _G.rb_voiding = true
                _G.rb_teleporting = false
                RB.setStatus('buying ammo: ' .. emptyGunTool.Name)
                RB.buyAmmo(emptyGunTool)
                return
            end
        end

        if isReloadingValue or isLowAmmo then
            _G.rb_voiding = true
            _G.rb_teleporting = false
            RB.setStatus("reloading... (void)")
            RB.voidSelf(RootPart)
            RB.reloadTool()
            if RB.viewactive and RB.lockedTarget and RB.lockedTarget.Character then
                local tHumanoid   = RB.lockedTarget.Character:FindFirstChildOfClass("Humanoid")
                local tUpperTorso = RB.lockedTarget.Character:FindFirstChild("UpperTorso")
                workspace.CurrentCamera.CameraSubject = tHumanoid or tUpperTorso or Character:FindFirstChild("Humanoid")
            elseif not kfSpectating then
                workspace.CurrentCamera.CameraSubject = Character:FindFirstChild("Humanoid")
            end
            return
        end
        if not RB.lockedTarget or _G.rb_shouldSwitch then
            RB.lockedTarget=nil _G.rb_shouldSwitch=false _G.rb_lockedTargetUserId=nil
            if RB.selecttargets and #RB.targets > 0 then
                for attempt=1,#RB.targets do
                    _G.rb_currentTargetIndex=(_G.rb_currentTargetIndex%#RB.targets)+1
                    local candidate = RB.targets[_G.rb_currentTargetIndex]
                    if candidate and candidate.Character then
                        local be  = candidate.Character:FindFirstChild("BodyEffects")
                        local hum = candidate.Character:FindFirstChild("Humanoid")
                        local gra = candidate.Character:FindFirstChild("GRABBING_CONSTRAINT")
                        if be and hum and hum.Health>0 and not gra then
                            local sd = be:FindFirstChild("SDeath") and be["SDeath"].Value
                            if not sd then RB.lockedTarget=candidate break end
                        end
                    end
                end
            else
                local closestDist = math.huge
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr~=LocalPlayer and plr.Character then
                        local tHRP = plr.Character:FindFirstChild("HumanoidRootPart")
                        local tHum = plr.Character:FindFirstChild("Humanoid")
                        local be   = plr.Character:FindFirstChild("BodyEffects")
                        local gra  = plr.Character:FindFirstChild("GRABBING_CONSTRAINT")
                        if tHRP and tHum and tHum.Health>0 and be and not gra then
                            local isKO = be:FindFirstChild("K.O") and be["K.O"].Value
                            local sd   = be:FindFirstChild("SDeath") and be["SDeath"].Value
                            if not sd then
                                local dist = (tHRP.Position - RootPart.Position).Magnitude
                                local eff  = isKO and (dist+10000) or dist
                                if eff < closestDist then closestDist=eff RB.lockedTarget=plr end
                            end
                        end
                    end
                end
            end
        end
        if not RB.lockedTarget or not RB.lockedTarget.Character then
            if RB.lockedTarget and not RB.lockedTarget:IsDescendantOf(game) then
                _G.rb_lockedTargetUserId=nil RB.lockedTarget=nil _G.rb_shouldSwitch=true
            end
            _G.rb_isInCombat=false _G.rb_voiding=true _G.rb_teleporting=false
            RB.setStatus("no target... (void)")
            RB.voidSelf(RootPart)
            RB.reloadTool()
            if not kfSpectating then workspace.CurrentCamera.CameraSubject=Character:FindFirstChild("Humanoid") end
            return
        end
        if RB.lockedTarget then _G.rb_lockedTargetUserId = RB.lockedTarget.UserId end
        local TargetChar = RB.lockedTarget.Character
        local TargetRoot  = TargetChar and TargetChar:FindFirstChild("HumanoidRootPart")
        local UpperTorso  = TargetChar and TargetChar:FindFirstChild("UpperTorso")
        local TargetBE    = TargetChar and TargetChar:FindFirstChild("BodyEffects")
        local TargetHum   = TargetChar and TargetChar:FindFirstChild("Humanoid")
        local TargetFF    = TargetChar and TargetChar:FindFirstChildOfClass("ForceField")
        if TargetRoot then _G.rb_lastKnownTargetPos = TargetRoot.Position end
        if not TargetRoot or not TargetHum or TargetHum.Health<=0 then _G.rb_shouldSwitch=true _G.rb_isInCombat=false return end
        local isKO = TargetBE and TargetBE:FindFirstChild("K.O")    and TargetBE["K.O"].Value
        local isSD = TargetBE and TargetBE:FindFirstChild("SDeath") and TargetBE["SDeath"].Value

        if RB.buyingWeapon then return end
        if RB.autoBuyWeapon then
            local weapons = Options.RbAutoBuyWeaponSelect and Options.RbAutoBuyWeaponSelect.Value
            local wepList = {}
            if type(weapons) == "table" then
                for name, sel in pairs(weapons) do
                    if type(name) == "number" and type(sel) == "string" then
                        table.insert(wepList, sel)
                    elseif type(name) == "string" and sel == true then
                        table.insert(wepList, name)
                    end
                end
            end
            if #wepList > 0 then
                for _, wn in ipairs(wepList) do
                    if not RB.hasSpecificGun(wn) then
                        RB.setStatus('buying weapon: ' .. wn)
                        RB.buyGun(wn)
                        return
                    end
                end
            end
        end

        if RB.buyingAmmo then return end
        if RB.autoBuyAmmo then
            local emptyTool = nil
            local charTools = Character and Character:GetChildren() or {}
            local bp        = LocalPlayer:FindFirstChild("Backpack")
            local bpTools   = bp and bp:GetChildren() or {}
            local function isToolEmpty(t)
                if t:IsA('Tool') and t:FindFirstChild('Ammo') and t.Ammo.Value <= 0 then
                    if not _G.rb_failedAmmoBuy[t] or tick() > _G.rb_failedAmmoBuy[t] then
                        return true
                    end
                end
                return false
            end
            for _, t in ipairs(charTools) do
                if isToolEmpty(t) then emptyTool = t; break end
            end
            if not emptyTool then
                for _, t in ipairs(bpTools) do
                    if isToolEmpty(t) then emptyTool = t; break end
                end
            end
            if emptyTool then
                local hum = Character:FindFirstChildOfClass("Humanoid")
                if hum then pcall(function() hum:UnequipTools() end) end
                _G.rb_voiding = true
                _G.rb_teleporting = false
                RB.setStatus('buying ammo: ' .. emptyTool.Name)
                RB.buyAmmo(emptyTool)
                return
            end
        end

        if not isKO and not isSD then
            if RB.lockedTarget then RB.killedTargets[RB.lockedTarget.UserId] = nil end
        end

        if (isKO or isSD) and RB.lockedTarget then
            local tuid = RB.lockedTarget.UserId
            if not RB.killedTargets[tuid] then
                RB.killedTargets[tuid] = true
                if RB.notificationsEnabled then
                    RB.killCount = RB.killCount + 1
                    Library:Notify(string.format("✦ KILL  %s  [%d / %d]", RB.lockedTarget.DisplayName or RB.lockedTarget.Name, RB.killCount, RB.deathCount), 4)
                end
                if RB.trashTalkAutoEnabled then
                    if not RB.trashSent[tuid] or tick() - RB.trashSent[tuid] > 5 then
                        RB.trashSent[tuid] = tick()
                        task.spawn(function()
                            task.wait(0.3)
                            local phrase = RB.trashPhrases[math.random(1, #RB.trashPhrases)]
                            RB.sendChat(phrase)
                        end)
                    end
                end
            end
        end

        if isSD then
            _G.rb_isInCombat=false _G.rb_shouldSwitch=true RB.lockedTarget=nil
            _G.rb_smoothedTargetPos=nil _G.rb_voiding=true _G.rb_teleporting=false
            RB.setStatus("target dead... (switching)")
            RB.voidSelf(RootPart)
            RB.reloadTool()
            return
        end
        if TargetFF then
            _G.rb_isInCombat=false _G.rb_voiding=true _G.rb_teleporting=false
            RB.setStatus("waiting FF... (void)")
            RB.voidSelf(RootPart)
            RB.reloadTool()
            if RB.viewactive then workspace.CurrentCamera.CameraSubject = TargetHum or UpperTorso
            elseif not kfSpectating then workspace.CurrentCamera.CameraSubject = Character:FindFirstChild("Humanoid") end
            return
        end
        _G.rb_isInCombat=true _G.rb_voiding=false _G.rb_teleporting=true
        if RB.viewactive then workspace.CurrentCamera.CameraSubject = TargetHum or UpperTorso
        elseif not kfSpectating then workspace.CurrentCamera.CameraSubject = Character:FindFirstChild("Humanoid") end
              if isKO and UpperTorso and RB.stompactive and _G.rb_canrun then
            _G.rb_teleporting = false
            _G.rb_voiding = false
            RB.setStatus("stomping: " .. (RB.lockedTarget.DisplayName or RB.lockedTarget.Name))
            pcall(function()
                RootPart.Velocity = Vector3.zero
                RootPart.RotVelocity = Vector3.zero
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
                RootPart.CFrame = CFrame.new(UpperTorso.Position + Vector3.new(0, 3.5, 0))
            end)
            _G.rbStompFrameCount = (_G.rbStompFrameCount or 0) + 1
            if _G.rbStompFrameCount >= 2 then
                _G.rbStompFrameCount = 0
                pcall(function()
                    ReplicatedStorage.MainEvent:FireServer("Stomp")
                end)
            end
            return
        end

        if not isKO then
            RB.setStatus("killing: "..RB.lockedTarget.Name)
        end

        if not isKO and _G.rb_canrun then
            local tPos = TargetRoot.Position

            if TargetRoot then
                if applyToHRP then applyToHRP(TargetRoot) end
                if HitboxVisuals and HitboxVisuals[TargetRoot] then HitboxVisuals[TargetRoot].CFrame = TargetRoot.CFrame end
            end

            if not RB.flamethrower_hack then _G.rb_smoothedTargetPos=nil end

            if RB.flamethrower_hack then
                local targetHead = TargetChar:FindFirstChild("Head") or UpperTorso or TargetRoot
                local targetHeadPos = targetHead and targetHead.Position or tPos
                _G.rb_orbitAngle = ((_G.rb_orbitAngle or 0) + 3.5 * dt) % (2 * math.pi)
                local ox = math.cos(_G.rb_orbitAngle) * 11
                local oz = math.sin(_G.rb_orbitAngle) * 11
                local flamePos = targetHeadPos + Vector3.new(ox, 3.5, oz)
                pcall(function()
                    RootPart.Velocity = Vector3.zero
                    RootPart.RotVelocity = Vector3.zero
                    RootPart.AssemblyLinearVelocity = Vector3.zero
                    RootPart.AssemblyAngularVelocity = Vector3.zero
                    RootPart.CFrame = CFrame.lookAt(flamePos, targetHeadPos)
                end)
            elseif RB.abovetarget then
                local abovePos = tPos + Vector3.new(0, 6, 0)
                local targetCF = CFrame.lookAt(abovePos, tPos)
                _G.rb_steppedMove(RootPart, targetCF)
            else
                local stablePos = tPos + Vector3.new(0, 2, 6)
                local targetCF = CFrame.lookAt(stablePos, tPos)
                _G.rb_steppedMove(RootPart, targetCF)
            end
        end
    end)
end

do
    local KnifeGb, KnifePlayerDropdown, kfOriginCFrame, kfSpectating, messageLabel
    local kfPresetPhrases, lastTrashTalkTick, kfSendChatMessage
    local kfTv, kfOv, kfIsEnabled, kfUpdateStatus, kfFindPlayerFromLabel, kfIsBagged, kfGetBag
    local kfGetShopItem, kfForceCFrame, kfFindMelee, kfBuyingBag, kfBuyBag, kfBuyingWeapon
    local kfBuyWeapon, kfGetHitbox, kfGetTargetPlayers, kfIsKO, kfHasForceField, kfIsDeadOrRespawning
    local kfTeleportToVoid, kfGetPrimaryTarget, kfEquipMelee

    do
        KnifeGb = Tabs.ragebot:AddLeftGroupbox('KnifeBot')
        KnifeGb:AddToggle('KnifeEnabled', { Text = 'enabled', Default = false })
            :AddKeyPicker('KnifeEnabledKey', { Default = 'X', Mode = 'Toggle', Text = 'KnifeBot', SyncToggleState = false, NoUI = false })
        KnifeGb:AddToggle('KnifeAutoSwing', { Text = 'heavy attack', Default = false })
        KnifeGb:AddDropdown('KnifeAutoSwingWeapon', {
            Values = { 'Knife', 'Combat', 'Bat', 'Stopsing', 'Sledgehammer' },
            Default = 1,
            Multi = false,
            Text = 'Auto Swing Weapon'
        })
        KnifeGb:AddToggle('KnifeFastLightAttacks', { Text = 'fast attacks', Default = false })
        KnifeGb:AddToggle('KnifeAutoBuyWeapon', { Text = 'auto buy weapon', Default = false })
        KnifeGb:AddDropdown('KnifeAutoBuyWeaponSelect', {
            Values = { 'Knife', 'Bat', 'Stopsing', 'Sledgehammer' },
            Default = 1,
            Multi = false,
            Text = 'Auto Buy Weapon Select'
        })

        KnifeGb:AddToggle('KnifeGlue', { Text = 'glue connection', Default = false })
            :AddKeyPicker('KnifeGlueKey', { Default = 'G', Mode = 'Toggle', Text = 'Glue', SyncToggleState = true, NoUI = false })
        KnifeGb:AddToggle('KnifeAutoStomp', { Text = 'auto stomp KO target', Default = true })
        KnifeGb:AddToggle('KnifeAutoTrashTalk', { Text = 'auto trash talk', Default = false })
        KnifeGb:AddDropdown('KnifeTrashTalkMode', {
            Values = { 'Random Presets', 'Custom' },
            Multi = false,
            Text = 'Trash Talk Mode'
        })
        KnifeGb:AddInput('KnifeCustomTrashTalk', {
            Default = 'KraviX ON TOP!',
            Numeric = false,
            Finished = false,
            Text = 'Custom Trash Talk',
            Placeholder = 'Enter custom trash talk...'
        })
        KnifeGb:AddSlider('KnifeDistance', { Text = 'Distance', Default = 3, Min = 0, Max = 20, Rounding = 0 })
        KnifeGb:AddSlider('KnifeHitboxSize', { Text = 'Hitbox Size', Default = 21, Min = 1, Max = 100, Rounding = 0 })

        kfPresetPhrases = {
            "Get KraviX",
            "KraviX taught you a lesson again",
            "Dominated by KraviX, accept it",
            "Trash detected, get out",
            "KraviX dominated",
            "Accept the L",
            "hahaha"
        }

        lastTrashTalkTick = 0
        kfSendChatMessage = function(msg)
            if not msg or msg == "" then return end
            pcall(function()
                local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
                if chatEvents and chatEvents:FindFirstChild("SayMessageRequest") then
                    chatEvents.SayMessageRequest:FireServer(msg, "All")
                end
            end)
            pcall(function()
                local textChatService = game:GetService("TextChatService")
                if textChatService and textChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                    local general = textChatService:FindFirstChild("TextChannels", true) and textChatService.TextChannels:FindFirstChild("RBXGeneral")
                    if general then
                        general:SendAsync(msg)
                    end
                end
            end)
        end

        local function knifeGetPlayers()
            local values = {}
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local formatted = player.DisplayName .. " (@" .. player.Name .. ")"
                    table.insert(values, formatted)
                end
            end
            table.sort(values)
            return values
        end

        KnifePlayerDropdown = KnifeGb:AddDropdown('KnifeSelectPlayer', {
            Values = knifeGetPlayers(),
            Default = 1,
            Multi = true,
            Text = 'Select Target(s)'
        })

        Players.PlayerAdded:Connect(function()
            task.delay(0.5, function()
                if KnifePlayerDropdown and KnifePlayerDropdown.SetValues then
                    KnifePlayerDropdown:SetValues(knifeGetPlayers())
                end
            end)
        end)
        Players.PlayerRemoving:Connect(function()
            task.delay(0.5, function()
                if KnifePlayerDropdown and KnifePlayerDropdown.SetValues then
                    KnifePlayerDropdown:SetValues(knifeGetPlayers())
                end
            end)
        end)

        kfOriginCFrame = nil
        kfSpectating = false

        do
            getgenv()._kfGui = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("KnifebotStatusGui")
            if not getgenv()._kfGui then
                getgenv()._kfGui = Instance.new("ScreenGui")
                getgenv()._kfGui.Name = "KnifebotStatusGui"
                getgenv()._kfGui.ResetOnSpawn = false
                getgenv()._kfGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
            end

            messageLabel = getgenv()._kfGui:FindFirstChild("StatusLabel")
            if not messageLabel then
                messageLabel = Instance.new("TextLabel")
                messageLabel.Name = "StatusLabel"
                messageLabel.BackgroundTransparency = 1
                messageLabel.Size = UDim2.new(1, 0, 0, 30)
                messageLabel.Position = UDim2.new(0, 0, 0.5, 0)
                messageLabel.AnchorPoint = Vector2.new(0, 0.5)
                messageLabel.Font = 2
                messageLabel.TextSize = 13
                messageLabel.TextXAlignment = Enum.TextXAlignment.Center
                messageLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                messageLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                messageLabel.TextStrokeTransparency = 0
                messageLabel.Text = ""
                messageLabel.Parent = getgenv()._kfGui
            end
        end
    end

    do
        kfTv = function(n) local t = Toggles[n] return t and t.Value end
        kfOv = function(n) local o = Options[n] return o and o.Value end

        getgenv().KnifeBotActive = false
        kfIsEnabled = function()
            if getgenv().Flying then return false end
            return kfTv('KnifeEnabled') and getgenv().KnifeBotActive
        end

        kfUpdateStatus = function(text)
            if not kfIsEnabled() then
                if messageLabel then messageLabel.Text = "" end
                return
            end
            if messageLabel then messageLabel.Text = text or "" end
        end

        kfFindPlayerFromLabel = function(label)
            if type(label) ~= "string" or label == "" then return nil end
            local username = string.match(label, "%(@([^%)]+)%)")
            if username then
                local plr = Players:FindFirstChild(username)
                if plr then return plr end
            end
            local direct = Players:FindFirstChild(label)
            if direct then return direct end
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name == label or p.DisplayName == label or (p.DisplayName .. " (@" .. p.Name .. ")") == label then
                    return p
                end
            end
            return nil
        end

        kfIsBagged = function(plr)
            if not plr or not plr.Character then return false end
            for _, name in ipairs({"Christmas_Sock","BrownBag","Bag","SantaBag","HalloweenBag","Socks"}) do
                local c = plr.Character:FindFirstChild(name, true)
                if c and not c:IsA("Tool") then return true end
            end
            return false
        end

        kfGetBag = function()
            local char = LocalPlayer.Character
            local bp = LocalPlayer.Backpack
            if not char then return nil end
            for _, name in ipairs({"[BrownBag]","[Christmas_Sock]","[Bag]","BrownBag"}) do
                local t = char:FindFirstChild(name) or (bp and bp:FindFirstChild(name))
                if t then return t end
            end
            return nil
        end

        kfGetShopItem = function(targetName)
            local shop = workspace:FindFirstChild("Ignored") and workspace.Ignored:FindFirstChild("Shop")
            if not shop then return nil, nil end
            local cleanTarget = string.lower(targetName or ""):gsub("[%[%]]", ""):gsub("%s", "")
            if cleanTarget == "stopsing" then cleanTarget = "stopsign" end
            for _, item in ipairs(shop:GetChildren()) do
                local cleanItem = string.lower(item.Name):gsub("[%[%]]", ""):gsub("%s", "")
                if cleanItem:find(cleanTarget, 1, true) then
                    local head = item:FindFirstChild("Head") or item:FindFirstChildOfClass("BasePart") or item:FindFirstChildWhichIsA("BasePart")
                    local cd = item:FindFirstChildOfClass("ClickDetector") or item:FindFirstChildWhichIsA("ClickDetector")
                    if not cd then
                        for _, v in ipairs(item:GetDescendants()) do
                            if v:IsA("ClickDetector") then cd = v; break end
                        end
                    end
                    if head and cd then
                        return head, cd
                    end
                end
            end
            return nil, nil
        end
    end

    do
        kfForceCFrame = nil
        if getgenv().kfForceCFrameConn then getgenv().kfForceCFrameConn:Disconnect() end
        getgenv().kfForceCFrameConn = RunService.Heartbeat:Connect(function()
            if kfForceCFrame then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = kfForceCFrame
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 1.85, 0)
                end
            end
        end)

        kfFindMelee = function(parent)
            if not parent then return nil end
            local selectedWep = (kfTv('KnifeAutoBuyWeapon') and kfOv('KnifeAutoBuyWeaponSelect')) or kfOv('KnifeAutoSwingWeapon') or 'Knife'
            local validNames = {}
            if selectedWep == 'Knife' then
                validNames = { '[knife]', 'knife' }
            elseif selectedWep == 'Combat' then
                validNames = { '[combat]', 'combat' }
            elseif selectedWep == 'Bat' then
                validNames = { '[bat]', 'bat' }
            elseif selectedWep == 'Stopsing' then
                validNames = { '[stopsing]', 'stopsing', '[stopsign]', 'stopsign' }
            elseif selectedWep == 'Sledgehammer' then
                validNames = { '[sledgehammer]', 'sledgehammer' }
            else
                validNames = { '[knife]', '[bat]', '[combat]', 'combat', '[stopsing]', '[sledgehammer]' }
            end
            for _, t in ipairs(parent:GetChildren()) do
                if t:IsA('Tool') then
                    local lname = string.lower(t.Name)
                    for _, name in ipairs(validNames) do
                        if lname == name then return t end
                    end
                end
            end
            return nil
        end

        kfBuyingBag = false
        kfBuyBag = function()
            if kfBuyingBag then return end
            if kfGetBag() ~= nil then return end
            kfBuyingBag = true
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then kfBuyingBag = false return end

                local head, cd = kfGetShopItem("bag")
                if not head or not cd then kfBuyingBag = false return end

                local safePos = hrp.CFrame
                local shopCF = CFrame.new(head.Position - Vector3.new(0, 5.5, 0))

                local attempts = 0
                while kfGetBag() == nil and attempts < 15 do
                    char = LocalPlayer.Character
                    if not char then break end
                    hrp = char:FindFirstChild("HumanoidRootPart")
                    if not hrp then break end
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if not hum or hum.Health <= 0 then break end

                    kfForceCFrame = shopCF
                    hrp.CFrame = shopCF
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 1.85, 0)

                    task.wait(0.08)
                    pcall(function() fireclickdetector(cd) end)
                    pcall(function() fireclickdetector(cd, 0) end)
                    pcall(function() fireclickdetector(cd, 0, "MouseClick") end)
                    pcall(function() fireclickdetector(cd, 1) end)
                    task.wait(0.1)

                    attempts = attempts + 1
                end

                kfForceCFrame = nil
                char = LocalPlayer.Character
                hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp and safePos then
                    hrp.CFrame = safePos
                end
            end)
            kfForceCFrame = nil
            kfBuyingBag = false
        end

        kfBuyingWeapon = false
        kfBuyWeapon = function(wepName)
            if kfBuyingWeapon then return end
            local charCheck = LocalPlayer.Character
            if kfFindMelee(charCheck) or kfFindMelee(LocalPlayer:FindFirstChild('Backpack')) then return end
            kfBuyingWeapon = true
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then kfBuyingWeapon = false return end

                local targetName = string.lower(wepName or "knife"):gsub("[%[%]]", "")
                local head, cd = kfGetShopItem(targetName)
                if (not head or not cd) and targetName == "stopsing" then
                    head, cd = kfGetShopItem("stopsign")
                end
                if not head or not cd then kfBuyingWeapon = false return end

                local origCFrame = root.CFrame
                local shopCF = CFrame.new(head.Position - Vector3.new(0, 5.5, 0))

                local attempts = 0
                while attempts < 15 do
                    local c = LocalPlayer.Character
                    if kfFindMelee(c) or kfFindMelee(LocalPlayer:FindFirstChild('Backpack')) then break end
                    if not c then break end
                    root = c:FindFirstChild("HumanoidRootPart")
                    if not root then break end
                    local hum = c:FindFirstChildOfClass("Humanoid")
                    if not hum or hum.Health <= 0 then break end

                    kfForceCFrame = shopCF
                    root.CFrame = shopCF
                    root.AssemblyLinearVelocity = Vector3.new(0, 1.85, 0)

                    task.wait(0.08)
                    pcall(function() fireclickdetector(cd) end)
                    pcall(function() fireclickdetector(cd, 0) end)
                    pcall(function() fireclickdetector(cd, 0, "MouseClick") end)
                    pcall(function() fireclickdetector(cd, 1) end)
                    task.wait(0.1)

                    attempts = attempts + 1
                end

                kfForceCFrame = nil
                local c = LocalPlayer.Character
                root = c and c:FindFirstChild("HumanoidRootPart")
                if root and origCFrame then
                    root.CFrame = origCFrame
                end
            end)
            kfForceCFrame = nil
            kfBuyingWeapon = false
        end

        kfGetHitbox = function()
            local melee = kfFindMelee(LocalPlayer.Character) or kfFindMelee(LocalPlayer:FindFirstChild('Backpack'))
            if not melee then return nil end
            local handle = melee:FindFirstChild('Handle') or melee:FindFirstChildWhichIsA('BasePart')
            if not handle then return nil end
            local hb = handle:FindFirstChild('HITBOX_PART') or handle
            if hb and hb:IsA('BasePart') then return hb end
            return nil
        end
    end

    do
        local function setKnifeBotActive(state)
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild('HumanoidRootPart')
            if state then
                getgenv().KnifeBotActive = true
                if root and not kfOriginCFrame then
                    kfOriginCFrame = root.CFrame
                end
            else
                getgenv().KnifeBotActive = false
                if messageLabel then messageLabel.Text = "" end
                local hb = kfGetHitbox()
                if hb and hb:IsA("BasePart") then
                    local origSize = hb:GetAttribute('LarpticOrigSize')
                    if typeof(origSize) == 'Vector3' then hb.Size = origSize end
                    local origMassless = hb:GetAttribute('LarpticOrigMassless')
                    if origMassless ~= nil then hb.Massless = origMassless end
                    hb:SetAttribute('LarpticOrigSize', nil)
                    hb:SetAttribute('LarpticOrigMassless', nil)
                end
                if root and kfOriginCFrame then
                    pcall(function()
                        root.CFrame = kfOriginCFrame
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                    end)
                    kfOriginCFrame = nil
                end
            end
            if kfUpdateCameraView then pcall(kfUpdateCameraView) end
        end

        if Toggles.KnifeEnabled then
            Toggles.KnifeEnabled:OnChanged(function()
                setKnifeBotActive(Toggles.KnifeEnabled.Value)
            end)
        end

        if Options.KnifeEnabledKey then
            Options.KnifeEnabledKey:OnClick(function()
                if not Toggles.KnifeEnabled or not Toggles.KnifeEnabled.Value then
                    return
                end
                setKnifeBotActive(not getgenv().KnifeBotActive)
            end)
        end

        kfGetTargetPlayers = function()
            local targets = {}
            local selected = kfOv('KnifeSelectPlayer')
            if type(selected) == "table" then
                for k, v in pairs(selected) do
                    local label = nil
                    if type(k) == "number" and type(v) == "string" then
                        label = v
                    elseif type(k) == "string" and v == true then
                        label = k
                    end
                    if label then
                        local plr = kfFindPlayerFromLabel(label)
                        if plr and plr ~= LocalPlayer then
                            table.insert(targets, plr)
                        end
                    end
                end
            elseif type(selected) == "string" and selected ~= "" then
                local plr = kfFindPlayerFromLabel(selected)
                if plr and plr ~= LocalPlayer then
                    table.insert(targets, plr)
                end
            end
            if #targets == 0 and getgenv().ForceHitTarget and getgenv().ForceHitTarget ~= LocalPlayer then
                table.insert(targets, getgenv().ForceHitTarget)
            end
            return targets
        end

        kfIsKO = function(plr)
            if not plr or not plr.Character then return false end
            local bodyEffects = plr.Character:FindFirstChild("BodyEffects")
            if not bodyEffects then return false end
            local ko = bodyEffects:FindFirstChild("K.O")
            return ko and ko.Value == true
        end

        kfHasForceField = function(plr)
            if not plr or not plr.Character then return false end
            return plr.Character:FindFirstChildOfClass("ForceField") ~= nil
        end

        kfIsDeadOrRespawning = function(plr)
            if not plr or not plr.Character then return true end
            local bodyEffects = plr.Character:FindFirstChild("BodyEffects")
            if bodyEffects then
                local sdeath = bodyEffects:FindFirstChild("SDeath")
                if sdeath and sdeath.Value == true then return true end
            end
            local torso = plr.Character:FindFirstChild("UpperTorso") or plr.Character:FindFirstChild("Torso") or plr.Character:FindFirstChild("HumanoidRootPart")
            if not torso then return true end
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if (not hum or hum.Health <= 0) and not kfIsKO(plr) then return true end
            return false
        end

        kfTeleportToVoid = function(root)
            if not root then return end
            pcall(function()
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = CFrame.new(
                    math.random(-500000, 500000),
                    math.random(0, 500000),
                    math.random(-500000, 500000)
                )
            end)
        end

        kfGetPrimaryTarget = function(includeDeadAndFF)
            local targets = kfGetTargetPlayers()
            if #targets > 0 then
                if includeDeadAndFF then
                    return targets[1]
                end
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local bestPlr = nil
                local bestDist = math.huge
                for _, plr in ipairs(targets) do
                    if plr and plr.Character and not kfIsDeadOrRespawning(plr) and not kfHasForceField(plr) then
                        local tRoot = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("UpperTorso")
                        if tRoot then
                            if root then
                                local d = (root.Position - tRoot.Position).Magnitude
                                if d < bestDist then
                                    bestDist = d
                                    bestPlr = plr
                                end
                            else
                                return plr
                            end
                        end
                    end
                end
                return bestPlr or targets[1]
            end

            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local bestPlr = nil
            local bestDist = math.huge
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    if includeDeadAndFF or (not kfIsDeadOrRespawning(plr) and not kfHasForceField(plr)) then
                        local tRoot = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("UpperTorso")
                        if tRoot then
                            if root then
                                local d = (root.Position - tRoot.Position).Magnitude
                                if d < bestDist then
                                    bestDist = d
                                    bestPlr = plr
                                end
                            else
                                return plr
                            end
                        end
                    end
                end
            end
            return bestPlr
        end

        kfEquipMelee = function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass('Humanoid')
            if not hum then return nil end
            local tool = kfFindMelee(char)
            if tool then return tool end
            local bpTool = kfFindMelee(LocalPlayer:FindFirstChild('Backpack'))
            if bpTool then
                pcall(function() hum:EquipTool(bpTool) end)
                return char:FindFirstChild(bpTool.Name) or bpTool
            end
            return nil
        end
    end

    do
        task.spawn(function()
            while task.wait(0.1) do
                local hb = kfGetHitbox()
                if hb and hb:IsA("BasePart") then
                    if kfIsEnabled() then
                        if hb:GetAttribute('LarpticOrigSize') == nil then
                            hb:SetAttribute('LarpticOrigSize', hb.Size)
                        end
                        if hb:GetAttribute('LarpticOrigMassless') == nil then
                            hb:SetAttribute('LarpticOrigMassless', hb.Massless)
                        end
                        local sz = kfOv('KnifeHitboxSize') or 21
                        hb.Size = Vector3.new(sz, sz, sz)
                        hb.Massless = true
                        hb.CanCollide = false
                    else
                        if hb:GetAttribute('LarpticOrigSize') ~= nil then
                            local origSize = hb:GetAttribute('LarpticOrigSize')
                            if typeof(origSize) == 'Vector3' then hb.Size = origSize end
                            hb:SetAttribute('LarpticOrigSize', nil)
                        end
                        if hb:GetAttribute('LarpticOrigMassless') ~= nil then
                            hb.Massless = hb:GetAttribute('LarpticOrigMassless')
                            hb:SetAttribute('LarpticOrigMassless', nil)
                        end
                    end
                end
            end
        end)

        task.spawn(function()
            local stompFrameCount = 0
            local targetIndex = 1
            while task.wait() do
                if kfIsEnabled() and (kfTv('KnifeGlue') or kfTv('KnifeAutoSwing') or kfTv('KnifeFastLightAttacks')) then
                    local char = LocalPlayer.Character
                    local root = char and char:FindFirstChild('HumanoidRootPart')
                    local hum = char and char:FindFirstChildOfClass('Humanoid')

                    if not char or not root or not hum or hum.Health <= 0 then
                        kfUpdateStatus("reloading...")
                        task.wait(0.2)
                        continue
                    end

                    if kfTv('KnifeAutoBuyWeapon') then
                        local selectedWep = kfOv('KnifeAutoBuyWeaponSelect') or 'Knife'
                        local hasWep = kfFindMelee(char) or kfFindMelee(LocalPlayer:FindFirstChild('Backpack'))
                        if not hasWep then
                            kfUpdateStatus("buying weapon: " .. tostring(selectedWep))
                            kfBuyWeapon(selectedWep)
                            hasWep = kfFindMelee(LocalPlayer.Character) or kfFindMelee(LocalPlayer:FindFirstChild('Backpack'))
                            if not hasWep then
                                task.wait(0.1)
                                continue
                            end
                        end
                    end

                    local allTargets = kfGetTargetPlayers()
                    if #allTargets == 0 then
                        kfUpdateStatus("no target...")
                        kfTeleportToVoid(root)
                        task.wait(0.1)
                        continue
                    end

                    local koTarget = nil
                    if kfTv('KnifeAutoStomp') then
                        for _, p in ipairs(allTargets) do
                            if kfIsKO(p) and not kfIsDeadOrRespawning(p) then
                                koTarget = p
                                break
                            end
                        end
                    end

                    if koTarget then
                        kfUpdateStatus("stomping: " .. koTarget.Name)
                        local targetChar = koTarget.Character
                        local torso = targetChar and (targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("HumanoidRootPart"))
                        if torso and root then
                            pcall(function()
                                root.Velocity = Vector3.zero
                                root.RotVelocity = Vector3.zero
                                root.AssemblyLinearVelocity = Vector3.zero
                                root.AssemblyAngularVelocity = Vector3.zero
                                root.CFrame = CFrame.new(torso.Position + Vector3.new(0, 3.5, 0))
                            end)
                        end
                        stompFrameCount = stompFrameCount + 1
                        if stompFrameCount >= 2 then
                            stompFrameCount = 0
                            pcall(function()
                                ReplicatedStorage.MainEvent:FireServer("Stomp")
                            end)

                            if kfTv('KnifeAutoTrashTalk') and (tick() - lastTrashTalkTick > 1.5) then
                                lastTrashTalkTick = tick()
                                local mode = kfOv('KnifeTrashTalkMode') or 'Random Presets'
                                local msg = ""
                                if mode == 'Custom' then
                                    local customVal = kfOv('KnifeCustomTrashTalk') or (Options.KnifeCustomTrashTalk and Options.KnifeCustomTrashTalk.Value)
                                    if customVal and customVal ~= "" then
                                        msg = customVal
                                    else
                                        msg = kfPresetPhrases[math.random(1, #kfPresetPhrases)]
                                    end
                                else
                                    msg = kfPresetPhrases[math.random(1, #kfPresetPhrases)]
                                end
                                kfSendChatMessage(msg)
                            end
                        end
                    else
                        local activeTargets = {}
                        for _, p in ipairs(allTargets) do
                            if not kfIsDeadOrRespawning(p) and not kfHasForceField(p) and not kfIsKO(p) then
                                table.insert(activeTargets, p)
                            end
                        end

                        if #activeTargets == 0 then
                            kfUpdateStatus("targets dead/FF...")
                            kfTeleportToVoid(root)
                            task.wait(0.1)
                        else
                            stompFrameCount = 0
                            if targetIndex > #activeTargets then targetIndex = 1 end
                            local targetPlr = activeTargets[targetIndex]

                            local targetChar = targetPlr.Character
                            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                            if targetRoot then
                                local namesStr = ""
                                    for idx, p in ipairs(activeTargets) do
                                        namesStr = namesStr .. (idx > 1 and ", " or "") .. p.Name
                                    end
                                    kfUpdateStatus("killing (" .. #activeTargets .. "): " .. namesStr)

                                    local dist = kfOv('KnifeDistance') or 3
                                    local targetPos = targetRoot.Position
                                    local dir = (root.Position - targetPos)
                                    dir = (dir.Magnitude > 0.1) and dir.Unit or Vector3.new(0, 0, 1)
                                    pcall(function()
                                        root.CFrame = CFrame.lookAt(targetPos + dir * dist, targetPos)
                                        root.AssemblyLinearVelocity = Vector3.zero
                                    end)

                                    if kfTv('KnifeAutoSwing') or kfTv('KnifeFastLightAttacks') then
                                        local meleeTool = kfEquipMelee()
                                        if meleeTool then
                                            if kfTv('KnifeAutoSwing') then
                                                pcall(function() meleeTool:Activate() end)
                                            end
                                            if kfTv('KnifeFastLightAttacks') then
                                                pcall(function()
                                                    game:GetService("VirtualUser"):ClickButton1(Vector2.new(20, 20), workspace.CurrentCamera.CFrame)
                                                end)
                                                local handle = meleeTool:FindFirstChild("Handle") or meleeTool:FindFirstChildOfClass("Part") or meleeTool:FindFirstChildWhichIsA("BasePart")
                                                if handle and firetouchinterest and targetChar then
                                                    for _, pName in ipairs({"UpperTorso", "Head", "HumanoidRootPart", "LowerTorso"}) do
                                                        local pPart = targetChar:FindFirstChild(pName)
                                                        if pPart then
                                                            pcall(function()
                                                                firetouchinterest(handle, pPart, 0)
                                                                firetouchinterest(handle, pPart, 1)
                                                            end)
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                else
                    kfUpdateStatus("")
                    task.wait(0.1)
                end
                if not kfIsEnabled() then
                    if messageLabel then messageLabel.Text = "" end
                end
            end
        end)

        if getgenv().KnifeGlueConn then getgenv().KnifeGlueConn:Disconnect() end
        getgenv().KnifeGlueConn = RunService.Heartbeat:Connect(function()
            if getgenv().Flying or not kfIsEnabled() then return end
            if kfBuyingWeapon or kfBuyingBag or kfForceCFrame then return end
            if not (kfTv('KnifeGlue') or kfTv('KnifeFastLightAttacks') or kfTv('KnifeAutoSwing')) then return end
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass('Humanoid')
            local root = hum and hum.RootPart
            if not root then return end

            local targetPlr = kfGetPrimaryTarget()
            if targetPlr then
                local isFF = kfIsDeadOrRespawning(targetPlr) or kfHasForceField(targetPlr)
                if isFF or kfIsKO(targetPlr) then
                    if sethiddenproperty then pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end) end
                    return
                end
                local targetChar = targetPlr.Character
                local targetPart = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    if sethiddenproperty then pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", targetPart) end) end
                    local dist = kfOv('KnifeDistance') or 2
                    pcall(function()
                        root.CFrame = CFrame.lookAt(targetPart.Position + Vector3.new(0, 0, dist), targetPart.Position)
                        root.AssemblyLinearVelocity = Vector3.zero
                    end)
                end
            end
        end)

        if Toggles.KnifeGlue then
            Toggles.KnifeGlue:OnChanged(function()
                if not Toggles.KnifeGlue.Value then
                    if sethiddenproperty then
                        local char = LocalPlayer.Character
                        local hum = char and char:FindFirstChildOfClass('Humanoid')
                        local root = hum and hum.RootPart
                        if root then pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end) end
                    end
                    local hb = kfGetHitbox()
                    if hb and hb:IsA("BasePart") then
                        local orig = hb:GetAttribute('LarpticOrigSize')
                        if typeof(orig) == 'Vector3' then hb.Size = orig end
                        local origMassless = hb:GetAttribute('LarpticOrigMassless')
                        if origMassless ~= nil then hb.Massless = origMassless end
                        hb:SetAttribute('LarpticOrigSize', nil)
                        hb:SetAttribute('LarpticOrigMassless', nil)
                        hb.Transparency = 1
                    end
                end
            end)
        end
    end
end

do
    local Desync = {
        Enabled=false, StayInVoid=false, Visualize=false,
        Transparency=0, Spam=false, InVoid=0.4, OnGround=0.133, Method="Custom",
    }
    local abletodesync = true
    local invoid = false

    local function CreateDesyncPart(name, size, parent)
        local part = Instance.new("Part")
        part.CanCollide=false part.Name=name part.Size=size part.Parent=parent
        return part
    end
    local function CreateDesyncWeld(p0, p1, c0)
        local weld = Instance.new("Weld")
        weld.Part0=p0 weld.Part1=p1 weld.C0=c0 weld.Parent=p0
    end
    local function CreateDesyncRig()
        local model = Instance.new("Model") model.Name=""
        local root = CreateDesyncPart("HumanoidRootPart", Vector3.new(2,2,1), model)
        root.Transparency=1 root.CanCollide=false
        local humanoid = Instance.new("Humanoid")
        humanoid.RigType=Enum.HumanoidRigType.R6 humanoid.Parent=model
        local parts = {
            Head={2,1,1,0,1.5,0}, Torso={2,2,1,0,0,0},
            ["Left Arm"]={1,2,1,-1.5,0,0}, ["Right Arm"]={1,2,1,1.5,0,0},
            ["Left Leg"]={1,2,1,-0.5,-2,0}, ["Right Leg"]={1,2,1,0.5,-2,0},
        }
        local torso = CreateDesyncPart("Torso", Vector3.new(2,2,1), model)
        torso.CanCollide=false
        for name, data in pairs(parts) do
            local part = CreateDesyncPart(name, Vector3.new(unpack(data,1,3)), model)
            CreateDesyncWeld(torso, part, CFrame.new(unpack(data,4,6)))
        end
        CreateDesyncWeld(root, torso, CFrame.new(0,0,0))
        model.PrimaryPart=root model.Parent=workspace
        return model
    end
    local desyncClone = CreateDesyncRig()
    for _, part in ipairs(desyncClone:GetDescendants()) do
        if part:IsA("Part") then
            part.CanCollide=false part.Material=Enum.Material.Neon part.Color=Color3.fromRGB(80,120,200)
        end
    end
    local function SetDesyncRigTransparency(rig, transparency)
        for _, part in ipairs(rig:GetDescendants()) do
            if part:IsA("Part") and part.Name ~= "HumanoidRootPart" then
                part.Transparency = transparency
            end
        end
    end
    _G.Desync = {MinX=10,MaxX=10,MinY=10,MaxY=10,MinZ=10,MaxZ=10,MinPitch=0,MaxPitch=360,MinYaw=0,MaxYaw=360}

    RunService.Heartbeat:Connect(function()
        pcall(function()
            if not Desync.Enabled or not abletodesync then
                SetDesyncRigTransparency(desyncClone, 1) return
            end
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local function getSpoofed()
                if Desync.StayInVoid then
                    return CFrame.new(math.random(-450000000,-100000000),math.random(100000000,450000000),math.random(-450000000,-100000000))
                elseif Desync.Method=="Custom" then
                    local rP=math.rad(math.random(_G.Desync.MinPitch,_G.Desync.MaxPitch)-180)
                    local rY=math.rad(math.random(_G.Desync.MinYaw,_G.Desync.MaxYaw)-180)
                    return (hrp.CFrame+Vector3.new(math.random(-_G.Desync.MinX,_G.Desync.MaxX),math.random(-_G.Desync.MinY,_G.Desync.MaxY),math.random(-_G.Desync.MinZ,_G.Desync.MaxZ)))*CFrame.Angles(rP,rY,0)
                elseif Desync.Method=="Randomize" then
                    return hrp.CFrame+Vector3.new(math.random(-50,50),math.random(0,50),math.random(-50,50))
                elseif Desync.Method=="Void" then
                    return hrp.CFrame+Vector3.new(math.random(-80000,80000),math.random(0,80000),math.random(-80000,80000))
                end
            end
            local shouldRun = (not Desync.Spam) or (Desync.Spam and invoid)
            if shouldRun then
                local saved=hrp.CFrame local spoofed=getSpoofed()
                hrp.CFrame=spoofed
                if Desync.Visualize then
                    SetDesyncRigTransparency(desyncClone,Desync.Transparency)
                    desyncClone.HumanoidRootPart.CFrame=spoofed
                else SetDesyncRigTransparency(desyncClone,1) end
                RunService:BindToRenderStep("DesyncRestore",199,function()
                    hrp.CFrame=saved RunService:UnbindFromRenderStep("DesyncRestore")
                end)
            else SetDesyncRigTransparency(desyncClone,1) end
        end)
    end)
    task.spawn(function()
        while true do
            invoid=true task.wait(Desync.InVoid)
            invoid=false task.wait(Desync.OnGround)
        end
    end)

    local DesyncGroup          = Tabs.ragebot:AddRightGroupbox('Desync')

    DesyncGroup:AddToggle('DesyncEnabled',     {Text='Desync',          Default=false}):AddKeyPicker('DesyncKeybind',{Default='',SyncToggleState=false,Mode='Toggle',Text='Desync Key',NoUI=false})
    DesyncGroup:AddToggle('DesyncStayInVoid',  {Text='Stay In Void',    Default=false})
    DesyncGroup:AddToggle('DesyncSpam',        {Text='Spam',            Default=false})
    DesyncGroup:AddToggle('DesyncVisualize',   {Text='Visualize',       Default=false})
    DesyncGroup:AddDropdown('DesyncMethod',    {Values={'Custom','Randomize','Void'}, Default=1, Multi=false, Text='Method'})
    DesyncGroup:AddSlider('DesyncInVoid',      {Text='In Void Time',    Default=0.4,   Min=0.05, Max=2, Rounding=2})
    DesyncGroup:AddSlider('DesyncOnGround',    {Text='On Ground Time',  Default=0.133, Min=0.05, Max=2, Rounding=3})
    DesyncGroup:AddSlider('DesyncTransparency',{Text='Visualize Trans', Default=0,     Min=0,    Max=1, Rounding=2})
    Toggles.DesyncEnabled:OnChanged(function()     Desync.Enabled     = Toggles.DesyncEnabled.Value end)
    Options.DesyncKeybind:OnClick(function()
        Toggles.DesyncEnabled:SetValue(not Toggles.DesyncEnabled.Value)
    end)
    Toggles.DesyncEnabled:OnChanged(function()     Desync.Enabled     = Toggles.DesyncEnabled.Value end)
    Toggles.DesyncStayInVoid:OnChanged(function()  Desync.StayInVoid  = Toggles.DesyncStayInVoid.Value end)
    Toggles.DesyncSpam:OnChanged(function()        Desync.Spam        = Toggles.DesyncSpam.Value end)
    Toggles.DesyncVisualize:OnChanged(function()   Desync.Visualize   = Toggles.DesyncVisualize.Value end)
    Options.DesyncMethod:OnChanged(function()      Desync.Method      = Options.DesyncMethod.Value end)
    Options.DesyncInVoid:OnChanged(function()      Desync.InVoid      = Options.DesyncInVoid.Value end)
    Options.DesyncOnGround:OnChanged(function()    Desync.OnGround    = Options.DesyncOnGround.Value end)
    Options.DesyncTransparency:OnChanged(function() Desync.Transparency= Options.DesyncTransparency.Value end)

    DesyncGroup:AddToggle('UndergroundInvisible', {Text = 'Underground Invisible', Default = false})
        :AddKeyPicker('UndergroundInvisibleKeybind', {Default = 'None', SyncToggleState = true, Mode = 'Toggle', Text = 'Underground Invisible Key'})

    local fpos_state = {
        enabled = false,
        timer = 0,
        saved_cframe = nil,
        hook = nil
    }

    local fpos_old_index
    local function fpos_ensure_hook(root)
        if not fpos_state.hook then
            fpos_old_index = hookmetamethod(game, "__index", function(self, index)
                if not checkcaller() and fpos_state.enabled and fpos_state.saved_cframe and index == "CFrame" and self == root then
                    return fpos_state.saved_cframe
                end
                return fpos_old_index(self, index)
            end)
            fpos_state.hook = fpos_old_index
        end
    end

    RunService.Heartbeat:Connect(function(delta)
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        if fpos_state.enabled then
            fpos_ensure_hook(root)
            fpos_state.timer = fpos_state.timer + delta
            local random_rotation = CFrame.Angles(math.rad(math.random(-180,180)), math.rad(math.random(-180,180)), math.rad(math.random(-180,180)))
            local target_cframe = CFrame.new(root.Position.X, root.Position.Y - 18, root.Position.Z) * random_rotation
            fpos_state.saved_cframe = root.CFrame
            root.CFrame = target_cframe
            RunService.RenderStepped:Wait()
            if root and root.Parent then
                root.CFrame = fpos_state.saved_cframe
            end
        end
    end)

    Toggles.UndergroundInvisible:OnChanged(function()
        fpos_state.enabled = Toggles.UndergroundInvisible.Value
    end)
end



local defaultMaxZoom = LocalPlayer.CameraMaxZoomDistance or 128
local function toggleUnlockMaxZoom(state)
    if state then
        LocalPlayer.CameraMaxZoomDistance = 999999
    else
        LocalPlayer.CameraMaxZoomDistance = defaultMaxZoom or 128
    end
end

local removePepperSprayActive = false
local function toggleRemovePepperSpray(state)
    removePepperSprayActive = state
    if state then
        task.spawn(function()
            while removePepperSprayActive do
                pcall(function()
                    local lighting = game:GetService("Lighting")
                    for _, child in ipairs(lighting:GetChildren()) do
                        if child.Name:lower():find("pepper") then
                            if child:IsA("PostEffect") then child.Enabled = false end
                        end
                    end
                    local pgui = LocalPlayer:FindFirstChild("PlayerGui")
                    if pgui then
                        local mainGui = pgui:FindFirstChild("MainScreenGui") or pgui:FindFirstChild("MainGui")
                        if mainGui then
                            local pSpray = mainGui:FindFirstChild("PepperSpray") or mainGui:FindFirstChild("Pepper")
                            if pSpray then pSpray.Visible = false end
                        end
                    end
                end)
                task.wait(0.5)
            end
        end)
    end
end

local old_new_index = nil
if hookmetamethod then
    old_new_index = hookmetamethod(game, "__newindex", function(self, index, value)
        if not checkcaller() then
            if index == "CFrame" and (self == Camera or self == workspace.CurrentCamera) and Toggles.NoRecoil and Toggles.NoRecoil.Value then
                local callingScript = getcallingscript()
                if callingScript and callingScript.Name == "Framework" then
                    return
                end
            end
        end
        return old_new_index(self, index, value)
    end)
end

local MiscGroup = Tabs.misc:AddLeftGroupbox("Misc")

MiscGroup:AddToggle('NoRecoil', {
    Text = 'No Recoil',
    Default = false
})

MiscGroup:AddToggle('AntiCollision', {
    Text = 'Anti Collision',
    Default = false,
    Callback = function(v)
        setAntiCollision(v)
    end
})



MiscGroup:AddToggle('UnlockMaxZoom', {
    Text = 'Unlock Max Zoom Distance',
    Default = false,
    Callback = function(v)
        toggleUnlockMaxZoom(v)
    end
})

MiscGroup:AddToggle('RemovePepperSpray', {
    Text = 'Remove Pepper Spray Effect',
    Default = false,
    Callback = function(v)
        toggleRemovePepperSpray(v)
    end
})

MiscGroup:AddToggle('CashAura', {
    Text = 'Cash Aura',
    Default = false
})

local function doCashAura()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local ignored = workspace:FindFirstChild("Ignored")
    local drop = ignored and ignored:FindFirstChild("Drop")
    if not drop then return end

    for _, cash in ipairs(drop:GetChildren()) do
        if cash.Name == "MoneyDrop" then
            local pos = cash:IsA("BasePart") and cash.Position or (cash:FindFirstChildWhichIsA("BasePart") and cash:FindFirstChildWhichIsA("BasePart").Position)
            if pos and (pos - hrp.Position).Magnitude < 11.5 then
                local clickDetector = cash:FindFirstChildOfClass("ClickDetector") or cash:FindFirstChildWhichIsA("ClickDetector")
                if clickDetector then
                    fireclickdetector(clickDetector)
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.1)
        if Toggles.CashAura and Toggles.CashAura.Value then
            pcall(doCashAura)
        end
    end
end)

