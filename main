local hitsounds = {
    RIFK7 = "rbxassetid://9102080552",
    Bubble = "rbxassetid://9102092728",
    Minecraft = "rbxassetid://5869422451",
    Cod = "rbxassetid://160432334",
    Bameware = "rbxassetid://6565367558",
    Neverlose = "rbxassetid://6565370984",
    Gamesense = "rbxassetid://4817809188",
    Rust = "rbxassetid://6565371338",
}

local HitSndSettings = {sound_enabled = false, sound_id = "Gamesense", sound_volume = 1}

local triggerHitmarker

local function doHitSound()
    if not (HitSndSettings.sound_enabled or (Toggles.HitSoundToggle and Toggles.HitSoundToggle.Value)) then return end
    local s = Instance.new("Sound")
    s.SoundId = hitsounds[HitSndSettings.sound_id] or "rbxassetid://97643101798871"
    s.Volume = HitSndSettings.sound_volume
    s.Parent = workspace
    s:Play()
    s.Ended:Connect(function() s:Destroy() end)
end

local myTargets = {}
local targetHealth = {}

local function addTargetFromShot()
    local mousePos = UserInputService:GetMouseLocation()
    local closestPlayer = nil
    local closestDist = 200
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestPlayer = player
                    end
                end
            end
        end
    end
    if closestPlayer then
        myTargets[closestPlayer.UserId] = closestPlayer
        if closestPlayer.Character then
            local hum = closestPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                targetHealth[closestPlayer.UserId] = hum.Health
            end
        end
        task.delay(3, function()
            myTargets[closestPlayer.UserId] = nil
            targetHealth[closestPlayer.UserId] = nil
        end)
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and tool:FindFirstChild("Ammo") then
                task.spawn(addTargetFromShot)
            end
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or
       input.UserInputType == Enum.UserInputType.MouseButton2 then
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and tool:FindFirstChild("Ammo") then
                task.spawn(addTargetFromShot)
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    for userId, player in pairs(myTargets) do
        if player and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                local cur = hum.Health
                local prev = targetHealth[userId] or cur
                if cur < prev then
                    doHitSound()
                    triggerHitmarker(player)
                end
                targetHealth[userId] = cur
                if cur <= 0 then
                    myTargets[userId] = nil
                    targetHealth[userId] = nil
                end
            end
        else
            myTargets[userId] = nil
            targetHealth[userId] = nil
        end
    end
end)

