for _, it in ipairs(masterItemList) do
    table.insert(sorterOptions, it.display)
    for _, rName in ipairs(refillOnly) do
        if it.display == rName then table.insert(dropdownRefill, it.display .. " [$" .. it.price .. "]") end
    end
end

local SorterSlots = {}
local IsSorting = false

local function executeSort()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    if not bp or not char or IsSorting then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum:UnequipTools() end
    task.wait(0.2)

    local tools = {}
    for _, v in ipairs(bp:GetChildren()) do if v:IsA("Tool") then table.insert(tools, v) end end
    for _, v in ipairs(char:GetChildren()) do if v:IsA("Tool") then table.insert(tools, v) end end

    local sorted = {}
    local used = {}
    local ghosts = {}

    for i = 1, 10 do
        local target = SorterSlots[i]
        local found = nil
        if target and target ~= "None" then
            for _, t in ipairs(tools) do
                if not used[t] and t.Name:lower():find(target:lower()) then
                    found = t; used[t] = true; break
                end
            end
        end
        if found then
            sorted[i] = found
        else
            local g = Instance.new("Tool")
            g.Name = ""
            table.insert(ghosts, g)
            sorted[i] = g
        end
    end

    IsSorting = true
    for _, t in ipairs(tools) do pcall(function() t.Parent = nil end) end
    task.wait(0.1)

    for i = 1, 10 do
        sorted[i].Parent = bp
        task.wait(0.05)
    end
    for _, t in ipairs(tools) do if not used[t] then t.Parent = bp end end

    task.wait(0.1)
    for _, g in ipairs(ghosts) do g:Destroy() end
    IsSorting = false
end


local function buyItemByName(itemName)
    pcall(function()
        local shops = workspace:FindFirstChild("Ignored") and workspace.Ignored:FindFirstChild("Shop")
        if shops then
            for _, shop in ipairs(shops:GetChildren()) do
                if shop:FindFirstChild("ClickDetector") and shop.Name:lower():find(itemName:lower()) then
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        fireclickdetector(shop.ClickDetector)
                    end
                end
            end
        end
    end)
end

local function hasRefillItem(buyName)
    local bp, char = LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character
    local clean = buyName:gsub("[%[%]]", "")
    local function check(p)
        if not p then return false end
        for _, v in ipairs(p:GetChildren()) do if v:IsA("Tool") and (v.Name == buyName or v.Name:find(clean)) then return true end end
        return false
    end
    return check(bp) or check(char)
end


local SorterGroup = Tabs.main:AddLeftGroupbox('Inventory Sorter', 'layout-grid')
SorterGroup:AddButton({Text = 'Manual Sort', Func = executeSort})
SorterGroup:AddToggle('AutoSortRespawn', {Text = 'Auto Sort on Respawn', Default = false})

for i = 1, 10 do
    SorterGroup:AddDropdown('Slot' .. i, {
        Text = 'Slot ' .. i,
        Values = sorterOptions,
        Default = 1,
        Multi = false,
    })
    Options['Slot' .. i]:OnChanged(function()
        SorterSlots[i] = Options['Slot' .. i].Value
    end)
end

LocalPlayer.CharacterAdded:Connect(function()
    if Toggles.AutoSortRespawn and Toggles.AutoSortRespawn.Value then
        task.wait(2.5)
        executeSort()
    end
end)




local desync4 = {
    enabled = false,
    teleportPosition = nil,
    old_position = nil
}

if hookmetamethod and not getgenv().moonstandHooked then
    getgenv().moonstandHooked = true
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, key)
        if not checkcaller() and key == "CFrame" then
            if LocalPlayer.Character and self == LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                if desync4.enabled and desync4.old_position then
                    return desync4.old_position
                end
            end
        end
        return oldIndex(self, key)
    end)
end

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    if desync4.enabled and desync4.teleportPosition then
        desync4.old_position = rootPart.CFrame
        rootPart.CFrame = desync4.teleportPosition
        RunService.RenderStepped:Wait()
        if desync4.old_position then
            rootPart.CFrame = desync4.old_position
        end
    end
end)

local function buyItemWithDesync4(shopHead, clickDetector, times, checkFunc)
    times = times or 1
    if not shopHead or not clickDetector then return end

    local char = LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    desync4.old_position = rootPart.CFrame
    desync4.teleportPosition = shopHead.CFrame
    desync4.enabled = true

    local start = tick()
    local duration = (times * 0.25) + 0.3
    while desync4.enabled and (tick() - start) < duration do
        fireclickdetector(clickDetector)
        RunService.RenderStepped:Wait()
        if checkFunc and checkFunc() then
            break
        end
    end

    desync4.enabled = false
    desync4.teleportPosition = nil
end

local all_items = {}
local AutoBuyGroup = Tabs.main:AddRightGroupbox('Auto Buy', 'shopping-bag')

local function scanShop()
    table.clear(all_items)
    local defaultWeapons = {
        "AK47",
        "AR",
        "AUG",
        "Deagle",
        "Double-Barrel SG",
        "DrumGun",
        "Flamethrower",
        "Flintlock",
        "Glock",
        "Grenade",
        "LMG",
        "P90",
        "Revolver",
        "Rifle",
        "RPG",
        "Shotgun",
        "Silencer",
        "SilencerAR",
        "SMG",
        "Tactical Shotgun"
    }
    local ignored = workspace:FindFirstChild("Ignored")
    local shop = ignored and ignored:FindFirstChild("Shop")
    if shop then
        for _, item in ipairs(shop:GetChildren()) do
            local name = string.match(item.Name, "%b[]")
            local head = item:FindFirstChild("Head") or item:FindFirstChildWhichIsA("BasePart")
            if head and head.CFrame.p.Y > -35 and name then
                name = name:sub(2, -2)
                if name:lower():find("ammo") then
                    local base = name:gsub("%s*[Aa][Mm][Mm][Oo]%s*", ""):gsub("^%s*(.-)%s*$", "%1")
                    if not all_items[base] then all_items[base] = {main=nil, ammo=head}
                    elseif not all_items[base].ammo then all_items[base].ammo = head end
                else
                    local base = name:gsub("^%s*(.-)%s*$", "%1")
                    if not all_items[base] then all_items[base] = {main=head, ammo=nil}
                    elseif not all_items[base].main then all_items[base].main = head end
                end
            end
        end
    end

    local weaponMap = {}
    local ammoMap = {}

    for _, w in ipairs(defaultWeapons) do
        weaponMap[w] = true
        ammoMap[w] = true
    end

    for n, d in pairs(all_items) do
        local lowerN = n:lower()
        local isNonWeapon = lowerN:find("armor") or lowerN:find("bag") or lowerN:find("weight") or lowerN:find("food") or lowerN:find("phone") or lowerN:find("mask")
        if not isNonWeapon then
            weaponMap[n] = true
        end
        if d.ammo or (d.main and d.ammo) then
            ammoMap[n] = true
        end
    end

    local weaponList = {}
    local ammoList = {}
    for w in pairs(weaponMap) do table.insert(weaponList, w) end
    for a in pairs(ammoMap) do table.insert(ammoList, a) end

    table.sort(weaponList)
    table.sort(ammoList)
    return weaponList, ammoList
end

local weaponList, ammoList = scanShop()

AutoBuyGroup:AddDropdown('WeaponSelect', {Values=weaponList, Default=1, Multi=false, Text='Select Weapon'})
AutoBuyGroup:AddButton({Text='Buy Weapon', Func=function()
    local wList = scanShop()
    if Options.WeaponSelect and #wList > 0 then
        pcall(function() Options.WeaponSelect:SetValues(wList) end)
    end
    local v = Options.WeaponSelect and Options.WeaponSelect.Value
    if v then
        local g = all_items[v] or {}
        local mainPart = g.main
        local ammoPart = g.ammo

        if not mainPart then
            local ignored = workspace:FindFirstChild("Ignored")
            local shop = ignored and ignored:FindFirstChild("Shop")
            if shop then
                local vClean = v:gsub("[%[%]]", ""):lower()
                for _, item in ipairs(shop:GetChildren()) do
                    local itemName = item.Name:lower()
                    if not itemName:find("ammo") then
                        if itemName:find("%[" .. vClean .. "%]") or itemName:find(vClean, 1, true) then
                            mainPart = item:FindFirstChild("Head") or item:FindFirstChildWhichIsA("BasePart")
                            if mainPart then break end
                        end
                    end
                end
            end
        end

        if mainPart then
            local cdMain = mainPart.Parent:FindFirstChildOfClass("ClickDetector") or mainPart:FindFirstChildOfClass("ClickDetector")
            if cdMain then
                buyItemWithDesync4(mainPart, cdMain, 1)
            end
        end
        if ammoPart then
            local cdAmmo = ammoPart.Parent:FindFirstChildOfClass("ClickDetector") or ammoPart:FindFirstChildOfClass("ClickDetector")
            if cdAmmo then
                buyItemWithDesync4(ammoPart, cdAmmo, 1)
            end
        end
    end
end})

AutoBuyGroup:AddButton({Text='Buy Armor', Func=function()
    scanShop()
    local a = all_items["High-Medium Armor"] or all_items["Medium Armor"] or all_items["MediumArmor"]
    if a and a.main then
        local cd = a.main.Parent:FindFirstChildOfClass("ClickDetector") or a.main.Parent:FindFirstChildWhichIsA("ClickDetector")
        if cd then
            buyItemWithDesync4(a.main, cd, 1)
        end
    end
end})

