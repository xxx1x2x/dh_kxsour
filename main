MiscGroup:AddToggle("AutoBounty", {Text="Auto Bounty", Default=false})
local autoBountyConn = nil
Toggles.AutoBounty:OnChanged(function()
    local enabled = Toggles.AutoBounty.Value
    if autoBountyConn then
        autoBountyConn:Disconnect()
        autoBountyConn = nil
    end

    if enabled then
        local posterTexts = workspace:FindFirstChild("MAP") and workspace.MAP:FindFirstChild("BountyPosters") and workspace.MAP.BountyPosters:FindFirstChild("Poster") and workspace.MAP.BountyPosters.Poster:FindFirstChild("Texts")
        local playerPoster = posterTexts and posterTexts:FindFirstChild("PlayerName") and posterTexts.PlayerName:FindFirstChild("SurfaceGui") and posterTexts.PlayerName.SurfaceGui:FindFirstChild("TextLabel")

        local function checkPoster()
            if playerPoster and playerPoster.Text ~= "" and playerPoster.Text ~= LocalPlayer.Name then
                local target = Players:FindFirstChild(playerPoster.Text)
                if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                    end
                end
            end
        end

        checkPoster()
        if playerPoster then
            autoBountyConn = playerPoster:GetPropertyChangedSignal("Text"):Connect(checkPoster)
        end
    end
end)

