local customShootSettings = {
    enabled = false,
    sound_id = "SSG08",
    custom_id = "",
    volume = 1
}

local shootsounds = {
    SSG08  = "rbxassetid://2476571739",
    SCAR20 = "rbxassetid://2476571739",
    AWP    = "rbxassetid://1112948895"
}

local function getCustomShootSoundId()
    if customShootSettings.sound_id == "Custom" then
        local raw = customShootSettings.custom_id
        if raw and raw ~= "" then
            if isfile and isfile(raw) and getcustomasset then
                return getcustomasset(raw, false)
            end
            return raw
        end
    end
    return shootsounds[customShootSettings.sound_id] or "rbxassetid://2476571739"
end

local function applyCustomShootSoundToTool(tool)
    if not tool or not tool:IsA("Tool") then return end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end

    local function checkAndHookSound(sound)
        if sound:IsA("Sound") and (sound.Name == "MG" or sound.Name == "ShootSound" or sound.Name == "Shoot") then
            if customShootSettings.enabled then
                sound.SoundId = getCustomShootSoundId()
                sound.Volume = customShootSettings.volume
            end
        end
    end

    for _, child in ipairs(handle:GetChildren()) do
        checkAndHookSound(child)
    end
    handle.ChildAdded:Connect(checkAndHookSound)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    char.ChildAdded:Connect(applyCustomShootSoundToTool)
end)
if LocalPlayer.Character then
    LocalPlayer.Character.ChildAdded:Connect(applyCustomShootSoundToTool)
    for _, tool in ipairs(LocalPlayer.Character:GetChildren()) do
        applyCustomShootSoundToTool(tool)
    end
end

