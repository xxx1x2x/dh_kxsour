    local function sa2UpdateColor(c)
        sa2Color = c
        if not sa2Enabled then return end
        for _, att in ipairs(sa2Attachments) do
            if att and att.Parent then
                for _, desc in ipairs(att:GetDescendants()) do
                    if desc:IsA("ParticleEmitter") or desc:IsA("Beam") or desc:IsA("Trail") then
                        pcall(function() desc.Color = ColorSequence.new(c) end)
                    end
                end
                if att:IsA("ParticleEmitter") or att:IsA("Beam") or att:IsA("Trail") then
                    pcall(function() att.Color = ColorSequence.new(c) end)
                end
            end
        end
        for _, model in ipairs(sa2Models) do
            if model and model.Parent then
                for _, desc in ipairs(model:GetDescendants()) do
                    if desc:IsA("ParticleEmitter") or desc:IsA("Beam") or desc:IsA("Trail") then
                        pcall(function() desc.Color = ColorSequence.new(c) end)
                    elseif desc:IsA("BasePart") and not desc:IsA("MeshPart") then
                        pcall(function() desc.Color = c end)
                    end
                end
            end
        end
    end

    local function sa2Refresh()
        sa2Clear()
        if not sa2Enabled then return end
        local char = LocalPlayer.Character if not char then return end
        if sa2Types["Angelic"]      then sa2CreateAngelic(char) end
        if sa2Types["Ambient"]      then sa2CreateAmbient(char) end
        if sa2Types["Nimb"]         then sa2CreateNimb(char) end
        if sa2Types["Tornado"]      then sa2CreateTornado(char) end
        if sa2Types["Swirl"]        then sa2CreateSwirl(char) end
        if sa2Types["Bubble"]       then sa2CreateBubble2(char) end
        if sa2Types["Air"]          then sa2CreateAir(char) end
        if sa2Types["Ritual"]       then sa2CreateRitual(char) end
        if sa2Types["Rain"]         then sa2CreateRain(char) end
        if sa2Types["Cloak Aura"]   then sa2AttachModel(sa2ModelIDs["Cloak Aura"]) end
        if sa2Types["Sweet Hearth"] then sa2AttachModel(sa2ModelIDs["Sweet Hearth"]) end
        if sa2Types["Ethereal"]     then sa2AttachModel(sa2ModelIDs["Ethereal"]) end
        for name, id in pairs(sa2ParticleAuraIDs) do
            if sa2Types[name] then sa2AttachParticleAura(name, id) end
        end
        sa2UpdateColor(sa2Color)
    end

    LocalPlayer.CharacterAdded:Connect(function(char)
        if getgenv().trailEnabled then trailUtility.trail_character(true) end
        if sa2Enabled then
            char:WaitForChild("Humanoid", 5)
            char:WaitForChild("UpperTorso", 5)
            task.wait(1)
            sa2Refresh()
        end
    end)
    if LocalPlayer.Character then
        if getgenv().trailEnabled then trailUtility.trail_character(true) end
        if sa2Enabled then sa2Refresh() end
    end

    SelfEffectsGroup:AddToggle("TrailToggle",{Text="Trail",Default=false,
        Callback=function(s) getgenv().trailEnabled=s trailUtility.trail_character(s) end
    }):AddColorPicker("TrailColor",{Text="Trail Color",Default=Color3.fromRGB(0,120,255),
        Callback=function(c) TrailVisuals.Color=c if getgenv().trailEnabled then trailUtility.trail_character(false) trailUtility.trail_character(true) end end
    }):AddColorPicker("TrailColor2",{Text="Trail Color 2",Default=Color3.fromRGB(140,0,255),
        Callback=function(c) TrailVisuals.Color2=c if getgenv().trailEnabled then trailUtility.trail_character(false) trailUtility.trail_character(true) end end
    })
    SelfEffectsGroup:AddSlider("TrailLifetime",{Text="Trail Lifetime",Default=1.6,Min=0.1,Max=5,Rounding=1,
        Callback=function(v) TrailVisuals.LifeTime=v if getgenv().trailEnabled then trailUtility.trail_character(false) trailUtility.trail_character(true) end end
    })

    SelfEffectsGroup:AddToggle("Aura2Toggle",{Text="Auras",Default=false,
        Callback=function(s)
            sa2Enabled=s
            if s then
                sa2Refresh()
                if sa2CharConn then sa2CharConn:Disconnect() end
                sa2CharConn=LocalPlayer.CharacterAdded:Connect(function(char)
                    char:WaitForChild("Humanoid", 5)
                    char:WaitForChild("UpperTorso", 5)
                    task.wait(1)
                    if sa2Enabled then sa2Refresh() end
                end)
            else
                if sa2CharConn then sa2CharConn:Disconnect() sa2CharConn=nil end
                sa2Clear()
            end
        end
    }):AddColorPicker("Aura2Color",{Text="Aura 2 Color",Default=Color3.fromRGB(133,220,255),
        Callback=function(c)
            sa2UpdateColor(c)
        end
    })
    SelfEffectsGroup:AddDropdown("AuraType2",{
        Text="Auras",
        Values={
            "Angelic","Ambient","Nimb","Tornado",
            "Swirl","Bubble","Air","Ritual","Rain",
            "Cloak Aura","Sweet Hearth","Ethereal",
            "Starlight","Heavenly","Ribbon","Sakura","Angel","Wind","Flow","Star"
        },
        Default={},
        Multi=true,
        Callback=function(sel)
            sa2Types={}
            if type(sel) == "table" then
                for k,v in pairs(sel) do
                    if type(k) == "number" and type(v) == "string" then
                        sa2Types[v] = true
                    elseif v == true then
                        sa2Types[k] = true
                    end
                end
            end
            if sa2Enabled then sa2Refresh() end
        end
    })
end

do
    local DamageGroup  = Tabs.visuals:AddRightGroupbox('Damage Numbers')
    local isDmgEnabled = false
    local dmgColor     = Color3.fromRGB(255,255,255)
    local prevDmgHealth= {}
    local dmgRayParams = RaycastParams.new()
    dmgRayParams.FilterType  = Enum.RaycastFilterType.Blacklist
    dmgRayParams.IgnoreWater = true

    local function isVisible(player)
        if not player.Character or not player.Character:FindFirstChild("Head") then return false end
        local head = player.Character.Head
        local orig = Camera.CFrame.Position
        local dir  = (head.Position - orig)
        dmgRayParams.FilterDescendantsInstances = {LocalPlayer.Character}
        local res = workspace:Raycast(orig, dir, dmgRayParams)
        return not res or res.Instance:IsDescendantOf(player.Character)
    end

    local function getNearestCursor()
        local mouse = UserInputService:GetMouseLocation()
        local nearest, shortest = nil, math.huge
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and isVisible(player) then
                local sp, on = Camera:WorldToViewportPoint(player.Character.Head.Position)
                if on then
                    local d = (Vector2.new(sp.X,sp.Y) - mouse).Magnitude
                    if d < shortest then shortest=d nearest=player end
                end
            end
        end
        return nearest
    end

    local function showDamage(player, amount)
        if not isDmgEnabled then return end
        local head = player.Character and player.Character:FindFirstChild("Head")
        if not head then return end
        local gui = head:FindFirstChild("DamageContainer")
        if not gui then
            gui = Instance.new("BillboardGui")
            gui.Name="DamageContainer" gui.Parent=head gui.Adornee=head
            gui.Size=UDim2.new(0,100,0,50) gui.StudsOffset=Vector3.new(0,2,0)
            gui.AlwaysOnTop=true gui.MaxDistance=500 gui.Enabled=true
        end
        local lbl = Instance.new("TextLabel", gui)
        lbl.Text=tostring(amount) lbl.TextColor3=dmgColor
        lbl.TextSize=32+(amount/10) lbl.Font=Enum.Font.SourceSansBold
        lbl.BackgroundTransparency=1 lbl.Size=UDim2.new(1,0,0,32)
        lbl.TextStrokeTransparency=0.4
        lbl.Position=UDim2.new(0.5,-50+math.random(-20,20),0,math.random(-20,20))
        local t1 = TweenService:Create(lbl,TweenInfo.new(3,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),{Position=UDim2.new(0.5,-50,0,-100)})
        t1:Play()
        t1.Completed:Connect(function()
            local t2 = TweenService:Create(lbl,TweenInfo.new(1,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),{TextTransparency=1,TextStrokeTransparency=1})
            t2:Play()
            t2.Completed:Connect(function() lbl:Destroy() end)
        end)
    end

    RunService.RenderStepped:Connect(function()
        local near = getNearestCursor()
        if near and near.Character then
            local hum = near.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                local cur  = hum.Health
                local prev = prevDmgHealth[near.UserId] or cur
                if cur < prev and isDmgEnabled then showDamage(near, math.floor(prev-cur)) end
                prevDmgHealth[near.UserId] = cur
            end
        end
    end)

    DamageGroup:AddToggle('DamageNumbersToggle',{Text='Damage Numbers',Default=false})
    DamageGroup:AddLabel('Color'):AddColorPicker('DamageColorPicker',{Default=dmgColor,Title='Damage Color',Transparency=0})
    Toggles.DamageNumbersToggle:OnChanged(function() isDmgEnabled = Toggles.DamageNumbersToggle.Value end)
    Options.DamageColorPicker:OnChanged(function()   dmgColor     = Options.DamageColorPicker.Value end)
end

local CharacterSettings = {
    FlyEnabled = false,
    FlySpeed = 50,
}

do

    local FOVGroup = Tabs.character:AddLeftGroupbox('FOV Changer')
    local FOVChangerSettings = {Enabled = false, Amount = 90}
    FOVGroup:AddToggle('EnableFOVChanger', {Text = 'Enable FOV Changer', Default = false})
    FOVGroup:AddSlider('FOVChangerAmount', {Text = 'FOV Amount', Default = 90, Min = 60, Max = 130, Rounding = 0})

    Toggles.EnableFOVChanger:OnChanged(function()
        FOVChangerSettings.Enabled = Toggles.EnableFOVChanger.Value
        if not FOVChangerSettings.Enabled then
            Camera.FieldOfView = 70
        end
    end)

    Options.FOVChangerAmount:OnChanged(function()
        FOVChangerSettings.Amount = Options.FOVChangerAmount.Value
    end)

    RunService.RenderStepped:Connect(function()
        if FOVChangerSettings.Enabled then
            Camera.FieldOfView = FOVChangerSettings.Amount
        end
    end)

    local CharGroup = Tabs.character:AddLeftGroupbox('Movement')
    CharGroup:AddToggle('EnableFly',{Text='Enable Fly',Default=false}):AddKeyPicker('FlyToggle',{Default='X',SyncToggleState=false,Mode='Toggle',Text='Fly Toggle',NoUI=false})
    CharGroup:AddSlider('FlySpeed', {Text='Fly Speed', Default=50, Min=10, Max=500, Rounding=0})

    local Flags = {cframeSpeedEnabled=false, cframeSpeedAmount=150}
    CharGroup:AddToggle('CframeSpeedToggle',{Text='CFrame Speed',Default=false}):AddKeyPicker('CframeSpeedKeybind',{Default='V',SyncToggleState=false,Mode='Toggle',Text='CFrame Speed',NoUI=false})
    CharGroup:AddSlider('CframeSpeedSlider',{Text='Speed Amount',Default=150,Min=16,Max=1000,Rounding=0})

    getgenv().Flying = false
    local flyConnections = {}
    local flyCore, flyWeld, flyPos, flyGyro

    local function startFly()
        if getgenv().Flying then return end
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        getgenv().Flying = true

        if workspace:FindFirstChild("IgnoredVelocity") then pcall(function() workspace.IgnoredVelocity:Destroy() end) end

        flyCore = Instance.new("Part")
        flyCore.Name = "IgnoredVelocity"
        flyCore.Size = Vector3.new(0.05, 0.05, 0.05)
        flyCore.Anchored = false
        flyCore.CanCollide = false
        flyCore.CFrame = root.CFrame
        flyCore.Parent = workspace

        flyWeld = Instance.new("Weld", flyCore)
        flyWeld.Part0 = root
        flyWeld.Part1 = flyCore
        flyWeld.C0 = CFrame.new(0, 0, 0)
        flyWeld.C1 = CFrame.new(0, 0, 0)

        flyPos = Instance.new("BodyPosition", flyCore)
        flyPos.Name = "IgnoredVelocity"
        flyPos.maxForce = Vector3.new(math.huge, math.huge, math.huge)
        flyPos.position = root.Position

        flyGyro = Instance.new("BodyGyro", flyCore)
        flyGyro.Name = "IgnoredVelocity"
        flyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        flyGyro.P = 9e4
        flyGyro.cframe = root.CFrame

        hum.PlatformStand = true
        hum.AutoJumpEnabled = false

        local conn = RunService.RenderStepped:Connect(function(dt)
            if not getgenv().Flying or UserInputService:GetFocusedTextBox() or not flyPos or not flyGyro then return end
            local cam = Camera
            if not cam then return end
            local speed = (CharacterSettings.FlySpeed or 50) * dt * 2.5
            local currentPos = flyPos.position

            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end

            if dir.Magnitude > 0 then
                flyPos.position = currentPos + (dir.Unit * speed)
            end
            flyGyro.cframe = cam.CFrame
        end)
        table.insert(flyConnections, conn)
    end

    local function stopFly()
        getgenv().Flying = false
        for _, conn in ipairs(flyConnections) do pcall(function() conn:Disconnect() end) end
        flyConnections = {}

        if flyCore then pcall(function() flyCore:Destroy() end) flyCore = nil end
        if workspace:FindFirstChild("IgnoredVelocity") then pcall(function() workspace.IgnoredVelocity:Destroy() end) end

        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.PlatformStand = false
                hum.AutoJumpEnabled = true
            end
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end
    end

    if _G.cframeSpeedConn then _G.cframeSpeedConn:Disconnect() end
    _G.cframeSpeedConn = RunService.Heartbeat:Connect(function(dt)
        if Flags.cframeSpeedEnabled and LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
            if hrp and hum then
                local mv = hum.MoveDirection.Unit * Flags.cframeSpeedAmount * dt
                if mv.Magnitude > 0 then hrp.CFrame = hrp.CFrame + mv end
            end
        end
    end)

    Toggles.EnableFly:OnChanged(function()
        CharacterSettings.FlyEnabled = Toggles.EnableFly.Value
        if CharacterSettings.FlyEnabled then startFly() else stopFly() end
    end)
    Options.FlySpeed:OnChanged(function() CharacterSettings.FlySpeed = Options.FlySpeed.Value end)
    Options.FlyToggle:OnClick(function()
        if not Toggles.EnableFly.Value then return end
        CharacterSettings.FlyEnabled = not CharacterSettings.FlyEnabled
        if CharacterSettings.FlyEnabled then startFly() else stopFly() end
    end)

    Toggles.CframeSpeedToggle:OnChanged(function() Flags.cframeSpeedEnabled    = Toggles.CframeSpeedToggle.Value end)
    Options.CframeSpeedSlider:OnChanged(function() Flags.cframeSpeedAmount      = Options.CframeSpeedSlider.Value end)
    Options.CframeSpeedKeybind:OnClick(function()
        if not Toggles.CframeSpeedToggle.Value then return end
        Flags.cframeSpeedEnabled = not Flags.cframeSpeedEnabled
    end)

    local velocityactive = false
    local velocitykeybindactive = false
    local velocityspeed = 100

    CharGroup:AddToggle('velocityactive',{Text='Speed',Default=false,Callback=function(value)
        velocitykeybindactive = value
        if not velocitykeybindactive then velocityactive = false end
    end}):AddKeyPicker('velocitykeybindactive',{Default='Z',SyncToggleState=false,Mode='Toggle',Text='Speed',NoUI=false,Callback=function(value)
        if not velocitykeybindactive then return end
        velocityactive = value
    end})
    CharGroup:AddSlider('velocityspeed',{Text='Speed Amount',Default=100,Min=1,Max=1000,Rounding=0,Callback=function(value)
        velocityspeed = value
    end})

    RunService.Heartbeat:Connect(function(dt)
        if velocityactive and LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum then
                local mv = hum.MoveDirection
                if mv.Magnitude > 0 then
                    local currentY = hrp.AssemblyLinearVelocity.Y
                    local horizVel = mv.Unit * velocityspeed
                    hrp.AssemblyLinearVelocity = Vector3.new(horizVel.X, currentY, horizVel.Z)
                end
            end
        end
    end)

    local jumppoweractive = false
    local DESIRED_JUMP_POWER = 100
    local jumpPowerConnection = nil

    CharGroup:AddToggle('jumppoweractive',{Text='Jump Power',Default=false,Callback=function(value)
        jumppoweractive = value
        local char = LocalPlayer.Character
        if not char then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        if jumppoweractive then
            humanoid.JumpPower = DESIRED_JUMP_POWER
            humanoid.UseJumpPower = true
            if jumpPowerConnection then jumpPowerConnection:Disconnect() end
            jumpPowerConnection = humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
                if humanoid.JumpPower ~= DESIRED_JUMP_POWER then
                    humanoid.JumpPower = DESIRED_JUMP_POWER
                end
            end)
        else
            if jumpPowerConnection then jumpPowerConnection:Disconnect() jumpPowerConnection = nil end
            humanoid.JumpPower = 16
        end
    end})
    CharGroup:AddSlider('DESIRED_JUMP_POWER',{Text='Jump Power Amount',Default=100,Min=0,Max=1000,Rounding=1,Callback=function(value)
        DESIRED_JUMP_POWER = value
        if jumppoweractive then
            local char = LocalPlayer.Character
            if char then
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid then humanoid.JumpPower = DESIRED_JUMP_POWER end
            end
        end
    end})

    getgenv().SpinbotEnabled = false
    getgenv().SpinSpeed = 10

    local function toggleSpinbot(state)
        if state then
            if not getgenv().SpinConnection then
                getgenv().SpinConnection = RunService.RenderStepped:Connect(function()
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and not getgenv().Flying then
                        LocalPlayer.Character.Humanoid.AutoRotate = false
                        LocalPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(getgenv().SpinSpeed), 0)
                    end
                end)
            end
        else
            if getgenv().SpinConnection then
                getgenv().SpinConnection:Disconnect()
                getgenv().SpinConnection = nil
            end
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.AutoRotate = true
            end
        end
    end

    CharGroup:AddToggle('SpinbotToggle', {
        Text = 'Spin',
        Default = false,
        Callback = function(state)
            getgenv().SpinbotEnabled = state
            toggleSpinbot(state)
        end,
    })

    CharGroup:AddSlider('SpinSpeedSlider', {
        Text = 'Spin Speed',
        Default = 10,
        Min = 1,
        Max = 50,
        Rounding = 1,
        Callback = function(value)
            getgenv().SpinSpeed = value
        end,
    })

    LocalPlayer.CharacterAdded:Connect(function(char)
        stopFly()
        local humanoid = char:WaitForChild("Humanoid")
        if jumppoweractive then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = DESIRED_JUMP_POWER
            if jumpPowerConnection then jumpPowerConnection:Disconnect() end
            jumpPowerConnection = humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
                if humanoid.JumpPower ~= DESIRED_JUMP_POWER then
                    humanoid.JumpPower = DESIRED_JUMP_POWER
                end
            end)
        end
        if getgenv().SpinbotEnabled then
            toggleSpinbot(true)
        end
    end)

    CharGroup:AddDivider()

    CharGroup:AddToggle('AnimationBreaker', {Text = 'Animation Breaker', Default = false})
    CharGroup:AddSlider('AnimBreakerLag', {Text = 'Lag Amount', Default = 0, Min = 0, Max = 100, Rounding = 0, Suffix = '%'})
    CharGroup:AddSlider('AnimBreakerJitter', {Text = 'Jitter Amount', Default = 0, Min = 0, Max = 100, Rounding = 0, Suffix = '%'})

    local animBreakerData = {}
    local animTimeData = {}
    local animLastFreezeTick = os.clock()
    local animLastUpdate = os.clock()
    local animLastFreeze = os.clock()
    local animFreezeState = false

    RunService.Heartbeat:Connect(function()
        if not Toggles.AnimationBreaker or not Toggles.AnimationBreaker.Value then return end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local now = os.clock()
        if now - animLastUpdate > 0.028 then
            animLastUpdate = now
            local animations = hum:GetPlayingAnimationTracks()
            local lagVal = Options.AnimBreakerLag and Options.AnimBreakerLag.Value or 0
            local jitterVal = Options.AnimBreakerJitter and Options.AnimBreakerJitter.Value or 0

            if lagVal > 0 then
                local lagSec = lagVal / 100
                if now - animLastFreezeTick > lagSec then
                    animLastFreezeTick = now
                    task.spawn(function() animLastFreeze = os.clock() end)
                    animFreezeState = false
                else
                    animFreezeState = true
                end

                for i = 1, #animations do
                    local anim = animations[i]
                    if not animFreezeState then
                        animBreakerData[anim] = (anim.TimePosition or 0) + now - animLastFreeze
                    else
                        pcall(function() anim.TimePosition = animBreakerData[anim] or 0 end)
                    end
                end
            end

            for i = 1, #animations do
                local anim = animations[i]
                if not anim.Looped then
                    local t = animTimeData[anim]
                    if not t then
                        animTimeData[anim] = now
                    else
                        if now - t > (anim.Length or 1) then
                            pcall(function() anim:Stop() end)
                            animTimeData[anim] = nil
                        end
                    end
                end
            end

            if jitterVal > 0 then
                local jitFactor = jitterVal / 100
                for i = 1, #animations do
                    pcall(function()
                        animations[i].TimePosition = animations[i].TimePosition * -math.random(1 + jitFactor, 2 + jitFactor * 3)
                    end)
                end
            end
        end
    end)
end
do
    local DanceIds = {
        ["Billy Bounce"]  = "rbxassetid://136095999219650",
