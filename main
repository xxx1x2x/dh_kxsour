if not fireclickdetector then
    fireclickdetector = function(detector)
        if syn and syn.fireclickdetector then
            syn.fireclickdetector(detector)
        elseif getrenv and getrenv().fireclickdetector then
            getrenv().fireclickdetector(detector)
        else
            warn("fireclickdetector is not available on this executor")
        end
    end
end




local _antiCollisionConn = nil
local function setAntiCollision(state)
    if _antiCollisionConn then _antiCollisionConn:Disconnect() _antiCollisionConn = nil end
    if state then
        _antiCollisionConn = RunService.Stepped:Connect(function()
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    for _, part in pairs(plr.Character:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end
        end)
    end
end

local GetTarget3DVelocity, ab_GetBagCFrame
do
    local AB = {
        Enabled     = false,
        TargetName  = "",
        BuyingBag   = false,
        LastAttempt = 0,
        SpamRate    = 30,
        SpawnCamp   = true,
        BagDist     = 2.5,
        BagHeight   = 2.5,
        Prediction  = 0.1,
        RespawnConn = nil,
    }

    local function ab_IsDead(player)
        if not player or not player.Character then return true end
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health <= 0 then return true end
        local be = player.Character:FindFirstChild("BodyEffects")
        local sd = be and (be:FindFirstChild("SDeath") or be:FindFirstChild("Dead"))
        return sd and sd.Value == true or false
    end

    local function ab_IsBagged(player)
        if not player or not player.Character then return false end
        for _, name in ipairs({"Christmas_Sock","BrownBag","Bag","SantaBag","HalloweenBag","Socks"}) do
            local c = player.Character:FindFirstChild(name, true)
            if c and not c:IsA("Tool") then return true end
        end
        return false
    end

    local function ab_HasForceField(player)
        if not player or not player.Character then return false end
        return player.Character:FindFirstChildOfClass("ForceField") ~= nil
    end

    local function ab_GetBag()
        local char = LocalPlayer.Character
        local bp = LocalPlayer.Backpack
        if not char then return nil end
        for _, name in ipairs({"[BrownBag]","[Christmas_Sock]","[Bag]","BrownBag"}) do
            local t = char:FindFirstChild(name) or (bp and bp:FindFirstChild(name))
            if t then return t end
        end
        return nil
    end

    local function ab_BuyBag()
        if AB.BuyingBag then return end
        AB.BuyingBag = true
        task.spawn(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then AB.BuyingBag = false return end

            local safePos = hrp.CFrame

            local ignored = workspace:FindFirstChild("Ignored")
            local shop = ignored and ignored:FindFirstChild("Shop")
            if not shop then AB.BuyingBag = false return end
            
            local bagItem = nil
            for _, item in ipairs(shop:GetChildren()) do
                local name = item.Name:lower()
                if name:find("brownbag") or name:find("%[bag%]") or name:find("bag") then
                    bagItem = item
                    break
                end
            end
            
            if not bagItem then AB.BuyingBag = false return end
            
            local head = bagItem:FindFirstChild("Head") or bagItem:FindFirstChildOfClass("Part") or bagItem:FindFirstChildOfClass("MeshPart")
            local cd = bagItem:FindFirstChildOfClass("ClickDetector")
            if not cd then
                for _, v in pairs(bagItem:GetDescendants()) do
                    if v:IsA("ClickDetector") then cd = v; break end
                end
            end
            
            if not head or not cd then AB.BuyingBag = false return end


            hrp.CFrame = head.CFrame + Vector3.new(0, 3, 0)
            task.wait(0.08)
            if fireclickdetector then
                pcall(function() fireclickdetector(cd) end)
                pcall(function() fireclickdetector(cd, 0, "MouseClick") end)
            end
            task.wait(0.08)
            
            char = LocalPlayer.Character
            hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = safePos
            end
            AB.BuyingBag = false
        end)
    end



    local lastTargetPositions = {}
    local lastTargetTimes = {}

    GetTarget3DVelocity = function(targetRoot)
        local now = tick()
        local pos = targetRoot.Position
        local physVel = targetRoot.AssemblyLinearVelocity or targetRoot.Velocity or Vector3.zero
        
        local targetName = targetRoot.Parent and targetRoot.Parent.Name
        if targetName then
            local prevPos = lastTargetPositions[targetName]
            local prevTime = lastTargetTimes[targetName]
            lastTargetPositions[targetName] = pos
            lastTargetTimes[targetName] = now
            
            if prevPos and prevTime and (now - prevTime) > 0 and (now - prevTime) < 0.25 then
                local deltaVel = (pos - prevPos) / (now - prevTime)
                if deltaVel.Magnitude > physVel.Magnitude or physVel.Magnitude < 2 then
                    physVel = deltaVel
                end
            end
        end
        return physVel
    end


    ab_GetBagCFrame = function(targetRoot)
        local targetChar = targetRoot.Parent
        local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
        local physVel = targetRoot.AssemblyLinearVelocity or targetRoot.Velocity or Vector3.zero
        local realVel = GetTarget3DVelocity(targetRoot)
        
        local speed = math.max(physVel.Magnitude, realVel.Magnitude)
        local moveDir = Vector3.zero
        
        if targetHum and targetHum.MoveDirection.Magnitude > 0 then
            moveDir = targetHum.MoveDirection.Unit
        elseif realVel.Magnitude > 1 then
            moveDir = realVel.Unit
        end


        local baseCF = targetRoot.CFrame * CFrame.Angles(math.rad(90), 0, math.rad(180)) - Vector3.new(0, 0.5, 0)
        

        local predFactor = (AB.Prediction and AB.Prediction > 0) and AB.Prediction or 0.08
        if speed > 100 then

            predFactor = 0.02
        elseif speed > 30 then
            predFactor = 0.05
        end

        local predOffset = (moveDir * speed * predFactor)
        return CFrame.new(baseCF.Position + predOffset) * baseCF.Rotation
    end

        local function ab_GetTarget(name)
        if not name or name == "" then return nil end
        local p = Players:FindFirstChild(name)
        if not p or ab_IsDead(p) then return nil end
        if not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then return nil end
        return p
    end



    local function ab_ChaseAndBag(targetName, onlyOnce, stopFlag)
        local target = ab_GetTarget(targetName)
        if not target then return end

        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local orig = hrp.CFrame 

        local wasBagged = false
        local deadline = onlyOnce and (tick() + 20) or math.huge


        setAntiCollision(true)

        while true do
            RunService.Stepped:Wait()
            if stopFlag and stopFlag() then break end
            if tick() > deadline then break end

            char = LocalPlayer.Character
            if char and char.Parent then
                local currentHRP = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")

                if currentHRP and hum and hum.Health > 0 then
                    if currentHRP ~= hrp then
                        hrp = currentHRP
                        orig = hrp.CFrame
                    end

                    if not AB.BuyingBag then
                        target = ab_GetTarget(targetName)
                        if not target then
                            if onlyOnce and ab_IsDead(Players:FindFirstChild(targetName)) then
                                local respawnDeadline = tick() + 30
                                while tick() < respawnDeadline do
                                    RunService.Stepped:Wait()
                                    if stopFlag and stopFlag() then break end
                                    local p = Players:FindFirstChild(targetName)
                                    if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then break end
                                end
                            end
                            task.wait(0.05)
                        else
                            local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
                            if targetRoot and not ab_HasForceField(target) then
                                local isBagged = ab_IsBagged(target)

                                if isBagged then
                                    if not wasBagged then
                                        wasBagged = true
                                        pcall(function()
                                            if sethiddenproperty and hrp then
                                                sethiddenproperty(hrp, "PhysicsRepRootPart", nil)
                                            end
                                        end)
                                        if hrp then
                                            hrp.CFrame = orig
                                            if hrp.AssemblyLinearVelocity then
                                                hrp.AssemblyLinearVelocity = Vector3.zero
                                            else
                                                hrp.Velocity = Vector3.zero
                                            end
                                        end
                                        pcall(function()
                                            local MainEvent = ReplicatedStorage:FindFirstChild("MainEvent")
                                            if MainEvent then MainEvent:FireServer("Stomp") end
                                        end)
                                        if not ab_GetBag() then ab_BuyBag() end
                                        if onlyOnce then break end
                                    end
                                    task.wait(0.1)
                                else
                                    wasBagged = false
                                    local bag = ab_GetBag()
                                    if not bag then
                                        ab_BuyBag()
                                    else
                                        local glueCF = ab_GetBagCFrame(targetRoot)
                                        local targetVel = GetTarget3DVelocity(targetRoot)
                                        
                                        if AB.UseDesync then

                                            pcall(function()
                                                if sethiddenproperty then
                                                    sethiddenproperty(hrp, "PhysicsRepRootPart", targetRoot)
                                                end
                                            end)
                                        else

                                            pcall(function()
                                                if sethiddenproperty then
                                                    sethiddenproperty(hrp, "PhysicsRepRootPart", nil)
                                                end
                                            end)
                                            hrp.CFrame = glueCF
                                            if hrp.AssemblyLinearVelocity then
                                                hrp.AssemblyLinearVelocity = targetVel
                                            else
                                                hrp.Velocity = targetVel
                                            end
                                        end

                                        if bag.Parent == LocalPlayer.Backpack then
                                            if hum then hum:EquipTool(bag) end
                                        end

                                        if bag.Parent == char then
                                            bag:Activate()
                                            local handle = bag:FindFirstChild("Handle") or bag:FindFirstChildOfClass("Part")
                                            local tPart = target.Character:FindFirstChild("UpperTorso") or target.Character:FindFirstChild("Head") or targetRoot
                                            if handle and tPart and firetouchinterest then
                                                pcall(function()
                                                    firetouchinterest(handle, tPart, 0)
                                                    firetouchinterest(handle, tPart, 1)
                                                end)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    else
                        task.wait(0.05)
                    end
                else
                    task.wait(0.1)
                end
            else
                task.wait(0.1)
            end
        end

        pcall(function()
            if sethiddenproperty and hrp then
                sethiddenproperty(hrp, "PhysicsRepRootPart", nil)
            end
        end)

        if not (Toggles.AntiCollision and Toggles.AntiCollision.Value) then
            setAntiCollision(false)
        end
    end

                    local ab_loopRunning = false
    local function ab_StartLoop()
        if ab_loopRunning then return end
        ab_loopRunning = true
        task.spawn(function()
            while AB.Enabled do
                ab_ChaseAndBag(AB.TargetName, false, function() return not AB.Enabled end)
                task.wait(0.05)
            end
            ab_loopRunning = false
        end)
    end

    local ab_singleRunning = false
    local function ab_SingleUse()
        if AB.TargetName == "" then
            Library:Notify("Select a player first!", 2)
            return
        end
        if ab_singleRunning then return end
        ab_singleRunning = true
        task.spawn(function()
            Library:Notify("Chasing " .. AB.TargetName .. " to bag...", 2)
            ab_ChaseAndBag(AB.TargetName, true, function() return ab_singleRunning == false end)
            ab_singleRunning = false
            Library:Notify("Bag Once finished on " .. AB.TargetName, 2)
        end)
    end

    
    local BaggerGroup = Tabs.main:AddRightGroupbox('Auto Bagger')

    local BaggerTargetDropdown = BaggerGroup:AddDropdown('AB_Target', {
        Values = {},
        Default = 1,
        Multi = false,
        Text = 'Target',
        Tooltip = 'Select a player to auto bag',
        Callback = function(v) 
            if v then
                AB.TargetName = v:match("@([^%s%)]+)") or v
            else
                AB.TargetName = ""
            end
        end
    })

    local function updateBaggerPlayerList()
        local values = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                table.insert(values, player.DisplayName .. ' (@' .. player.Name .. ')')
            end
        end
        table.sort(values)
        if BaggerTargetDropdown and BaggerTargetDropdown.SetValues then
            BaggerTargetDropdown:SetValues(values)
            if BaggerTargetDropdown.Value and not table.find(values, BaggerTargetDropdown.Value) then
                BaggerTargetDropdown:SetValue(nil)
                AB.TargetName = ""
            end
        end
    end

    Players.PlayerAdded:Connect(function()
        task.delay(0.5, updateBaggerPlayerList)
    end)
    Players.PlayerRemoving:Connect(function()
        task.delay(0.5, updateBaggerPlayerList)
    end)
    updateBaggerPlayerList()

    BaggerGroup:AddToggle('AB_Enabled', {Text='Enable Auto Bagger', Default=false,
        Callback=function(v)
            AB.Enabled = v
            if v then
                if not ab_GetBag() then ab_BuyBag() end
                ab_StartLoop()
                Library:Notify('Auto Bagger ON  ' .. AB.TargetName, 2)
            else
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass('Humanoid')
                local root = hum and hum.RootPart
                if root and sethiddenproperty then
                    pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
                end
                Library:Notify('Auto Bagger OFF', 2)
            end
        end
    })

    BaggerGroup:AddSlider('AB_Prediction', {Text='Velocity Prediction', Default=0.5, Min=0, Max=1, Rounding=2,
        Callback=function(v) AB.Prediction = v end
    })

    BaggerGroup:AddButton({Text='Bag Once', Func=function() ab_SingleUse() end})
end

do
    local AntiBagGroup = Tabs.main:AddRightGroupbox('Anti-Bag')

    local AntiB = {
        Enabled = false,
        AutoCounter = false,
        DetectionRadius = 107,
        InfiniteVoid = false,
        PredictTeleport = false,
        TeleportTolerance = 80,
        DodgeDelay = 0,
        DodgeDuration = 0.46,
        MaxDodges = 2,
        DodgeAnimTarget = 22,  
        DodgeAnimFinish = 29,   
        Dodging = false,
        LastDodgeTime = 0,
        SavedCFrame = nil,
        DodgeCount = 0,
        CurrentThreat = nil,
        TrackedSwingers = {},
        BuyingBag = false,
        HasSwung = false,
        AutoEquipped = nil,
        LastScanTime = 0,
        ScanInterval = 0.03, 
    }

    
    local BagAnimIds = {
        ["rbxassetid://10921259953"] = true,
        ["rbxassetid://3493406987"] = true,
        ["10921259953"] = true,
        ["3493406987"] = true,
        ["rbxassetid://10921259953"] = true,  
        ["rbxassetid://3493406987"] = true,   
        ["10921259953"] = true,
        ["3493406987"] = true,
    }

    
    local BagKeywords = {
        "bag", "sock", "brownbag", "christmas", "brown"
    }


    local function ab_IsSwingingBagFast(player)
        if not player or not player.Character then return false end
        
        
        local tool = player.Character:FindFirstChildOfClass("Tool")
        if not tool then return false end
        
        local toolName = tool.Name:lower()
        local isBagTool = false
        for _, keyword in ipairs(BagKeywords) do
            if toolName:find(keyword, 1, true) then
                isBagTool = true
                break
            end
        end
        if not isBagTool then return false end
        
        
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if not hum then return false end
        
        local tracks = hum:GetPlayingAnimationTracks()
        for _, track in ipairs(tracks) do
            local anim = track.Animation
            if anim then
                local id = tostring(anim.AnimationId or "")
                local num = id:match("(%d+)")
                
                
                if BagAnimIds[id] or (num and BagAnimIds[num]) or id:find("3493406987", 1, true) then
                    local len = tonumber(track.Length) or 0
                    local time = tonumber(track.TimePosition) or 0
                    
                    
                    local targetPhase = AntiB.DodgeAnimTarget / 100
                    local finishPhase = AntiB.DodgeAnimFinish / 100
                    
                    if len > 0 then
                        local progress = time / len
                        
                        if progress >= 0.01 and progress <= finishPhase then
                            return true
                        end
                    elseif time > 0.01 then
                        
                        return true
                    end
                end
            end
        end
        
        return false
    end

    
    local function ab_BuyBagFast()
        if AntiB.BuyingBag then return end
        AntiB.BuyingBag = true
        
        task.spawn(function()
            local ignored = workspace:FindFirstChild("Ignored")
            local shop = ignored and ignored:FindFirstChild("Shop")
            if not shop then 
                AntiB.BuyingBag = false 
                return 
            end
            
            local bagItem
            for _, item in ipairs(shop:GetChildren()) do
                local name = item.Name:lower()
                if name:find("brownbag") or name:find("%[bag%]") then
                    bagItem = item
                    break
                end
            end
            
            if not bagItem then 
                AntiB.BuyingBag = false 
                return 
            end
            
            local head = bagItem:FindFirstChild("Head")
            local cd = bagItem:FindFirstChildOfClass("ClickDetector")
            if not cd then
                for _, v in pairs(bagItem:GetDescendants()) do
                    if v:IsA("ClickDetector") then cd = v; break end
                end
            end
            
            if not head or not cd then 
                AntiB.BuyingBag = false 
                return 
            end
            
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then 
                AntiB.BuyingBag = false 
                return 
            end
            
            local orig = hrp.CFrame
            local deadline = tick() + 0.8 
            
            while tick() < deadline do
                char = LocalPlayer.Character
                hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then break end
                
                hrp.CFrame = head.CFrame + Vector3.new(0, 3, 0)
                task.wait(0.03)  
                fireclickdetector(cd)
                task.wait(0.03)  
                
                local bp = LocalPlayer.Backpack
                if bp then
                    local bag = bp:FindFirstChild("[BrownBag]") or bp:FindFirstChild("BrownBag") or bp:FindFirstChild("Bag")
                    if bag then break end
                end
            end
            
            hrp.CFrame = orig
            AntiB.BuyingBag = false
        end)
    end

    
    local function ab_GetBagToolFast()
        local char = LocalPlayer.Character
        local bp = LocalPlayer.Backpack
        if not char then return nil end
        
        
        for _, name in ipairs({"[BrownBag]", "BrownBag", "[Bag]", "Bag", "[Christmas_Sock]"}) do
            local tool = char:FindFirstChild(name)
            if tool then return tool end
        end
        
        
        if bp then
            for _, name in ipairs({"[BrownBag]", "BrownBag", "[Bag]", "Bag", "[Christmas_Sock]"}) do
                local tool = bp:FindFirstChild(name)
                if tool then return tool end
            end
        end
        
        return nil
    end

    
    local function ab_EquipBagFast()
        local bag = ab_GetBagToolFast()
        if not bag then
            ab_BuyBagFast()
            return false
        end
        
        if bag.Parent == LocalPlayer.Backpack then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:EquipTool(bag)
                return true
            end
        end
        
        return bag.Parent == LocalPlayer.Character
    end

    
    local function ab_GoVoidFast()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        AntiB.SavedCFrame = hrp.CFrame
        hrp.CFrame = CFrame.new(1.8812581888888e13, 9.9999999999999e29, 9.98235235621111e14)
    end

    
    local function ab_ReturnFromVoidFast()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp or not AntiB.SavedCFrame then return end
        hrp.CFrame = AntiB.SavedCFrame
        AntiB.SavedCFrame = nil
    end

    
    local function ab_GetCounterPositionFast(targetRoot)
        return ab_GetBagCFrame(targetRoot)
    end

    
    local function ab_IsPlayerSelectedFast(playerName)
        if not playerName then return false end
        local val = Options.antibag_targets and Options.antibag_targets.Value
        if not val then return false end
        for formattedName, isSelected in pairs(val) do
            if isSelected then
                local cleanName = formattedName:match("@([^%s%)]+)") or formattedName
                if cleanName == playerName then return true end
            end
        end
        return false
    end


    local ab_heartbeat_conn = nil
    
    local function AntiBagLoop()
        if ab_heartbeat_conn then
            ab_heartbeat_conn:Disconnect()
            ab_heartbeat_conn = nil
        end
        
        
        ab_heartbeat_conn = RunService.Stepped:Connect(function()
            if not AntiB.Enabled then 
                if AntiB.Dodging then
                    AntiB.Dodging = false
                    ab_ReturnFromVoidFast()
                end
                return 
            end

            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not char or not hrp then return end

            local now = tick()


            if AntiB.Dodging then
                local elapsed = now - AntiB.LastDodgeTime
                local duration = AntiB.DodgeDuration + AntiB.DodgeDelay
                
                if elapsed < AntiB.DodgeDelay then
                    hrp.CFrame = CFrame.new(1.8812581888888e13, 9.9999999999999e29, 9.98235235621111e14)
                    return
                elseif elapsed < duration then
                    hrp.CFrame = CFrame.new(1.8812581888888e13, 9.9999999999999e29, 9.98235235621111e14)
                    
                    
                    if AntiB.AutoCounter and AntiB.CurrentThreat and AntiB.CurrentThreat.Character then
                        local tRoot = AntiB.CurrentThreat.Character:FindFirstChild("HumanoidRootPart")
                        if tRoot then
                            local bag = ab_GetBagToolFast()
                            if not bag then
                                ab_BuyBagFast()
                                task.wait(0.03)
                                bag = ab_GetBagToolFast()
                            end
                            
                            if bag and bag.Parent == LocalPlayer.Backpack then
                                local hum = char:FindFirstChildOfClass("Humanoid")
                                if hum then 
                                    hum:EquipTool(bag)
                                    AntiB.AutoEquipped = bag
                                end
                            end
                            
                            local counterPos = ab_GetBagCFrame(tRoot)
                            local targetVel = GetTarget3DVelocity(tRoot)
                            
                            hrp.CFrame = counterPos
                            if hrp.AssemblyLinearVelocity then
                                hrp.AssemblyLinearVelocity = targetVel
                            else
                                hrp.Velocity = targetVel
                            end
                            
                            if bag and bag.Parent == char then
                                bag:Activate()
                                AntiB.HasSwung = true
                                
                                local handle = bag:FindFirstChild("Handle") or bag:FindFirstChildOfClass("Part")
                                local tPart = AntiB.CurrentThreat.Character:FindFirstChild("UpperTorso") or AntiB.CurrentThreat.Character:FindFirstChild("Head") or tRoot
                                if handle and tPart and firetouchinterest then
                                    pcall(function()
                                        firetouchinterest(handle, tPart, 0)
                                        firetouchinterest(handle, tPart, 1)
                                    end)
                                end
                            end
                        end
                    end
                    return
                else
                    AntiB.Dodging = false
                    AntiB.DodgeCount = AntiB.DodgeCount + 1
                    ab_ReturnFromVoidFast()
                    
                    
                    local threatFound = false
                    local myPos = hrp.Position
                    local safeDist = AntiB.DetectionRadius
                    local infVoid = AntiB.InfiniteVoid
                    
                    for _, player in ipairs(Players:GetPlayers()) do
                        if player ~= LocalPlayer and player.Character then
                            local phrp = player.Character:FindFirstChild("HumanoidRootPart")
                            if phrp then
                                local dist = (phrp.Position - myPos).Magnitude
                                local isTargeted = ab_IsPlayerSelectedFast(player.Name)
                                
                                if ab_IsSwingingBagFast(player) then
                                    if isTargeted or (infVoid and dist <= safeDist) or (not infVoid and dist <= math.min(safeDist, 22)) then
                                        threatFound = true
                                        AntiB.CurrentThreat = player
                                        break
                                    end
                                end
                            end
                        end
                    end
                    
                    if threatFound and AntiB.DodgeCount < AntiB.MaxDodges then
                        AntiB.Dodging = true
                        AntiB.LastDodgeTime = now
                        AntiB.SavedCFrame = hrp.CFrame
                        AntiB.HasSwung = false
                        if statusLabel then
                            statusLabel:SetText('LOOPING (' .. AntiB.DodgeCount + 1 .. '/' .. AntiB.MaxDodges .. ')')
                        end
                    else
                        AntiB.DodgeCount = 0
                        AntiB.CurrentThreat = nil
                        AntiB.HasSwung = false
                        if AntiB.AutoEquipped and AntiB.AutoEquipped.Parent == char then
                            AntiB.AutoEquipped.Parent = LocalPlayer.Backpack
                        end
                        AntiB.AutoEquipped = nil
                        if statusLabel then
                            statusLabel:SetText('No Threats')
                        end
                    end
                    return
                end
            end


            local myPos = hrp.Position
            local safeDist = AntiB.DetectionRadius
            local infVoid = AntiB.InfiniteVoid
            local teleportTolerance = AntiB.TeleportTolerance
            local predictTeleport = AntiB.PredictTeleport
            
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local phrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if phrp then
                        local dist = (phrp.Position - myPos).Magnitude
                        local isTargeted = ab_IsPlayerSelectedFast(player.Name)
                        
                        
                        if ab_IsSwingingBagFast(player) then
                            
                            if predictTeleport then
                                local lastPos = AntiB.TrackedSwingers[player.Name]
                                if lastPos then
                                    local moved = (phrp.Position - lastPos).Magnitude
                                    if moved > teleportTolerance and (isTargeted or (infVoid and dist <= safeDist)) then
                                        
                                        AntiB.Dodging = true
                                        AntiB.LastDodgeTime = now - AntiB.DodgeDelay
                                        AntiB.SavedCFrame = hrp.CFrame
                                        AntiB.CurrentThreat = player
                                        AntiB.DodgeCount = 0
                                        AntiB.HasSwung = false
                                        hrp.CFrame = CFrame.new(1.8812581888888e13, 9.9999999999999e29, 9.98235235621111e14)
                                        
                                        if AntiB.AutoCounter then
                                            ab_BuyBagFast()
                                        end
                                        
                                        if statusLabel then
                                            statusLabel:SetText('PREDICTED TP! (' .. player.Name .. ')')
                                        end
                                        return
                                    end
                                end
                            end
                            
                            AntiB.TrackedSwingers[player.Name] = phrp.Position
                            
                            
                            local shouldDodge = false
                            if isTargeted then
                                shouldDodge = true
                            elseif infVoid and dist <= safeDist then
                                shouldDodge = true
                            elseif not infVoid and dist <= math.min(safeDist, 22) then
                                shouldDodge = true
                            end
                            
                            if shouldDodge then
                                
                                AntiB.Dodging = true
                                AntiB.LastDodgeTime = now
                                AntiB.SavedCFrame = hrp.CFrame
                                AntiB.CurrentThreat = player
                                AntiB.DodgeCount = 0
                                AntiB.HasSwung = false
                                hrp.CFrame = CFrame.new(1.8812581888888e13, 9.9999999999999e29, 9.98235235621111e14)
                                
                                if AntiB.AutoCounter then
                                    ab_BuyBagFast()
                                end
                                
                                if statusLabel then
                                    statusLabel:SetText('DODGING: ' .. player.Name)
                                end
                                return
                            end
                        else
                            AntiB.TrackedSwingers[player.Name] = nil
                        end
                    end
                end
            end
            
            if statusLabel and not AntiB.Dodging then
                statusLabel:SetText('No Threats')
            end
        end)
    end

    AntiBagLoop()



    
    AntiBagGroup:AddToggle('antibag_enabled', {
        Text = 'Enable Anti-Bag',
        Default = false,
        Tooltip = 'Briefly voids you to dodge incoming bags',
        Callback = function(v)
            AntiB.Enabled = v
            if not v then
                AntiB.Dodging = false
                AntiB.SavedCFrame = nil
                AntiB.DodgeCount = 0
                AntiB.CurrentThreat = nil
                AntiB.HasSwung = false
                ab_ReturnFromVoidFast()
                if AntiB.AutoEquipped and AntiB.AutoEquipped.Parent == LocalPlayer.Character then
                    AntiB.AutoEquipped.Parent = LocalPlayer.Backpack
                end
                AntiB.AutoEquipped = nil
                if statusLabel then
                    statusLabel:SetText('No Threats')
                end
            end
        end
    })


    AntiBagGroup:AddToggle('antibag_auto_counter', {
        Text = 'Auto Counter Bag',
        Default = false,
        Tooltip = 'Automatically buys bag, equips and swings while voided, then un-voids right behind the threat',
        Callback = function(v) 
            AntiB.AutoCounter = v 
            if v then
                Library:Notify('Auto Counter enabled', 2)
            end
        end
    })


    AntiBagGroup:AddSlider('antibag_detection_radius', {
        Text = 'Detection Radius',
        Default = 107,
        Min = 5,
        Max = 1000,
        Rounding = 0,
        Suffix = ' studs',
        Callback = function(v) AntiB.DetectionRadius = v end
