end

local strafeTargetPlayer = nil
local lockTargetPlayer = nil

local function findNewStrafeTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local viewportCenter = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local bestPlr, bestDist = nil, math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Head")
            if hum and hum.Health > 0 and hrp then
                local be = plr.Character:FindFirstChild("BodyEffects")
                local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
                local isSD = be and be:FindFirstChild("SDeath") and be["SDeath"].Value
                if not (isKO or isSD) then
                    local screenPos, onScreen = cam:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestPlr = plr
                        end
                    end
                end
            end
        end
    end
    return bestPlr
end

local function getSelectedTarget()
    if strafeTargetPlayer and strafeTargetPlayer.Parent and strafeTargetPlayer.Character then
        local hum = strafeTargetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            return strafeTargetPlayer
        end
    end
    if lockTargetPlayer and lockTargetPlayer.Parent and lockTargetPlayer.Character then
        local hum = lockTargetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            return lockTargetPlayer
        end
    end
    local tld = _G.TargetLockDot
    if tld and tld.isActive and tld.lockedPlr and tld.lockedPlr.Parent then
        return tld.lockedPlr
    end
    local name = Options and Options.TargetPlayerDropdown and Options.TargetPlayerDropdown.Value
    if name and name ~= "No Players" and name ~= "" then
        local plr = Players:FindFirstChild(name)
        if plr then return plr end
    end
    if CamLockSettings and CamLockSettings.StickyTarget and CamLockSettings.StickyTarget.Parent then
        local plr = Players:GetPlayerFromCharacter(CamLockSettings.StickyTarget.Parent)
        if plr then return plr end
    end
    return nil
end

_G.TargetLockDot = _G.TargetLockDot or {}
local TLD = _G.TargetLockDot

TLD.part = TLD.part or nil
TLD.lockedPlr = nil
TLD.isActive = false
TLD.wasAvailable = false

function TLD.cleanup()
    if TLD.part then
        TLD.part.CFrame = CFrame.new(0, 9999, 0)
    end
    TLD.lockedPlr = nil
    TLD.isActive = false
    TLD.wasAvailable = false
end

function TLD.ensurePart()
    local dotColor = (Options and Options.DotTargetColor and Options.DotTargetColor.Value) or Color3.fromRGB(255, 30, 30)
    if not TLD.part or not TLD.part.Parent then
        local part = Instance.new("Part")
        part.Name = "KraviXTargetDotMarker"
        part.Anchored = true
        part.CanCollide = false
        part.Size = Vector3.new(0.1, 0.1, 0.1)
        part.Transparency = 1
        part.CFrame = CFrame.new(0, 9999, 0)
        part.Parent = workspace

        local bgui = Instance.new("BillboardGui")
        bgui.Name = "PP"
        bgui.Adornee = part
        bgui.Size = UDim2.new(0, 16, 0, 16)
        bgui.AlwaysOnTop = true
        bgui.LightInfluence = 0
        bgui.Parent = part

        local frame = Instance.new("Frame", bgui)
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundTransparency = 0
        frame.BackgroundColor3 = dotColor
        frame.BorderSizePixel = 0

        local corner = Instance.new("UICorner", frame)
        corner.CornerRadius = UDim.new(1, 0)

        local stroke = Instance.new("UIStroke", frame)
        stroke.Color = Color3.fromRGB(0, 0, 0)
        stroke.Thickness = 1.5

        TLD.part = part
    else
        if TLD.part:FindFirstChild("PP") and TLD.part.PP:FindFirstChildOfClass("Frame") then
            TLD.part.PP:FindFirstChildOfClass("Frame").BackgroundColor3 = dotColor
        end
    end
end

function TLD.lock(plr)
    if not plr or not plr.Parent then return end
    TLD.lockedPlr = plr
    TLD.isActive = true
    TLD.wasAvailable = true
    TLD.ensurePart()
    if Toggles and Toggles.EnableSilent and not Toggles.EnableSilent.Value then
        pcall(function() Toggles.EnableSilent:SetValue(true) end)
    end
    Library:Notify("Locked Target Dot on: " .. (plr.DisplayName or plr.Name), 3)
end

function TLD.unlock()
    local oldName = TLD.lockedPlr and (TLD.lockedPlr.DisplayName or TLD.lockedPlr.Name)
    TLD.cleanup()
    if oldName then
        Library:Notify("Unlocked Target Dot from: " .. oldName, 3)
    else
        Library:Notify("Unlocked Target Dot", 2)
    end
end

