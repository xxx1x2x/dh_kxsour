do
local CamLockSettings = {
    Enabled = false,
    Smoothness = 0.450,
    Prediction = 0.100,
    PredictionEnabled = true,
    WallCheck = true,
    KOCheck = true,
    TargetPart = "HumanoidRootPart",
    Sticky = false,
    StickyTarget = nil,
    ShowFOV = false,
    FOVMode = "Mouse",
    FOV = 200,
    FOVColor = Color3.fromRGB(200, 200, 255),
}

local CamFOVCircle = Drawing.new("Circle")
CamFOVCircle.Thickness = 1.5
CamFOVCircle.NumSides = 64
CamFOVCircle.Filled = false
CamFOVCircle.Transparency = 1
CamFOVCircle.Color = CamLockSettings.FOVColor

local function GetCamLockFOVOrigin()
    if CamLockSettings.FOVMode == "Mouse" or CamLockSettings.FOVMode == "mouse" then
        return UserInputService:GetMouseLocation()
    else
        return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    end
end

local function GetCamLockTarget()
    local origin = GetCamLockFOVOrigin()
    local bestTarget, bestDist = nil, CamLockSettings.FOV or 200
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local partName = CamLockSettings.TargetPart
            local part = plr.Character:FindFirstChild(partName)
            if partName == "Legs" then
                part = plr.Character:FindFirstChild("LeftLowerLeg") or plr.Character:FindFirstChild("RightLowerLeg") or plr.Character:FindFirstChild("HumanoidRootPart")
            end
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if part and hum and hum.Health > 0 then
                local be = plr.Character:FindFirstChild("BodyEffects")
                local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
                local isSD = be and be:FindFirstChild("SDeath") and be["SDeath"].Value
                if not (CamLockSettings.KOCheck and (isKO or isSD)) then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local mousePos = origin
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist < bestDist then
                            if CamLockSettings.WallCheck then
                                local rayOrigin = Camera.CFrame.Position
                                local rayDir = part.Position - rayOrigin
                                local rayParams = RaycastParams.new()
                                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                                local ignoreList = {LocalPlayer.Character, plr.Character, Camera}
                                if workspace:FindFirstChild("Ignored") then table.insert(ignoreList, workspace.Ignored) end
                                rayParams.FilterDescendantsInstances = ignoreList
                                local hitResult = workspace:Raycast(rayOrigin, rayDir, rayParams)
                                if not hitResult then
                                    bestDist = dist
                                    bestTarget = part
                                end
                            else
                                bestDist = dist
                                bestTarget = part
                            end
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

RunService.RenderStepped:Connect(function()
    if CamLockSettings.ShowFOV then
        local origin = GetCamLockFOVOrigin()
        CamFOVCircle.Position = origin
        CamFOVCircle.Radius = CamLockSettings.FOV
        CamFOVCircle.Color = CamLockSettings.FOVColor
        CamFOVCircle.Visible = true
    else
        CamFOVCircle.Visible = false
    end

    local isHolding = CamLockSettings.Enabled and Options.CamLockKey and Options.CamLockKey:GetState()
    if isHolding then
        local targetPart = nil
        if CamLockSettings.Sticky and CamLockSettings.StickyTarget and CamLockSettings.StickyTarget.Parent then
            local stickyChar = CamLockSettings.StickyTarget.Parent
            local stickyHum = stickyChar:FindFirstChildOfClass("Humanoid")
            local stickyBE = stickyChar:FindFirstChild("BodyEffects")
            local stickyKO = stickyBE and stickyBE:FindFirstChild("K.O") and stickyBE["K.O"].Value
            local stickySD = stickyBE and stickyBE:FindFirstChild("SDeath") and stickyBE["SDeath"].Value
            if stickyHum and stickyHum.Health > 0 and not (CamLockSettings.KOCheck and (stickyKO or stickySD)) then
                targetPart = CamLockSettings.StickyTarget
            else
                CamLockSettings.StickyTarget = nil
                targetPart = GetCamLockTarget()
                if CamLockSettings.Sticky then
                    CamLockSettings.StickyTarget = targetPart
                end
            end
        else
            targetPart = GetCamLockTarget()
            if CamLockSettings.Sticky then
                CamLockSettings.StickyTarget = targetPart
            end
        end

        if targetPart then
            local targetPos = targetPart.Position
            if CamLockSettings.PredictionEnabled then
                local vel = targetPart.Velocity or Vector3.zero
                targetPos = targetPos + (vel * CamLockSettings.Prediction)
            end

            local currentCF = Camera.CFrame
            local targetCF = CFrame.new(currentCF.Position, targetPos)
            Camera.CFrame = currentCF:Lerp(targetCF, math.clamp(CamLockSettings.Smoothness, 0.01, 1))
        end
    else
        CamLockSettings.StickyTarget = nil
    end
end)

local CamLockGroup = Tabs.main:AddLeftGroupbox('CamLock System', 'lock')

CamLockGroup:AddToggle('EnableCamLock', {Text = 'Enable CamLock', Default = false}):AddKeyPicker('CamLockKey', {Default = 'MB2', SyncToggleState = false, Mode = 'Hold', Text = 'CamLock Key', NoUI = false})
CamLockGroup:AddToggle('CamKOCheck', {Text = 'K.O Check', Default = true})
CamLockGroup:AddToggle('CamWallCheck', {Text = 'Wall Check', Default = true})
CamLockGroup:AddToggle('CamSticky', {Text = 'Sticky Target', Default = false})
CamLockGroup:AddToggle('CamPrediction', {Text = 'Prediction', Default = true})
CamLockGroup:AddSlider('CamPredictionValue', {Text = 'Prediction Amount', Default = 0.100, Min = 0, Max = 0.5, Rounding = 3})
CamLockGroup:AddSlider('CamSmooth', {Text = 'Smoothness', Default = 0.450, Min = 0.01, Max = 1, Rounding = 3})
CamLockGroup:AddDropdown('CamTargetPart', {Values = {'Head', 'HumanoidRootPart', 'UpperTorso', 'Legs'}, Default = 2, Multi = false, Text = 'Target Part'})
CamLockGroup:AddToggle('CamShowFOV', {Text = 'Show FOV Circle', Default = false})
CamLockGroup:AddDropdown('CamFOVMode', {Values = {'Mouse', 'Center'}, Default = 1, Multi = false, Text = 'FOV Origin'})
CamLockGroup:AddSlider('CamFOVSize', {Text = 'FOV Radius', Default = 200, Min = 10, Max = 800, Rounding = 0})
CamLockGroup:AddLabel('FOV Color'):AddColorPicker('CamFOVColor', {Default = Color3.fromRGB(200, 200, 255), Title = 'FOV Color'})

Toggles.EnableCamLock:OnChanged(function() CamLockSettings.Enabled = Toggles.EnableCamLock.Value end)
Toggles.CamKOCheck:OnChanged(function() CamLockSettings.KOCheck = Toggles.CamKOCheck.Value end)
Toggles.CamSticky:OnChanged(function() CamLockSettings.Sticky = Toggles.CamSticky.Value end)
Toggles.CamWallCheck:OnChanged(function() CamLockSettings.WallCheck = Toggles.CamWallCheck.Value end)
Toggles.CamPrediction:OnChanged(function() CamLockSettings.PredictionEnabled = Toggles.CamPrediction.Value end)
Options.CamPredictionValue:OnChanged(function() CamLockSettings.Prediction = Options.CamPredictionValue.Value end)
Options.CamSmooth:OnChanged(function() CamLockSettings.Smoothness = Options.CamSmooth.Value end)
Options.CamTargetPart:OnChanged(function() CamLockSettings.TargetPart = Options.CamTargetPart.Value end)
Toggles.CamShowFOV:OnChanged(function() CamLockSettings.ShowFOV = Toggles.CamShowFOV.Value end)
Options.CamFOVMode:OnChanged(function() CamLockSettings.FOVMode = Options.CamFOVMode.Value end)
Options.CamFOVSize:OnChanged(function() CamLockSettings.FOV = Options.CamFOVSize.Value end)
Options.CamFOVColor:OnChanged(function() CamLockSettings.FOVColor = Options.CamFOVColor.Value end)
end



do
local SilentAimSettings = {
    Enabled = false,
    KOCheck = false,
    WallCheck = false,
    MaxDistance = 500,
    FOVMode = "Mouse",
    TargetPart = "Head",
    ShowFOV = false,
    FOVColor = Color3.fromRGB(255, 255, 255),
    FOV = 150,
}

local GunHandler, OriginalGetAim
pcall(function()
    GunHandler = require(ReplicatedStorage.Modules.GunHandler)
    OriginalGetAim = GunHandler.getAim
end)

local function GetFOVOrigin()
    if SilentAimSettings.FOVMode == "Mouse" or SilentAimSettings.FOVMode == "mouse" then
        return UserInputService:GetMouseLocation()
    else
        return Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    end
end

local function GetNearestPlayerSilent()
    local best, target = math.huge, nil
    local origin = GetFOVOrigin()
    local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localHrp then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local targetPartName = SilentAimSettings.TargetPart
            local targetPart = plr.Character:FindFirstChild(targetPartName)
            if targetPartName == "Legs" then
                targetPart = plr.Character:FindFirstChild("LeftLowerLeg") or plr.Character:FindFirstChild("RightLowerLeg") or hrp
            end
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")

            if hrp and targetPart and hum and hum.Health > 0 then
                local dist = (hrp.Position - localHrp.Position).Magnitude
                if dist <= SilentAimSettings.MaxDistance then
                    local be = plr.Character:FindFirstChild("BodyEffects")
                    local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
                    local isSD = be and be:FindFirstChild("SDeath") and be["SDeath"].Value
                    if not (SilentAimSettings.KOCheck and (isKO or isSD)) then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local fovDist = (Vector2.new(screenPos.X, screenPos.Y) - origin).Magnitude
                            if fovDist <= SilentAimSettings.FOV and fovDist < best then
                                if SilentAimSettings.WallCheck then
                                    local rayOrigin = Camera.CFrame.Position
                                    local rayDir = targetPart.Position - rayOrigin
                                    local rayParams = RaycastParams.new()
                                    rayParams.FilterType = Enum.RaycastFilterType.Exclude
                                    local ignoreList = {LocalPlayer.Character, plr.Character, Camera}
                                    if workspace:FindFirstChild("Ignored") then table.insert(ignoreList, workspace.Ignored) end
                                    rayParams.FilterDescendantsInstances = ignoreList
                                    local hitResult = workspace:Raycast(rayOrigin, rayDir, rayParams)
                                    if not hitResult then
                                        best = fovDist
                                        target = targetPart
                                    end
                                else
                                    best = fovDist
                                    target = targetPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return target
end

local function GetNearestPlayerTracer()
    local best, target = math.huge, nil
    local origin = GetFOVOrigin()
    local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not localHrp then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local targetPartName = SilentAimSettings.TargetPart
            local targetPart = plr.Character:FindFirstChild(targetPartName)
            if targetPartName == "Legs" then
                targetPart = plr.Character:FindFirstChild("LeftLowerLeg") or plr.Character:FindFirstChild("RightLowerLeg") or hrp
            end
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")

            if hrp and targetPart and hum and hum.Health > 0 then
                local dist = (hrp.Position - localHrp.Position).Magnitude
                if dist <= SilentAimSettings.MaxDistance then
                    local be = plr.Character:FindFirstChild("BodyEffects")
                    local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
                    local isSD = be and be:FindFirstChild("SDeath") and be["SDeath"].Value
                    if not (SilentAimSettings.KOCheck and (isKO or isSD)) then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local fovDist = (Vector2.new(screenPos.X, screenPos.Y) - origin).Magnitude
                            if fovDist <= SilentAimSettings.FOV and fovDist < best then
                                best = fovDist
                                target = targetPart
                            end
                        end
                    end
                end
            end
        end
    end
    return target
end

local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5
FOVCircle.NumSides = 64
FOVCircle.Filled = false
FOVCircle.Transparency = 1
FOVCircle.Color = SilentAimSettings.FOVColor

local SilentTracer = Drawing.new("Line")
SilentTracer.Thickness = 1.5
SilentTracer.Transparency = 1
SilentTracer.Color = Color3.fromRGB(255, 255, 255)
SilentTracer.Visible = false

RunService.RenderStepped:Connect(function()
    if SilentAimSettings.ShowFOV then
        local origin = GetFOVOrigin()
        FOVCircle.Position = origin
        FOVCircle.Radius = SilentAimSettings.FOV
        FOVCircle.Color = SilentAimSettings.FOVColor
        FOVCircle.Visible = true
    else
        FOVCircle.Visible = false
    end

    if SilentAimSettings.Enabled and Toggles.SilentTracer and Toggles.SilentTracer.Value then
        local tracerTarget = GetNearestPlayerTracer()
        if tracerTarget then
            local screenPos, onScreen = Camera:WorldToViewportPoint(tracerTarget.Position)
            if onScreen then
                local origin = GetFOVOrigin()
                SilentTracer.From = origin
                SilentTracer.To = Vector2.new(screenPos.X, screenPos.Y)
                SilentTracer.Visible = true
            else
                SilentTracer.Visible = false
            end
        else
            SilentTracer.Visible = false
        end
    else
        SilentTracer.Visible = false
    end
end)

local dotPart = nil
local currentDotTarget = nil
local dotEnabledState = false
local lastDotToggleTime = 0

local function getClosestPlayerToCursorDot()
    local closestPlayer = nil
    local bestScore = math.huge
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local origin = GetFOVOrigin()

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            local root = v.Character:FindFirstChild("HumanoidRootPart")
            if root then
                local be = v.Character:FindFirstChild("BodyEffects")
                local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
                local isSD = be and be:FindFirstChild("SDeath") and be["SDeath"].Value
                if not (isKO or isSD) then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - origin).Magnitude
                        if mouseDist <= (SilentAimSettings.FOV or 500) then
                            local worldDist = (root.Position - myRoot.Position).Magnitude
                            local score = worldDist + (mouseDist * 0.5)
                            if score < bestScore then
                                bestScore = score
                                closestPlayer = v
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function cleanupDotTarget()
    if dotPart then
        dotPart.CFrame = CFrame.new(0, 9999, 0)
    end
    currentDotTarget = nil
    dotEnabledState = false
end

local function ensureDotPartExists()
    local dotColor = Options.DotTargetColor and Options.DotTargetColor.Value or Color3.fromRGB(255, 255, 255)
    if not dotPart or not dotPart.Parent then
        local part = Instance.new("Part")
        part.Name = "DotTargetMarkerPart"
        part.Anchored = true
        part.CanCollide = false
        part.Size = Vector3.new(0.1, 0.1, 0.1)
        part.Transparency = 1
        part.CFrame = CFrame.new(0, 9999, 0)
        part.Parent = workspace

        local bgui = Instance.new("BillboardGui")
        bgui.Name = "PP"
        bgui.Adornee = part
        bgui.Size = UDim2.new(0.20, 0, 0.20, 0)
        bgui.AlwaysOnTop = true
        bgui.Parent = part

        local frame = Instance.new("Frame", bgui)
        frame.Size = UDim2.new(4, 0, 4, 0)
        frame.BackgroundTransparency = 0.1
        frame.BackgroundColor3 = dotColor
        frame.BorderSizePixel = 0

        local corner = Instance.new("UICorner", frame)
        corner.CornerRadius = UDim.new(50, 50)

        dotPart = part
    else
        if dotPart:FindFirstChild("PP") and dotPart.PP:FindFirstChildOfClass("Frame") then
            dotPart.PP:FindFirstChildOfClass("Frame").BackgroundColor3 = dotColor
        end
    end
end

local function toggleDotLock()
    if tick() - lastDotToggleTime < 0.25 then return end
    lastDotToggleTime = tick()

    if not Toggles.DotTargetEnable or not Toggles.DotTargetEnable.Value then return end
    if not SilentAimSettings.Enabled then
        Library:Notify("Dot Target: Enable Silent Aim first!", 2)
        return
    end

    if dotEnabledState then
        cleanupDotTarget()
        Library:Notify("Dot Target: Unlocked", 2)
    else
        local targetPlr = getClosestPlayerToCursorDot()
        if targetPlr and targetPlr.Character then
            ensureDotPartExists()
            currentDotTarget = targetPlr
            dotEnabledState = true
            Library:Notify("Dot Target Locked: " .. (targetPlr.DisplayName or targetPlr.Name), 2)
        else
            Library:Notify("Dot Target: No target near cursor!", 2)
        end
    end
end

local function applyGunHandlerHook()
    if not GunHandler or not OriginalGetAim then return end
    GunHandler.getAim = function(origin, range)
        if SilentAimSettings.Enabled then
            local aimPos = nil
            if dotEnabledState and dotPart and dotPart.Parent and currentDotTarget then
                aimPos = dotPart.Position
            else
                local target = GetNearestPlayerSilent()
                if target and target.Parent then
                    aimPos = target.Position
                end
            end
            if aimPos then
                local dir = aimPos - origin
                if dir.Magnitude > 0.001 then
                    return dir.Unit, range
                end
            end
        end
        local ok, a, b = pcall(OriginalGetAim, origin, range)
        if ok and a then return a, b end
        return Camera.CFrame.LookVector, range
    end
end

local function removeGunHandlerHook()
    if GunHandler and OriginalGetAim then
        GunHandler.getAim = OriginalGetAim
    end
end

local SilentGroup = Tabs.main:AddRightGroupbox("Silent Aim")
SilentGroup:AddToggle("EnableSilent",  {Text="Enable Silent Aim", Default=false})
SilentGroup:AddToggle("SilentTracer",  {Text="Tracer",            Default=false})
SilentGroup:AddToggle("SilentKOCheck", {Text="K.O Check", Default=false})
SilentGroup:AddToggle("SilentWallCheck", {Text="Wall Check", Default=false})
SilentGroup:AddDropdown("SilentFOVMode", {Values={"Mouse", "Center"}, Default=1, Multi=false, Text="FOV Position"})
SilentGroup:AddSlider("SilentMaxDistance", {Text="Max Distance", Default=500, Min=50, Max=2000, Rounding=0})
SilentGroup:AddDropdown("SilentTargetPart", {Values={"Head","HumanoidRootPart","UpperTorso","LowerTorso"}, Default=1, Multi=false, Text="Target Part"})
SilentGroup:AddLabel("Tracer Color"):AddColorPicker("SilentTracerColor",{Default=Color3.fromRGB(255,255,255),Title="Tracer Color",Transparency=0})
SilentGroup:AddDivider()
SilentGroup:AddToggle("SilentShowFOV", {Text="Show FOV Circle", Default=false})
SilentGroup:AddSlider("SilentFOVSize", {Text="FOV Size", Default=150, Min=20, Max=1000, Rounding=0})
SilentGroup:AddLabel("FOV Color"):AddColorPicker("SilentFOVColor",{Default=Color3.fromRGB(255,255,255),Title="FOV Color",Transparency=0})

Toggles.EnableSilent:OnChanged(function()
    SilentAimSettings.Enabled = Toggles.EnableSilent.Value
    if SilentAimSettings.Enabled then applyGunHandlerHook() else removeGunHandlerHook() end
end)
Toggles.SilentKOCheck:OnChanged(function() SilentAimSettings.KOCheck = Toggles.SilentKOCheck.Value end)
Toggles.SilentWallCheck:OnChanged(function() SilentAimSettings.WallCheck = Toggles.SilentWallCheck.Value end)
Options.SilentFOVMode:OnChanged(function() SilentAimSettings.FOVMode = Options.SilentFOVMode.Value end)
Options.SilentMaxDistance:OnChanged(function() SilentAimSettings.MaxDistance = Options.SilentMaxDistance.Value end)
Options.SilentTargetPart:OnChanged(function() SilentAimSettings.TargetPart = Options.SilentTargetPart.Value end)
Options.SilentTracerColor:OnChanged(function() SilentTracer.Color = Options.SilentTracerColor.Value end)
Toggles.SilentShowFOV:OnChanged(function() SilentAimSettings.ShowFOV = Toggles.SilentShowFOV.Value end)
Options.SilentFOVSize:OnChanged(function() SilentAimSettings.FOV = Options.SilentFOVSize.Value end)
Options.SilentFOVColor:OnChanged(function() SilentAimSettings.FOVColor = Options.SilentFOVColor.Value end)

SilentGroup:AddToggle('DotTargetEnable', {Text='Dot Target', Default=false})
    :AddKeyPicker('DotTargetKey', {Default='Q', Mode='Toggle', Text='Dot Key', SyncToggleState=false, NoUI=false})
SilentGroup:AddLabel('Dot Color'):AddColorPicker('DotTargetColor', {Default=Color3.fromRGB(255,255,255), Title='Dot Color', Transparency=0})

Toggles.DotTargetEnable:OnChanged(function()
    if not Toggles.DotTargetEnable.Value then
        cleanupDotTarget()
    end
end)

Options.DotTargetColor:OnChanged(function()
    if dotPart and dotPart:FindFirstChild("PP") and dotPart.PP:FindFirstChildOfClass("Frame") then
        dotPart.PP:FindFirstChildOfClass("Frame").BackgroundColor3 = Options.DotTargetColor.Value
    end
end)

if Options.DotTargetKey and Options.DotTargetKey.OnClick then
    Options.DotTargetKey:OnClick(toggleDotLock)
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if Toggles.DotTargetEnable and Toggles.DotTargetEnable.Value then
        local dotKey = Options.DotTargetKey and Options.DotTargetKey.Value
        if dotKey and input.KeyCode == dotKey then
            toggleDotLock()
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if dotEnabledState and currentDotTarget and currentDotTarget.Character then
        local targetPartName = SilentAimSettings.TargetPart or "HumanoidRootPart"
        local part = currentDotTarget.Character:FindFirstChild(targetPartName) or currentDotTarget.Character:FindFirstChild("HumanoidRootPart")
        local hum = currentDotTarget.Character:FindFirstChildOfClass("Humanoid")
        local be = currentDotTarget.Character:FindFirstChild("BodyEffects")
        local isKO = be and be:FindFirstChild("K.O") and be["K.O"].Value
        local isSD = be and be:FindFirstChild("SDeath") and be["SDeath"].Value
        
        if part and hum and hum.Health > 0 and not (isKO or isSD) then
            ensureDotPartExists()
            dotPart.CFrame = part.CFrame
        else
            cleanupDotTarget()
        end
    else
        if dotPart then
            dotPart.CFrame = CFrame.new(0, 9999, 0)
        end
    end
end)
end



local HitboxSettings = {
    Enabled = false,
    Size = 15,
    Color = Color3.fromRGB(255, 255, 255),
    Transparency = 0.5,
}

local HitboxOriginal = {}
local HitboxVisuals = {}

local function applyToHRP(HRP)
    if not HitboxOriginal[HRP] then
        HitboxOriginal[HRP] = {
            Size = HRP.Size,
            CanCollide = HRP.CanCollide
        }
    end

    HRP.Size = Vector3.new(HitboxSettings.Size, HitboxSettings.Size, HitboxSettings.Size)
    HRP.CanCollide = false

    if not HitboxVisuals[HRP] or not HitboxVisuals[HRP].Parent then
        local sphere = Instance.new("Part")
        sphere.Name = "HitboxVisualizer"
        sphere.Material = Enum.Material.ForceField
        sphere.Color = HitboxSettings.Color
        sphere.Transparency = HitboxSettings.Transparency
        sphere.Size = Vector3.new(HitboxSettings.Size, HitboxSettings.Size, HitboxSettings.Size)
        sphere.Anchored = false
        sphere.CanCollide = false
        sphere.Massless = true
        sphere.Parent = workspace

        HitboxVisuals[HRP] = sphere
    else
        HitboxVisuals[HRP].Color = HitboxSettings.Color
        HitboxVisuals[HRP].Transparency = HitboxSettings.Transparency
        HitboxVisuals[HRP].Size = Vector3.new(HitboxSettings.Size, HitboxSettings.Size, HitboxSettings.Size)
    end
end

local function revertHRP(HRP)
    local data = HitboxOriginal[HRP]
    if data then
        if HRP and HRP.Parent then
            HRP.Size = data.Size
            HRP.CanCollide = data.CanCollide
        end
        HitboxOriginal[HRP] = nil
    end

    if HitboxVisuals[HRP] then
        pcall(function() HitboxVisuals[HRP]:Destroy() end)
        HitboxVisuals[HRP] = nil
    end
end

RunService.RenderStepped:Connect(function()
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer then
            local char = Player.Character
            local HRP = char and char:FindFirstChild("HumanoidRootPart")
            if HRP then
                if HitboxSettings.Enabled then
                    applyToHRP(HRP)
                    local visual = HitboxVisuals[HRP]
                    if visual then
                        visual.CFrame = HRP.CFrame
                    end
                else
                    revertHRP(HRP)
                end
            end
        end
    end
end)

