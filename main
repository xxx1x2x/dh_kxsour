    })


    AntiBagGroup:AddToggle('antibag_predict_teleport', {
        Text = 'Predict Teleport Baggers',
        Default = false,
        Tooltip = 'Instantly voids (ignoring delay) if a player teleports into your safe zone.',
        Callback = function(v) AntiB.PredictTeleport = v end
    })


    AntiBagGroup:AddSlider('antibag_teleport_tolerance', {
        Text = 'Teleport Speed Tolerance',
        Default = 80,
        Min = 10,
        Max = 200,
        Rounding = 0,
        Suffix = ' studs/frame',
        Callback = function(v) AntiB.TeleportTolerance = v end
    })


    AntiBagGroup:AddSlider('antibag_dodge_delay', {
        Text = 'Dodge Delay',
        Default = 0,
        Min = 0,
        Max = 1,
        Rounding = 2,
        Suffix = 's',
        Callback = function(v) AntiB.DodgeDelay = v end
    })


    AntiBagGroup:AddSlider('antibag_dodge_duration', {
        Text = 'Dodge Duration',
        Default = 0.46,
        Min = 0.05,
        Max = 1,
        Rounding = 2,
        Suffix = 's',
        Callback = function(v) AntiB.DodgeDuration = v end
    })


    AntiBagGroup:AddSlider('antibag_max_dodges', {
        Text = 'Max Dodge Cycles',
        Default = 2,
        Min = 1,
        Max = 10,
        Rounding = 0,
        Suffix = ' times',
        Callback = function(v) AntiB.MaxDodges = v end
    })


    AntiBagGroup:AddSlider('antibag_dodge_anim_target', {
        Text = 'Dodge Anim Target %',
        Default = 22,
        Min = 1,
        Max = 100,
        Rounding = 0,
        Suffix = '%',
        Tooltip = 'Animation progress percentage to detect bag swing (lower = faster detection)',
        Callback = function(v) AntiB.DodgeAnimTarget = v end
    })

    AntiBagGroup:AddSlider('antibag_dodge_anim_finish', {
        Text = 'Dodge Anim Finish %',
        Default = 29,
        Min = 1,
        Max = 100,
        Rounding = 0,
        Suffix = '%',
        Tooltip = 'Animation progress percentage to finish bag swing detection',
        Callback = function(v) AntiB.DodgeAnimFinish = v end
    })


    AntiBagGroup:AddToggle('antibag_respawn_on_bag', {
        Text = 'Respawn on bag',
        Default = false,
        Tooltip = 'If bag is detected on you, instantly reset',
        Callback = function(v) end
    })


    local AntiBagTargetDropdown = AntiBagGroup:AddDropdown('antibag_targets', {
        Values = {},
        Default = {},
        Multi = true,
        Text = 'Select Targets to Dodge',
        Tooltip = 'Target player that u wanna dodge on inf range bags or something like this',
        Callback = function() end
    })


    local function updateAntiBagPlayerList()
        local values = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                table.insert(values, player.DisplayName .. ' (@' .. player.Name .. ')')
            end
        end
        table.sort(values)
        if AntiBagTargetDropdown and AntiBagTargetDropdown.SetValues then
            AntiBagTargetDropdown:SetValues(values)
        end
    end

    Players.PlayerAdded:Connect(function()
        task.delay(0.5, updateAntiBagPlayerList)
    end)
    Players.PlayerRemoving:Connect(function()
        task.delay(0.5, updateAntiBagPlayerList)
    end)
    updateAntiBagPlayerList()
end


do
    local RB = {
        targets = {},
        lockedTarget = nil,
        active = false,
        enabled = false,
        selecttargets = false,
        flamethrower_hack = false,
        flamepos = "Above Head",
        stompactive = false,
        abovetarget = false,
        viewactive = false,
        notificationsEnabled = false,
        killCount = 0,
        deathCount = 0,
        lastKilledTarget = nil,
        trashTalkAutoEnabled = false,
        trashTalkSentForTarget = {},
        savedCFrame = nil,
        autoBuyWeapon = false,
        autoBuyAmmo = false,
        autoBagTarget = false,
        buyingWeapon = false,
        buyingAmmo = false,
        buyingBag = false,
        forceCFrame = nil,
        setStatus = function(txt) end,
        sendChat = function(msg) end,
        trashPhrases = {},
        killedTargets = {},
        trashSent = {},
        voidSelf = function(root) end,
        reloadTool = function() end,
        GroupBox = nil,
        TargetDropdown = nil,
        targetsDepBox = nil,
        updatePlayerList = function() end,
        getShopItem = nil,
        findGun = nil,
        getCurrentGunName = nil,
        hasSpecificGun = nil,
        hasGun = nil,
        buyGun = nil,
        getShopAmmoItem = nil,
        buyAmmo = nil,
        getMyBag = nil,
        isTargetBagged = nil,
        buyBag = nil,
        useBag = nil,
        getBagCFrame = nil,
    }

    local VirtualUser = game:GetService("VirtualUser")

    local function handleFlamethrower(char, root, targetChar)
        if not char or not root or not targetChar then return end
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local hum = char:FindFirstChildOfClass("Humanoid")
        local flameTool = char:FindFirstChild("[Flamethrower]") or char:FindFirstChild("Flamethrower")
        if not flameTool and bp then
            local bpFlame = bp:FindFirstChild("[Flamethrower]") or bp:FindFirstChild("Flamethrower")
            if bpFlame and hum then
                pcall(function() hum:EquipTool(bpFlame) end)
                flameTool = bpFlame
            end
        end
        if flameTool and flameTool:IsA("Tool") then
            pcall(function() flameTool:Activate() end)
            pcall(function()
                VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
            end)
        end
    end

