local animationParts = {
    "Idle1", "Walk", "Run", "Jump", "Climb", "Fall", "SwimIdle", "Swim"
}


local selectedAnimations = {
    Idle1 = nil,
    Walk = nil,
    Run = nil,
    Jump = nil,
    Climb = nil,
    Fall = nil,
    SwimIdle = nil,
    Swim = nil
}

local function applyAnimation(part, style)
    local char = LocalPlayer.Character
    if not char then return end
    local animate = char:FindFirstChild("Animate")
    if not animate then return end

    local styleData = animationStyles[style]
    if not styleData then return end

    local id
    if part == "Idle1" then id = styleData.idle1
    elseif part == "Walk" then id = styleData.walk
    elseif part == "Run" then id = styleData.run
    elseif part == "Jump" then id = styleData.jump
    elseif part == "Climb" then id = styleData.climb
    elseif part == "Fall" then id = styleData.fall
    elseif part == "SwimIdle" then id = styleData.swimidle
    elseif part == "Swim" then id = styleData.swim
    end

    if not id then return end

    local path
    if part == "Idle1" then path = "idle.Animation1"
    elseif part == "Walk" then path = "walk.WalkAnim"
    elseif part == "Run" then path = "run.RunAnim"
    elseif part == "Jump" then path = "jump.JumpAnim"
    elseif part == "Climb" then path = "climb.ClimbAnim"
    elseif part == "Fall" then path = "fall.FallAnim"
    elseif part == "SwimIdle" then path = "swimidle.SwimIdle"
    elseif part == "Swim" then path = "swim.Swim"
    end

    if path then
        local parts = {}
        for token in string.gmatch(path, "[^%.]+") do
            table.insert(parts, token)
        end
        local obj = animate
        for i = 1, #parts - 1 do
            obj = obj[parts[i]]
            if not obj then return end
        end
        local last = parts[#parts]
        if obj and obj[last] then
            obj[last].AnimationId = "http://www.roblox.com/asset/?id=" .. id
        end
    end
end

local function reapplyAllAnimations()
    for part, style in pairs(selectedAnimations) do
        if style then
            applyAnimation(part, style)
        end
    end
end



local animGroup = Tabs.character:AddLeftGroupbox('Animation Parts')

for _, part in ipairs(animationParts) do
    local styleNames = {}
    for name in pairs(animationStyles) do
        table.insert(styleNames, name)
    end
    table.sort(styleNames)

    animGroup:AddDropdown("Anim_" .. part, {
        Values    = styleNames,
        Default   = 1,
        AllowNull = true,
        Multi     = false,
        Text      = part,
        Callback  = function(value)
            selectedAnimations[part] = value
            applyAnimation(part, value)
        end
    })
end


