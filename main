        if getgenv().rb_forceCFrameConn then getgenv().rb_forceCFrameConn:Disconnect() end
        getgenv().rb_forceCFrameConn = RunService.Heartbeat:Connect(function()
            if RB.forceCFrame then
                local c = LocalPlayer.Character
                local hrp = c and c:FindFirstChild('HumanoidRootPart')
