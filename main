local game_hud_styles = {
    ["Default"] = function()
        local main_gui = getGameMainGui()
        if not main_gui then return end
        local bar = main_gui:FindFirstChild("Bar")
        if not bar then return end

        for _, object in ipairs(bar:GetChildren()) do
            if object:IsA("GuiObject") then
                local corner = object:FindFirstChildOfClass("UICorner")
                if corner then corner:Destroy() end
                if object:FindFirstChild("bar") then
                    local corner2 = object.bar:FindFirstChildOfClass("UICorner")
                    if corner2 then corner2:Destroy() end
                end
                local line = object:FindFirstChild("line")
                if line then line:Destroy() end
                local shadow = object:FindFirstChild("shadow")
                if shadow then shadow:Destroy() end
                object.BackgroundColor3 = Color3.fromRGB(58,58,58)
                if object:FindFirstChild("Picture") then
                    object.Picture.Visible = true
                end
                object.BackgroundTransparency = 0
                if object:FindFirstChild("bar") then
                    object.bar.BackgroundTransparency = object.Name == "Armor" and 0.3 or 0
                end
                if object.Name == "Armor" and object:FindFirstChild("firebar") then
                    object.firebar.BackgroundTransparency = 0
                    local corner3 = object.firebar:FindFirstChildOfClass("UICorner")
                    if corner3 then corner3:Destroy() end
                end
                if object:FindFirstChild("TextLabel") then
                    object.TextLabel.TextXAlignment = object.Name == "Energy" and Enum.TextXAlignment.Right or object.Name == "Armor" and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
                    object.TextLabel.TextSize = 18
                    object.TextLabel.Font = Enum.Font.SourceSansBold
                    if object.TextLabel.Text and #object.TextLabel.Text > 0 then
                        object.TextLabel.Text = string.upper(string.sub(object.TextLabel.Text, 1, 1)) .. string.sub(object.TextLabel.Text, 2, #object.TextLabel.Text)
                    end
                end
            end
        end
    end,
    ["Minimalistic"] = function()
        local main_gui = getGameMainGui()
        if not main_gui then return end
        local bar = main_gui:FindFirstChild("Bar")
        if not bar then return end

        for _, object in ipairs(bar:GetChildren()) do
            if object:IsA("GuiObject") then
                if not object:FindFirstChildOfClass("UICorner") then
                    Instance.new("UICorner", object)
                end
                object.BackgroundColor3 = Color3.fromRGB(0,0,0)
                if object:FindFirstChild("Picture") then
                    object.Picture.Visible = false
                end
                if object:FindFirstChild("bar") and not object.bar:FindFirstChildOfClass("UICorner") then
                    Instance.new("UICorner", object.bar)
                end
                if object.Name == "Armor" and object:FindFirstChild("firebar") then
                    if not object.firebar:FindFirstChildOfClass("UICorner") then
                        Instance.new("UICorner", object.firebar)
                    end
                    object.firebar.BackgroundTransparency = 0.5
                end
                if object:FindFirstChild("bar") then
                    object.bar.BackgroundTransparency = 0.5
                end
                object.BackgroundTransparency = 0.5
                if object:FindFirstChild("TextLabel") then
                    object.TextLabel.TextXAlignment = Enum.TextXAlignment.Center
                    object.TextLabel.TextSize = 14
                    object.TextLabel.Text = string.lower(object.TextLabel.Text)
                    object.TextLabel.Font = Enum.Font.GothamBold
                end
            end
        end
    end,
    ["Simple dark"] = function()
        local main_gui = getGameMainGui()
        if not main_gui then return end
        local bar = main_gui:FindFirstChild("Bar")
        if not bar then return end

        for _, object in ipairs(bar:GetChildren()) do
            if object:IsA("GuiObject") then
                object.BackgroundColor3 = Color3.fromRGB(20,20,20)
                if object:FindFirstChild("Picture") then
                    object.Picture.Visible = false
                end
                if object:FindFirstChild("TextLabel") then
                    object.TextLabel.TextXAlignment = Enum.TextXAlignment.Center
                    object.TextLabel.TextSize = 14
                    object.TextLabel.Text = string.lower(object.TextLabel.Text)
                    object.TextLabel.Font = Enum.Font.ArialBold
                end
            end
        end
    end
}

local function applyGameHud()
    local main_gui = getGameMainGui()
    if not main_gui then return end
    local bar = main_gui:FindFirstChild("Bar")
    if not bar then return end

    if gameHudSettings.enabled then
        game_hud_styles["Default"]()
        if game_hud_styles[gameHudSettings.style] then
            game_hud_styles[gameHudSettings.style]()
        end
        if bar:FindFirstChild("HP") and bar.HP:FindFirstChild("bar") then
            bar.HP.bar.BackgroundColor3 = gameHudSettings.healthColor
        end
        if bar:FindFirstChild("Energy") and bar.Energy:FindFirstChild("bar") then
            bar.Energy.bar.BackgroundColor3 = gameHudSettings.energyColor
        end
        if bar:FindFirstChild("Armor") then
            if bar.Armor:FindFirstChild("bar") then
                bar.Armor.bar.BackgroundColor3 = gameHudSettings.armorColor
            end
            if bar.Armor:FindFirstChild("firebar") then
                bar.Armor.firebar.BackgroundColor3 = gameHudSettings.firearmorColor
            end
        end
    else
        game_hud_styles["Default"]()
        if bar:FindFirstChild("HP") and bar.HP:FindFirstChild("bar") then
            bar.HP.bar.BackgroundColor3 = Color3.fromRGB(36, 182, 3)
        end
        if bar:FindFirstChild("Energy") and bar.Energy:FindFirstChild("bar") then
            bar.Energy.bar.BackgroundColor3 = Color3.fromRGB(182, 182, 9)
        end
        if bar:FindFirstChild("Armor") then
            if bar.Armor:FindFirstChild("bar") then
                bar.Armor.bar.BackgroundColor3 = Color3.fromRGB(0, 136, 194)
            end
            if bar.Armor:FindFirstChild("firebar") then
                bar.Armor.firebar.BackgroundColor3 = Color3.fromRGB(253, 121, 33)
            end
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if gameHudSettings.enabled then
        applyGameHud()
    end
end)

