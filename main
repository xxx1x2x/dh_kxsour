local showHitNotifyFunc
do
    local gui, container, active = nil, nil, {}
    local W, H, GAP, DUR, FADE = 240, 26, 5, 2.5, 0.25
    local MAX = 6

    local function createHitNotifyGui()
        if gui and gui.Parent then return end
        gui = Instance.new("ScreenGui")
        gui.Name = "KraviXHitNotifyGui"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        pcall(function() gui.Parent = game:GetService("CoreGui") end)
        if not gui.Parent then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

        container = Instance.new("Frame")
        container.Name = "Container"
        container.Parent = gui
        container.BackgroundTransparency = 1
        container.BorderSizePixel = 0
        container.Size = UDim2.new(0, W, 0, 200)
        container.AnchorPoint = Vector2.new(0.5, 1)
        container.Position = UDim2.new(0.5, 0, 0.78, 0)
    end

    local function updatePositions(animated)
        for i, n in ipairs(active) do
            if n.frame and n.frame.Parent then
                local targetY = -(i * H) - ((i - 1) * GAP)
                n.currentY = targetY
                local targetPos = UDim2.new(0, 0, 1, targetY)
                if animated then
                    TweenService:Create(n.frame, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = targetPos}):Play()
                else
                    n.frame.Position = targetPos
                end
            end
        end
    end

    local function fadeOut(n)
        if not n or n.removing then return end
        n.removing = true
        local frame, label = n.frame, n.label
        if frame and frame.Parent then
            TweenService:Create(frame, TweenInfo.new(FADE, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Position = UDim2.new(0, 40, 1, n.currentY), BackgroundTransparency = 1}):Play()
            TweenService:Create(label, TweenInfo.new(FADE, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1}):Play()
            task.delay(FADE + 0.05, function()
                if frame and frame.Parent then frame:Destroy() end
            end)
        end
        for i, x in ipairs(active) do
            if x == n then table.remove(active, i); break end
        end
        updatePositions(true)
    end

    showHitNotifyFunc = function(targetName, partName, damage)
        if Toggles.HitNotifyToggle and not Toggles.HitNotifyToggle.Value then return end
        createHitNotifyGui()
        while #active >= MAX do
            local old = active[1]
            if old then fadeOut(old) else break end
        end

        local frame = Instance.new("Frame")
        frame.Name = "HitNotifyCard"
        frame.Parent = container
        frame.Size = UDim2.new(1, 0, 0, H)
        frame.Position = UDim2.new(0, -20, 1, -H)
        frame.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
        frame.BackgroundTransparency = 1
        frame.BorderSizePixel = 0

        local corner = Instance.new("UICorner", frame)
        corner.CornerRadius = UDim.new(1, 0)

        local label = Instance.new("TextLabel")
        label.Parent = frame
        label.Size = UDim2.new(1, -16, 1, 0)
        label.Position = UDim2.new(0, 8, 0, 0)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold
        label.TextSize = 12
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.TextYAlignment = Enum.TextYAlignment.Center
        label.RichText = true
        label.TextTransparency = 1

        local textStr
        if damage and damage > 0 then
            textStr = string.format("<font color=\"#C084FC\">Hit</font> <b><font color=\"#FFFFFF\">%s</font></b> <font color=\"#A855F7\">(-%d HP)</font>", tostring(targetName), damage)
        else
            textStr = string.format("<font color=\"#C084FC\">Hit</font> <b><font color=\"#FFFFFF\">%s</font></b>", tostring(targetName))
        end
        label.Text = textStr

        local item = { frame = frame, label = label, currentY = -H, removing = false }
        table.insert(active, item)
        updatePositions(false)

        local finalPos = UDim2.new(0, 0, 1, item.currentY)
        TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = finalPos, BackgroundTransparency = 0.2}):Play()
        TweenService:Create(label, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()

        task.delay(DUR, function()
            if item and not item.removing then fadeOut(item) end
        end)
    end
end

local HitSndSettings = {sound_enabled = false, sound_id = "Gamesense", sound_volume = 1, custom_id = ""}

local triggerHitmarker

local function doHitSound()
    if not (HitSndSettings.sound_enabled or (Toggles.HitSoundToggle and Toggles.HitSoundToggle.Value)) then return end
    local soundId = hitsounds[HitSndSettings.sound_id]
    if HitSndSettings.sound_id == "Custom" or (Options and Options.HitSoundSelect and Options.HitSoundSelect.Value == "Custom") then
        local rawCustom = HitSndSettings.custom_id or (Options and Options.HitCustomSoundID and Options.HitCustomSoundID.Value) or ""
        if rawCustom ~= "" then
            if not rawCustom:find("rbxassetid://") and tonumber(rawCustom) then
                soundId = "rbxassetid://" .. rawCustom
            else
                soundId = rawCustom
            end
        end
    end
    local s = Instance.new("Sound")
    s.SoundId = soundId or "rbxassetid://97643101798871"
    s.Volume = HitSndSettings.sound_volume
    s.Parent = workspace
    s:Play()
    s.Ended:Connect(function() s:Destroy() end)
end
doHitSoundFunc = doHitSound

local myTargets = {}
local targetHealth = {}

local function addTargetFromShot()
    local mousePos = UserInputService:GetMouseLocation()
    local closestPlayer = nil
    local closestDist = 200
    local hitPartName = "Head"

    local cam = workspace.CurrentCamera
    if cam then
        local ray = cam:ViewportPointToRay(mousePos.X, mousePos.Y)
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        if LocalPlayer.Character then
            rayParams.FilterDescendantsInstances = { LocalPlayer.Character }
        end
        rayParams.IgnoreWater = true
        local res = workspace:Raycast(ray.Origin, ray.Direction * 1000, rayParams)
        if res and res.Instance then
            local p = Players:GetPlayerFromCharacter(res.Instance.Parent) or Players:GetPlayerFromCharacter(res.Instance.Parent.Parent)
            if p and p ~= LocalPlayer then
                closestPlayer = p
                hitPartName = res.Instance.Name
            end
        end
    end

    if not closestPlayer then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closestPlayer = player
                            local mDist = 9999
                            for _, part in ipairs(player.Character:GetChildren()) do
                                if part:IsA("BasePart") then
                                    local pPos, pOn = Camera:WorldToViewportPoint(part.Position)
                                    if pOn then
                                        local d = (Vector2.new(pPos.X, pPos.Y) - mousePos).Magnitude
                                        if d < mDist then
                                            mDist = d
                                            hitPartName = part.Name
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if closestPlayer then
        myTargets[closestPlayer.UserId] = { player = closestPlayer, part = hitPartName }
        if closestPlayer.Character then
            local hum = closestPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                targetHealth[closestPlayer.UserId] = hum.Health
            end
        end
        task.delay(3, function()
            myTargets[closestPlayer.UserId] = nil
            targetHealth[closestPlayer.UserId] = nil
        end)
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and tool:FindFirstChild("Ammo") then
                task.spawn(addTargetFromShot)
            end
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or
       input.UserInputType == Enum.UserInputType.MouseButton2 then
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and tool:FindFirstChild("Ammo") then
                task.spawn(addTargetFromShot)
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    for userId, data in pairs(myTargets) do
        local player = (type(data) == "table" and data.player) or data
        local partName = (type(data) == "table" and data.part) or "Head"
        if player and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                local cur = hum.Health
                local prev = targetHealth[userId] or cur
                if cur < prev then
                    local damage = math.floor(prev - cur)
                    doHitSound()
                    triggerHitmarker(player)
                    if showHitNotifyFunc then
                        showHitNotifyFunc(player.DisplayName or player.Name, partName, damage)
                    end
                end
                targetHealth[userId] = cur
                if cur <= 0 then
                    myTargets[userId] = nil
                    targetHealth[userId] = nil
                end
            end
        else
            myTargets[userId] = nil
            targetHealth[userId] = nil
        end
    end
end)

