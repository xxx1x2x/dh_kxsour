local weatherPart = nil
local weatherParticle = nil
local weatherTypes = {
    ["rain"] = {
        Speed = NumberRange.new(60, 60),
        LockedToPart = true,
        Rate = 600,
        Texture = "rbxassetid://1822883048",
        EmissionDirection = Enum.NormalId.Bottom,
        Transparency = NumberSequence.new{
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.25, 0.784),
            NumberSequenceKeypoint.new(0.75, 0.784),
            NumberSequenceKeypoint.new(1, 1)
        },
        Lifetime = NumberRange.new(0.8, 0.8),
        LightEmission = 0.05,
        LightInfluence = 0.9,
        Orientation = Enum.ParticleOrientation.FacingCameraWorldUp,
        Size = NumberSequence.new{
            NumberSequenceKeypoint.new(0, 10),
            NumberSequenceKeypoint.new(1, 10)
        }
    },
    ["snow"] = {
        Transparency = NumberSequence.new{
            NumberSequenceKeypoint.new(0, 0.737),
            NumberSequenceKeypoint.new(0.973, 0.768),
            NumberSequenceKeypoint.new(1, 1)
        },
        Texture = "rbxassetid://99851851",
        SpreadAngle = Vector2.new(50, 50),
        Speed = NumberRange.new(20, 35),
        Lifetime = NumberRange.new(1.2, 1.8),
        LightEmission = 0.5,
        Rate = 1000,
        EmissionDirection = Enum.NormalId.Bottom,
        Orientation = Enum.ParticleOrientation.FacingCameraWorldUp,
        Size = NumberSequence.new{
            NumberSequenceKeypoint.new(0, 0.33),
            NumberSequenceKeypoint.new(0.551, 0.4),
            NumberSequenceKeypoint.new(1, 0.33)
        }
    }
}

local function applyWeatherProps(p, props)
    for prop, val in pairs(props) do
        pcall(function() p[prop] = val end)
    end
end

local function updateWeather()
    if weatherPart then
        weatherPart:Destroy()
        weatherPart = nil
        weatherParticle = nil
    end

    if Toggles.EnableWeather and Toggles.EnableWeather.Value then
        local cam = workspace.CurrentCamera
        if not cam then return end

        weatherPart = Instance.new("Part")
        weatherPart.Size = Vector3.new(40, 40, 85)
        weatherPart.CanCollide = false
        weatherPart.Massless = true
        weatherPart.CastShadow = false
        weatherPart.Transparency = 1
        weatherPart.Anchored = true
        weatherPart.Name = "WeatherPart"
        weatherPart.Parent = workspace:FindFirstChild("Ignored") or workspace

        local wType = Options.WeatherType and Options.WeatherType.Value or "rain"
        local data = weatherTypes[wType] or weatherTypes["rain"]

        weatherParticle = Instance.new("ParticleEmitter")
        applyWeatherProps(weatherParticle, data)

        local colorVal = Options.WeatherColor and Options.WeatherColor.Value or Color3.fromRGB(255, 255, 255)
        weatherParticle.Color = ColorSequence.new(colorVal)

        local rateSlider = Options.WeatherRate and Options.WeatherRate.Value or 100
        weatherParticle.Rate = (data.Rate or 600) * (rateSlider / 100)

        weatherParticle.Parent = weatherPart
    end
end

Toggles.EnableWeather:OnChanged(updateWeather)
Options.WeatherType:OnChanged(updateWeather)
Options.WeatherColor:OnChanged(function()
    if weatherParticle and Options.WeatherColor then
        weatherParticle.Color = ColorSequence.new(Options.WeatherColor.Value)
    end
end)
Options.WeatherRate:OnChanged(function()
    if weatherParticle and Options.WeatherRate then
        local wType = Options.WeatherType and Options.WeatherType.Value or "rain"
        local data = weatherTypes[wType] or weatherTypes["rain"]
        weatherParticle.Rate = (data.Rate or 600) * (Options.WeatherRate.Value / 100)
    end
end)

RunService.RenderStepped:Connect(function()
    if weatherPart and Toggles.EnableWeather and Toggles.EnableWeather.Value then
        local cam = workspace.CurrentCamera
        if cam then
            weatherPart.CFrame = CFrame.new(cam.CFrame.Position) + Vector3.new(0, 20, 0)
        end
    end
end)

