        ["Cloak Aura"]   = 99046723611000,
        ["Sweet Hearth"] = 91724768175470,
        ["Ethereal"]     = 97041568674250,
    }



    local sa2ParticleAuraIDs = {
        ["Starlight"] = 134645216613107,
        ["Heavenly"]  = 139300897520961,
        ["Ribbon"]    = 132069507632161,
        ["Sakura"]    = 81755778619404,
