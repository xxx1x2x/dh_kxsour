MiscGroup:AddToggle("AntiFlingToggle", {Text="Anti Fling", Default=false})
local antiflingConn
local function ToggleAntiFling(state)
    if antiflingConn then antiflingConn:Disconnect() antiflingConn = nil end
    if state then
        antiflingConn = RunService.Stepped:Connect(function()
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    for _, v in pairs(player.Character:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = false end
                    end
                end
            end
        end)
    end
end
Toggles.AntiFlingToggle:OnChanged(function() ToggleAntiFling(Toggles.AntiFlingToggle.Value) end)

MiscGroup:AddToggle("AntiSitToggle", {Text="Anti Sit", Default=false})
local AntiSit = false
local antiSitConn1, antiSitConn2, antiSitConn3
local function neutralizeSeat(seat)
    if seat:IsA("Seat") or seat:IsA("VehicleSeat") then
        seat.Disabled = true seat.CanTouch = false
    end
end
local function ToggleAntiSit(state)
    AntiSit = state
    if antiSitConn1 then antiSitConn1:Disconnect() end
    if antiSitConn2 then antiSitConn2:Disconnect() end
    if antiSitConn3 then antiSitConn3:Disconnect() end
    if state then
        for _, obj in ipairs(workspace:GetDescendants()) do neutralizeSeat(obj) end
        antiSitConn1 = workspace.DescendantAdded:Connect(function(obj)
            if obj:IsA("Seat") or obj:IsA("VehicleSeat") then task.wait(0.1) neutralizeSeat(obj) end
        end)
        if LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
            if hum then
                antiSitConn2 = hum:GetPropertyChangedSignal("Sit"):Connect(function()
                    if hum.Sit then hum.Sit = false end
                end)
            end
        end
        antiSitConn3 = LocalPlayer.CharacterAdded:Connect(function(char)
            local hum = char:WaitForChild("Humanoid")
            hum:GetPropertyChangedSignal("Sit"):Connect(function()
                if hum.Sit and AntiSit then hum.Sit = false end
            end)
        end)
    else
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Seat") or obj:IsA("VehicleSeat") then
                obj.Disabled = false obj.CanTouch = true
            end
        end
    end
end
Toggles.AntiSitToggle:OnChanged(function() ToggleAntiSit(Toggles.AntiSitToggle.Value) end)


