do
    MiscGroup:AddToggle("AntiSitToggle", {Text="Anti Sit", Default=false})
    getgenv().antiSitConns = getgenv().antiSitConns or {}
    Toggles.AntiSitToggle:OnChanged(function()
        local state = Toggles.AntiSitToggle.Value
        getgenv().AntiSitActive = state
        for _, c in ipairs(getgenv().antiSitConns) do pcall(function() c:Disconnect() end) end
        table.clear(getgenv().antiSitConns)

        local function neut(seat)
            if seat:IsA("Seat") or seat:IsA("VehicleSeat") then
                seat.Disabled = true
                seat.CanTouch = false
            end
        end

        if state then
            for _, obj in ipairs(workspace:GetDescendants()) do neut(obj) end
            table.insert(getgenv().antiSitConns, workspace.DescendantAdded:Connect(function(obj)
                if obj:IsA("Seat") or obj:IsA("VehicleSeat") then task.wait(0.1) neut(obj) end
            end))
            if LocalPlayer.Character then
                local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
                if hum then
                    table.insert(getgenv().antiSitConns, hum:GetPropertyChangedSignal("Sit"):Connect(function()
                        if hum.Sit then hum.Sit = false end
                    end))
                end
            end
            table.insert(getgenv().antiSitConns, LocalPlayer.CharacterAdded:Connect(function(char)
                local hum = char:WaitForChild("Humanoid")
                table.insert(getgenv().antiSitConns, hum:GetPropertyChangedSignal("Sit"):Connect(function()
                    if hum.Sit and getgenv().AntiSitActive then hum.Sit = false end
                end))
            end))
        else
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Seat") or obj:IsA("VehicleSeat") then
                    obj.Disabled = false
                    obj.CanTouch = true
                end
            end
        end
    end)
end

