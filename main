local AnimatedToolsGroup = Tabs.visuals:AddRightGroupbox('Animated Tools')

AnimatedToolsGroup:AddToggle('EnableAnimatedTools', {Text = 'Enable Animated Tools', Default = false})
AnimatedToolsGroup:AddDropdown('AnimToolHorizontal', {Values = {'sine spin', 'spin', 'random', 'jitter'}, Default = 1, Multi = false, Text = 'Horizontal Mode'})
AnimatedToolsGroup:AddSlider('AnimToolHorizontalSpeed', {Text = 'Horizontal Speed', Default = 10, Min = 0, Max = 100, Rounding = 0, Suffix = '%'})
AnimatedToolsGroup:AddDropdown('AnimToolVertical', {Values = {'sine spin', 'spin', 'random', 'jitter'}, Default = 1, Multi = false, Text = 'Vertical Mode'})
AnimatedToolsGroup:AddSlider('AnimToolVerticalSpeed', {Text = 'Vertical Speed', Default = 10, Min = 0, Max = 100, Rounding = 0, Suffix = '%'})

local oldToolGrips = {}

local function resetToolGrips()
    for tool, origGrip in pairs(oldToolGrips) do
        if tool and tool.Parent then
            pcall(function() tool.Grip = origGrip end)
        end
    end
    oldToolGrips = {}
end

Toggles.EnableAnimatedTools:OnChanged(function()
    if not Toggles.EnableAnimatedTools.Value then
        resetToolGrips()
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if not Toggles.EnableAnimatedTools or not Toggles.EnableAnimatedTools.Value then return end
    local char = LocalPlayer.Character
    if not char then return end

    local hMode = Options.AnimToolHorizontal and Options.AnimToolHorizontal.Value or 'sine spin'
    local hSpeed = (Options.AnimToolHorizontalSpeed and Options.AnimToolHorizontalSpeed.Value or 10) / 10
    local vMode = Options.AnimToolVertical and Options.AnimToolVertical.Value or 'sine spin'
    local vSpeed = (Options.AnimToolVerticalSpeed and Options.AnimToolVerticalSpeed.Value or 10) / 10

    local horiz = 0
    if hMode == 'sine spin' then
        horiz = math.sin(os.clock()) * 45
    elseif hMode == 'random' then
        horiz = (math.random() * 2 - 1) * 180
    elseif hMode == 'jitter' then
        horiz = math.random(-10, 10)
    elseif hMode == 'spin' then
        horiz = 45
    end

    local vert = 0
    if vMode == 'sine spin' then
        vert = math.sin(os.clock()) * 45
    elseif vMode == 'random' then
        vert = (math.random() * 2 - 1) * 180
    elseif vMode == 'jitter' then
        vert = math.random(-10, 10)
    elseif vMode == 'spin' then
        vert = 45
    end

    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and child:FindFirstChild("Handle") then
            if not oldToolGrips[child] then
                oldToolGrips[child] = child.Grip
            end
            pcall(function()
                child.Grip = child.Grip * CFrame.Angles(math.rad(vert * dt * vSpeed), math.rad(horiz * dt * hSpeed), 0)
            end)
        end
    end
end)

do
    local trailUtility = {}
    trailUtility.trail_character = function(state)
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp  = char:WaitForChild("HumanoidRootPart")
        if state then
            if hrp:FindFirstChild("BlaBla") then return end
            local trail = Instance.new("Trail", hrp)
            trail.Name = "BlaBla"
            local a0 = Instance.new("Attachment",hrp); a0.Position=Vector3.new(0,1,0)
            local a1 = Instance.new("Attachment",hrp); a1.Position=Vector3.new(0,-1,0)
            trail.Attachment0=a0; trail.Attachment1=a1
            trail.Color=ColorSequence.new(TrailVisuals.Color, TrailVisuals.Color2)
            trail.Lifetime=TrailVisuals.LifeTime
            trail.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,0)})
            trail.LightEmission=0.2; trail.Brightness=10
            trail.WidthScale=NumberSequence.new{NumberSequenceKeypoint.new(0,TrailVisuals.Width),NumberSequenceKeypoint.new(1,0)}
        else
            for _, c in ipairs(hrp:GetChildren()) do
                if c:IsA("Trail") and c.Name=="BlaBla" then c:Destroy() end
            end
        end
    end

    local SelfEffectsGroup = Tabs.visuals:AddLeftGroupbox('Self Auras')

    local sa2Enabled     = false
    local sa2Color       = Color3.fromRGB(133, 220, 255)
    local sa2Types       = {}
    local sa2Attachments = {}
    local sa2Models      = {}
    local sa2CharConn

    local sa2ModelIDs = {
        ["Cloak Aura"]   = 99046723611000,
        ["Sweet Hearth"] = 91724768175470,
        ["Ethereal"]     = 97041568674250,
    }

    local sa2ParticleAuraIDs = {
        ["Starlight"] = 134645216613107,
        ["Heavenly"]  = 139300897520961,
        ["Ribbon"]    = 132069507632161,
        ["Sakura"]    = 81755778619404,
        ["Angel"]     = 97658130917593,
        ["Wind"]      = 80694081850877,
        ["Flow"]      = 119913533725648,
        ["Star"]      = 73754563740680,
    }
    local sa2ParticleAuraCache = {}

    local function sa2Clear()
        for _, a in ipairs(sa2Attachments) do pcall(function() a:Destroy() end) end
        sa2Attachments = {}
        for _, m in ipairs(sa2Models) do pcall(function() m:Destroy() end) end
        sa2Models = {}
    end

    local function sa2MakeAtt(parent, cf)
        local a = Instance.new("Attachment")
        a.CFrame = cf a.Parent = parent
        table.insert(sa2Attachments, a) return a
    end

    local function sa2AttachModel(assetId)
        local char = LocalPlayer.Character if not char then return end
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") if not torso then return end
        local ok, model = pcall(function() return game:GetObjects("rbxassetid://"..assetId)[1] end)
        if not ok or not model then return end
        model.Parent = char
        if model:IsA("Accessory") then
            local hum = char:FindFirstChildWhichIsA("Humanoid")
            if hum then hum:AddAccessory(model) table.insert(sa2Models, model) end
            return
        end
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide=false p.Massless=true p.Anchored=false p.CanTouch=false p.CanQuery=false
            end
        end
        if model:IsA("Model") then
            model:PivotTo(torso.CFrame)
            for _, p in ipairs(model:GetDescendants()) do
                if p:IsA("BasePart") then
                    local m6 = Instance.new("Motor6D")
                    m6.Part0=torso m6.Part1=p m6.C0=torso.CFrame:ToObjectSpace(p.CFrame) m6.Parent=torso
                end
            end
        elseif model:IsA("BasePart") then
            model.CFrame=torso.CFrame
            local m6 = Instance.new("Motor6D")
            m6.Part0=torso m6.Part1=model m6.C0=torso.CFrame:ToObjectSpace(model.CFrame) m6.Parent=torso
        end
        table.insert(sa2Models, model)
    end

    local function sa2AttachParticleAura(name, assetId)
        local char = LocalPlayer.Character if not char then return end

        local source = sa2ParticleAuraCache[name]
        if not source then
            local ok, obj = pcall(function() return game:GetObjects("rbxassetid://"..assetId)[1] end)
            if not ok or not obj then return end
            sa2ParticleAuraCache[name] = obj
            source = obj
        end

        local ok, cloned = pcall(function() return source:Clone() end)
        if not ok or not cloned then return end

        for _, part in ipairs(cloned:GetChildren()) do
            local target = char:FindFirstChild(part.Name)
            if target then
                for _, child in ipairs(part:GetChildren()) do
                    child.Parent = target
                    table.insert(sa2Attachments, child)
                end
            end
        end

        cloned:Destroy()
    end

    local function sa2CreateAngelic(char)
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") if not torso then return end
        local a1 = sa2MakeAtt(torso, CFrame.new(-1.012,0.5,0.852,0.966,0,0.259,0,1,0,-0.259,0,0.966))
        local function makeE(parent, dir)
            local e = Instance.new("ParticleEmitter")
            e.Lifetime=NumberRange.new(1,1) e.LockedToPart=true e.LightEmission=1
            e.Color=ColorSequence.new(sa2Color) e.Speed=NumberRange.new(0.05,0.05)
            e.Size=NumberSequence.new(2.75,3.5) e.Rate=4
            e.Texture="http://www.roblox.com/asset/?id=13267054240"
            e.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.2,0),NumberSequenceKeypoint.new(0.8,0),NumberSequenceKeypoint.new(1,1)})
            e.EmissionDirection=dir e.Orientation=Enum.ParticleOrientation.VelocityPerpendicular e.Parent=parent
        end
        makeE(a1, Enum.NormalId.Back)
        local a2 = sa2MakeAtt(torso, CFrame.new(1.167,0.5,0.852,0.966,0,-0.259,0,1,0,0.259,0,0.966))
        makeE(a2, Enum.NormalId.Front)
        local a3 = sa2MakeAtt(torso, CFrame.new(0,0.3,0))
        local e3 = Instance.new("ParticleEmitter")
        e3.Lifetime=NumberRange.new(2,2) e3.FlipbookLayout=Enum.ParticleFlipbookLayout.Grid4x4
        e3.SpreadAngle=Vector2.new(180,180) e3.LockedToPart=true e3.LightEmission=1
        e3.Color=ColorSequence.new(sa2Color) e3.Speed=NumberRange.new(0.5,0.5) e3.Brightness=2
        e3.Size=NumberSequence.new(3,4) e3.Rate=5 e3.Texture="rbxassetid://11402221943"
        e3.FlipbookMode=Enum.ParticleFlipbookMode.OneShot
        e3.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.5,0.3),NumberSequenceKeypoint.new(1,1)})
        e3.Parent=a3
    end

